<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!-- Versão única de todos os executáveis (interface, aplicador, nexus, nexus-task, nexus-recover). A publicação
       (tools/packaging/publish.py) passa SourceRevisionId com o hash do commit: InformationalVersion = 1.0.0+<hash>.
       CI (release.yml manual): 1.0.0-ci.<execução>. Estável: tag v1.0.0 ou Run workflow com stable=true (sem sufixo).
       Pré-lançamento: -p:VersionSuffix=rc.1 (ou a tag v1.0.0-rc.1). Depois de publicar a estável, suba para 1.0.1
       (docs/08-packaging.md, "Lançar uma versão"). -->
  <PropertyGroup>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Product>NEXUS</Product>
    <Company>NEXUS</Company>
    <Authors>robinexe</Authors>
    <Description>NEXUS: utilitário de desempenho e manutenção para Windows, com diário, confirmação e desfazer.</Description>
    <Copyright>Copyright (c) 2026 robinexe</Copyright>
  </PropertyGroup>
  <!-- Marca de cópia publicada (publish.py passa -p:NexusPackaged=true): sem ela o NEXUS é "versão de desenvolvimento" e não
       procura nem instala atualizações (src/Nexus.Updates, docs/11-atualizacao.md). -->
  <ItemGroup Condition="'$(NexusPackaged)' == 'true'">
    <AssemblyMetadata Include="NexusPackaged" Value="true" />
  </ItemGroup>
</Project>
