<Project Sdk="Microsoft.NET.Sdk">
  <!-- nexus: linha de comando (varrer, recomendar, simular, aplicar pelo aplicador, desfazer, histórico, medir, comparar).
       Não escreve no sistema: toda mudança vai pelo aplicador (nexus-broker, copiado ao lado, como na interface). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nexus</AssemblyName>
    <RootNamespace>Nexus.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Automation\Nexus.Automation.csproj" />
    <ProjectReference Include="..\Nexus.Broker\Nexus.Broker.csproj" />
    <ProjectReference Include="..\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
    <ProjectReference Include="..\Nexus.Measurement\Nexus.Measurement.csproj" />
    <ProjectReference Include="..\Nexus.Persistence\Nexus.Persistence.csproj" />
    <!-- nexus selftest: leituras de todos os módulos (somente leitura). -->
    <ProjectReference Include="..\Nexus.SelfTest\Nexus.SelfTest.csproj" />
    <!-- O aplicador (nexus-broker) vai junto: é iniciado sob demanda para simular e aplicar. Só ordem de build. -->
    <ProjectReference Include="..\Nexus.Broker.Host\Nexus.Broker.Host.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyBrokerHost" AfterTargets="Build">
    <ItemGroup>
      <BrokerHostFiles Include="$(MSBuildThisFileDirectory)..\Nexus.Broker.Host\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerHostFiles)" DestinationFiles="@(BrokerHostFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
