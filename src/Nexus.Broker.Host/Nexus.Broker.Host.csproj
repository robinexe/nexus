<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host do broker (Windows). Escritas reais só passam pelo VmOnlyExecutionGate: no PC físico, nada é escrito.
       Console (desenvolvimento) ou serviço Windows (LocalSystem, opção service; instalado por tools\service\Install-Broker.ps1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>nexus-broker</AssemblyName>
    <RootNamespace>Nexus.Broker.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Broker\Nexus.Broker.csproj" />
    <ProjectReference Include="..\Nexus.Persistence\Nexus.Persistence.csproj" />
    <ProjectReference Include="..\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <ProjectReference Include="..\Nexus.GameProfiles\Nexus.GameProfiles.csproj" />
    <ProjectReference Include="..\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
