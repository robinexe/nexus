<Project Sdk="Microsoft.NET.Sdk">
  <!-- Módulo SystemTools. net10.0: a lógica roda nos testes em qualquer SO; o que toca o Windows usa [SupportedOSPlatform("windows")]. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.SystemTools</RootNamespace>
    <!-- LibraryImport (wlanapi, crypt32, srclient, dnsapi) gera código com ponteiros. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <!-- Checagens do PC (Checks/): os leitores devolvem os registros e as regras de Nexus.HardwareDiscovery.PcChecks. -->
    <ProjectReference Include="..\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
  </ItemGroup>
</Project>
