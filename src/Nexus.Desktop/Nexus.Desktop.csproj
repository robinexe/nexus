<Project Sdk="Microsoft.NET.Sdk">
  <!-- Interface desktop em modo SOMENTE LEITURA. Não constrói ActionExecutor, não pega a trava de execução e só registra
       handlers embrulhados em SimulationOnlyHandler. DesktopReadOnlyTests verifica isso no assembly compilado. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nexus.Desktop</RootNamespace>
    <AssemblyName>Nexus.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone gerado de tools/packaging/icon/nexus.svg por build_icon.py (versionado; não precisa regenerar no build). -->
    <ApplicationIcon>Assets\nexus.ico</ApplicationIcon>
    <!-- Publicação (tools/packaging/publish.py): self-contained por RID, sem trimming (WPF e reflexão não suportam). -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.Persistence\Nexus.Persistence.csproj" />
    <ProjectReference Include="..\Nexus.Broker\Nexus.Broker.csproj" />
    <!-- O aplicador (nexus-broker) vai junto da interface: é iniciado sob demanda para aplicar neste PC. -->
    <ProjectReference Include="..\Nexus.Broker.Host\Nexus.Broker.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Nexus.Measurement\Nexus.Measurement.csproj" />
    <ProjectReference Include="..\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <ProjectReference Include="..\Nexus.Lab.Cpu\Nexus.Lab.Cpu.csproj" />
    <ProjectReference Include="..\Nexus.Lab.Gpu\Nexus.Lab.Gpu.csproj" />
    <ProjectReference Include="..\Nexus.Lab.Memory\Nexus.Lab.Memory.csproj" />
    <ProjectReference Include="..\Nexus.Cleaning\Nexus.Cleaning.csproj" />
    <ProjectReference Include="..\Nexus.DiskTools\Nexus.DiskTools.csproj" />
    <ProjectReference Include="..\Nexus.Programs\Nexus.Programs.csproj" />
    <ProjectReference Include="..\Nexus.Boot\Nexus.Boot.csproj" />
    <ProjectReference Include="..\Nexus.Privacy\Nexus.Privacy.csproj" />
    <ProjectReference Include="..\Nexus.Security\Nexus.Security.csproj" />
    <ProjectReference Include="..\Nexus.Security.Scanner\Nexus.Security.Scanner.csproj" />
    <ProjectReference Include="..\Nexus.Monitoring\Nexus.Monitoring.csproj" />
    <ProjectReference Include="..\Nexus.SystemTools\Nexus.SystemTools.csproj" />
    <ProjectReference Include="..\Nexus.DriverUpdates\Nexus.DriverUpdates.csproj" />
    <ProjectReference Include="..\Nexus.Automation\Nexus.Automation.csproj" />
    <ProjectReference Include="..\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
    <ProjectReference Include="..\Nexus.GameProfiles\Nexus.GameProfiles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- nexus.exe (linha de comando) ao lado da interface: a verificação semanal agendada chama este executável. -->
    <ProjectReference Include="..\Nexus.Cli\Nexus.Cli.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyCli" AfterTargets="Build">
    <ItemGroup>
      <CliFiles Include="$(MSBuildThisFileDirectory)..\Nexus.Cli\bin\$(Configuration)\net10.0\nexus.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBrokerHost" AfterTargets="Build">
    <ItemGroup>
      <BrokerHostFiles Include="$(MSBuildThisFileDirectory)..\Nexus.Broker.Host\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerHostFiles)" DestinationFiles="@(BrokerHostFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
