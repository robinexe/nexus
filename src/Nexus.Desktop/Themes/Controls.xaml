<!--
  Estilos de controle e de texto do NEXUS. Usa só as chaves de Themes/Tokens.xaml. Dono: design system (shell).

  Contrato (nomes fixos, use nas páginas):
    Texto ...... Text.Display, Text.H1, Text.H2, Text.Body, Text.Small, Text.Metric, Text.MetricLabel (+ Text.Readout, Text.Label)
    Painéis .... Panel.Card, Panel.Hero, Panel.Inset, Panel.Notice, Panel.Instrument
    Botões ..... Button.Primary (âmbar, a ação principal da tela), Button.Secondary, Button.Ghost (ciano, links), Button.Danger
    Selo ....... DataTemplate "Chip" (ContentPresenter Content={Binding Status} ContentTemplate={StaticResource Chip})
    Foco ....... Focus.Ring (anel ciano só no foco por teclado), Focus.Inset
    Conversores  StatusTone, SeverityHint, ZeroToVisible, FalseToVisible (Views/Shell) + os de Themes/Converters.xaml
  Por tipo (implícitos): TextBlock, Button, ToggleButton, CheckBox, RadioButton, TextBox, ComboBox, ComboBoxItem, ListBox,
  ListBoxItem, ListView, ListViewItem (com ou sem GridView), GridViewColumnHeader, ScrollBar, ToolTip, Expander, ProgressBar.
  Chaves antigas mantidas por compatibilidade: H1, Sub, Small, Card.

  Design system v2 (docs/10-design-system.md — leia antes de redesenhar uma página):
    Ícones ..... Themes/Icons.xaml: Geometry "Icon.*" em grade 24 (Icon.Cpu, Icon.Gpu, Icon.Ram, Icon.Disk, Icon.Clean, Icon.Programs,
                 Icon.Startup, Icon.Services, Icon.Privacy, Icon.Security, Icon.Scan, Icon.Network, Icon.Drivers, Icon.Measure,
                 Icon.Monitor, Icon.Auto, Icon.Assistant, Icon.MemoryDoctor, Icon.Settings, Icon.Check, Icon.Warning, Icon.Error,
                 Icon.Info, Icon.Undo, Icon.Refresh, Icon.Export, Icon.Lock, Icon.Trash, Icon.Quarantine…). Desenhe com c:Icon.
    Ilustrações  Assets/Illustrations/*.xaml: DrawingImage "Illo.*" 160×120 (Illo.Pc, Illo.Cpu, Illo.Gpu, Illo.Ram, Illo.Disk,
                 Illo.Cleaning, Illo.Programs, Illo.Startup, Illo.Services, Illo.Privacy, Illo.Security, Illo.Scanner, Illo.Network,
                 Illo.Drivers, Illo.Measure, Illo.Monitor, Illo.Automation, Illo.Assistant, Illo.MemoryDoctor, Illo.Settings,
                 Illo.Diagnostics, Illo.History).
    Componentes  Themes/Components.xaml + Views/Controls (xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"): c:HeroPanel,
                 c:AnimatedNumber, c:RingMeter, c:BeforeAfter, c:HowItWorks + c:StepItem (modelo StepCard), c:StatTile,
                 c:ExplainToggle, c:StatusChip, c:EmptyState, c:SkeletonLoader, c:Sparkline, c:Icon.
    Estilos .... Tab.Underline (abas), Explain.Toggle. Conversores: ResourceByKey, ToneBrush, PageIcon, InvertBool.
    Casca ...... Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="NomeDoTipoDaPagina" abre qualquer página.

  Movimento: hover/clique com fade curto (ShellMotion.Fast, que vira zero quando o Windows desliga animações). Nada em loop,
  exceto o indicador de ocupado enquanto algo está de fato carregando (e parado quando as animações estão desligadas).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">

  <!-- ===== Conversores da casca ===== -->
  <shell:StatusToneConverter x:Key="StatusTone"/>
  <shell:SeverityHintConverter x:Key="SeverityHint"/>
  <shell:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
  <shell:FalseToVisibleConverter x:Key="FalseToVisible"/>
  <shell:FractionScaleConverter x:Key="FractionScale"/>

  <!-- O canto entre as duas barras de rolagem e alguns modelos padrão usam esta cor de sistema: escurecida para o tema. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#161D2E"/>

  <!-- ===== Foco por teclado ===== -->
  <Style x:Key="Focus.Ring">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderBrush="{StaticResource Brush.Signal}" BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Focus.Inset">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="1" BorderBrush="{StaticResource Brush.Signal}" BorderThickness="1.5" CornerRadius="5" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Texto ===== -->
  <!-- Implícito: sem Foreground de propósito (herda da janela/controle; assim o texto dentro de botões e selos respeita a cor deles). -->
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Text.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Display}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="38"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style>
  <Style x:Key="Text.H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.H1}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Text.H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.H2}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="20"/>
  </Style>
  <Style x:Key="Text.Small" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Small}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="17"/>
  </Style>
  <Style x:Key="Text.Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Metric}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>
  <Style x:Key="Text.MetricLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Small}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Leitura de instrumento: valores médios (nomes de peças, versões) na fonte de números. -->
  <Style x:Key="Text.Readout" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Readout}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="32"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style>
  <!-- Rótulo de seção pequeno, em caixa normal (sem CAIXA ALTA espaçada). -->
  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Compatibilidade (páginas antigas) -->
  <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Text.H1}"/>
  <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="Margin" Value="0,6,0,18"/>
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}"/>

  <!-- ===== Painéis ===== -->
  <!-- "Instrumento de precisão": superfícies separadas por luminosidade e um realce de 1 px no topo (luz de cima), sem contorno.
       Quem quer destacar um cartão com cor passa BorderBrush E BorderThickness="1". -->
  <Style x:Key="Panel.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Highlight}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
    <Setter Property="Padding" Value="18,16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Panel.Hero" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Highlight}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
    <Setter Property="Padding" Value="32,28"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Panel.Inset" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.LineSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Painel de instrumento (novo, 05/11/2026): o degrau mais fundo, atrás de mostradores ao vivo (Início, Varredura). -->
  <Style x:Key="Panel.Instrument" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Ground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.LineSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
    <Setter Property="Padding" Value="28,24"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Aviso: fundo âmbar escuro. Use para "nada é aplicado aqui", limites, cuidados. -->
  <Style x:Key="Panel.Notice" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.WarnBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TraceLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- Compatibilidade -->
  <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
    <Setter Property="Margin" Value="0,0,12,12"/>
  </Style>

  <!-- ===== Selo de status ===== -->
  <!-- Fundo no tom do status a 14%, ponto e texto no tom. Conteúdo: FactStatus, DiagnosticSeverity, PlanStatus, CapabilityLabel. -->
  <DataTemplate x:Key="Chip">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True">
      <Border CornerRadius="{StaticResource Radius.Chip}" Background="{Binding Converter={StaticResource StatusTone}}" Opacity="0.14"/>
      <StackPanel Orientation="Horizontal" Margin="8,2,10,3">
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,1,6,0" Fill="{Binding Converter={StaticResource StatusTone}}"/>
        <TextBlock Text="{Binding Converter={StaticResource StatusText}}" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                   Foreground="{Binding Converter={StaticResource StatusTone}, ConverterParameter=text}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- ===== Botões ===== -->
  <!-- Um único modelo: a "lavagem" usa a cor do texto do próprio botão (clareia os escuros, escurece o âmbar). -->
  <ControlTemplate x:Key="Template.Button" TargetType="ButtonBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"/>
      <Border x:Name="Wash" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="Press" Background="{TemplateBinding Foreground}" CornerRadius="{StaticResource Radius.Control}" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" Focusable="False" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.08" Duration="{x:Static shell:ShellMotion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static shell:ShellMotion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.10" Duration="{x:Static shell:ShellMotion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static shell:ShellMotion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Button.Base" TargetType="ButtonBase">
    <Setter Property="Template" Value="{StaticResource Template.Button}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Trace}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="Padding" Value="20,10"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.BadSoft}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Bad}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <!-- Botão sem estilo explícito = secundário. -->
  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>

  <!-- ToggleButton solto: como o secundário, marcado fica com contorno âmbar. -->
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== CheckBox: caixa limpa, marcada em âmbar ===== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="4"/>
              <Path x:Name="Check" Data="M4.5,9.2 L7.6,12.3 L13.5,5.9" Stroke="{StaticResource Brush.Bg}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              <Border x:Name="Dash" Width="8" Height="2" CornerRadius="1" Background="{StaticResource Brush.Bg}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="9,0,0,0" Focusable="False" RecognizesAccessKey="True"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Content" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Trace}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Trace}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
              <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== RadioButton ===== -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Brush.Trace}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter x:Name="Content" Grid.Column="1" Margin="9,0,0,0" Focusable="False" RecognizesAccessKey="True"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Content" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Trace}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TextBox ===== -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Brush.Trace}"/>
    <Setter Property="SelectionOpacity" Value="0.35"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ComboBox (somente leitura e editável) ===== -->
  <ControlTemplate x:Key="ComboBox.Toggle" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
      <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 L8,0"
            Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
        <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Brush.Text}"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="Root">
            <ToggleButton x:Name="Toggle" Template="{StaticResource ComboBox.Toggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite" Margin="10,6,30,6" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <TextBox x:Name="PART_EditableTextBox" Margin="2,1,26,1" Visibility="Hidden" Background="Transparent" BorderThickness="0"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Focusable="True"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border x:Name="DropDown" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Control}" TextElement.Foreground="{StaticResource Brush.Text}" SnapsToDevicePixels="True">
                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDown" Property="MinHeight" Value="40"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ListBox ===== -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"/>
            <Border x:Name="Mark" Width="3" Margin="0,6" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Brush.Trace}" Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ListView / GridView ===== -->
  <!-- O modelo do ListView não é trocado (o GridView precisa do ScrollViewer com cabeçalho dele); só cores e borda. -->
  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>

  <!-- Funciona com GridView (GridViewRowPresenter) e sem ele (ContentPresenter). -->
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="2,7"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1"/>
            <Border x:Name="Mark" Width="2" HorizontalAlignment="Left" Background="{StaticResource Brush.Trace}" Visibility="Collapsed"/>
            <GridViewRowPresenter x:Name="Row" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                  Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <ContentPresenter x:Name="Plain" Margin="{TemplateBinding Padding}" Visibility="Collapsed"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
              <Setter TargetName="Row" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Plain" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
              <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent">
                    <Rectangle Width="1" Margin="0,9" HorizontalAlignment="Center" Fill="{StaticResource Brush.Line}"/>
                  </Border>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="Role" Value="Padding">
              <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Role" Value="Floating">
              <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
              <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ScrollBar fina ===== -->
  <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Margin="2" CornerRadius="3" Background="{StaticResource Brush.Line}" SnapsToDevicePixels="True"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TextDim}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.TextMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.PageButton}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.PageButton}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Track x:Name="PART_Track" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.PageButton}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.PageButton}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Height" Value="Auto"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== ToolTip ===== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MaxWidth" Value="560"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Expander: cabeçalho com seta que gira ===== -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Padding" Value="0,8,0,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel Background="{TemplateBinding Background}">
            <ToggleButton x:Name="HeaderToggle" DockPanel.Dock="Top" FocusVisualStyle="{StaticResource Focus.Ring}" Cursor="Hand"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                          Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource Font.Display}" FontSize="14"
                          HorizontalContentAlignment="Stretch">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="6,7" SnapsToDevicePixels="True">
                    <DockPanel>
                      <Path x:Name="Chevron" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                            Data="M3,1 L7,5 L3,9" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"/>
                      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                      <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Brush.Text}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90"/>
                        </Setter.Value>
                      </Setter>
                      <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Brush.Trace}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Margin="{TemplateBinding Padding}" Visibility="Collapsed" Focusable="False"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ProgressBar: barra âmbar fina ===== -->
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Line}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            <Border x:Name="Sweep" Background="{TemplateBinding Foreground}" CornerRadius="2" Visibility="Collapsed">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <LinearGradientBrush.RelativeTransform>
                    <TranslateTransform X="0"/>
                  </LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="Transparent" Offset="0.32"/>
                  <GradientStop Color="Black" Offset="0.32"/>
                  <GradientStop Color="Black" Offset="0.68"/>
                  <GradientStop Color="Transparent" Offset="0.68"/>
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="SweepRun">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                     From="{x:Static shell:ShellMotion.SweepFrom}" To="{x:Static shell:ShellMotion.SweepTo}"
                                     Duration="0:0:1.4" RepeatBehavior="Forever"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="SweepRun"/>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
