<!--
  NEXUS — tokens de design ("bancada de telemetria"). Contrato compartilhado: as chaves abaixo NÃO mudam de nome; os valores podem
  ser refinados. Ideia: fundo azul-grafite profundo, traço âmbar de fósforo (o que é medido/agora/depois), ciano de sinal
  (referência/antes), verde e vermelho só para melhora/piora. Tipos nativos do Windows: Bahnschrift (instrumento, DIN) para
  títulos e números; Segoe UI Variable para texto corrido.
  Chaves novas (acréscimos, podem ser usadas por qualquer página): C.SurfaceLow, C.LineSoft, Brush.SurfaceLow, Brush.LineSoft,
  Brush.Hover, Brush.TraceSoft, Brush.SignalSoft, Brush.GoodSoft, Brush.BadSoft, Brush.TraceLine, Brush.Graticule, Size.Readout,
  Radius.Chip, Space.Page.
  05/11/2026 ("Instrumento de precisão", docs/14-redesign-brief.md): C.Ground, Brush.Ground, Brush.Highlight, Brush.TextSoft,
  Brush.Track, Size.Hero, Space.1…8. C.TextDim clareado para #7C88A8 (5,3:1 sobre Bg; antes 3,3:1 reprovava WCAG AA).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cores -->
  <Color x:Key="C.Ground">#0A0E18</Color>
  <Color x:Key="C.Bg">#0E1320</Color>
  <Color x:Key="C.SurfaceLow">#111726</Color>
  <Color x:Key="C.Surface">#161D2E</Color>
  <Color x:Key="C.SurfaceHi">#1F2840</Color>
  <Color x:Key="C.Line">#2A3550</Color>
  <Color x:Key="C.LineSoft">#1E2638</Color>
  <Color x:Key="C.Text">#E8ECF5</Color>
  <Color x:Key="C.TextMuted">#8A96B3</Color>
  <Color x:Key="C.TextDim">#7C88A8</Color>
  <Color x:Key="C.Trace">#FFB547</Color>
  <Color x:Key="C.Signal">#4FD1E8</Color>
  <Color x:Key="C.Good">#5EE6A0</Color>
  <Color x:Key="C.Bad">#FF6B7A</Color>
  <Color x:Key="C.WarnBg">#251F12</Color>

  <SolidColorBrush x:Key="Brush.Ground" Color="{StaticResource C.Ground}"/>
  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource C.Bg}"/>
  <SolidColorBrush x:Key="Brush.SurfaceLow" Color="{StaticResource C.SurfaceLow}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}"/>
  <SolidColorBrush x:Key="Brush.SurfaceHi" Color="{StaticResource C.SurfaceHi}"/>
  <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="Brush.LineSoft" Color="{StaticResource C.LineSoft}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource C.TextMuted}"/>
  <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource C.TextDim}"/>
  <!-- Âmbar: o que é medido agora, "depois", ação principal -->
  <SolidColorBrush x:Key="Brush.Trace" Color="{StaticResource C.Trace}"/>
  <!-- Ciano: referência, "antes", informação -->
  <SolidColorBrush x:Key="Brush.Signal" Color="{StaticResource C.Signal}"/>
  <SolidColorBrush x:Key="Brush.Good" Color="{StaticResource C.Good}"/>
  <SolidColorBrush x:Key="Brush.Bad" Color="{StaticResource C.Bad}"/>
  <SolidColorBrush x:Key="Brush.WarnBg" Color="{StaticResource C.WarnBg}"/>

  <!-- Tons translúcidos: hover, seleção e fundos de selo (sempre sobre as superfícies escuras) -->
  <SolidColorBrush x:Key="Brush.Hover" Color="#0FE8ECF5"/>
  <SolidColorBrush x:Key="Brush.TraceSoft" Color="#1FFFB547"/>
  <SolidColorBrush x:Key="Brush.TraceLine" Color="#40FFB547"/>
  <SolidColorBrush x:Key="Brush.SignalSoft" Color="#1A4FD1E8"/>
  <SolidColorBrush x:Key="Brush.GoodSoft" Color="#1A5EE6A0"/>
  <SolidColorBrush x:Key="Brush.BadSoft" Color="#1FFF6B7A"/>
  <!-- Véu por trás dos avisos do NEXUS (Views/Shell/NexusDialog): Bg a 85 %. -->
  <SolidColorBrush x:Key="Brush.Scrim" Color="#D90E1320"/>
  <!-- "Instrumento de precisão" (05/11/2026): profundidade por luz, não por borda. Realce de 1 px no topo das superfícies,
       texto de apoio claro sobre superfície (frases dos mostradores) e trilho dos mostradores. -->
  <SolidColorBrush x:Key="Brush.Highlight" Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="Brush.TextSoft" Color="#C9D1E3"/>
  <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource C.LineSoft}"/>

  <!-- Retícula de osciloscópio: grade fina para áreas de instrumento (use com Opacity baixa) -->
  <DrawingBrush x:Key="Brush.Graticule" TileMode="Tile" Stretch="None"
                Viewport="0,0,32,32" ViewportUnits="Absolute" Viewbox="0,0,32,32" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Geometry="M0,0.5 L32,0.5 M0.5,0 L0.5,32">
        <GeometryDrawing.Pen>
          <Pen Brush="{StaticResource Brush.Line}" Thickness="1"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Tipos -->
  <FontFamily x:Key="Font.Display">Bahnschrift SemiBold</FontFamily>
  <FontFamily x:Key="Font.Numbers">Bahnschrift SemiCondensed</FontFamily>
  <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Escala (px): 12 · 14 · 17 · 24 · 32 · 44 (números grandes); 28 para leituras de instrumento; 56 para o número herói -->
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Small">12</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Body">14</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.H2">17</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.H1">24</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Display">32</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Metric">44</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Readout">28</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Size.Hero">56</system:Double>

  <!-- Raios por hierarquia: painel grande 14, cartão 10, controle 6, selo 10 -->
  <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
  <CornerRadius x:Key="Radius.Card">10</CornerRadius>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">10</CornerRadius>

  <!-- Margem padrão de página -->
  <Thickness x:Key="Space.Page">40,28,40,40</Thickness>
  <!-- Grade de 4 px (espaços entre blocos): 4 · 8 · 12 · 16 · 24 · 32 · 48 · 64 -->
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.1">4</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.2">8</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.3">12</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.4">16</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.5">24</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.6">32</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.7">48</system:Double>
  <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="Space.8">64</system:Double>

  <!-- Durações de movimento (respeitar SystemParameters.ClientAreaAnimation: sem animação quando desligada).
       Os modelos de controle usam Views/Shell/ShellMotion (x:Static), que já zera as durações quando o Windows desliga animações. -->
  <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
  <Duration x:Key="Motion.Normal">0:0:0.22</Duration>
  <Duration x:Key="Motion.Slow">0:0:0.6</Duration>

  <!-- Compatibilidade com as chaves antigas (as páginas migram para as novas) -->
  <StaticResource x:Key="Bg" ResourceKey="Brush.Bg"/>
  <StaticResource x:Key="Panel" ResourceKey="Brush.Surface"/>
  <StaticResource x:Key="PanelAlt" ResourceKey="Brush.SurfaceHi"/>
  <StaticResource x:Key="Line" ResourceKey="Brush.Line"/>
  <StaticResource x:Key="Fg" ResourceKey="Brush.Text"/>
  <StaticResource x:Key="Muted" ResourceKey="Brush.TextMuted"/>
  <StaticResource x:Key="Accent" ResourceKey="Brush.Trace"/>
  <StaticResource x:Key="Warn" ResourceKey="Brush.WarnBg"/>
</ResourceDictionary>
