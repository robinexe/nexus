<!--
  Inicialização: tempo de boot medido pelo Windows (Diagnostics-Performance), histórico em barras e a lista de itens com
  interruptor (mesmo método do Gerenciador de Tarefas). Recursos locais em DataTemplate.Resources; do tema, só chaves do contrato.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:o="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:StartupPage}">
    <DataTemplate.Resources>
      <o:EmptyToCollapsedConverter x:Key="B.Has"/>
      <o:EmptyToCollapsedConverter x:Key="B.HasNot" Invert="True"/>

      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Interruptor: um botão (o estado vem do sistema relido depois de aplicar, nunca do clique). -->
      <Style x:Key="B.Switch" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="track" Width="40" Height="22" CornerRadius="11" BorderThickness="1"
                      Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Line}">
                <Ellipse x:Name="knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.TextDim}"/>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.GoodSoft}"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
                  <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Good}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Selo de impacto: Alto (vermelho), Médio (âmbar), Baixo (verde), Desconhecido (neutro). -->
      <DataTemplate x:Key="B.Impact">
        <Border x:Name="chip" BorderThickness="1" CornerRadius="9" Padding="9,1,9,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                BorderBrush="{StaticResource Brush.Line}" ToolTip="{Binding ImpactReason}">
          <TextBlock x:Name="label" Text="{Binding ImpactLabel}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Small}"
                     Foreground="{StaticResource Brush.TextMuted}"/>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding ImpactTone}" Value="Bad">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Bad}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.BadSoft}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ImpactTone}" Value="Warn">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ImpactTone}" Value="Good">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.GoodSoft}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>

        <!-- Hero: tempo real do último boot e histórico -->
        <Border Style="{StaticResource Panel.Hero}" Margin="0,18,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="280"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="Último boot (medido pelo Windows)" Style="{StaticResource Text.MetricLabel}"/>
              <TextBlock Text="{Binding HeroValue}" Style="{StaticResource Text.Metric}" FontSize="44" Foreground="{StaticResource Brush.Trace}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Body}" Margin="0,6,0,0"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
                         Text="Fonte: log Microsoft-Windows-Diagnostics-Performance (eventos 100 a 110). Mudanças só aparecem no próximo boot."/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Visibility="{Binding HasBootData, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Últimas inicializações" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding BootBars}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Width="30" Margin="0,0,4,0" ToolTip="{Binding Value}">
                      <Grid Height="92">
                        <Border x:Name="bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                Background="{StaticResource Brush.Signal}" Opacity="0.55"/>
                      </Grid>
                      <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Numbers}" FontSize="10.5" HorizontalAlignment="Center"
                                 Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsLast}" Value="True">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Trace}"/>
                        <Setter TargetName="bar" Property="Opacity" Value="1"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Desfazer visível depois de aplicar -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,14,0,0" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LastChange}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Desfazer" Style="{StaticResource Button.Secondary}" Command="{Binding UndoCommand}" Margin="12,0,0,0"/>
          </Grid>
        </Border>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,12,0,0"
                   Visibility="{Binding Message, Converter={StaticResource B.Has}}"/>

        <!-- Barra de ferramentas -->
        <Grid Margin="0,20,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nome, editor ou caminho"/>
          <CheckBox Grid.Column="1" Content="Mostrar itens do Windows" IsChecked="{Binding ShowWindowsItems}" VerticalAlignment="Center" Margin="14,0,0,0"/>
          <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="14,0"/>
          <Button Grid.Column="3" Content="Ler de novo" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Notes}" Visibility="{Binding Notes.Count, Converter={StaticResource B.Has}}" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,1"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Lendo registro, pastas, tarefas e serviços…" Style="{StaticResource Text.Small}"
                   Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>

        <!-- Lista -->
        <ItemsControl ItemsSource="{Binding Visible}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource B.Switch}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding StateText}" AutomationProperties.Name="{Binding StateText}"/>
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Small}"/>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" ToolTip="{Binding Path}"/>
                    <TextBlock Text="{Binding Origin}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
                    <TextBlock Text="{Binding FileText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}"
                               Visibility="{Binding FileText, Converter={StaticResource B.Has}}"/>
                    <TextBlock Text="{Binding ReadOnlyReason}" Style="{StaticResource Text.Small}"
                               Visibility="{Binding ReadOnlyReason, Converter={StaticResource B.Has}}"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Impacto no boot" Style="{StaticResource Text.Small}"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource B.Impact}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  </StackPanel>

                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Content="Remover entrada" Style="{StaticResource Button.Danger}" Command="{Binding RemoveCommand}"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Pôr em manual" Style="{StaticResource Button.Secondary}" Command="{Binding ManualCommand}"
                            Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Text.Small}" Margin="0,14,0,0"
                   Text="Impacto: Alto = o Windows mediu 3 s ou mais para o item no boot; Médio = de 1 a 3 s; Baixo = menos de 1 s. Desconhecido = o Windows não registrou atraso desse item (ele só registra o que passa do limite dele), ou o log não pôde ser lido. Nada é estimado."/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
