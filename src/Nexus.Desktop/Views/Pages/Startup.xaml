<!--
  Inicialização (design system v2, docs/10-design-system.md):
    1. Destaque: foguete + "X s" do último boot contando (medido pelo próprio Windows) e o gráfico dos últimos boots ao lado
       (âmbar = último, vermelho = bem acima da média). "Ler de novo" / "Desfazer última mudança".
    2. Quatro números (ligados, impacto alto, órfãos, do Windows) + último boot comparado com a média.
    3. Como funciona: lê → mede → desliga → desfaz. Desfazer visível depois de aplicar.
    4. Itens como cartões: interruptor (estado relido do sistema, nunca do clique), ícone da origem, selo de impacto; caminho e
       motivo do impacto recolhidos. Esqueleto na primeira leitura; vazio com o próximo passo.
  A lógica é a mesma do StartupPage (só foram expostos números para a apresentação: BootSeconds, EnabledCount…).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:startup="clr-namespace:Nexus.Desktop.Views.Modules.Startup">
  <DataTemplate DataType="{x:Type vm:StartupPage}">
    <DataTemplate.Resources>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Interruptor: um botão (o estado vem do sistema relido depois de aplicar, nunca do clique). O botão desliza com fade curto. -->
      <Style x:Key="B.Switch" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="track" Width="46" Height="26" CornerRadius="13" BorderThickness="1"
                      Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Line}">
                <Ellipse x:Name="knob" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.TextDim}"/>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.GoodSoft}"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
                  <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Good}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Cartão de item da inicialização. -->
      <DataTemplate x:Key="B.ItemCard" DataType="{x:Type vm:StartupRow}">
        <Border x:Name="card" Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Interruptor (ou cadeado quando é só leitura) -->
            <StackPanel Width="60" VerticalAlignment="Center">
              <Button Style="{StaticResource B.Switch}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                      Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                      ToolTip="{Binding StateText}" AutomationProperties.Name="{Binding SwitchName}"/>
              <c:Icon Data="{StaticResource Icon.Lock}" Size="18" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Left" Margin="12,0,0,0"
                      Visibility="{Binding CanToggle, Converter={StaticResource FalseToVisible}}"/>
              <TextBlock x:Name="state" Text="{Binding StateText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse Fill="{Binding ImpactToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                      Foreground="{Binding ImpactToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
              <TextBlock Text="{Binding SubLine}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SubLine}"/>
              <Border Style="{StaticResource Panel.Notice}" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                      Visibility="{Binding FileText, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                  <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{Binding FileText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
              <TextBlock Text="{Binding ReadOnlyReason}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                         Visibility="{Binding ReadOnlyReason, Converter={StaticResource NullToCollapsed}}"/>
              <c:ExplainToggle Header="Detalhes" Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{Binding ImpactReason}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="130">
              <TextBlock Text="Impacto no boot" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              <c:StatusChip Tone="{Binding ImpactToneValue}" Text="{Binding ImpactLabel}" HorizontalAlignment="Right" Margin="0,3,0,0" ToolTip="{Binding ImpactReason}"/>
              <Button Content="Remover entrada" Style="{StaticResource Button.Danger}" Command="{Binding RemoveCommand}" Margin="0,8,0,0"
                      Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
              <Button Content="Pôr em manual" Style="{StaticResource Button.Secondary}" Command="{Binding ManualCommand}" Margin="0,8,0,0"
                      Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Grid>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsOn}" Value="False">
            <Setter TargetName="card" Property="Opacity" Value="0.78"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsOn}" Value="True">
            <Setter TargetName="state" Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque: último boot + gráfico dos últimos boots ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Startup}" Title="Último boot"
                     Number="{Binding BootSeconds}" Decimals="1" Suffix=" s" IsLoading="{Binding IsLoading}"
                     Caption="{Binding BootCaption}"
                     ActionText="Ler de novo" Command="{Binding RefreshCommand}"
                     SecondaryText="Desfazer última mudança" SecondaryCommand="{Binding UndoCommand}">
          <Grid MinWidth="260">
            <c:SkeletonLoader Shape="Tiles" Columns="6" Height="110" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Visibility="{Binding HasBootData, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Últimos boots (segundos)" Style="{StaticResource Text.Small}" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding BootBars}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:BootBar}">
                    <StackPanel Width="26" Margin="0,0,4,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                      <Grid Height="92">
                        <Border x:Name="bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                Background="{StaticResource Brush.Signal}" Opacity="0.55" startup:BarGrow.OnLoad="True"/>
                        <Border Height="1" Background="{StaticResource Brush.LineSoft}" VerticalAlignment="Bottom"/>
                      </Grid>
                      <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Numbers}" FontSize="10" HorizontalAlignment="Center"
                                 Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsSlow}" Value="True">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Bad}"/>
                        <Setter TargetName="bar" Property="Opacity" Value="0.7"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsLast}" Value="True">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Trace}"/>
                        <Setter TargetName="bar" Property="Opacity" Value="1"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Width="10" Height="10" Background="{StaticResource Brush.Trace}" CornerRadius="2" VerticalAlignment="Center"/>
                <TextBlock Text="último" Style="{StaticResource Text.Small}" Margin="6,0,12,0"/>
                <Border Width="10" Height="10" Background="{StaticResource Brush.Bad}" CornerRadius="2" VerticalAlignment="Center"/>
                <TextBlock Text="bem acima da média" Style="{StaticResource Text.Small}" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </c:HeroPanel>

        <!-- Desfazer visível depois de aplicar -->
        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding LastChange}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Números ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="150" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="4" Margin="-7,0,-7,16" Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Startup}" Number="{Binding EnabledCount}" Decimals="0" Tone="Warn"
                      Label="Ligados" Detail="Programas de terceiros que abrem com o Windows."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Bolt}" Number="{Binding HighImpactCount}" Decimals="0" Tone="{Binding HighImpactTone}"
                      Label="Impacto alto" Detail="O Windows mediu 3 s ou mais no boot."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Warning}" Number="{Binding OrphanCount}" Decimals="0"
                      Label="Órfãos" Detail="Apontam para um programa que não existe mais."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Windows}" Number="{Binding WindowsCount}" Decimals="0" Tone="Info"
                      Label="Do Windows" Detail="Ocultos por padrão: normalmente não se desliga."/>
        </UniformGrid>

        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Último boot comparado com a média -->
          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <c:Icon Data="{StaticResource Icon.Measure}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Último boot × média" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <c:BeforeAfter Before="{Binding BootAverageSeconds}" After="{Binding BootSeconds}" HigherIsBetter="False"
                             BeforeLabel="Média dos boots" AfterLabel="Último boot"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,10,0,0"
                         Text="Mudanças aqui só aparecem no próximo boot."/>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                             Text="Fonte: log Microsoft-Windows-Diagnostics-Performance (eventos 100 a 110), o mesmo que o Windows usa para medir o próprio boot. Nada é estimado."/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </Border>
          <!-- Como funciona -->
          <Border Grid.Column="2" Style="{StaticResource Panel.Inset}" Padding="18,14,6,14">
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Registro, pasta Inicializar, tarefas e serviços."/>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Mede" Text="Impacto vem do Windows, item por item."/>
              <c:StepItem Icon="{StaticResource Icon.Startup}" Title="Desliga" Text="Igual ao Gerenciador de Tarefas. O programa fica." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Um clique volta ao que era." Tone="Good"/>
            </c:HowItWorks>
          </Border>
        </Grid>

        <!-- ===== 3. Itens ===== -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <c:Icon Data="{StaticResource Icon.Startup}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
            <TextBlock Text="O que abre com o Windows" Style="{StaticResource Text.H2}" FontSize="15.5" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left"
                   ToolTip="Buscar por nome, editor ou caminho" AutomationProperties.Name="Buscar na inicialização"/>
          <CheckBox Grid.Column="2" Content="Mostrar itens do Windows" IsChecked="{Binding ShowWindowsItems}" VerticalAlignment="Center" Margin="14,0,8,0"/>
          <Button Grid.Column="3" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,10"
                   Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}"/>

        <c:SkeletonLoader Shape="Lines" Lines="6" Margin="4,4,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Startup}" Text="Nada encontrado."
                      Detail="Nenhum item de terceiros (ou da busca) abre com o Windows. Os do Windows ficam ocultos."
                      ActionText="Ler de novo" Command="{Binding RefreshCommand}"
                      Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>

        <ItemsControl ItemsSource="{Binding Visible}" ItemTemplate="{StaticResource B.ItemCard}" Focusable="False"/>

        <Border Style="{StaticResource Panel.Inset}" Padding="14,6,14,10" Margin="0,8,0,0">
          <StackPanel>
            <c:ExplainToggle Header="Como o impacto é medido?">
              <TextBlock Style="{StaticResource Text.Small}"
                         Text="Alto = o Windows mediu 3 s ou mais para o item no boot; Médio = de 1 a 3 s; Baixo = menos de 1 s. Desconhecido = o Windows não registrou atraso desse item (ele só registra o que passa do limite dele), ou o log não pôde ser lido. Nada é estimado."/>
            </c:ExplainToggle>
            <c:ExplainToggle Header="Observações da leitura" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </c:ExplainToggle>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
