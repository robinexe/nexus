<!--
  Laboratório da placa de vídeo (design system v2, docs/10-design-system.md):
    1. Destaque: placa com duas ventoinhas, memória de vídeo contando, anel da VRAM em uso, "Gravar enquanto jogo" / "Ler de novo".
    2. Desfazer sempre visível para o que foi aplicado nesta sessão.
    3. Quatro cartões: barramento PCIe, limite de potência, memória de vídeo, monitor principal.
    4. Monitores: antes → depois (Hz de agora × o máximo que o monitor aguenta) com "Usar 144 Hz".
    5. Gravar enquanto joga: como funciona em 4 passos, gráfico com legenda (entra da esquerda para a direita), veredito.
    6. O que segura a placa: cartões com selo e Corrigir; recursos (HAGS, Resizable BAR, MPO, Modo de Jogo) como selos;
       jogos e a GPU de cada um (notebook híbrido). 6b. Driver NVIDIA por jogo (perfis DRS) e cache de sombreador. 7. Ficha técnica recolhida (leituras do driver, GPUs, notas).
  Toda correção vai pelo aplicador (Host.ApplyAsync) com diário e Desfazer; a gravação só lê sensores.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:gpu="clr-namespace:Nexus.Desktop.Views.Modules.GpuLab">
  <DataTemplate DataType="{x:Type vm:GpuLabPage}">
    <DataTemplate.Resources>

      <!-- Legenda do gráfico -->
      <Style x:Key="G.Swatch" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
      <Style x:Key="G.LegendText" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Margin" Value="0,0,16,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <!-- Título de seção com ícone -->
      <DataTemplate x:Key="G.SectionHeader">
        <StackPanel Orientation="Horizontal">
          <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>

      <!-- Achado: distintivo pelo tom, título, selo, evidência medida e Corrigir. Conselho e fonte em "Por que isso?". -->
      <DataTemplate x:Key="G.Finding" DataType="{x:Type vm:GpuFindingRow}">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
              <Ellipse Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                      Foreground="{Binding ToneKind, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneKind}" Text="{Binding LevelText}" VerticalAlignment="Top" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                         MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/>
              <c:ExplainToggle Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Small}" Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="{Binding FixLabel}" Command="{Binding FixCommand}"
                    VerticalAlignment="Top" Margin="0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Gpu}" Title="Memória de vídeo"
                     Number="{Binding VramBytes}" Kind="Bytes" ValueText="{Binding HeroFallback}" IsLoading="{Binding IsLoading}" Caption="{Binding HeroCaption}"
                     ActionText="{Binding RecordButtonText}" Command="{Binding RecordCommand}"
                     SecondaryText="Ler de novo" SecondaryCommand="{Binding RefreshCommand}">
          <StackPanel Width="190">
            <c:RingMeter Value="{Binding VramUsedPercent}" WarnAt="85" BadAt="95" HigherIsBetter="False" Label="da VRAM em uso"
                         Width="128" Height="128" Thickness="10" HorizontalAlignment="Center"
                         Visibility="{Binding HasVramUse, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding HybridText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,10,0,0"
                       TextAlignment="Center" Visibility="{Binding HybridText, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Desfazer (mudanças desta sessão) ===== -->
        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,0,0,14" Focusable="False" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GpuAppliedChange}">
              <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding Text, StringFormat='Aplicado: {0}'}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 3. Quatro cartões ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="170" Margin="0,0,0,20" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Cards}" Margin="-7,0,-7,20" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GpuStatCard}">
              <c:StatTile Margin="7,0" Icon="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Label="{Binding Title}" Value="{Binding Value}"
                          Detail="{Binding Detail}" Trend="{Binding Trend}" TrendTone="{Binding ToneKind}" ToolTip="{Binding Detail}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 4. Monitores ===== -->
        <ContentControl Content="Monitores" Tag="{StaticResource Icon.Monitor}" ContentTemplate="{StaticResource G.SectionHeader}" Focusable="False" Margin="0,0,0,2"/>
        <TextBlock Text="Monitor de 144 Hz rodando a 60 Hz é o desperdício mais comum." Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Monitors}" Focusable="False" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GpuMonitorRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12" Padding="18,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                    <c:Icon Data="{StaticResource Icon.Monitor}" Size="19" Foreground="{Binding ToneKind, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
                    <TextBlock Text="{Binding Mode}" FontFamily="{StaticResource Font.Numbers}" FontSize="18" Foreground="{StaticResource Brush.Trace}" Margin="0,2,0,6"/>
                    <c:StatusChip Tone="{Binding ToneKind}" Text="{Binding StatusText}" HorizontalAlignment="Left"/>
                    <c:ExplainToggle Header="Detalhes" Margin="0,4,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Max}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Visibility="{Binding Max, Converter={StaticResource NullToCollapsed}}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                        <TextBlock Text="Acontece depois de formatar ou trocar o cabo. A troca é a mesma de Configurações › Tela › Taxa de atualização."
                                   Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Top" Visibility="{Binding IsBelowMax, Converter={StaticResource BoolToVis}}">
                    <c:BeforeAfter Before="{Binding CurrentHz}" After="{Binding MaxHz}" BeforeLabel="Agora (Hz)" AfterLabel="O monitor aguenta (Hz)"/>
                    <Button Style="{StaticResource Button.Secondary}" Content="{Binding FixLabel}" Command="{Binding FixCommand}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5. Gravar enquanto joga ===== -->
        <ContentControl Content="Gravar enquanto você joga" Tag="{StaticResource Icon.Games}" ContentTemplate="{StaticResource G.SectionHeader}" Focusable="False" Margin="0,8,0,2"/>
        <TextBlock Text="Em repouso a placa baixa o clock de propósito. O que ela entrega só aparece com um jogo aberto." Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,14">
          <c:HowItWorks>
            <c:StepItem Icon="{StaticResource Icon.Games}" Title="Abra o jogo" Text="Deixe o jogo aberto e volte aqui."/>
            <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Clique em gravar" Text="Você tem 10 s para voltar ao jogo e jogar normalmente."/>
            <c:StepItem Icon="{StaticResource Icon.Monitor}" Title="O NEXUS observa" Text="60 s lendo clock, uso, temperatura e potência. Só leitura." Tone="Warn"/>
            <c:StepItem Icon="{StaticResource Icon.Check}" Title="Diz o que segurou" Text="Potência, calor ou configuração, com o que fazer." Tone="Good"/>
          </c:HowItWorks>
        </Border>
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding RecordStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite"/>
              <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding RecordCommand}" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Measure}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding RecordButtonText}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </Grid>
            <ProgressBar Value="{Binding RecordProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Progresso da gravação"/>
            <WrapPanel Margin="0,12,0,6">
              <Border Style="{StaticResource G.Swatch}" Background="{StaticResource Brush.Trace}"/>
              <TextBlock Text="clock" Style="{StaticResource G.LegendText}"/>
              <Border Style="{StaticResource G.Swatch}" Background="{StaticResource Brush.Signal}"/>
              <TextBlock Text="uso" Style="{StaticResource G.LegendText}"/>
              <Border Style="{StaticResource G.Swatch}" Background="{StaticResource Brush.Bad}"/>
              <TextBlock Text="temperatura" Style="{StaticResource G.LegendText}"/>
              <Border Style="{StaticResource G.Swatch}" Background="{StaticResource Brush.Good}"/>
              <TextBlock Text="potência" Style="{StaticResource G.LegendText}"/>
              <Border Width="14" Height="10" Background="{StaticResource Brush.TraceSoft}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="segurada por potência" Style="{StaticResource G.LegendText}"/>
              <Border Width="14" Height="10" Background="{StaticResource Brush.BadSoft}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="segurada por calor" Style="{StaticResource G.LegendText}"/>
            </WrapPanel>
            <Border Style="{StaticResource Panel.Inset}" Padding="8,8,8,4">
              <gpu:GpuTelemetryChart Height="200" Samples="{Binding Samples}" Bands="{Binding Bands}" MaxClock="{Binding ChartMaxClock}" Duration="60"
                                     AutomationProperties.Name="Gráfico da gravação: clock, uso, temperatura e potência da placa"/>
            </Border>
            <c:ExplainToggle Header="Como ler o gráfico" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="Clock em relação ao máximo da placa; uso de 0 a 100%; temperatura de 0 a 100 °C; potência em relação ao limite. As faixas coloridas ao fundo marcam os segundos em que o driver disse por que segurou a placa."/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                           Text="Fonte: NVML do driver NVIDIA (1 leitura por segundo). Em placas AMD e Intel só o uso aparece: clocks e motivos exigem o SDK do fabricante."/>
              </StackPanel>
            </c:ExplainToggle>
            <DockPanel Margin="0,10,0,0" Visibility="{Binding Verdict, Converter={StaticResource NullToCollapsed}}">
              <c:Icon Data="{StaticResource Icon.Sparkle}" Size="18" Foreground="{Binding VerdictToneKind, Converter={StaticResource ToneBrush}}" Margin="0,0,10,0" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.H2}" FontSize="15.5"
                         Foreground="{Binding VerdictToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding RecordFindings}" ItemTemplate="{StaticResource G.Finding}" Focusable="False" Margin="0,0,0,8"/>

        <!-- ===== 6. O que segura a placa ===== -->
        <ContentControl Content="O que segura a sua placa" Tag="{StaticResource Icon.Gpu}" ContentTemplate="{StaticResource G.SectionHeader}" Focusable="False" Margin="0,8,0,2"/>
        <TextBlock Text="O que foi medido e de onde veio. Corrigir passa pelo aplicador, com Desfazer." Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
        <c:SkeletonLoader Shape="Lines" Lines="4" Margin="4,0,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource G.Finding}" Focusable="False"/>
        <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding ShowNoFindings, Converter={StaticResource BoolToVis}}">
          <c:StatusChip Tone="Good" Text="Nada a apontar com o que foi lido." HorizontalAlignment="Left"/>
        </Border>

        <Grid Margin="0,6,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Recursos como selos -->
          <Border Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <c:Icon Data="{StaticResource Icon.Settings}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Recursos da placa" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GpuCheckRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8" ToolTip="{Binding Note}" Background="Transparent">
                      <DockPanel>
                        <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneKind}" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- Qual GPU cada jogo usa -->
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <c:Icon Data="{StaticResource Icon.Games}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Qual GPU cada jogo usa" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Text.Small}" Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVis}}"
                         Text="Notebook com duas GPUs: marque a dedicada nos jogos sem preferência."/>
              <TextBlock Style="{StaticResource Text.Small}" Visibility="{Binding IsHybrid, Converter={StaticResource FalseToVisible}}"
                         Text="Este PC tem uma GPU de jogo só: a escolha por app não muda nada aqui."/>
              <ItemsControl ItemsSource="{Binding Games}" Margin="0,8,0,0" Focusable="False" Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GpuGameRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8" ToolTip="{Binding Exe}" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                            <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Store, Mode=OneWay}" Foreground="{StaticResource Brush.TextDim}"/>
                          </TextBlock>
                          <c:StatusChip Tone="{Binding ToneKind}" Text="{Binding Preference}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Usar a dedicada" Command="{Binding FixCommand}"
                                VerticalAlignment="Center" Margin="0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== 6b. Driver NVIDIA por jogo (perfis do driver, pelo aplicador) ===== -->
        <ContentControl Content="Driver NVIDIA por jogo" Tag="{StaticResource Icon.Settings}" ContentTemplate="{StaticResource G.SectionHeader}" Focusable="False" Margin="0,8,0,2"/>
        <TextBlock Text="Os mesmos ajustes do Painel de Controle NVIDIA, gravados no perfil do jogo. Com Desfazer." Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
        <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,14" Visibility="{Binding NvAvailable, Converter={StaticResource FalseToVisible}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding NvStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>
        <Grid Margin="0,0,0,14" Visibility="{Binding NvAvailable, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Por jogo -->
          <Border Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <c:Icon Data="{StaticResource Icon.Games}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Escolha o jogo" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Style="{StaticResource Text.Small}" Visibility="{Binding HasNvGames, Converter={StaticResource FalseToVisible}}"
                         Text="Nenhum jogo da Steam ou da Epic com executável encontrado."/>
              <ComboBox ItemsSource="{Binding NvGames}" SelectedItem="{Binding SelectedNvGame}" DisplayMemberPath="Label" MinWidth="260" HorizontalAlignment="Left"
                        AutomationProperties.Name="Jogo para os ajustes do driver NVIDIA" Visibility="{Binding HasNvGames, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding NvCurrent}" Focusable="False" Margin="0,10,0,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GpuKeyValue}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,6" ToolTip="{Binding Note}" Background="Transparent">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="O que gravar" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
              <CheckBox IsChecked="{Binding NvLowLatency}" Margin="0,4">
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                           Text="Modo de baixa latência: ligado. Menos atraso quando a placa está no limite (DirectX 9/11, jogo sem Reflex)."/>
              </CheckBox>
              <CheckBox IsChecked="{Binding NvMaxPower}" Margin="0,4">
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                           Text="Preferir desempenho máximo. A placa não baixa o clock com o jogo aberto. Mais calor e consumo."/>
              </CheckBox>
              <DockPanel Margin="0,4">
                <CheckBox IsChecked="{Binding NvFpsCap}" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="Limitar o FPS em"/>
                </CheckBox>
                <ComboBox ItemsSource="{Binding NvFpsOptions}" SelectedItem="{Binding SelectedNvFps}" MinWidth="80" Margin="10,0,0,0" HorizontalAlignment="Left"
                          AutomationProperties.Name="Limite de FPS"/>
              </DockPanel>
              <TextBlock Text="{Binding NvFpsHint}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="26,0,0,4"/>
              <CheckBox IsChecked="{Binding NvVsync}" Margin="0,4">
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                           Text="V-Sync ligado no driver. Só com monitor G-SYNC e limite de FPS; desligue o V-Sync dentro do jogo."/>
              </CheckBox>
              <c:ExplainToggle Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Small}"
                             Text="Fica no banco de perfis do driver, o mesmo do Painel de Controle NVIDIA. Vale na próxima vez que o jogo abrir. Se o jogo não tem perfil no driver, o NEXUS cria um chamado &quot;NEXUS - jogo.exe&quot;; Desfazer devolve o que havia e apaga esse perfil se ficar vazio."/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                             Text="Fontes: NvApiDriverSettings.h (NVIDIA), notas do driver NVIDIA e testes da Blur Busters (G-SYNC: V-Sync no driver + limite 3 FPS abaixo da taxa)."/>
                </StackPanel>
              </c:ExplainToggle>
              <Button Style="{StaticResource Button.Secondary}" Content="Aplicar no driver" Command="{Binding ApplyNvCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <!-- Cache de sombreador (global) -->
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <c:Icon Data="{StaticResource Icon.Disk}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Cache de sombreador" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Text="Agora" Style="{StaticResource Text.Label}"/>
              <TextBlock Text="{Binding ShaderCacheText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}" Margin="0,2,0,8"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,8"
                         Text="Cache cheio faz o jogo voltar a compilar sombreadores durante a partida (travadinhas). Maior evita isso; não aumenta FPS."/>
              <ComboBox ItemsSource="{Binding ShaderCacheOptions}" SelectedItem="{Binding SelectedShaderCache}" DisplayMemberPath="Label" MinWidth="140" HorizontalAlignment="Left"
                        AutomationProperties.Name="Tamanho do cache de sombreador"/>
              <Button Style="{StaticResource Button.Secondary}" Content="Aplicar no driver" Command="{Binding ApplyShaderCacheCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== 7. Ficha técnica (avançado, recolhida) ===== -->
        <Expander Margin="0,0,0,14">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Code}" Size="16" Margin="0,0,8,0"/>
              <TextBlock Text="Ficha técnica: leituras do driver e GPUs do PC" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Expander.Header>
          <Border Style="{StaticResource Panel.Card}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,10"
                         Text="Fontes: DXGI (identidade, VRAM, GPU de alto desempenho), gerenciador de dispositivos (driver e PCIe), NVML do driver NVIDIA (clocks, limites e motivos). Nada é instalado: só leitura."/>
              <TextBlock Text="{Binding VendorNote}" Style="{StaticResource Text.Small}" Margin="0,0,0,8" Visibility="{Binding VendorNote, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding Readings}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GpuKeyValue}">
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Text.Small}" VerticalAlignment="Top"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="GPUs neste PC" Style="{StaticResource Text.Label}" Margin="0,14,0,4"/>
              <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GpuAdapterRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                      <DockPanel>
                        <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top">
                          <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                          <c:Icon Data="{StaticResource Icon.Gpu}" Size="16" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                          <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
                            <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Font.Display}"/> <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/>
                          </TextBlock>
                          <TextBlock Style="{StaticResource Text.Small}">
                            <Run Text="{Binding Architecture, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Memory, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Driver, Mode=OneWay}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Ids}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextDim}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
