<!--
  Laboratório da placa de vídeo: identidade (DXGI/NVML), barramento PCIe, limites, monitores (com "Usar 144 Hz"), gravação de
  60 s enquanto o usuário joga (gráfico com faixas de limitação) e achados com Corrigir/Desfazer. Recursos locais em
  DataTemplate.Resources; do tema, só chaves do contrato de Themes/Controls.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:o="clr-namespace:Nexus.Desktop.Views.Optimize"
                    xmlns:gpu="clr-namespace:Nexus.Desktop.Views.Modules.GpuLab">
  <DataTemplate DataType="{x:Type vm:GpuLabPage}">
    <DataTemplate.Resources>
      <o:EmptyToCollapsedConverter x:Key="G.Has"/>
      <o:EmptyToCollapsedConverter x:Key="G.HasNot" Invert="True"/>

      <!-- Barra de tom à esquerda de cartões e achados: good (verde), warn (âmbar), bad (vermelho), info (ciano). -->
      <Style x:Key="G.ToneBar" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="0,2,14,2"/>
        <Setter Property="Background" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good"><Setter Property="Background" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Background" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Background" Value="{StaticResource Brush.Bad}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="G.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Margin" Value="0,26,0,4"/>
      </Style>

      <!-- Achado (usado na lista principal e na análise da gravação). -->
      <DataTemplate x:Key="G.Finding">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource G.ToneBar}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
              <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" Visibility="{Binding Advice, Converter={StaticResource G.Has}}"/>
              <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="{Binding FixLabel}" Command="{Binding FixCommand}"
                    VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Item da legenda do gráfico. -->
      <Style x:Key="G.LegendDot" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Ler de novo" Command="{Binding RefreshCommand}" VerticalAlignment="Top"/>
        </Grid>

        <!-- Hero: o que a placa é -->
        <Border Style="{StaticResource Panel.Hero}" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="Sua placa de vídeo principal" Style="{StaticResource Text.MetricLabel}"/>
            <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource Text.Display}" Foreground="{StaticResource Brush.Trace}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding HybridText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"
                       Visibility="{Binding HybridText, Converter={StaticResource G.Has}}"/>
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                       Text="Fontes: DXGI (identidade, VRAM, GPU de alto desempenho), gerenciador de dispositivos (driver e PCIe), NVML do driver NVIDIA (clocks, limites e motivos). Nada é instalado: só leitura."/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Trace}" Margin="0,10,0,0"
                   Visibility="{Binding Message, Converter={StaticResource G.Has}}"/>

        <!-- Desfazer: mudanças feitas aqui nesta sessão -->
        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,10,0,0" Visibility="{Binding Changes.Count, Converter={StaticResource G.Has}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}">
                    <Run Text="Aplicado:"/> <Run Text="{Binding Text, Mode=OneWay}"/>
                  </TextBlock>
                  <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Desfazer" Command="{Binding UndoCommand}" Margin="12,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cartões: barramento, limites, memória, recursos -->
        <ItemsControl ItemsSource="{Binding Cards}" Margin="0,14,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Width="268" MinHeight="150" Margin="0,0,12,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource G.ToneBar}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Metric}" Margin="0,2,0,0" Visibility="{Binding Value, Converter={StaticResource G.Has}}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Monitores -->
        <TextBlock Text="Monitores" Style="{StaticResource G.Section}"/>
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                   Text="Taxa atual contra a maior que o monitor anuncia na mesma resolução. Monitor de 144 Hz rodando a 60 Hz é o desperdício mais comum (acontece depois de formatar ou trocar o cabo)."/>
        <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource G.ToneBar}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
                      <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Font.Display}"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding Mode, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Max}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" Visibility="{Binding Max, Converter={StaticResource G.Has}}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{Binding FixLabel}" Command="{Binding FixCommand}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Gravação -->
        <TextBlock Text="Gravar enquanto você joga" Style="{StaticResource G.Section}"/>
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                   Text="Em repouso a placa baixa clock e PCIe de propósito; o que ela entrega só aparece com carga. Abra um jogo, clique em Gravar e volte para ele: o NEXUS lê clocks, potência, temperatura, PCIe e os motivos de limitação 1 vez por segundo durante 60 s e diz o que segurou a placa."/>
        <Border Style="{StaticResource Panel.Card}" Margin="0,10,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding RecordStatus}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="{Binding RecordButtonText}" Command="{Binding RecordCommand}" Margin="16,0,0,0"/>
            </Grid>
            <ProgressBar Value="{Binding RecordProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
            <gpu:GpuTelemetryChart Height="200" Margin="0,14,0,0" Samples="{Binding Samples}" Bands="{Binding Bands}" MaxClock="{Binding ChartMaxClock}"
                                   Duration="60"/>
            <WrapPanel Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Style="{StaticResource G.LegendDot}" Background="{StaticResource Brush.Trace}"/>
                <TextBlock Text="clock gráfico (do máximo)" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Style="{StaticResource G.LegendDot}" Background="{StaticResource Brush.Signal}"/>
                <TextBlock Text="uso da GPU" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Style="{StaticResource G.LegendDot}" Background="{StaticResource Brush.Bad}"/>
                <TextBlock Text="temperatura (0–100 °C)" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Style="{StaticResource G.LegendDot}" Background="{StaticResource Brush.Good}"/>
                <TextBlock Text="potência (do limite)" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <Border Width="14" Height="10" Background="{StaticResource Brush.TraceSoft}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="faixa: limitada por potência" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="10" Background="{StaticResource Brush.BadSoft}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="faixa: limitada por temperatura/hardware" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding Verdict}" Margin="0,14,0,0" Visibility="{Binding Verdict, Converter={StaticResource G.Has}}">
              <TextBlock.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding VerdictTone}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VerdictTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
                    <DataTrigger Binding="{Binding VerdictTone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Resources>
            </TextBlock>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding RecordFindings}" ItemTemplate="{StaticResource G.Finding}" Margin="0,8,0,0"/>

        <!-- Achados -->
        <TextBlock Text="O que segura a sua placa" Style="{StaticResource G.Section}"/>
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                   Text="Cada item mostra o que foi medido e de onde veio. Corrigir passa pelo aplicador do NEXUS (diário + Desfazer); itens sem botão são só para você saber."/>
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource G.Finding}" Margin="0,10,0,0"/>
        <TextBlock Text="Nada a apontar com o que foi lido." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Good}" Margin="0,6,0,0"
                   Visibility="{Binding Findings.Count, Converter={StaticResource ZeroToVisible}}"/>

        <!-- Jogos e GPU por app -->
        <TextBlock Text="Qual GPU cada jogo usa" Style="{StaticResource G.Section}"/>
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVis}}"
                   Text="Notebook híbrido: o Windows escolhe a GPU por app. Jogos encontrados nos manifestos da Steam e da Epic; marque alto desempenho nos que estão sem preferência."/>
        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding IsHybrid, Converter={StaticResource FalseToVisible}}"
                   Text="Este PC tem uma GPU de jogo só: a preferência por app do Windows não muda nada aqui."/>
        <ItemsControl ItemsSource="{Binding Games}" Margin="0,10,0,0" Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
                      <Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Store, Mode=OneWay}" Foreground="{StaticResource Brush.TextDim}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Exe}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Style="{StaticResource Text.Small}">
                      <Run Text="Preferência:"/> <Run Text="{Binding Preference, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Usar a dedicada" Command="{Binding FixCommand}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Leituras do driver -->
        <TextBlock Text="Leituras do driver" Style="{StaticResource G.Section}"/>
        <TextBlock Text="{Binding VendorNote}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding VendorNote, Converter={StaticResource G.Has}}"/>
        <Border Style="{StaticResource Panel.Card}" Margin="0,10,0,0" Visibility="{Binding Readings.Count, Converter={StaticResource G.Has}}">
          <ItemsControl ItemsSource="{Binding Readings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Top"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Top"/>
                  <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Text.Small}" VerticalAlignment="Top"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- GPUs do PC -->
        <TextBlock Text="GPUs neste PC" Style="{StaticResource G.Section}"/>
        <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Font.Display}"/> <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/>
                  </TextBlock>
                  <TextBlock Style="{StaticResource Text.Small}">
                    <Run Text="{Binding Architecture, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Memory, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Driver, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Ids}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,12,0,0" Visibility="{Binding Notes.Count, Converter={StaticResource G.Has}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
