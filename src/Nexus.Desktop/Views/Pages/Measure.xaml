<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:MeasurePage}">
    <StackPanel Margin="24">
      <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
