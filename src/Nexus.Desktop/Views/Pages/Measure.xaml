<!--
  Medir (design system v2, docs/10-design-system.md):
    1. Destaque ....... jogo aberto/medido com o FPS GIGANTE ao vivo (último segundo), 1% low/frametime/média logo abaixo,
                        "Medir agora"/"Parar e guardar" e dois interruptores grandes: medir automaticamente e mostrador de FPS.
    2. PresentMon ..... ausente: "Como começar" em 3 passos (baixar → salvar → medir) com Localizar/Procurar de novo.
       Como funciona .. sem nenhuma partida ainda: Detecta → Mede → Compara.
    3. Ao vivo ........ frametime dos últimos 60 s com a partida de referência sobreposta (só durante a medição).
    4. Antes x depois . veredito em uma frase com distintivo (verde/vermelho/ciano) + BeforeAfter por métrica com selo honesto
                        (só "Melhorou"/"Piorou" quando o teste comprova); traço sobreposto; avisos visíveis; método recolhido.
    5. Jogos medidos .. cartões com FPS médio grande e sparkline do 1% low por partida; clicar escolhe o jogo.
    6. Partida ........ 4 números (StatTile), frametime, distribuição e ações; detalhes recolhidos. Lista de partidas ao lado.
    7. Comparação manual (marcadas como antes/depois) e Ajustes da medição recolhidos (tudo o que existia continua aqui).
  A captura, o mostrador (OverlayWindow) e as preferências são os mesmos do MeasurePage; o VM só ganhou números de apresentação.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:m="clr-namespace:Nexus.Desktop.Views.Measure"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:MeasurePage}">
    <DataTemplate.Resources>
      <m:BoolVisibilityConverter x:Key="M.Vis"/>
      <m:BoolVisibilityConverter x:Key="M.VisNot" Invert="True"/>
      <m:PresenceVisibilityConverter x:Key="M.Has"/>
      <m:PresenceVisibilityConverter x:Key="M.HasNot" Invert="True"/>
      <m:IntEqualsConverter x:Key="M.IntEq"/>

      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Seção da configuração. -->
      <Style x:Key="M.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Margin" Value="0,0,0,8"/>
      </Style>

      <!-- Número pequeno ao vivo (abaixo do FPS gigante). -->
      <Style x:Key="M.LiveSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <!--
        Interruptor grande (CheckBox): cartão inteiro clicável, ícone (Tag = Geometry), conteúdo (título + frase) e a chave
        à direita. Liga = âmbar com a bolinha à direita. Troca de uma vez (sem animação: respeita as animações desligadas).
      -->
      <Style x:Key="M.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Border x:Name="Card" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Card}" Padding="14,12" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse x:Name="Badge" Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon x:Name="Glyph" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="18"
                            Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Focusable="False" RecognizesAccessKey="True"/>
                  <Grid Grid.Column="2" Width="48" Height="26" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border x:Name="Track" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.TextDim}" BorderThickness="1.5" CornerRadius="13"/>
                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource Brush.TextMuted}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                  </Grid>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TraceLine}"/>
                  <Setter TargetName="Badge" Property="Fill" Value="{StaticResource Brush.TraceSoft}"/>
                  <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
                  <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Trace}"/>
                  <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
                  <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.Bg}"/>
                  <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Selo Antes (ciano) / Depois (âmbar) de uma SessionRow. Sem marca: nada aparece. -->
      <DataTemplate x:Key="M.TagChip">
        <Border x:Name="chip" Visibility="Collapsed" BorderThickness="1" CornerRadius="9" Padding="9,1,9,2" HorizontalAlignment="Left"
                VerticalAlignment="Center" BorderBrush="{StaticResource Brush.Line}">
          <TextBlock x:Name="chipText" Text="{Binding TagText}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Small}"
                     Foreground="{StaticResource Brush.TextMuted}"/>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsBefore}" Value="True">
            <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
            <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsAfter}" Value="True">
            <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Cartão de item de lista (jogos e partidas): marca âmbar e fundo mais claro no escolhido. -->
      <Style x:Key="M.Item" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Padding" Value="14,10,12,10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border x:Name="card" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter/>
                </Border>
                <Border x:Name="tick" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,2,2,0"
                        Background="{StaticResource Brush.Trace}" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="card" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.TraceLine}"/>
                  <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="M.GameCard" TargetType="ListBoxItem" BasedOn="{StaticResource M.Item}">
        <Setter Property="Margin" Value="7,0,7,14"/>
        <Setter Property="Padding" Value="16,14"/>
      </Style>

      <!-- Uma métrica do antes x depois: nome + selo honesto + diferença (±), e as barras antes → depois. -->
      <DataTemplate x:Key="M.MetricBars" DataType="{x:Type vm:ComparisonRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,14,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="{Binding Explanation}">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              <c:StatusChip Tone="{Binding VerdictTone}" Text="{Binding VerdictText}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                         ToolTip="Diferença e, quando houver, o intervalo de 95%."/>
            </StackPanel>
            <c:BeforeAfter Grid.Column="1" Before="{Binding Before}" After="{Binding After}" HigherIsBetter="{Binding HigherIsBetter}"
                           BeforeLabel="{Binding BeforeLabel}" AfterLabel="{Binding AfterLabel}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Linha compacta (comparação manual e o detalhe recolhido): antes → depois, diferença e a frase. -->
      <DataTemplate x:Key="M.MetricRow" DataType="{x:Type vm:ComparisonRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" ToolTip="{Binding Explanation}"/>
            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}">
              <Run Text="{Binding BeforeText, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/><Run Text="  →  " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding AfterText, Mode=OneWay}" Foreground="{StaticResource Brush.Trace}"/>
            </TextBlock>
            <StackPanel Grid.Column="2">
              <c:StatusChip Tone="{Binding VerdictTone}" Text="{Binding VerdictText}" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding Sentence}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Lista de executáveis com botão remover (o comando vem do ItemsControl). -->
      <DataTemplate x:Key="M.ExeItem">
        <DockPanel Margin="0,2">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Remover" Margin="8,0,0,0" Padding="6,2"
                  Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding StringFormat='Remover {0}'}"/>
          <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" FontFamily="Consolas" VerticalAlignment="Center"/>
        </DockPanel>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Status, Converter={StaticResource M.Has}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- Convite depois de aplicar algo pelo NEXUS -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Padding="16,12" Visibility="{Binding ShowInvite, Converter={StaticResource M.Vis}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding EnableAutoCommand}" Content="Medir automaticamente" Margin="0,0,8,0"
                      Visibility="{Binding AutoMeasure, Converter={StaticResource M.VisNot}}"/>
              <Button Style="{StaticResource Button.Ghost}" Command="{Binding DismissInviteCommand}" Content="Entendi" Margin="0"/>
            </StackPanel>
            <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Games}" Size="20" Foreground="{StaticResource Brush.Trace}" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="Jogue uma partida para medir o antes e depois" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding InviteText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0"
                         MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding InviteText}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ================================================================ 1. DESTAQUE -->
        <Border Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Panel}" SnapsToDevicePixels="True" Margin="0,0,0,20">
          <Grid>
            <Rectangle Fill="{StaticResource Brush.Graticule}" Opacity="0.28" IsHitTestVisible="False" RadiusX="10" RadiusY="10"/>
            <Grid Margin="22,18,24,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Image Source="{StaticResource Illo.Measure}" Width="160" Height="120" Margin="0,0,22,0" VerticalAlignment="Top"
                     Stretch="Uniform" Focusable="False" AutomationProperties.Name=""/>

              <!-- Jogo + FPS gigante -->
              <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Brush.TextDim}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Brush.Signal}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Brush.Bad}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding HeroKicker}" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="NoWrap"/>
                </StackPanel>
                <TextBlock Text="{Binding HeroGame}" Style="{StaticResource Text.Display}" Margin="0,2,0,0" MaxHeight="76" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <c:AnimatedNumber Value="{Binding HeroFps}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="96"
                                    Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Bottom" TextWrapping="NoWrap"
                                    AutomationProperties.Name="{Binding HeroFpsLabel}"/>
                  <StackPanel VerticalAlignment="Bottom" Margin="12,0,0,18">
                    <TextBlock Text="FPS" FontFamily="{StaticResource Font.Numbers}" FontSize="26" Foreground="{StaticResource Brush.Trace}"/>
                    <TextBlock Text="{Binding HeroFpsLabel}" Style="{StaticResource Text.Small}" MaxWidth="220"/>
                  </StackPanel>
                </StackPanel>

                <!-- Ao vivo: os três números de apoio -->
                <UniformGrid Columns="3" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="{Binding IsCapturing, Converter={StaticResource M.Vis}}">
                  <StackPanel Margin="0,0,26,0" ToolTip="Média do 1% de quadros mais lentos dos últimos 10 s: a travadinha que você sente agora.">
                    <TextBlock Text="1% low" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding LiveLow1}" Style="{StaticResource M.LiveSmall}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,26,0" ToolTip="Tempo mediano de cada quadro no último segundo.">
                    <TextBlock Text="Frametime (ms)" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding LiveFrametime}" Style="{StaticResource M.LiveSmall}"/>
                  </StackPanel>
                  <StackPanel ToolTip="FPS médio desde o começo da partida.">
                    <TextBlock Text="FPS médio" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding LiveAverage}" Style="{StaticResource M.LiveSmall}"/>
                  </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                           MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding HeroDetail}"/>
                <TextBlock Text="{Binding CaptureNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,4,0,0"
                           Visibility="{Binding CaptureNote, Converter={StaticResource M.Has}}"/>

                <WrapPanel Margin="0,14,0,0">
                  <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCaptureCommand}" Margin="0,4,8,0"
                          Visibility="{Binding IsCapturing, Converter={StaticResource M.VisNot}}"
                          ToolTip="Começa a medir agora o jogo aberto (ou o executável indicado).">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Measure}" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="Medir agora" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Primary}" Command="{Binding StopCaptureCommand}" Margin="0,4,8,0"
                          Visibility="{Binding IsCapturing, Converter={StaticResource M.Vis}}"
                          ToolTip="Para a medição e guarda a partida (o jogo continua aberto).">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Check}" Size="16" Margin="0,0,8,0"/>
                      <TextBlock Text="Parar e guardar" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Ghost}" Command="{Binding AddCurrentGameCommand}" Content="É um jogo: lembrar" Margin="0,4,4,0"
                          Visibility="{Binding IsPlaying, Converter={StaticResource M.Vis}}" ToolTip="Coloca este executável na sua lista de jogos."/>
                  <Button Style="{StaticResource Button.Ghost}" Command="{Binding ExcludeCurrentCommand}" Content="Não é jogo" Margin="0,4,0,0"
                          Visibility="{Binding IsPlaying, Converter={StaticResource M.Vis}}" ToolTip="O NEXUS deixa de tratar este programa como jogo."/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsPlaying, Converter={StaticResource M.VisNot}}">
                  <TextBlock Text="Sem jogo detectado? Executável:" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding ManualExe, UpdateSourceTrigger=PropertyChanged}" Width="170" Padding="6,3"
                           AutomationProperties.Name="Executável do jogo para medir à mão"
                           ToolTip="Ex.: cs2.exe (como aparece no Gerenciador de Tarefas, aba Detalhes)."/>
                </StackPanel>
              </StackPanel>

              <!-- Interruptores grandes (lado a lado, embaixo: cabem até na janela de 980 px) -->
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                <UniformGrid Columns="2" Margin="-6,0">
                  <CheckBox Style="{StaticResource M.Switch}" IsChecked="{Binding AutoMeasure}" Tag="{StaticResource Icon.Auto}" Margin="6,0"
                            AutomationProperties.Name="Medir automaticamente"
                            ToolTip="Quando um jogo abre, o NEXUS começa a medir; quando fecha, guarda a partida e compara com a anterior.">
                    <StackPanel>
                      <TextBlock Text="Medir automaticamente" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Text="Mede cada partida sozinho." Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox Style="{StaticResource M.Switch}" IsChecked="{Binding OverlayEnabled}" Tag="{StaticResource Icon.Monitor}" Margin="6,0"
                            AutomationProperties.Name="Mostrador de FPS no jogo"
                            ToolTip="Janela pequena por cima do jogo com FPS, 1% low e frametime. Não entra no jogo.">
                    <StackPanel>
                      <TextBlock Text="Mostrador de FPS" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Text="FPS no canto da tela, por cima do jogo." Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </CheckBox>
                </UniformGrid>
                <WrapPanel Margin="0,8,0,0">
                  <c:StatusChip Tone="Info" Text="Medir não muda nada no PC" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource Button.Ghost}" Command="{Binding PreviewOverlayCommand}" Content="{Binding PreviewText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                             Visibility="{Binding HotkeyEnabled, Converter={StaticResource M.Vis}}"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <!-- ================================================================ 2. PRESENTMON AUSENTE: COMO COMEÇAR -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20" Visibility="{Binding HasPresentMon, Converter={StaticResource M.VisNot}}">
          <StackPanel>
            <DockPanel Margin="0,0,14,14">
              <c:StatusChip DockPanel.Dock="Right" Tone="Warn" Text="Falta o PresentMon" VerticalAlignment="Center"/>
              <TextBlock Text="Para medir, falta uma peça gratuita" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Export}" Title="Baixe" Text="O PresentMon acompanha o NEXUS; se faltou ou foi recusado, baixe o PresentMon-2.x-x64.exe oficial da Intel (GitHub, seção Releases)." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Disk}" Title="Salve" Text="Em %LocalAppData%\NEXUS\PresentMon, ou indique onde salvou."/>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Meça" Text="Abra um jogo: o NEXUS mede sozinho." Tone="Good"/>
            </c:HowItWorks>
            <WrapPanel Margin="0,14,0,0">
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding BrowseCommand}" Margin="0,0,8,4">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Localizar PresentMon" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Command="{Binding RescanPresentMonCommand}" Margin="0,0,8,4">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Procurar de novo" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding PresentMonTrustText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,8,14,0"/>
            <c:ExplainToggle Margin="0,8,0,0" Content="{Binding PresentMonHelp}"/>
          </StackPanel>
        </Border>

        <!-- Como funciona (sem nenhuma partida ainda) -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20" Visibility="{Binding ShowIntro, Converter={StaticResource M.Vis}}">
          <StackPanel>
            <TextBlock Text="Como funciona" Style="{StaticResource Text.H2}" Margin="0,0,0,14"/>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Games}" Title="Detecta" Text="Percebe quando um jogo abre. Só lê o nome do programa."/>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Mede" Text="Grava o tempo de cada quadro, sem entrar no jogo." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.TrendUp}" Title="Compara" Text="Na partida seguinte, mostra o antes x depois." Tone="Good"/>
            </c:HowItWorks>
          </StackPanel>
        </Border>

        <!-- ================================================================ 3. AO VIVO -->
        <Border Style="{StaticResource Panel.Card}" Padding="20,16" Margin="0,0,0,20" Visibility="{Binding IsCapturing, Converter={StaticResource M.Vis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LiveClock}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                         Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
              <c:Icon Data="{StaticResource Icon.Measure}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,0,8,0"/>
              <TextBlock Text="Cada quadro, ao vivo" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding LiveDelta}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,0,0,10"
                       Visibility="{Binding LiveDelta, Converter={StaticResource M.Has}}"/>
            <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8">
              <m:FrametimeChart Height="200" IsLive="True" Points="{Binding LiveTrace}" SecondaryPoints="{Binding ReferenceTrace}"
                                Stroke="{StaticResource Brush.Trace}" SecondaryStroke="{StaticResource Brush.Signal}"
                                GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"
                                ToolTip="Últimos 60 segundos: tempo de cada quadro (âmbar) e a partida de referência (ciano)."/>
            </Border>
            <TextBlock Style="{StaticResource Text.Small}" Margin="2,8,0,0">
              <Run Text="Âmbar: agora." Foreground="{StaticResource Brush.Trace}"/><Run Text=" Mais baixo e mais reto é melhor. "/><Run Text="{Binding ReferenceText, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- ================================================================ 4. ANTES X DEPOIS -->
        <Border Style="{StaticResource Panel.Card}" Padding="22,20" Margin="0,0,0,20">
          <StackPanel>
            <c:EmptyState Illustration="{StaticResource Illo.Measure}" Text="O antes x depois aparece aqui"
                          Detail="{Binding ComparisonEmptyText}" ActionText="{Binding ComparisonEmptyAction}" Command="{Binding EnableAutoCommand}"
                          Visibility="{Binding HasComparison, Converter={StaticResource M.VisNot}}"/>

            <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource M.Vis}}">
              <!-- Veredito em uma frase -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="60" Height="60" Margin="0,0,16,0" VerticalAlignment="Top">
                  <Ellipse Fill="{Binding ComparisonToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding ComparisonIconKey, Converter={StaticResource ResourceByKey}}" Size="28"
                          Foreground="{Binding ComparisonToneValue, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Antes x depois" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.TextMuted}"/>
                  <TextBlock Text="{Binding ComparisonVerdict}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.H1}" Margin="0,2,0,4"
                             Foreground="{Binding ComparisonToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                             TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" VerticalAlignment="Top" Margin="16,0,0,0"
                        ToolTip="Salva um arquivo de texto com o veredito, os números, as mudanças e os avisos.">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Export}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Exportar relatório" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Avisos: sempre visíveis -->
              <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,14,0,0" Visibility="{Binding ComparisonWarnings.Count, Converter={StaticResource M.Has}}">
                <DockPanel>
                  <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                  <StackPanel>
                    <TextBlock Text="Antes de acreditar no resultado" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Trace}"/>
                    <ItemsControl ItemsSource="{Binding ComparisonWarnings}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0"><Run Text="• "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Uma barra antes → depois por métrica -->
              <ItemsControl ItemsSource="{Binding ComparisonRows}" ItemTemplate="{StaticResource M.MetricBars}" Focusable="False" Margin="0,14,0,0"/>

              <!-- Traço sobreposto -->
              <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8" Margin="0,4,0,0">
                <m:FrametimeChart Height="170" Points="{Binding ComparisonAfterTrace}" SecondaryPoints="{Binding ComparisonBeforeTrace}"
                                  Stroke="{StaticResource Brush.Trace}" SecondaryStroke="{StaticResource Brush.Signal}"
                                  GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"
                                  ToolTip="Tempo de cada quadro: antes (ciano) e depois (âmbar)."/>
              </Border>
              <TextBlock Style="{StaticResource Text.Small}" Margin="2,6,0,0">
                <Run Text="Ciano: antes." Foreground="{StaticResource Brush.Signal}"/><Run Text=" "/><Run Text="Âmbar: depois." Foreground="{StaticResource Brush.Trace}"/><Run Text=" Mais baixo e mais reto é melhor."/>
              </TextBlock>

              <!-- O que mudou entre as partidas -->
              <StackPanel Margin="0,14,0,0" Visibility="{Binding ComparisonChanges.Count, Converter={StaticResource M.Has}}">
                <DockPanel Margin="0,0,0,4">
                  <c:Icon Data="{StaticResource Icon.Apply}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                  <TextBlock Text="O que o NEXUS mudou entre as duas partidas" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ComparisonChanges}" Focusable="False" Margin="24,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"><Run Text="• "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <c:ExplainToggle Header="Como foi calculado?" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding ComparisonModeText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{Binding ComparisonWhy}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding ComparisonMethod}" Style="{StaticResource Text.Small}" Margin="0,4,0,8"/>
                  <ItemsControl ItemsSource="{Binding ComparisonRows}" ItemTemplate="{StaticResource M.MetricRow}" Focusable="False"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================================================================ 5. JOGOS MEDIDOS -->
        <DockPanel Margin="0,6,0,12">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding ImportCommand}" VerticalAlignment="Center"
                  ToolTip="CSV do PresentMon ou do CapFrameX.">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="Importar CSV" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Jogos medidos" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Games.Count}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                     Foreground="{StaticResource Brush.TextDim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <c:EmptyState Illustration="{StaticResource Illo.Measure}" Text="Nenhum jogo medido ainda"
                      Detail="Cada jogo medido aparece aqui com o FPS e a tendência das partidas." Margin="0,0,0,20"
                      Visibility="{Binding HasGames, Converter={StaticResource M.VisNot}}"/>
        <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" ItemContainerStyle="{StaticResource M.GameCard}"
                 SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="-7,0,-7,6" AutomationProperties.Name="Jogos medidos"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ItemsPresenter/>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GameRow}">
              <StackPanel AutomationProperties.Name="{Binding Name}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon Data="{StaticResource Icon.Games}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="15.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding SessionsText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LastPlayedText, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <c:AnimatedNumber Value="{Binding LastFps}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="34"
                                    Foreground="{StaticResource Brush.Trace}" TextWrapping="NoWrap"/>
                  <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,6">
                    <TextBlock Text="FPS médio" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap"><Run Text="1% low "/><Run Text="{Binding LastLow1Text, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </StackPanel>
                <c:Sparkline Values="{Binding Low1Trend}" Height="34" Margin="0,8,0,0" Stroke="{StaticResource Brush.Trace}" Fill="{StaticResource Brush.TraceSoft}"
                             ToolTip="1% low de cada partida, da mais antiga para a mais nova."/>
                <c:StatusChip Tone="{Binding TrendTone}" Text="{Binding TrendText}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- ================================================================ 6. PARTIDA ESCOLHIDA + LISTA -->
        <Grid Margin="0,0,0,20" Visibility="{Binding HasSessions, Converter={StaticResource M.Vis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="260"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Panel.Card}" Padding="20,18" VerticalAlignment="Top" Visibility="{Binding Selected, Converter={StaticResource M.Has}}">
            <StackPanel>
              <DockPanel>
                <ContentControl DockPanel.Dock="Right" Content="{Binding Selected}" ContentTemplate="{StaticResource M.TagChip}" VerticalAlignment="Top" Focusable="False"/>
                <StackPanel>
                  <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.H2}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Selected.When, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Selected.DurationText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Selected.Source, Mode=OneWay}"/>
                  </TextBlock>
                  <c:StatusChip Tone="Warn" Text="{Binding Selected.ExcludedText}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Visibility="{Binding Selected.ExcludedText, Converter={StaticResource M.Has}}"/>
                </StackPanel>
              </DockPanel>

              <WrapPanel Margin="0,14,-10,4">
                <c:StatTile Width="158" Margin="0,0,10,10" Icon="{StaticResource Icon.Measure}" Label="FPS médio" Number="{Binding Selected.AverageFps, Mode=OneWay}" Decimals="0"
                            Tone="Warn" Detail="A partida inteira."/>
                <c:StatTile Width="158" Margin="0,0,10,10" Icon="{StaticResource Icon.TrendDown}" Label="1% low" Number="{Binding Selected.Low1Fps, Mode=OneWay}" Decimals="0"
                            Detail="Os piores momentos."/>
                <c:StatTile Width="158" Margin="0,0,10,10" Icon="{StaticResource Icon.History}" Label="Frametime P99" Number="{Binding Selected.P99Ms, Mode=OneWay}" Decimals="1"
                            Suffix=" ms" Detail="Menor é mais estável."/>
                <c:StatTile Width="158" Margin="0,0,10,10" Icon="{StaticResource Icon.Warning}" Label="Engasgos" Number="{Binding Selected.StuttersPerMinute, Mode=OneWay}" Decimals="1"
                            Suffix="/min" Detail="Trancos visíveis."/>
              </WrapPanel>

              <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8">
                <m:FrametimeChart Height="190" Points="{Binding Selected.Trace}" Stroke="{StaticResource Brush.Trace}"
                                  GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"
                                  ToolTip="Tempo de cada quadro ao longo da partida. As linhas tracejadas marcam 60, 144 e 240 FPS."/>
              </Border>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,16,0" VerticalAlignment="Center"
                           Text="Torre estreita à esquerda: quadros rápidos e iguais."/>
                <m:HistogramChart Grid.Column="1" Height="64" Bins="{Binding Selected.Histogram}" Fill="{StaticResource Brush.Trace}"
                                  OverflowFill="{StaticResource Brush.Bad}" LabelBrush="{StaticResource Brush.TextDim}"/>
              </Grid>

              <c:ExplainToggle Header="Detalhes desta partida" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Small}">
                    <Run Text="{Binding Selected.Application, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/><Run Text=" · "/><Run Text="{Binding Selected.FramesText, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Selected.ConditionsText}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                             Visibility="{Binding Selected.ConditionsText, Converter={StaticResource M.Has}}"/>
                  <TextBlock Text="{Binding Selected.AppliedText}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
                </StackPanel>
              </c:ExplainToggle>

              <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Command="{Binding DeleteCommand}" Margin="0" VerticalAlignment="Top"
                          ToolTip="Remove esta partida (e o CSV dela) da pasta de sessões do NEXUS. Pede confirmação.">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Trash}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="Apagar" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                  <WrapPanel>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CompareSelectedCommand}" Content="Comparar com a anterior" Margin="0,0,8,4"
                            ToolTip="Mostra no Antes x depois esta partida contra a referência escolhida pelo NEXUS."/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleExcludeCommand}" Content="Usar ou não nas comparações" Margin="0,0,4,4"
                            ToolTip="Partida atípica (outro mapa, download no PC, carregamento longo)? Tire das comparações."/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding TagBeforeCommand}" Content="Marcar como antes" Margin="0,0,4,4"/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding TagAfterCommand}" Content="Marcar como depois" Margin="0,0,4,4"/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ClearTagCommand}" Content="Tirar marca" Margin="0,0,4,4"/>
                  </WrapPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Partidas do jogo escolhido -->
          <StackPanel Grid.Column="2">
            <DockPanel Margin="2,0,0,10">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Sessions.Count}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                         Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Bottom"/>
              <TextBlock Style="{StaticResource Text.H2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="Partidas de "/><Run Text="{Binding SelectedGame.Name, Mode=OneWay}"/></TextBlock>
            </DockPanel>
            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource M.Item}"
                     SelectionMode="Single" Background="Transparent" BorderThickness="0" MaxHeight="640" AutomationProperties.Name="Partidas do jogo">
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SessionRow}">
                  <Grid AutomationProperties.Name="{Binding When}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{Binding When}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                      <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding DurationText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Source, Mode=OneWay}"/>
                      </TextBlock>
                      <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}"
                                 Visibility="{Binding ExcludedText, Converter={StaticResource M.Has}}"/>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource M.TagChip}" Margin="0,4,0,0" HorizontalAlignment="Left" Focusable="False"
                                      Visibility="{Binding TagText, Converter={StaticResource M.Has}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                      <TextBlock Text="{Binding AverageFpsText}" FontFamily="{StaticResource Font.Numbers}" FontSize="22"
                                 Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right"/>
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Small}" TextWrapping="NoWrap"><Run Text="1% low "/><Run Text="{Binding Low1Text, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>

        <!-- ================================================================ 7a. COMPARAÇÃO MANUAL -->
        <Border Style="{StaticResource Panel.Card}" Padding="22,18" Margin="0,0,0,20" Visibility="{Binding HasManual, Converter={StaticResource M.Vis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <c:Icon Data="{StaticResource Icon.Plan}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Suas partidas marcadas: antes x depois" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding ManualHeadline}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding ManualRows}" ItemTemplate="{StaticResource M.MetricBars}" Focusable="False"/>
            <c:ExplainToggle Header="Como foi calculado?" Content="{Binding ManualMethod}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- ================================================================ 7b. AJUSTES (recolhido) -->
        <Border Style="{StaticResource Panel.Card}" Padding="22,16">
          <StackPanel>
            <DockPanel>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Settings}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ajustes da medição" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Mostrador, atalho, quais programas são jogos, PresentMon e partidas guardadas." Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <c:ExplainToggle Header="Abrir os ajustes" Margin="50,8,0,0">
              <UniformGrid Columns="2" Margin="0,8,0,0">
                <!-- Medição automática -->
                <StackPanel Margin="0,0,24,20">
                  <TextBlock Text="Medição automática" Style="{StaticResource M.SectionTitle}"/>
                  <CheckBox IsChecked="{Binding AutoMeasure}" Margin="0,0,0,6">
                    <TextBlock Text="Medir sozinho quando um jogo abrir" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding DetectFullscreen}" Margin="0,0,0,6"
                            ToolTip="Além das bibliotecas e das listas, trata como jogo qualquer programa em tela cheia (exceto navegadores e players conhecidos).">
                    <TextBlock Text="Também considerar jogo o que estiver em tela cheia" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding RequestElevation}" Margin="0,0,0,6">
                    <TextBlock Text="Deixar o PresentMon pedir permissão ao Windows" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <c:ExplainToggle Header="Permissão do Windows" Content="{Binding RightsText}" Margin="24,0,0,8"/>
                  <StackPanel Margin="24,0,0,10">
                    <WrapPanel>
                      <Button Style="{StaticResource Button.Secondary}" Command="{Binding JoinPerfLogCommand}" Content="Medir sem pedir permissão toda vez" Margin="0,0,8,4"
                              Visibility="{Binding ShowPerfLogOffer, Converter={StaticResource M.Vis}}"
                              ToolTip="Coloca a sua conta no grupo do Windows &quot;Usuários do log de desempenho&quot; (um aviso do Windows agora). Dá para desfazer."/>
                      <Button Style="{StaticResource Button.Ghost}" Command="{Binding UndoPerfLogCommand}" Content="Desfazer" Margin="0,0,8,4"
                              Visibility="{Binding CanUndoPerfLog, Converter={StaticResource M.Vis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding PerfLogText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Guardar partidas com pelo menos" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding MinSessionSeconds, UpdateSourceTrigger=LostFocus}" Width="60" Margin="8,0" Padding="6,3" HorizontalContentAlignment="Right"
                             FontFamily="{StaticResource Font.Numbers}" AutomationProperties.Name="Duração mínima da partida, em segundos"/>
                    <TextBlock Text="segundos" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <!-- Mostrador -->
                <StackPanel Margin="0,0,0,20">
                  <TextBlock Text="Mostrador de FPS" Style="{StaticResource M.SectionTitle}"/>
                  <CheckBox IsChecked="{Binding OverlayOnGameStart}" Margin="0,0,0,6">
                    <TextBlock Text="Ligar sozinho quando um jogo abrir" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding OverlayShowSystem}" Margin="0,0,0,8">
                    <TextBlock Text="Mostrar uso de CPU, GPU e temperatura da GPU" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <TextBlock Text="Canto da tela" Style="{StaticResource Text.Small}" Margin="0,0,0,4"/>
                  <WrapPanel Margin="0,0,0,8">
                    <RadioButton GroupName="M.Corner" Content="Superior esquerdo" Margin="0,0,12,4" IsChecked="{Binding OverlayCornerValue, Converter={StaticResource M.IntEq}, ConverterParameter=0}"/>
                    <RadioButton GroupName="M.Corner" Content="Superior direito" Margin="0,0,12,4" IsChecked="{Binding OverlayCornerValue, Converter={StaticResource M.IntEq}, ConverterParameter=1}"/>
                    <RadioButton GroupName="M.Corner" Content="Inferior esquerdo" Margin="0,0,12,4" IsChecked="{Binding OverlayCornerValue, Converter={StaticResource M.IntEq}, ConverterParameter=2}"/>
                    <RadioButton GroupName="M.Corner" Content="Inferior direito" Margin="0,0,12,4" IsChecked="{Binding OverlayCornerValue, Converter={StaticResource M.IntEq}, ConverterParameter=3}"/>
                  </WrapPanel>
                  <CheckBox IsChecked="{Binding HotkeyEnabled}" Margin="0,0,0,6"
                            ToolTip="Um atalho global vale no Windows inteiro enquanto o NEXUS estiver aberto (inclusive na bandeja). Escolha uma combinação que nenhum outro programa use.">
                    <TextBlock Text="Atalho de teclado para ligar e desligar" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </CheckBox>
                  <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                    <TextBox Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="Ex.: Ctrl+Shift+F, Alt+F10, Ctrl+Alt+O."
                             AutomationProperties.Name="Atalho do mostrador"/>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ApplyHotkeyCommand}" Content="Usar este atalho" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource Text.Small}" Margin="24,0,0,8"/>
                  <c:ExplainToggle Header="Funciona com anticheat?" Content="{Binding OverlayHelp}"/>
                </StackPanel>

                <!-- Jogos -->
                <StackPanel Margin="0,0,24,20">
                  <TextBlock Text="Quais programas são jogos" Style="{StaticResource M.SectionTitle}"/>
                  <TextBlock Text="{Binding LibraryText}" Style="{StaticResource Text.Small}" Margin="0,0,0,4"/>
                  <Button Style="{StaticResource Button.Ghost}" Command="{Binding RescanLibraryCommand}" Content="Ler as bibliotecas de novo" HorizontalAlignment="Left" Margin="-8,0,0,10"/>
                  <TextBlock Text="Sua lista (sempre jogo)" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  <ItemsControl ItemsSource="{Binding UserGames}" Tag="{Binding RemoveGameCommand}" ItemTemplate="{StaticResource M.ExeItem}" Focusable="False" Margin="0,4,0,4"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding NewGameExe, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Nome do executável, ex.: eldenring.exe"
                             AutomationProperties.Name="Executável para a sua lista de jogos"/>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddGameCommand}" Content="Adicionar" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="Nunca tratar como jogo" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  <ItemsControl ItemsSource="{Binding ExcludedGames}" Tag="{Binding RemoveExcludedCommand}" ItemTemplate="{StaticResource M.ExeItem}" Focusable="False" Margin="0,4,0,0"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                             Text="Só o nome e a pasta de cada programa são lidos. O NEXUS não abre o jogo nem lê a memória dele."/>
                </StackPanel>

                <!-- PresentMon e sessões -->
                <StackPanel Margin="0,0,0,20">
                  <TextBlock Text="PresentMon" Style="{StaticResource M.SectionTitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <c:StatusChip Tone="Good" Text="{Binding PresentMonText}" Visibility="{Binding HasPresentMon, Converter={StaticResource M.Vis}}"/>
                    <c:StatusChip Tone="Bad" Text="{Binding PresentMonText}" Visibility="{Binding HasPresentMon, Converter={StaticResource M.VisNot}}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding PresentMonTrustText}" Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <WrapPanel Margin="0,0,0,6">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding BrowseCommand}" Content="Localizar PresentMon" Margin="0,0,8,4"/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding RescanPresentMonCommand}" Content="Procurar de novo" Margin="0,0,8,4"/>
                  </WrapPanel>
                  <c:ExplainToggle Header="O que é o PresentMon?" Content="{Binding PresentMonHelp}" Margin="0,0,0,16"/>

                  <TextBlock Text="Partidas guardadas" Style="{StaticResource M.SectionTitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Apagar partidas com mais de" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding KeepDays, UpdateSourceTrigger=LostFocus}" Width="60" Margin="8,0" Padding="6,3" HorizontalContentAlignment="Right"
                             FontFamily="{StaticResource Font.Numbers}" ToolTip="0 = guardar para sempre." AutomationProperties.Name="Dias para guardar as partidas"/>
                    <TextBlock Text="dias" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CleanupCommand}" Content="Limpar agora" Margin="12,0,0,0"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,8"
                             Text="A última partida de cada jogo e as marcadas nunca são apagadas. Só a pasta de sessões do NEXUS."/>
                  <WrapPanel>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ExportCsvCommand}" Content="Exportar todas (CSV)" Margin="0,0,8,4"/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenFolderCommand}" Content="Abrir a pasta de sessões" Margin="0,0,8,4"/>
                  </WrapPanel>
                </StackPanel>
              </UniformGrid>
            </c:ExplainToggle>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
