<!--
  Medir: gravar (PresentMon) ou importar uma sessão, ver o traço de frametime e marcar antes/depois.
  Recursos locais em DataTemplate.Resources; do tema, só as chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:m="clr-namespace:Nexus.Desktop.Views.Measure">
  <DataTemplate DataType="{x:Type vm:MeasurePage}">
    <DataTemplate.Resources>
      <m:BoolVisibilityConverter x:Key="M.Vis"/>
      <m:BoolVisibilityConverter x:Key="M.VisNot" Invert="True"/>
      <m:PresenceVisibilityConverter x:Key="M.Has"/>
      <m:PresenceVisibilityConverter x:Key="M.HasNot" Invert="True"/>
      <m:IntEqualsConverter x:Key="M.IntEq"/>
      <m:CaptureClockConverter x:Key="M.Clock"/>
      <m:InvertBoolConverter x:Key="M.Not"/>

      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Atalho de duração: botão de opção com cara de segmento. -->
      <Style x:Key="M.Preset" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="seg" Background="Transparent" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Control}" Padding="12,7" MinWidth="54">
                <TextBlock x:Name="label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                  <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
                  <Setter TargetName="seg" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                  <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Barra de progresso da captura: trilho escuro, traço âmbar com brilho. -->
      <Style x:Key="M.CaptureBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border x:Name="PART_Track" Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
                <Border x:Name="PART_Indicator" Background="{StaticResource Brush.Trace}" CornerRadius="3" HorizontalAlignment="Left">
                  <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.7" Color="{Binding Color, Source={StaticResource Brush.Trace}}"/>
                  </Border.Effect>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Selo Antes (ciano) / Depois (âmbar) de uma SessionRow. Sem marca: nada aparece. -->
      <DataTemplate x:Key="M.TagChip">
        <Border x:Name="chip" Visibility="Collapsed" BorderThickness="1" CornerRadius="9" Padding="9,1,9,2" HorizontalAlignment="Left"
                VerticalAlignment="Center" BorderBrush="{StaticResource Brush.Line}">
          <TextBlock x:Name="chipText" Text="{Binding TagText}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Small}"
                     Foreground="{StaticResource Brush.TextMuted}"/>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsBefore}" Value="True">
            <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
            <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsAfter}" Value="True">
            <Setter TargetName="chip" Property="Visibility" Value="Visible"/>
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="chipText" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Cartão de sessão na lista. -->
      <Style x:Key="M.SessionItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid Margin="0,0,0,6">
                <Border x:Name="card" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}" Padding="14,10,12,10">
                  <ContentPresenter/>
                </Border>
                <!-- Marca de seleção: um filete âmbar à esquerda, como o cursor de um instrumento. -->
                <Border x:Name="tick" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource Brush.Trace}" Visibility="Collapsed"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="card" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                  <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24,28,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="360"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- (a) Bancada de captura -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel.Card}" Margin="0,0,0,20" Padding="20,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="160"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,24,14">
              <TextBlock Text="Gravar uma sessão" Style="{StaticResource Text.H2}"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                         Text="Abra o jogo, entre numa partida ou no treino e grave. O NEXUS só lê o tempo de cada quadro; nada no PC muda."/>
            </StackPanel>

            <!-- Jogo -->
            <TextBlock Grid.Row="1" Text="Jogo" Style="{StaticResource Text.MetricLabel}" Margin="0,0,0,6"/>
            <StackPanel Grid.Row="2" Margin="0,0,24,0">
              <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Busy, Converter={StaticResource M.Not}, Mode=OneWay}"
                       ToolTip="Nome do executável do jogo, como aparece no Gerenciador de Tarefas (aba Detalhes)."/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,5,0,0"
                         Text="O nome do executável, como cs2.exe ou VALORANT-Win64-Shipping.exe."/>
            </StackPanel>

            <!-- Duração -->
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Duração" Style="{StaticResource Text.MetricLabel}" Margin="0,0,0,6"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,24,0" IsEnabled="{Binding Busy, Converter={StaticResource M.Not}, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource M.Preset}" Content="30 s" GroupName="M.Duration"
                             IsChecked="{Binding Seconds, Converter={StaticResource M.IntEq}, ConverterParameter=30}"/>
                <RadioButton Style="{StaticResource M.Preset}" Content="60 s" GroupName="M.Duration"
                             IsChecked="{Binding Seconds, Converter={StaticResource M.IntEq}, ConverterParameter=60}"/>
                <RadioButton Style="{StaticResource M.Preset}" Content="120 s" GroupName="M.Duration"
                             IsChecked="{Binding Seconds, Converter={StaticResource M.IntEq}, ConverterParameter=120}"/>
                <RadioButton Style="{StaticResource M.Preset}" Content="300 s" GroupName="M.Duration"
                             IsChecked="{Binding Seconds, Converter={StaticResource M.IntEq}, ConverterParameter=300}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Outra:" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Seconds, UpdateSourceTrigger=LostFocus}" Width="64" Padding="6,3" HorizontalContentAlignment="Right"
                         FontFamily="{StaticResource Font.Numbers}" ToolTip="De 10 a 600 segundos."/>
                <TextBlock Text="segundos (10 a 600)" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>

            <!-- Permissão -->
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding RequestElevation}" IsEnabled="{Binding Busy, Converter={StaticResource M.Not}, Mode=OneWay}" Margin="0,16,24,0" VerticalContentAlignment="Top">
              <StackPanel Margin="4,0,0,0">
                <TextBlock Text="Pedir permissão ao Windows" Style="{StaticResource Text.Body}"/>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="O PresentMon costuma precisar de permissão de administrador para ler os quadros do jogo. O Windows pergunta antes de abrir. Desmarque só se sua conta já tem esse acesso (grupo Usuários de log de desempenho)."/>
              </StackPanel>
            </CheckBox>

            <!-- Ação: Gravar / gravando -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" VerticalAlignment="Center">
              <StackPanel Visibility="{Binding Busy, Converter={StaticResource M.VisNot}}">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding CaptureCommand}" Margin="0" Height="48"
                        HorizontalAlignment="Stretch"
                        ToolTip="Começa a gravar o jogo indicado pela duração escolhida. Deixe o jogo em primeiro plano.">
                  <TextBlock Text="Gravar sessão" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.H2}"
                             Foreground="{StaticResource Brush.Bg}"/>
                </Button>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0" TextAlignment="Center"
                           Visibility="{Binding HasPresentMon, Converter={StaticResource M.VisNot}}"
                           Text="Localize o PresentMon abaixo para gravar."/>
              </StackPanel>
              <StackPanel Visibility="{Binding Busy, Converter={StaticResource M.Vis}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                             Foreground="{StaticResource Brush.Trace}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource M.Clock}">
                        <Binding Path="Progress"/>
                        <Binding Path="Seconds"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="Gravando" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Trace}"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource M.CaptureBar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,12"/>
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Content="Cancelar" Margin="0"
                        HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Grid>

            <!-- Rodapé: PresentMon e importação -->
            <Border Grid.Row="4" Grid.ColumnSpan="3" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Já tem uma captura?" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource Button.Secondary}" Command="{Binding ImportCommand}" Content="Importar CSV" Margin="0"
                          ToolTip="Importa um ou mais CSV do PresentMon ou do CapFrameX. O arquivo original não é alterado."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Brush.Bad}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPresentMon}" Value="True">
                            <Setter Property="Fill" Value="{StaticResource Brush.Good}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Style="{StaticResource Text.Small}" VerticalAlignment="Center" TextWrapping="NoWrap">
                    <Run Text="PresentMon:" Foreground="{StaticResource Brush.TextDim}"/>
                    <Run Text="{Binding PresentMonText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/>
                  </TextBlock>
                  <Button Style="{StaticResource Button.Ghost}" Command="{Binding BrowseCommand}" Content="Localizar PresentMon" Margin="8,0,0,0"
                          ToolTip="Indique onde está o PresentMon (executável oficial da Intel). O NEXUS lembra o caminho."/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Ajuda quando o PresentMon não foi encontrado -->
            <Border Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Panel.Notice}" Margin="0,12,0,0"
                    Visibility="{Binding HasPresentMon, Converter={StaticResource M.VisNot}}">
              <TextBlock Text="{Binding PresentMonHelp}" Style="{StaticResource Text.Body}"/>
            </Border>

            <!-- Status -->
            <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"
                       Margin="0,12,0,0" Visibility="{Binding Status, Converter={StaticResource M.Has}}"/>

            <!-- Saída do PresentMon (para entender um erro) -->
            <Expander Grid.Row="7" Grid.ColumnSpan="3" Margin="0,10,0,0" Visibility="{Binding Log, Converter={StaticResource M.Has}}">
              <Expander.Header>
                <TextBlock Text="Ver a saída do PresentMon" Style="{StaticResource Text.Small}"/>
              </Expander.Header>
              <Border Style="{StaticResource Panel.Inset}" Margin="0,8,0,0" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding Log}" FontFamily="Consolas" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextMuted}"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
              </Border>
            </Expander>
          </Grid>
        </Border>

        <!-- (b) O palco: a sessão selecionada -->
        <Grid Grid.Row="2" Grid.Column="0">
          <!-- Sessão selecionada -->
          <Border Style="{StaticResource Panel.Hero}" Padding="24,22"
                  Visibility="{Binding Selected, Converter={StaticResource M.Has}}">
            <StackPanel>
              <DockPanel>
                <ContentControl DockPanel.Dock="Right" Content="{Binding Selected}" ContentTemplate="{StaticResource M.TagChip}"
                                VerticalAlignment="Top" Margin="12,6,0,0" Focusable="False"/>
                <StackPanel>
                  <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Text.H1}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0">
                    <Run Text="{Binding Selected.Application, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/><Run Text=", gravada em "/><Run Text="{Binding Selected.When, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding Selected.DurationText, Mode=OneWay}"/><Run Text=" de captura, "/><Run Text="{Binding Selected.FramesText, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Selected.Source, Mode=OneWay}"/><Run Text="."/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>

              <!-- Os quatro números -->
              <UniformGrid Columns="4" Margin="0,22,0,18">
                <StackPanel Margin="0,0,16,0" ToolTip="Quantos quadros por segundo, em média, durante a sessão inteira.">
                  <TextBlock Text="FPS médio" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"
                             m:CountUp.Format="0" m:CountUp.Value="{Binding Selected.AverageFps, Mode=OneWay, FallbackValue=NaN}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                             Text="Quadros por segundo, em média, na sessão inteira."/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0" ToolTip="O FPS dos piores momentos: a média do 1% de quadros mais lentos. É o que você sente como travadinha.">
                  <TextBlock Text="1% low" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Style="{StaticResource Text.Metric}"
                             m:CountUp.Format="0" m:CountUp.Value="{Binding Selected.Low1Fps, Mode=OneWay, FallbackValue=NaN}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                             Text="O FPS dos piores momentos. É a travadinha que você sente."/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0" ToolTip="99% dos quadros saíram mais rápido que isto. Quanto menor, mais estável.">
                  <TextBlock Text="Frametime P99" Style="{StaticResource Text.MetricLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Metric}"
                               m:CountUp.Format="0.0" m:CountUp.Value="{Binding Selected.P99Ms, Mode=OneWay, FallbackValue=NaN}"/>
                    <TextBlock Text="ms" Style="{StaticResource Text.MetricLabel}" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                             Text="99% dos quadros saíram mais rápido que isso. Menor é mais estável."/>
                </StackPanel>
                <StackPanel ToolTip="Quadros que demoraram mais que o dobro dos vizinhos (e mais de 8 ms). Cada um é um tranco visível.">
                  <TextBlock Text="Engasgos por minuto" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Style="{StaticResource Text.Metric}"
                             m:CountUp.Format="0.0" m:CountUp.Value="{Binding Selected.StuttersPerMinute, Mode=OneWay, FallbackValue=NaN}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                             Text="Quadros com mais que o dobro do tempo dos vizinhos. Cada um é um tranco."/>
                </StackPanel>
              </UniformGrid>

              <!-- O traço -->
              <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8">
                <m:FrametimeChart Height="260" Points="{Binding Selected.Trace}"
                                  Stroke="{StaticResource Brush.Trace}" GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"
                                  ToolTip="Tempo de cada quadro ao longo da sessão, em milissegundos. As linhas tracejadas marcam o tempo por quadro de 60, 144 e 240 FPS."/>
              </Border>
              <TextBlock Style="{StaticResource Text.Small}" Margin="2,8,0,0"
                         Text="Tempo de cada quadro, do começo ao fim da sessão. Linha baixa e reta é jogo liso; cada pico é um engasgo. Triângulos no topo marcam picos maiores que a escala."/>

              <!-- Histograma -->
              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                  <TextBlock Text="Como os quadros se distribuem" Style="{StaticResource Text.Body}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                             Text="Uma torre estreita à esquerda é bom sinal. Barras espalhadas para a direita são quadros lentos."/>
                </StackPanel>
                <m:HistogramChart Grid.Column="1" Height="84" Bins="{Binding Selected.Histogram}" Fill="{StaticResource Brush.Trace}"
                                  OverflowFill="{StaticResource Brush.Bad}" LabelBrush="{StaticResource Brush.TextDim}"
                                  ToolTip="Quantos quadros caíram em cada faixa de 1 ms. A barra separada à direita junta tudo acima de 50 ms."/>
              </Grid>

              <!-- Ações da sessão selecionada -->
              <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Command="{Binding DeleteCommand}" Content="Apagar" Margin="0"
                          ToolTip="Remove esta sessão (e o CSV dela) da pasta de sessões do NEXUS. Pede confirmação."/>
                  <WrapPanel>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding TagBeforeCommand}" BorderBrush="{StaticResource Brush.Signal}" Margin="0,0,8,4"
                            ToolTip="Sessão gravada antes da mudança que você quer testar.">
                      <TextBlock Text="Marcar como antes" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}"/>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding TagAfterCommand}" BorderBrush="{StaticResource Brush.Trace}" Margin="0,0,8,4"
                            ToolTip="Sessão gravada depois da mudança.">
                      <TextBlock Text="Marcar como depois" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Trace}"/>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ClearTagCommand}" Content="Tirar marca" Margin="0,0,8,4"/>
                  </WrapPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Há sessões, mas nenhuma escolhida -->
          <Border Style="{StaticResource Panel.Card}" Padding="24">
            <Border.Visibility>
              <MultiBinding Converter="{x:Static m:MeasureVisibility.HasItemsButNoSelection}">
                <Binding Path="HasSessions"/>
                <Binding Path="Selected"/>
              </MultiBinding>
            </Border.Visibility>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                       Text="Escolha uma sessão na lista ao lado para ver o traço e os números dela."/>
          </Border>

          <!-- Estado vazio: primeira medição -->
          <Border Style="{StaticResource Panel.Hero}" Padding="28,26" Visibility="{Binding HasSessions, Converter={StaticResource M.VisNot}}">
            <StackPanel>
              <TextBlock Text="Sua primeira medição" Style="{StaticResource Text.Display}"/>
              <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,20"
                         Text="Grave uma partida e o NEXUS desenha aqui o tempo de cada quadro, com FPS médio, 1% low e engasgos."/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="1" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Display}"
                             Foreground="{StaticResource Brush.Trace}" Margin="0,-6,14,0"/>
                  <StackPanel>
                    <TextBlock Text="Abra o jogo" Style="{StaticResource Text.H2}"/>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                               Text="Entre numa partida, no treino ou num replay. Jogue um minuto antes para o jogo aquecer (shaders e cache)."/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Grid.Column="2">
                  <TextBlock DockPanel.Dock="Left" Text="2" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Display}"
                             Foreground="{StaticResource Brush.Trace}" Margin="0,-6,14,0"/>
                  <StackPanel>
                    <TextBlock Text="Grave uma sessão" Style="{StaticResource Text.H2}"/>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                               Text="Confira o nome do jogo acima e clique em Gravar sessão. Sem PresentMon? Importe um CSV do PresentMon ou do CapFrameX."/>
                  </StackPanel>
                </DockPanel>
              </Grid>
              <!-- Osciloscópio em repouso: a grade e as referências, sem sinal. -->
              <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8" Margin="0,24,0,0" Opacity="0.7">
                <m:FrametimeChart Height="170" GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- (c) Sessões e (d) como comparar direito -->
        <StackPanel Grid.Row="2" Grid.Column="2">
          <DockPanel Margin="2,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Sessions.Count}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                       Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Bottom"/>
            <TextBlock Text="Sessões" Style="{StaticResource Text.H2}"/>
          </DockPanel>

          <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource M.SessionItem}"
                   SelectionMode="Single" Background="Transparent" BorderThickness="0" Focusable="False">
            <ListBox.Template>
              <ControlTemplate TargetType="ListBox">
                <ItemsPresenter/>
              </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Application, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding When, Mode=OneWay}"/>
                    </TextBlock>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource M.TagChip}" Margin="0,6,0,0" HorizontalAlignment="Left" Focusable="False"
                                    Visibility="{Binding TagText, Converter={StaticResource M.Has}}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{Binding AverageFpsText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H1}"
                               Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Right"/>
                    <TextBlock Text="FPS médio" Style="{StaticResource Text.MetricLabel}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="2,0,0,12"
                     Visibility="{Binding HasSessions, Converter={StaticResource M.VisNot}}"
                     Text="As sessões gravadas ou importadas aparecem aqui."/>

          <TextBlock Style="{StaticResource Text.Small}" Margin="2,6,0,14" Visibility="{Binding HasSessions, Converter={StaticResource M.Vis}}"
                     Text="Marque sessões como antes e depois de uma mudança e abra Comparar para ver se a diferença é real."/>

          <Border Style="{StaticResource Panel.Notice}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="Para comparar direito" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding HowTo}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
