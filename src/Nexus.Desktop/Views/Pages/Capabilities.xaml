<!--
  "O que já funciona": capacidades desta versão agrupadas por área, cada uma com o seu rótulo honesto (Chip) e a observação.
  Recursos locais no DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:CapabilitiesPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Cap.Shown"/>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,24,24,24" MaxWidth="1100" HorizontalAlignment="Left">
        <!-- Cabeçalho -->
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>

        <!-- Placar: quantos itens em cada rótulo -->
        <UniformGrid Rows="1" Margin="0,18,0,0">
          <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="{Binding ValidatedCount}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Good}"/>
              <TextBlock Text="implementado e validado" Style="{StaticResource Text.MetricLabel}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="{Binding NotValidatedCount}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Signal}"/>
              <TextBlock Text="implementado, não validado" Style="{StaticResource Text.MetricLabel}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="{Binding NotSupportedCount}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.TextDim}"/>
              <TextBlock Text="não suportado neste ambiente" Style="{StaticResource Text.MetricLabel}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel.Inset}" Padding="14,10">
            <StackPanel>
              <TextBlock Text="{Binding PendingCount}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.TextMuted}"/>
              <TextBlock Text="pendente" Style="{StaticResource Text.MetricLabel}"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                   Text="Validado quer dizer que existe evidência registrada de um teste real. Sem essa evidência, o item fica como não validado, mesmo funcionando."/>

        <!-- Áreas -->
        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,10,16,0">
                  <TextBlock Text="{Binding Area}" Style="{StaticResource Text.H2}"/>
                  <TextBlock Text="{Binding Tally}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Capability}" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                                       Visibility="{Binding Note, Converter={StaticResource Cap.Shown}}"/>
                          </StackPanel>
                          <ContentPresenter Grid.Column="1" Content="{Binding Label}" ContentTemplate="{StaticResource Chip}"
                                            ToolTip="{Binding LabelText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
