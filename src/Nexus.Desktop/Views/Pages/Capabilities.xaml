<!--
  "O que já funciona" (design system v2, docs/10-design-system.md). Sem maquiagem: o que existe nesta versão e o que foi
  conferido de verdade.
    1. Destaque: quantas capacidades têm teste real registrado (conta) e o anel da parcela validada.
    2. Quatro cartões: validado, sem teste real ainda, não roda aqui, pendente.
    3. Uma área por cartão: ícone, barra "validado" da área e cada item com o seu selo; observação em 2 linhas.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:CapabilitiesPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Diagnostics}" Title="{l:T Pg.ValidadoTesteReal}"
                     Number="{Binding ValidatedCount}" Suffix="{Binding ValidatedSuffix}"
                     Caption="{l:T Pg.ValidadoExisteRegistroTeste}"
                     SecondaryText="{l:T Pg.VerHistorico}" SecondaryCommand="{x:Static shell:ShellCommands.Navigate}" SecondaryCommandParameter="HistoryPage">
          <StackPanel Width="164">
            <c:RingMeter Value="{Binding ValidatedPercent}" Label="{l:T Pg.Validado}" Width="136" Height="136" Thickness="11" HorizontalAlignment="Center"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== Quatro números ===== -->
        <UniformGrid Columns="4" Margin="-7,0">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding ValidatedCount}" Tone="Good"
                      Label="{l:T Pg.Validado2}" Detail="{l:T Pg.FuncionaFoiTestadoVerdade}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Info}" Number="{Binding NotValidatedCount}" Tone="Info"
                      Label="{l:T Pg.SemTesteRealAinda}" Detail="{l:T Pg.ExisteFaltaEvidenciaRegistrada}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Close}" Number="{Binding NotSupportedCount}"
                      Label="{l:T Pg.NaoRodaAqui}" Detail="{l:T Pg.PrecisaOutroAmbiente}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Plus}" Number="{Binding PendingCount}" Tone="Warn"
                      Label="{l:T Pg.Pendente}" Detail="{l:T Pg.AindaNaoExisteNesta}"/>
        </UniformGrid>

        <!-- ===== Áreas ===== -->
        <TextBlock Text="{l:T Pg.AreaArea}" Style="{StaticResource Text.H2}" Margin="0,26,0,12"/>
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" Margin="-7,0"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type opt:CapabilityGroup}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="7,0,7,14" opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" Margin="0,0,12,0">
                      <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                      <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Area}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding Tally}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </Grid>
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,8" AutomationProperties.Name="{Binding Tally}"/>
                  <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type opt:CapabilityCard}">
                        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                              <TextBlock Text="{Binding Capability}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                         ToolTip="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <c:StatusChip Grid.Column="1" Tone="{Binding Tone}" Text="{Binding ChipText}" VerticalAlignment="Top" ToolTip="{Binding LabelText}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
