<!--
  Ajustes (design system v2, docs/10-design-system.md).
    1. Destaque: controles deslizantes, quantos agendamentos estão ligados (conta, de 2); à direita o estado de cada coisa em selos.
    2. Agendamentos: cartão por tarefa (ícone, selo ligada/desligada, horário, condições, Ligar/Salvar e Desligar). A limpeza
       segura mostra o que entra e o que nunca entra recolhidos; avisos visíveis (desligada por padrão, vai para a quarentena).
    3. Atualizações (versão, automático, procurar agora, progresso, instalar).
    4. Notificações e bandeja, Iniciar com o Windows, Dados e relatórios e Sobre como cartões com ícone; explicações longas em
       "Por que isso?".
  A lógica é a do SettingsPage (o que muda o sistema vai pelo aplicador, com diário e desfazer).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">

  <!-- Uma tarefa agendada: distintivo, selo, situação, frequência, dia, hora, condições e os botões. -->
  <DataTemplate DataType="{x:Type vm:ScheduleEditor}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
          <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                  Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,2,0,0"/>
        </StackPanel>
        <c:StatusChip Grid.Column="2" Tone="{Binding Tone}" Text="{Binding StateText}" VerticalAlignment="Top"/>
      </Grid>
      <c:ExplainToggle Margin="50,2,0,0">
        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}"/>
      </c:ExplainToggle>

      <Border Style="{StaticResource Panel.Inset}" Padding="14,12" Margin="0,10,0,0">
        <StackPanel>
          <WrapPanel>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,8" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{x:Static vm:ScheduleEditor.Frequencies}" SelectedIndex="{Binding Frequency}" MinWidth="130" Margin="0,0,10,8"
                      AutomationProperties.Name="{l:T Settings.Frequencia}"/>
            <ComboBox ItemsSource="{x:Static vm:ScheduleEditor.Days}" SelectedIndex="{Binding Day}" MinWidth="110" Margin="0,0,10,8"
                      AutomationProperties.Name="{l:T Settings.DiaSemana}" Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,8" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{l:T Settings.Dia}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox ItemsSource="{x:Static vm:ScheduleEditor.MonthDays}" SelectedItem="{Binding MonthDay}" MinWidth="64" AutomationProperties.Name="{l:T Settings.DiaMes}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
              <TextBlock Text="{l:T Settings.As}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox ItemsSource="{x:Static vm:ScheduleEditor.Hours}" SelectedItem="{Binding Hour}" MinWidth="64" AutomationProperties.Name="{l:T Settings.Hora}"/>
              <TextBlock Text=":" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="4,0"/>
              <ComboBox ItemsSource="{x:Static vm:ScheduleEditor.Minutes}" SelectedItem="{Binding Minute}" MinWidth="64" AutomationProperties.Name="{l:T Settings.Minuto}"/>
            </StackPanel>
          </WrapPanel>
          <CheckBox Content="{l:T Settings.NaoRodarBateria}" IsChecked="{Binding SkipOnBattery}" Margin="0,2,0,0"/>
          <CheckBox Content="{l:T Settings.NaoRodarJogoAberto}" IsChecked="{Binding SkipWhenGaming}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <WrapPanel Margin="0,12,0,0">
        <Button Content="{Binding SaveText}" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
        <Button Content="{l:T Settings.Desligar}" Style="{StaticResource Button.Secondary}" Command="{Binding TurnOffCommand}"
                Visibility="{Binding IsOn, Converter={StaticResource BoolToVis}}"/>
      </WrapPanel>
    </StackPanel>
  </DataTemplate>

  <!-- Atualizações: versão, automático, procurar agora, progresso do download e instalar (ViewModels/AppUpdates.cs). -->
  <DataTemplate DataType="{x:Type vm:AppUpdates}">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <c:StatusChip DockPanel.Dock="Right" Tone="{Binding AutoTone}" Text="{Binding AutoChip}" VerticalAlignment="Top"/>
        <Grid Width="38" Height="38" Margin="0,0,12,0">
          <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
          <c:Icon Data="{StaticResource Icon.Refresh}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{l:T Settings.Atualizacoes}" Style="{StaticResource Text.H2}"/>
          <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
        </StackPanel>
      </DockPanel>
      <CheckBox Content="{l:T Settings.AtualizarAutomaticamente}" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding IsEnabled}"/>
      <TextBlock Text="{Binding KindNote}" Style="{StaticResource Text.Small}" Margin="24,4,0,0"/>

      <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"
                     Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar Height="4" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0"
                       Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{l:T Settings.ProgressoDownload}"/>
          <TextBlock Text="{Binding ReadyNotes}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                     Visibility="{Binding ReadyNotes, Converter={StaticResource NullToCollapsed}}"/>
          <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,12,0,0">
        <Button Content="{l:T Shell.ReiniciarAtualizar}" Style="{StaticResource Button.Primary}" Command="{Binding InstallNowCommand}" Margin="0,0,10,0"
                Visibility="{Binding HasReady, Converter={StaticResource BoolToVis}}"/>
        <Button Content="{l:T Settings.ProcurarAtualizacaoAgora}" Style="{StaticResource Button.Secondary}" Command="{Binding CheckNowCommand}" Margin="0,0,10,0"/>
        <Button Content="{l:T Shell.AbrirDownloads}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDownloadsCommand}"
                Visibility="{Binding HasNotify, Converter={StaticResource BoolToVis}}"/>
      </WrapPanel>
      <c:ExplainToggle Header="{l:T Settings.ComoConferido}" Margin="0,8,0,0"
                       Content="{l:T Settings.SoInstalaFoiAssinado}"/>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Settings}" Title="{l:T Settings.AgendamentosLigados}"
                     Number="{Binding ActiveSchedules}" Suffix="{l:T Settings.N2}"
                     Caption="{l:T Settings.SuaContaSemAdministrador}"
                     SecondaryText="{l:T Shell.LerNovo}" SecondaryCommand="{Binding RefreshCommand}">
          <StackPanel Width="230">
            <DockPanel Margin="0,0,0,8">
              <c:StatusChip DockPanel.Dock="Right" Tone="{Binding Scan.Tone}" Text="{Binding Scan.StateText}"/>
              <TextBlock Text="{l:T Settings.Verificacao}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:StatusChip DockPanel.Dock="Right" Tone="{Binding Clean.Tone}" Text="{Binding Clean.StateText}"/>
              <TextBlock Text="{l:T Settings.LimpezaSegura}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:StatusChip DockPanel.Dock="Right" Tone="{Binding StartTone}" Text="{Binding StartChip}"/>
              <TextBlock Text="{l:T Settings.Iniciar}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel>
              <c:StatusChip DockPanel.Dock="Right" Tone="{Binding NotificationsTone}" Text="{Binding NotificationsChip}"/>
              <TextBlock Text="{l:T Settings.Avisos}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </c:HeroPanel>

        <!-- Mensagens -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,12" Visibility="{Binding SettingsProblem, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding SettingsProblem}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>

        <!-- ===== Agendamentos ===== -->
        <TextBlock Text="{l:T Settings.Agendamentos}" Style="{StaticResource Text.H2}" Margin="0,4,0,12"/>
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,16">
          <c:HowItWorks>
            <c:StepItem Icon="{StaticResource Icon.History}" Title="{l:T Settings.VoceEscolhe}" Text="{l:T Settings.DiaHoraQuandoNao}"/>
            <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Settings.Confirma}" Text="{l:T Settings.TarefaVaiAgendadorWindows}" Tone="Warn"/>
            <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Settings.RodaSozinho}" Text="{l:T Settings.VerificarSoLeLimpar}"/>
            <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Settings.Desliga}" Text="{l:T Settings.CliqueRemoveTarefaFica}" Tone="Good"/>
          </c:HowItWorks>
        </Border>

        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
          <ContentControl Content="{Binding Scan}" Focusable="False"/>
        </Border>

        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12" BorderBrush="{StaticResource Brush.TraceLine}">
          <StackPanel>
            <ContentControl Content="{Binding Clean}" Focusable="False"/>
            <WrapPanel Margin="0,14,0,0">
              <c:StatusChip Tone="Info" Text="{l:T Settings.DesligadaPadrao}" Margin="0,0,6,6"/>
              <c:StatusChip Tone="Good" Text="{l:T Settings.VaiQuarentena}" Margin="0,0,6,6"/>
              <c:StatusChip Tone="Info" Text="{l:T Settings.SoCachesSuaConta}" Margin="0,0,6,6"/>
              <c:StatusChip Tone="Neutral" Text="{l:T Settings.NaoAceleraSoLibera}" Margin="0,0,6,6"/>
            </WrapPanel>
            <c:ExplainToggle Header="{l:T Settings.EntraNuncaEntra}" Margin="0,4,0,0">
              <StackPanel>
                <TextBlock Text="{Binding CleaningRules}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{Binding CleaningExcluded}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
                           Text="{l:T Settings.ProgramaAbertoExNavegador}"/>
              </StackPanel>
            </c:ExplainToggle>
            <DockPanel Margin="0,8,0,0">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding OpenLastCleaningCommand}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Page}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Settings.AbrirRelatorio}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding LastCleaning}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,12" Visibility="{Binding LegacyOn, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:T Settings.DesligarAntiga}" Style="{StaticResource Button.Secondary}" Command="{Binding LegacyOffCommand}" Margin="12,0,0,0"/>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LegacyText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <!-- ===== Atualizações ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,14,0,0" BorderBrush="{StaticResource Brush.TraceLine}">
          <ContentControl Content="{Binding Updates}" Focusable="False"/>
        </Border>

        <!-- ===== Idioma (settings.json; vale ao reabrir: os textos são carregados uma vez) ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,14,0,0">
          <DockPanel>
            <Grid Width="38" Height="38" Margin="0,0,12,0" DockPanel.Dock="Left" VerticalAlignment="Top">
              <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
              <c:Icon Data="{StaticResource Icon.Browser}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
            </Grid>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Display"
                        MinWidth="220" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="{l:T Settings.IdiomaInterface}"/>
              <Button Content="{l:T Settings.ReiniciarAgora}" Style="{StaticResource Button.Primary}" Command="{Binding RestartForLanguageCommand}"
                      VerticalAlignment="Center" Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{l:T Settings.Idioma}" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{l:T Settings.PortuguesEnglishOuEspanol}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <UniformGrid Columns="2" Margin="-7,14,-7,0">
          <!-- ===== Notificações e bandeja ===== -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Grid Width="38" Height="38" Margin="0,0,12,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Info}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Settings.AvisosBandeja}" Style="{StaticResource Text.H2}"/>
                  <TextBlock Text="{l:T Settings.PreferenciasInterfaceNadaAqui}" Style="{StaticResource Text.Small}"/>
                </StackPanel>
              </DockPanel>
              <CheckBox Content="{l:T Settings.AvisarQuandoTarefaAgendada}" IsChecked="{Binding Notifications}"/>
              <CheckBox Content="{l:T Settings.AvisarTambemQuandoFor}" IsChecked="{Binding NotifySkipped}" Margin="24,8,0,0" IsEnabled="{Binding Notifications}"/>
              <CheckBox Content="{l:T Settings.IconeNexusBandeja}" IsChecked="{Binding TrayIcon}" Margin="0,14,0,0"/>
              <CheckBox Content="{l:T Settings.MinimizarEscondeBandeja}" IsChecked="{Binding MinimizeToTray}" Margin="24,8,0,0" IsEnabled="{Binding TrayIcon}"/>
              <CheckBox Content="{l:T Settings.FecharXEscondeBandeja}" IsChecked="{Binding CloseToTray}" Margin="24,8,0,0" IsEnabled="{Binding TrayIcon}"/>
              <c:ExplainToggle Margin="0,10,0,0"
                               Content="{l:T Settings.AvisoAbreRelatorioClicar}"/>
            </StackPanel>
          </Border>

          <!-- ===== Iniciar com o Windows ===== -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding StartTone}" Text="{Binding StartChip}" VerticalAlignment="Top"/>
                <Grid Width="38" Height="38" Margin="0,0,12,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Startup}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l:T Settings.IniciarWindows}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{Binding StartText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <Button Content="{Binding StartButtonText}" Style="{StaticResource Button.Secondary}" Command="{Binding ToggleStartCommand}"
                      HorizontalAlignment="Left" MinWidth="100" Margin="0,12,0,0"/>
              <c:ExplainToggle Margin="0,8,0,0"
                               Content="{l:T Settings.AbreMinimizadoBandejaEntrada}"/>
            </StackPanel>
          </Border>

          <!-- ===== Dados e relatórios ===== -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Grid Width="38" Height="38" Margin="0,0,12,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Disk}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l:T Settings.DadosRelatorios}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:T Shell.Abrir}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataCommand}" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="{l:T Settings.DiarioQuarentenaPreferencias}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{x:Static vm:SettingsPage.DataDirectory}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             ToolTip="{x:Static vm:SettingsPage.DataDirectory}"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="{l:T Shell.Abrir}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenReportsCommand}" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="{l:T Settings.Relatorios}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{x:Static vm:SettingsPage.ReportsDirectory}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             ToolTip="{x:Static vm:SettingsPage.ReportsDirectory}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         ToolTip="{x:Static vm:SettingsPage.SettingsFile}">
                <Run Text="{l:T Settings.Preferencias}"/>
                <Run Text="{x:Static vm:SettingsPage.SettingsFile}"/>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- ===== Sobre ===== -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <Grid Width="38" Height="38" Margin="0,0,12,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Capabilities}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l:T Settings.Sobre}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{x:Static vm:SettingsPage.Version}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding CatalogText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
              <WrapPanel Margin="0,10,0,0">
                <c:StatusChip Tone="Good" Text="{l:T Settings.SemTelemetria}" Margin="0,0,6,6"/>
                <c:StatusChip Tone="Good" Text="{l:T Settings.SemContas}" Margin="0,0,6,6"/>
                <c:StatusChip Tone="Good" Text="{l:T Settings.AtualizacaoAssinada}" Margin="0,0,6,6"/>
              </WrapPanel>
              <c:ExplainToggle Header="{l:T Settings.DependenciasRedistribuidas}" Margin="0,4,0,0">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Licenses}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,4">
                          <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/>
                          <Run Text="·" Foreground="{StaticResource Brush.TextDim}"/>
                          <Run Text="{Binding License, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/>
                          <Run Text="·" Foreground="{StaticResource Brush.TextDim}"/>
                          <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{x:Static vm:SettingsPage.LicenseNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
              <WrapPanel Margin="-8,4,0,0">
                <Button Content="{l:T Settings.JaFunciona}" Style="{StaticResource Button.Ghost}"
                        Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="CapabilitiesPage"/>
                <Button Content="{l:T Settings.TermosUso}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenTermsCommand}"/>
                <Button Content="{l:T Settings.Privacidade}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenPrivacyCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
