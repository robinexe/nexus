<!--
  Segurança (design system v2, docs/10-design-system.md):
    1. Destaque: escudo com check, "N itens em verde" contando, escudo-placar (% em verde) na cor do estado e as contagens
       verde/âmbar/vermelho; ação principal "Verificação rápida" (pelo Microsoft Defender).
    2. Verificação do Defender: progresso (tempo que conta + barra + última mensagem; o Defender não informa porcentagem),
       cancelar, e as outras verificações.
    3. Como funciona: Lê → Verifica → Revisa → Desfaz.
    4. Placar item a item: cartões com distintivo ✓/!/× na cor do tom.
    5. Pontos suspeitos (cartões com selo de gravidade; porquê/como verificar recolhidos), histórico do Defender, inspetor
       de registro (mito × fato visível; explicação longa recolhida) e lacunas da leitura.
  Toda escrita passa pelo Host (aplicador); verificações abrem a ferramenta oficial do Defender depois de confirmar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:SecurityPage}">
    <DataTemplate.Resources>
      <Style x:Key="S.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <!-- Distintivo redondo na cor do tom, com o ícone escolhido pelo VM (✓ / ! / × / i). -->
      <DataTemplate x:Key="S.Badge">
        <Grid Width="36" Height="36">
          <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="18"
                  Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
        </Grid>
      </DataTemplate>

      <!-- Contagem pequena do placar (bolinha de cor + número + rótulo). -->
      <Style x:Key="S.CountNumber" TargetType="c:AnimatedNumber">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Decimals" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Security}" Title="Itens em verde"
                     Number="{Binding GoodNumber}" IsLoading="{Binding IsLoading}"
                     Accent="{Binding HeadlineUiTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                     Caption="{Binding Headline}"
                     ActionText="Verificação rápida" Command="{Binding QuickScanCommand}"
                     SecondaryText="Ler de novo" SecondaryCommand="{Binding RefreshCommand}">
          <StackPanel Width="200">
            <!-- Escudo-placar: contorno e fundo na cor do estado, % em verde no centro. -->
            <Grid Width="118" Height="128" HorizontalAlignment="Center"
                  AutomationProperties.Name="{Binding ScoreText}">
              <Path Stretch="Fill" StrokeThickness="3" StrokeLineJoin="Round"
                    Data="M50,4 L92,18 L92,52 C92,80 72,98 50,106 C28,98 8,80 8,52 L8,18 Z"
                    Fill="{Binding HeadlineUiTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"
                    Stroke="{Binding HeadlineUiTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
              <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                <c:AnimatedNumber Value="{Binding ScorePercent}" Kind="Percent" FontFamily="{StaticResource Font.Numbers}" FontSize="28"
                                  Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"/>
                <TextBlock Text="em verde" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <UniformGrid Columns="3" Margin="0,12,0,0">
              <StackPanel ToolTip="Em verde: ligado e em dia">
                <c:AnimatedNumber Value="{Binding GoodNumber}" Style="{StaticResource S.CountNumber}" Foreground="{StaticResource Brush.Good}"/>
                <TextBlock Text="verde" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel ToolTip="Em atenção: funciona, mas vale conferir">
                <c:AnimatedNumber Value="{Binding WarnNumber}" Style="{StaticResource S.CountNumber}" Foreground="{StaticResource Brush.Trace}"/>
                <TextBlock Text="atenção" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel ToolTip="Em vermelho: proteção desligada ou ameaça pendente">
                <c:AnimatedNumber Value="{Binding BadNumber}" Style="{StaticResource S.CountNumber}" Foreground="{StaticResource Brush.Bad}"/>
                <TextBlock Text="vermelho" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </c:HeroPanel>

        <!-- Desfazer (aparece depois de corrigir algo aqui) -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="A última correção feita aqui pode ser desfeita (também na página Aplicar)." Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Verificação do Defender ===== -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,16" Margin="0,0,0,16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Scan}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Verificar com o Microsoft Defender" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="O antivírus do Windows faz a verificação. O NEXUS só pede e mostra." Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding ReadAt}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Top"/>
            </Grid>

            <!-- Progresso: o Defender não informa porcentagem; mostramos o tempo que conta, a barra e a última mensagem. -->
            <Border Style="{StaticResource Panel.Inset}" Padding="14,12" Margin="0,14,0,0" Visibility="{Binding ScanStatus, Converter={StaticResource NullToCollapsed}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                             AutomationProperties.LiveSetting="Polite"/>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScanElapsed}" FontFamily="{StaticResource Font.Numbers}" FontSize="26" Foreground="{StaticResource Brush.Trace}"
                               HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                    <TextBlock Text="tempo" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelScanCommand}" VerticalAlignment="Center"
                          Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Foreground="{StaticResource Brush.Signal}"
                             Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Verificação em andamento"/>
                <TextBlock Text="{Binding ScanLine}" Style="{StaticResource S.Code}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding ScanLine}" Visibility="{Binding ScanLine, Converter={StaticResource NullToCollapsed}}"/>
              </StackPanel>
            </Border>

            <WrapPanel Margin="0,14,0,0">
              <Button Content="Verificação completa" Style="{StaticResource Button.Secondary}" Command="{Binding FullScanCommand}" Margin="0,0,8,6"
                      ToolTip="Pode levar mais de uma hora e deixar o PC mais lento enquanto roda."/>
              <Button Content="Verificar uma pasta…" Style="{StaticResource Button.Secondary}" Command="{Binding CustomScanCommand}" Margin="0,0,8,6"/>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding UpdateSignaturesCommand}" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Atualizar assinaturas" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenSecurityCommand}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Abrir Segurança do Windows" TextWrapping="NoWrap"/>
                  <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
            </WrapPanel>
            <c:ExplainToggle Margin="0,4,0,0"
                             Content="O antivírus é o Microsoft Defender (ou o seu, se tiver outro). O NEXUS não tem motor de vírus próprio: seria pior que o Defender. Ele lê o estado, explica e pede ao Defender para verificar pela ferramenta oficial (MpCmdRun). Remover ou pôr em quarentena é feito pelo próprio Defender."/>
          </StackPanel>
        </Border>

        <!-- ===== 3. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <c:HowItWorks>
            <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Confere Defender, firewall e o Windows. Ler não muda nada."/>
            <c:StepItem Icon="{StaticResource Icon.Scan}" Title="Verifica" Text="O Defender procura ameaças. Você vê o tempo e as mensagens." Tone="Warn"/>
            <c:StepItem Icon="{StaticResource Icon.Warning}" Title="Revisa" Text="Pontos suspeitos são mostrados. Nada é removido sozinho."/>
            <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Toda correção feita aqui guarda o estado anterior." Tone="Good"/>
          </c:HowItWorks>
        </Border>

        <!-- ===== 4. Placar item a item ===== -->
        <TextBlock Text="Sua proteção, item a item" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="150" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Protection}" Margin="-7,0,-7,14" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProtectionRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14" Padding="16,14">
                <DockPanel>
                  <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0"
                          Command="{Binding OpenCommand}" Visibility="{Binding OpenCommand, Converter={StaticResource NullToCollapsed}}"
                          AutomationProperties.Name="{Binding Name, StringFormat='Abrir no Windows: {0}'}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Abrir no Windows" TextWrapping="NoWrap"/>
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource S.Badge}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}"/>
                      <TextBlock Text="{Binding State}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.H2}" Margin="0,2,0,0"
                                 Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                                 MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"
                                 Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}"/>
                      <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"
                                 Visibility="{Binding Advice, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5a. Pontos suspeitos ===== -->
        <DockPanel Margin="0,0,0,4">
          <c:StatusChip DockPanel.Dock="Right" Tone="Info" Text="suspeito não é prova de vírus" VerticalAlignment="Center"/>
          <TextBlock Text="Pontos suspeitos para revisar" Style="{StaticResource Text.H2}"/>
        </DockPanel>
        <TextBlock Text="{Binding FindingSummary}" Style="{StaticResource Text.Small}" Margin="0,0,0,4"/>
        <c:ExplainToggle Margin="0,0,0,12"
                         Content="Heurísticas do NEXUS: inicialização, tarefas agendadas, hosts, proxy, extensões forçadas, exclusões do Defender, IFEO, AppInit e Winlogon. Um ponto suspeito não é prova de vírus: o NEXUS nunca remove nada sozinho. Onde houver correção reversível, o botão aparece."/>
        <ContentControl Focusable="False" Margin="0,0,0,20">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasFindings}" Value="False"/>
                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
          <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="Nenhum ponto suspeito."
                        Detail="As verificações do NEXUS não acharam nada fora do comum agora."/>
        </ContentControl>
        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,0,20" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FindingRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource S.Badge}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <c:StatusChip Tone="{Binding Tone}" Text="{Binding SeverityLabel}"/>
                      <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                    <Border Style="{StaticResource Panel.Inset}" Padding="8,6" Margin="0,6,0,2">
                      <TextBlock Text="{Binding Evidence}" Style="{StaticResource S.Code}" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/>
                    </Border>
                    <c:ExplainToggle>
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                          <Run Text="Por que é suspeito: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding Why, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0">
                          <Run Text="Como verificar: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding HowToVerify, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0">
                          <Run Text="O que fazer: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding Suggested, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource S.Code}" Margin="0,6,0,0"/>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top" Margin="16,0,0,0"
                          Command="{Binding FixCommand}" Visibility="{Binding FixCommand, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="Corrigir (reversível)" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5b. Histórico de ameaças do Defender ===== -->
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Ameaças que o Defender já encontrou" Style="{StaticResource Text.H2}"/>
          <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Command="{Binding OpenHistoryCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Histórico de proteção" TextWrapping="NoWrap"/>
              <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>
        <c:ExplainToggle Margin="0,0,0,12"
                         Content="Remover ou pôr em quarentena é tarefa do Defender: ele sabe desfazer, restaurar falso positivo e limpar o que está em uso. O NEXUS mostra o que foi encontrado e o que fazer."/>
        <Border Padding="16,12" Margin="0,0,0,20">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Panel.Card}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasThreats}" Value="False"/>
                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <DockPanel>
            <c:StatusChip Tone="Good" Text="Nenhuma ameaça registrada" Margin="0,0,12,0"/>
            <TextBlock Text="(ou o histórico não pôde ser lido)" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Threats}" Margin="0,0,0,20" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ThreatRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource S.Badge}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                               Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                    <c:ExplainToggle Header="Arquivos envolvidos" Margin="0,2,0,0" Visibility="{Binding Resources, Converter={StaticResource NullToCollapsed}}">
                      <TextBlock Text="{Binding Resources}" Style="{StaticResource S.Code}"/>
                    </c:ExplainToggle>
                  </StackPanel>
                  <c:StatusChip Grid.Column="2" Tone="{Binding Tone}" Text="{Binding StateText}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5c. Inspetor de registro (não é limpador) ===== -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,16" Margin="0,0,0,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Search}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Inspetor de registro" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Mostra sobras que apontam para arquivos que não existem mais. Você escolhe." Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </Grid>
            <UniformGrid Columns="2" Margin="-6,0,-6,8">
              <Border Background="{StaticResource Brush.BadSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,10" Margin="6,0">
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Top" Tone="Bad" Text="Mito" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                  <TextBlock Text="&quot;Limpar o registro deixa o PC mais rápido.&quot;" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
              <Border Background="{StaticResource Brush.GoodSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,10" Margin="6,0">
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Top" Tone="Good" Text="Fato" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                  <TextBlock Text="Sobras não são lidas no uso normal e não pesam. Remover só arruma listas." Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
            </UniformGrid>
            <c:ExplainToggle Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="O registro é um banco de dados indexado; entradas que sobram não são lidas no uso normal e não pesam. A Microsoft não dá suporte a limpadores de registro e avisa que eles já causaram problemas sérios (KB 2563254, &quot;Microsoft support policy for the use of registry cleaning utilities&quot;)."/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                           Text="Por isso aqui não há &quot;limpar tudo&quot;. O inspetor só mostra sobras que apontam para arquivos que não existem mais (útil para arrumar Programas e Recursos e o Executar). Cada entrada é copiada por inteiro antes e pode ser recriada com Desfazer. Disco externo desligado nunca conta como sobra."/>
              </StackPanel>
            </c:ExplainToggle>
            <WrapPanel>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding InspectCommand}" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Inspecionar registro" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="Remover selecionadas (com cópia)" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveOrphansCommand}" Margin="0,0,8,6"/>
              <Button Content="Limpar seleção" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding InspectorStatus}" Style="{StaticResource Text.Small}" Margin="0,2,0,6" AutomationProperties.LiveSetting="Polite"/>
            <c:SkeletonLoader Shape="Lines" Lines="4" Margin="0,4,0,8" Visibility="{Binding Inspecting, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Orphans}" Focusable="False" Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OrphanRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Removable, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,0,0"
                                AutomationProperties.Name="{Binding Display}"/>
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                        <TextBlock Style="{StaticResource S.Code}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Location}">
                          <Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ScopeText, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" VerticalAlignment="Top"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- O que não foi lido (honestidade sobre lacunas) -->
        <c:ExplainToggle Header="O que não deu para ler">
          <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:ExplainToggle>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
