<!--
  Segurança: placar de proteção (Defender + Windows), verificações do próprio Defender, pontos suspeitos para revisão,
  histórico de ameaças e o inspetor de registro (com o aviso do mito). Recursos locais em DataTemplate.Resources; do tema,
  só as chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:SecurityPage}">
    <DataTemplate.Resources>
      <!-- Cor por tom: Good verde, Warn âmbar, Bad vermelho, Info ciano, Unknown cinza. -->
      <Style x:Key="S.ToneText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ToneKey}" Value="Good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Info"><Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="S.ToneDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ToneKey}" Value="Good"><Setter Property="Fill" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Warn"><Setter Property="Fill" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Bad"><Setter Property="Fill" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Info"><Setter Property="Fill" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <!-- Faixa lateral do cartão, na cor do tom. -->
      <Style x:Key="S.ToneBar" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource Brush.LineSoft}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ToneKey}" Value="Good"><Setter Property="Background" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Warn"><Setter Property="Background" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Bad"><Setter Property="Background" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding ToneKey}" Value="Info"><Setter Property="Background" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="S.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="Good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="S.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28" MaxWidth="1200" HorizontalAlignment="Stretch">

        <!-- Cabeçalho -->
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="{Binding ReadAt}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Ler de novo" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}"/>
          </StackPanel>
        </Grid>

        <!-- Herói: placar e verificação -->
        <Border Style="{StaticResource Panel.Hero}" Margin="0,0,0,20">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Placar de proteção" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource S.Headline}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                           Text="O antivírus é o Microsoft Defender (ou o seu, se tiver outro). O NEXUS não tem motor de vírus próprio: seria pior que o Defender. Ele lê, explica e pede ao Defender para verificar."/>
              </StackPanel>
              <StackPanel Grid.Column="1" MinWidth="230">
                <Button Content="Verificação rápida" Style="{StaticResource Button.Primary}" Command="{Binding QuickScanCommand}" Margin="0,0,0,8"/>
                <Button Content="Verificação completa" Style="{StaticResource Button.Secondary}" Command="{Binding FullScanCommand}" Margin="0,0,0,8"/>
                <Button Content="Verificar uma pasta…" Style="{StaticResource Button.Secondary}" Command="{Binding CustomScanCommand}" Margin="0,0,0,8"/>
                <Button Content="Atualizar assinaturas" Style="{StaticResource Button.Secondary}" Command="{Binding UpdateSignaturesCommand}" Margin="0,0,0,8"/>
                <Button Content="Abrir Segurança do Windows" Style="{StaticResource Button.Ghost}" Command="{Binding OpenSecurityCommand}"/>
              </StackPanel>
            </Grid>

            <!-- Progresso da verificação (o Defender não informa porcentagem: tempo + mensagens). -->
            <Border Style="{StaticResource Panel.Inset}" Margin="0,18,0,0" Visibility="{Binding ScanStatus, Converter={StaticResource NullToCollapsed}}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding ScanElapsed}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="16,0"/>
                  <Button Grid.Column="2" Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelScanCommand}"
                          Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ScanLine}" Style="{StaticResource S.Code}" Margin="0,8,0,0" Visibility="{Binding ScanLine, Converter={StaticResource NullToCollapsed}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Placar item a item -->
        <ItemsControl ItemsSource="{Binding Protection}" Margin="0,0,0,24" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Width="272" Margin="0,0,12,12" Padding="14,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource S.ToneBar}" Margin="0,2,12,2"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Text="{Binding State}" Style="{StaticResource S.ToneText}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.H2}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" Visibility="{Binding Advice, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Content="Abrir no Windows" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0" Padding="8,3"
                            Command="{Binding OpenCommand}" Visibility="{Binding OpenCommand, Converter={StaticResource NullToCollapsed}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Desfazer (aparece depois de aplicar) -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,20" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="A última correção feita aqui pode ser desfeita. O estado anterior está no diário (também aparece na página Aplicar)." Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Desfazer" Style="{StaticResource Button.Secondary}" Command="{Binding UndoCommand}" Margin="12,0,0,0"/>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>

        <!-- Pontos suspeitos -->
        <TextBlock Text="Pontos suspeitos para revisar" Style="{StaticResource Text.H2}"/>
        <TextBlock Text="{Binding FindingSummary}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,4"/>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,12"
                   Text="Heurísticas do NEXUS (inicialização, tarefas agendadas, hosts, proxy, extensões forçadas, exclusões do Defender, IFEO, AppInit, Winlogon). Um ponto suspeito não é prova de vírus: o NEXUS nunca remove nada sozinho. Onde houver correção reversível, o botão aparece."/>
        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,0,0,24" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource S.ToneBar}" Margin="0,2,14,2"/>
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource S.ToneDot}" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding SeverityText}" Style="{StaticResource S.ToneText}" FontFamily="{StaticResource Font.Display}" FontSize="12.5"/>
                      <TextBlock Text=" · " Style="{StaticResource Text.Small}"/>
                      <TextBlock Text="{Binding Category}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                    <Border Style="{StaticResource Panel.Inset}" Padding="8,6" Margin="0,6,0,6">
                      <TextBlock Text="{Binding Evidence}" Style="{StaticResource S.Code}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                      <Run Text="Por que é suspeito: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding Why, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0">
                      <Run Text="Como verificar: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding HowToVerify, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0">
                      <Run Text="O que fazer: " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding Suggested, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Corrigir (reversível)" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top" Margin="16,0,0,0"
                          Command="{Binding FixCommand}" Visibility="{Binding FixCommand, Converter={StaticResource NullToCollapsed}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Histórico de ameaças do Defender -->
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Histórico de ameaças do Defender" Style="{StaticResource Text.H2}"/>
          <Button Grid.Column="1" Content="Abrir histórico de proteção" Style="{StaticResource Button.Ghost}" Command="{Binding OpenHistoryCommand}"/>
        </Grid>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,10"
                   Text="Remover ou pôr em quarentena é tarefa do Defender: ele sabe desfazer, restaurar falso positivo e limpar o que está em uso. O NEXUS mostra o que foi encontrado e o que fazer."/>
        <TextBlock Text="Nenhuma ameaça registrada (ou o histórico não pôde ser lido)." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Good}" Margin="0,0,0,24"
                   Visibility="{Binding ThreatCount, Converter={StaticResource ZeroToVisible}}"/>
        <ItemsControl ItemsSource="{Binding Threats}" Margin="0,0,0,24" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource S.ToneBar}" Margin="0,2,12,2"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Resources}" Style="{StaticResource S.Code}" Margin="0,4,0,0" Visibility="{Binding Resources, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource S.ToneText}" FontSize="{StaticResource Size.Small}" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inspetor de registro (não é limpador) -->
        <TextBlock Text="Inspetor de registro" Style="{StaticResource Text.H2}"/>
        <Border Style="{StaticResource Panel.Notice}" Margin="0,8,0,12">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
              <Run Text="Mito: " FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Trace}"/><Run Text="&quot;limpar o registro deixa o PC mais rápido&quot;."/>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0">
              <Run Text="Fato: " FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Good}"/><Run Text="o registro é um banco de dados indexado; entradas que sobram não são lidas no uso normal e não pesam. A Microsoft não dá suporte a limpadores de registro e avisa que eles já causaram problemas sérios (KB 2563254, &quot;Microsoft support policy for the use of registry cleaning utilities&quot;)."/>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                       Text="Por isso aqui não há &quot;limpar tudo&quot;. O inspetor só mostra sobras que apontam para arquivos que não existem mais (útil para arrumar Programas e Recursos e o Executar). Você escolhe o que remover; cada entrada é copiada por inteiro antes e pode ser recriada com Desfazer. Disco externo desligado nunca conta como sobra."/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Inspecionar registro" Style="{StaticResource Button.Secondary}" Command="{Binding InspectCommand}" Margin="0,0,8,0"/>
          <Button Content="Remover selecionadas (com cópia)" Style="{StaticResource Button.Primary}" Command="{Binding RemoveOrphansCommand}" Margin="0,0,8,0"/>
          <Button Content="Limpar seleção" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding InspectorStatus}" Style="{StaticResource Text.Small}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Orphans}" Margin="0,0,0,24" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,6" Padding="12,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Removable}" VerticalAlignment="Top" Margin="0,2,10,0"
                            AutomationProperties.Name="{Binding Display}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}">
                      <Run Text="{Binding Display, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding Category, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource S.Code}" FontSize="11" Margin="0,2,0,0">
                      <Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ScopeText, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- O que não foi lido (honestidade sobre lacunas) -->
        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,2"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
