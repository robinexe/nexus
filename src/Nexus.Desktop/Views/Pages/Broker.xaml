<!--
  "Aplicar" (design system v2, docs/10-design-system.md). Segundo passo do caminho seguro
  Simular → Confirmar → Registrar → Desfazer. Pedidos ao aplicador (broker), a única via de escrita da interface.
    1. Destaque: escudo, quantos estão marcados (conta), "Aplicar…" (âmbar; só habilita quando o aplicador libera) e, à direita,
       o estado do aplicador (cadeado + selo) com a resposta técnica recolhida.
    2. O trilho com "Você está aqui" e o que acontece ao aplicar (Você confirma → Guarda o original → Aplica e confere → Desfaz).
    3. Esquerda: ajustes marcados (os mesmos de Testar sem aplicar). Direita: última execução com "Desfazer esta execução" sempre
       visível depois de aplicar, e a resposta de cada ajuste em cartões com selo.
  Recursos locais no próprio DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:BrokerPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Bro.Shown"/>

      <!-- Passo do caminho seguro (mesmo desenho de Testar sem aplicar e Histórico). -->
      <DataTemplate x:Key="F.Step" DataType="{x:Type vm:FlowStep}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Button.Ghost}" Padding="0" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                  Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                  AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Text}">
            <Border x:Name="Card" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                  <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                          Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" TextWrapping="NoWrap">
                    <Run Text="{Binding Number, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextDim}"/>
                    <Run Text="{Binding Title, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Small}" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  <c:StatusChip x:Name="Here" Tone="Warn" Text="Você está aqui" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <c:Icon x:Name="Arrow" Grid.Column="1" Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{StaticResource Brush.TextDim}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TraceLine}"/>
            <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="Here" Property="Visibility" Value="Visible"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsLast}" Value="True">
            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <Style x:Key="Bro.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Bro.Next" TargetType="TextBlock" BasedOn="{StaticResource Bro.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Security}" Title="Marcados para aplicar"
                     Number="{Binding SelectedCount}" IsLoading="{Binding Busy}" Caption="{Binding GateCaption}"
                     ActionText="Aplicar…" Command="{Binding ApplyCommand}"
                     SecondaryText="Consultar o aplicador" SecondaryCommand="{Binding StatusCommand}">
          <StackPanel Width="230">
            <StackPanel Orientation="Horizontal">
              <Grid Width="46" Height="46" Margin="0,0,12,0">
                <Ellipse Fill="{Binding GateTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                <c:Icon Data="{StaticResource Icon.Lock}" Size="22" Foreground="{Binding GateTone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel VerticalAlignment="Center" opt:Reveal.Trigger="{Binding GateState}">
                <TextBlock Text="Aplicador" Style="{StaticResource Text.Small}"/>
                <c:StatusChip Tone="{Binding GateTone}" Text="{Binding GateChip}" HorizontalAlignment="Left" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,10,0,0"/>
            <c:ExplainToggle Header="Resposta do aplicador" Margin="0,4,0,0">
              <StackPanel>
                <TextBlock Text="{Binding GateTitle}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{Binding GateExplain}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Gate}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" Visibility="{Binding Gate, Converter={StaticResource Bro.Shown}}"/>
                <TextBlock Text="{Binding Coordination}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" Visibility="{Binding Coordination, Converter={StaticResource Bro.Shown}}"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </c:HeroPanel>

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding LastMessage, Converter={StaticResource Bro.Shown}}" opt:Reveal.Trigger="{Binding LastMessage}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding LastMessage}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== Caminho seguro ===== -->
        <TextBlock Text="O caminho de toda mudança" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Flow}" ItemTemplate="{StaticResource F.Step}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== O que acontece ao aplicar ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,18,0,22">
          <StackPanel>
            <TextBlock Text="Ao clicar em Aplicar" Style="{StaticResource Text.H2}" Margin="0,0,0,14"/>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="Você confirma" Text="Uma janela mostra o que vai mudar. Sem clique, nada muda." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.History}" Title="Guarda o original" Text="O valor de hoje vai para o diário antes de escrever."/>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Aplica e confere" Text="Relê depois de mudar para ter certeza."/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Um clique devolve o valor original." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="Ajustes da sua conta são aplicados direto. Ajustes de sistema pedem permissão no aviso do Windows e criam um ponto de restauração antes. Aplicar só libera quando o aplicador confirma que pode escrever."/>
          </StackPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
          </Grid.ColumnDefinitions>

          <!-- ===== Ajustes marcados ===== -->
          <Border Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Grid Width="34" Height="34" Margin="0,0,10,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Catalog}" Size="17" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Ajustes marcados" Style="{StaticResource Text.H2}"/>
                  <TextBlock Text="Os mesmos de Testar sem aplicar." Style="{StaticResource Text.Small}"/>
                </StackPanel>
              </DockPanel>

              <c:EmptyState Illustration="{StaticResource Illo.Settings}" Text="Nenhum ajuste disponível ainda."
                            Detail="Eles aparecem quando a leitura do PC terminar."
                            ActionText="Ver o que dá pra ajustar" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="CatalogPage"
                            Visibility="{Binding HasCandidates, Converter={StaticResource FalseToVisible}}"/>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520"
                            Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                        <CheckBox IsChecked="{Binding Include}" VerticalContentAlignment="Top" Cursor="Hand" AutomationProperties.Name="{Binding Title}">
                          <StackPanel Margin="4,-2,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                            <Grid Margin="0,3,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Current}" Style="{StaticResource Bro.Now}" ToolTip="{Binding Current}"/>
                              <c:Icon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Size="13" Foreground="{StaticResource Brush.TextDim}" Margin="6,0"/>
                              <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Bro.Next}" ToolTip="{Binding Desired}"/>
                            </Grid>
                          </StackPanel>
                        </CheckBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Button Command="{Binding PlanCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Plan}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Simular pelo aplicador" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- ===== Execução e respostas ===== -->
          <StackPanel Grid.Column="2">
            <!-- Última execução: Desfazer sempre visível depois de aplicar -->
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16" BorderBrush="{StaticResource Brush.TraceLine}"
                    Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <DockPanel>
                  <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
                    <c:Icon Data="{StaticResource Icon.Undo}" Size="19" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel>
                    <TextBlock Text="Dá para desfazer" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="O valor original de cada ajuste está guardado no diário." Style="{StaticResource Text.Small}"/>
                    <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                               FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,12,0,0">
                  <Button Command="{Binding RevertCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="Desfazer esta execução…" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                  <Button Content="Encerrar sessão" Command="{Binding EndSessionCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                          Visibility="{Binding SessionOpen, Converter={StaticResource BoolToVis}}"/>
                  <Button Content="Ver no Histórico" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="HistoryPage"
                          Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"/>
                </WrapPanel>
                <c:ExplainToggle Content="Desfazer devolve os valores originais guardados no diário. Encerrar sessão desfaz o que valia só para esta sessão."/>
              </StackPanel>
            </Border>

            <!-- Respostas por ajuste -->
            <TextBlock Text="Resposta de cada ajuste" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
            <c:SkeletonLoader Shape="Lines" Lines="4" Margin="4,0,4,12" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
            <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="Nenhuma resposta ainda."
                          Detail="Simule ou aplique: o resultado de cada ajuste aparece aqui."
                          ActionText="Testar sem aplicar" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="PlanPage"
                          Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"/>

            <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
              <UniformGrid Columns="3" Margin="-6,0,-6,12">
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.Check}" Number="{Binding GoodCount}" Tone="Good"
                            Label="Conferidos" Detail="Aplicados, revertidos ou já certos."/>
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.ArrowRight}" Number="{Binding ChangedCount}" Tone="Warn"
                            Label="Em andamento" Detail="Mudaram ou mudariam."/>
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.Error}" Number="{Binding ProblemCount}" Tone="Bad"
                            Label="Com problema" Detail="Falha ou conflito. Nada forçado."/>
              </UniformGrid>
              <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:BrokerResultRow}">
                    <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,0,6" opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                          <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                                  Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Action}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                     FontFamily="{StaticResource Font.Numbers}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Action}"/>
                          <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto" MaxWidth="200"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="lido" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Observed}" Style="{StaticResource Bro.Now}" ToolTip="{Binding Observed}"/>
                            <c:Icon Grid.Column="2" Data="{StaticResource Icon.ArrowRight}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="8,0"/>
                            <TextBlock Grid.Column="3" Text="desejado" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding Desired}" Style="{StaticResource Bro.Next}" ToolTip="{Binding Desired}"/>
                          </Grid>
                          <c:ExplainToggle Margin="0,2,0,0" Content="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <c:StatusChip Grid.Column="2" Tone="{Binding Tone}" Text="{Binding OutcomeText}" VerticalAlignment="Top"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Avançado -->
            <c:ExplainToggle Header="Avançado: alterações que ficaram pela metade" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="Se o PC desligou no meio de uma aplicação, o diário sabe o que faltou. Recuperar desfaz essas alterações com confirmação."/>
                <Button Content="Recuperar interrompidas…" Command="{Binding RecoverCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
