<!--
  "Aplicar": pedidos ao serviço NexusBroker, a única via de escrita da interface. O estado da escrita (bloqueada / liberada)
  fica no topo, explicado sem alarme. Aplicar usa Button.Primary e só habilita pelo comando. Recursos locais no DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:BrokerPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Bro.Shown"/>
      <opt:EmptyToCollapsedConverter x:Key="Bro.ShownWhenEmpty" Invert="True"/>
      <opt:OutcomeTextConverter x:Key="Bro.OutcomeText"/>
      <opt:OutcomeToneConverter x:Key="Bro.OutcomeTone"/>

      <!-- Cadeado: apagado sem resposta, ciano quando bloqueado (estado, não erro), verde e aberto quando liberado. -->
      <Style x:Key="Bro.LockShackle" TargetType="Path">
        <Setter Property="Data" Value="M7,11 L7,8 A5,5 0 0 1 17,8 L17,11"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding GateState}" Value="blocked">
            <Setter Property="Stroke" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding GateState}" Value="open">
            <Setter Property="Stroke" Value="{StaticResource Brush.Good}"/>
            <Setter Property="Data" Value="M7,11 L7,8 A5,5 0 0 1 16.6,6"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Bro.LockBody" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding GateState}" Value="blocked">
            <Setter Property="Fill" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding GateState}" Value="open">
            <Setter Property="Fill" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Bro.Arrow" TargetType="Path">
        <Setter Property="Data" Value="M0,5 L16,5 M11,0 L16,5 L11,10"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0"/>
      </Style>
      <Style x:Key="Bro.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Bro.Next" TargetType="TextBlock" BasedOn="{StaticResource Bro.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>

      <!-- Resultado por ajuste: verde conferido/revertido, vermelho falha/conflito, âmbar em andamento, neutro o resto. -->
      <Style x:Key="Bro.Outcome" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Outcome, Converter={StaticResource Bro.OutcomeTone}}" Value="good">
            <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Outcome, Converter={StaticResource Bro.OutcomeTone}}" Value="bad">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Outcome, Converter={StaticResource Bro.OutcomeTone}}" Value="change">
            <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </DataTemplate.Resources>

    <Grid Margin="24,24,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Cabeçalho -->
      <StackPanel Grid.ColumnSpan="3">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- ===== Estado da escrita ===== -->
      <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel.Hero}" Margin="0,16,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Viewbox Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,20,0">
            <Canvas Width="24" Height="24">
              <Path Style="{StaticResource Bro.LockShackle}"/>
              <Rectangle Canvas.Left="4" Canvas.Top="11" Width="16" Height="11" RadiusX="2.5" RadiusY="2.5" Style="{StaticResource Bro.LockBody}"/>
              <Ellipse Canvas.Left="10.5" Canvas.Top="14.5" Width="3" Height="3" Fill="{StaticResource Brush.SurfaceHi}"/>
            </Canvas>
          </Viewbox>

          <StackPanel Grid.Column="1" opt:Reveal.Trigger="{Binding GateState}">
            <TextBlock Text="{Binding GateTitle}" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="{Binding GateExplain}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
            <Border Style="{StaticResource Panel.Inset}" Margin="0,14,0,0" Padding="12,10" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="Resposta do serviço" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.TextDim}"/>
                <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Gate}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                           Visibility="{Binding Gate, Converter={StaticResource Bro.Shown}}"/>
                <TextBlock Text="{Binding Coordination}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                           Visibility="{Binding Coordination, Converter={StaticResource Bro.Shown}}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Button Grid.Column="2" Content="Consultar serviço" Command="{Binding StatusCommand}" Style="{StaticResource Button.Secondary}"
                  VerticalAlignment="Top" Margin="20,0,0,0"/>
        </Grid>
      </Border>

      <!-- ===== Ajustes e comandos ===== -->
      <Border Grid.Row="2" Style="{StaticResource Panel.Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Ajustes marcados" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="São os mesmos de Testar sem aplicar: marcar aqui vale para as duas páginas." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel>
              <Button Content="Aplicar…" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"/>
              <Button Content="Simular pelo serviço" Command="{Binding PlanCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Small}"
                       Text="Aplicar só libera quando o serviço confirma que pode escrever, e sempre pede a sua confirmação antes."/>
          </StackPanel>

          <Grid>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Top"
                       Text="Nenhum ajuste disponível ainda. Use Ler novamente no topo da janela."
                       Visibility="{Binding Candidates.Count, Converter={StaticResource Bro.ShownWhenEmpty}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include}" Margin="0,0,0,12" VerticalContentAlignment="Top" Cursor="Hand">
                      <StackPanel Margin="4,-2,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"/>
                        <Grid Margin="0,3,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Current}" Style="{StaticResource Bro.Now}" ToolTip="{Binding Current}"/>
                          <Path Grid.Column="1" Style="{StaticResource Bro.Arrow}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Bro.Next}" ToolTip="{Binding Desired}"/>
                        </Grid>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ===== Execução e respostas ===== -->
      <DockPanel Grid.Row="2" Grid.Column="2">
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Última execução" Style="{StaticResource Text.MetricLabel}"/>
            <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Reverter esta execução…" Command="{Binding RevertCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
              <Button Content="Encerrar sessão" Command="{Binding EndSessionCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
              <Button Content="Recuperar interrompidas…" Command="{Binding RecoverCommand}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Small}"
                       Text="Reverter devolve os valores originais guardados no diário do serviço. Encerrar sessão desfaz o que valia só para esta sessão."/>
            <TextBlock Text="{Binding LastMessage}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,10,0,0"
                       Visibility="{Binding LastMessage, Converter={StaticResource Bro.Shown}}" opt:Reveal.Trigger="{Binding LastMessage}"/>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Resposta por ajuste" Style="{StaticResource Text.H2}" Margin="0,0,0,8"/>

        <Grid>
          <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Top"
                     Text="Nenhuma resposta ainda. Simule ou aplique pelo serviço e o resultado de cada ajuste aparece aqui."
                     Visibility="{Binding Results, Converter={StaticResource Bro.ShownWhenEmpty}}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Visibility="{Binding Results, Converter={StaticResource Bro.Shown}}">
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="0,0,0,6"
                          opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Action}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                 FontFamily="{StaticResource Font.Numbers}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Outcome, Converter={StaticResource Bro.OutcomeText}}" Style="{StaticResource Bro.Outcome}"/>
                      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto" MaxWidth="220"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="lido" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Observed}" Style="{StaticResource Bro.Now}" ToolTip="{Binding Observed}"/>
                        <Path Grid.Column="2" Style="{StaticResource Bro.Arrow}"/>
                        <TextBlock Grid.Column="3" Text="desejado" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding Desired}" Style="{StaticResource Bro.Next}" ToolTip="{Binding Desired}"/>
                      </Grid>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                 Visibility="{Binding Detail, Converter={StaticResource Bro.Shown}}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
