<!--
  Otimização automática (design system v2, docs/10-design-system.md).
    1. Destaque: varinha, quantas ações seguras estão no plano (conta), "Otimizar agora" (âmbar), "Desfazer tudo" depois de
       aplicar; à direita o perfil detectado em selos e se o plano já foi conferido pelo aplicador.
    2. Como funciona: Lê → Monta o plano → Você confirma → Desfaz tudo.
    3. O plano: cada ação com ícone e selo do nível (sua conta / administrador), a limpeza segura, ganhos e o que ficou de fora
       recolhidos; resultado e mensagens.
    4. Recomendações, conselhos de hardware e o que evitar como cartões com ícone e selo; ganho e detalhes em "Por que isso?".
    5. Agendamentos (resumo; configurar em Ajustes).
  A lógica é a do AutomationPage; só foram expostos dados de apresentação.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:AutomationPage}">
    <DataTemplate.Resources>
      <!-- Recomendação: distintivo do módulo no tom (âmbar recomendado, ciano revisar, vermelho evitar), selo do tipo, motivo em 2 linhas. -->
      <DataTemplate x:Key="A.Recommendation" DataType="{x:Type vm:RecommendationRow}">
        <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14" Padding="18,14">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,8,0,0"
                    Command="{Binding DetailsCommand}" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="{Binding Title, StringFormat={l:T Auto.VerDetalhesN}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T Auto.VerDetalhes}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
            <StackPanel>
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneValue}" Text="{Binding Kind}" VerticalAlignment="Top"/>
                <Grid Width="38" Height="38" HorizontalAlignment="Left">
                  <Ellipse Fill="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                          Foreground="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
                </Grid>
              </DockPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5" Margin="0,10,0,4"/>
              <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" MaxHeight="36"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
              <c:ExplainToggle Margin="0,2,0,0" Visibility="{Binding HasGainOrMeta, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding Gain}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" Visibility="{Binding Gain, Converter={StaticResource NullToCollapsed}}"/>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <ItemsPanelTemplate x:Key="A.TwoColumns">
        <UniformGrid Columns="2"/>
      </ItemsPanelTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Automation}" Title="{l:T Auto.AcoesSegurasEstePc}"
                     Number="{Binding PlanNumber}" IsLoading="{Binding IsLoading}" Caption="{Binding Headline}"
                     ActionText="{l:T Auto.OtimizarAgora}" Command="{Binding OptimizeCommand}"
                     SecondaryText="{Binding UndoText}" SecondaryCommand="{Binding UndoAllCommand}">
          <StackPanel Width="230">
            <TextBlock Text="{l:T Auto.PerfilDetectado}" Style="{StaticResource Text.Small}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding ProfileChips}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <c:StatusChip Tone="Info" Text="{Binding}" Margin="0,0,6,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:StatusChip Tone="Good" Text="{l:T Auto.ConferidoPeloAplicador}" HorizontalAlignment="Left" Margin="0,6,0,0"
                          Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}"/>
            <c:StatusChip Tone="Neutral" Text="{Binding PlanState, StringFormat={l:T Auto.PlanoN}}" HorizontalAlignment="Left" Margin="0,6,0,0"
                          Visibility="{Binding IsVerified, Converter={StaticResource FalseToVisible}}"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Resultado e mensagens -->
        <Border Background="{StaticResource Brush.GoodSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" opt:Reveal.Trigger="{Binding Result}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Result}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Panel.Notice}" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>

        <!-- ===== Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,22">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Auto.LePc}" Text="{l:T Auto.NotebookOuDesktopTomada}"/>
              <c:StepItem Icon="{StaticResource Icon.Plan}" Title="{l:T Auto.MontaPlano}" Text="{l:T Auto.SoRiscoBaixoConferido}"/>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Pg.VoceConfirma}" Text="{l:T Auto.VeListaAprovaSistema}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Auto.DesfazTudo}" Text="{l:T Auto.BotaoVoltaTudoOrdem}" Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="{l:T Auto.SoEntraTemRisco}"/>
                <ItemsControl ItemsSource="{Binding ProfileNotes}" Focusable="False" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>

        <!-- ===== O plano ===== -->
        <Border Style="{StaticResource Panel.Card}" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}" BorderThickness="1">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Command="{Binding RefreshPlanCommand}" Style="{StaticResource Button.Ghost}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Auto.ConferirNovo}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Plan}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Auto.PlanoOtimizarAgora}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>

            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="0,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding PlanRows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OneClickRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel>
                      <c:StatusChip DockPanel.Dock="Right" Tone="{Binding LevelTone}" Text="{Binding Level}" Icon="{Binding IconKey, Converter={StaticResource ResourceByKey}}"
                                    VerticalAlignment="Center" Margin="12,0,0,0"/>
                      <c:Icon Data="{StaticResource Icon.Check}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Detail}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8" Visibility="{Binding HasCleaning, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Clean}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CleaningText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              </DockPanel>
            </Border>

            <c:ExplainToggle Header="{l:T Auto.MudaPratica}" Margin="0,8,0,0" Content="{Binding PlanGains}"
                             Visibility="{Binding HasGains, Converter={StaticResource BoolToVis}}"/>
            <c:ExplainToggle Header="{Binding SkippedTitle}" Margin="0,2,0,0" Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding PlanSkipped}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,0,0,4"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </c:ExplainToggle>

          </StackPanel>
        </Border>

        <!-- ===== Recomendações ===== -->
        <DockPanel Margin="0,28,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <c:StatusChip Tone="Warn" Text="{Binding RecommendCount, StringFormat={l:T Auto.NFazer}}" Margin="0,0,6,0"/>
            <c:StatusChip Tone="Bad" Text="{Binding AvoidCount, StringFormat={l:T Auto.NEvitar}}"/>
          </StackPanel>
          <TextBlock Text="{l:T Auto.RecomendacoesEstePc}" Style="{StaticResource Text.H2}"/>
        </DockPanel>
        <c:SkeletonLoader Shape="Tiles" Columns="2" Height="150" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Automation}" Text="{l:T Auto.NenhumaRecomendacaoAgora}"
                      Detail="{l:T Auto.SeuPcJaEsta}"
                      Visibility="{Binding NoRecommendations, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource A.Recommendation}" ItemsPanel="{StaticResource A.TwoColumns}"
                      Focusable="False" Margin="-7,0"/>

        <StackPanel Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
          <DockPanel Margin="0,16,0,12">
            <c:Icon Data="{StaticResource Icon.Hardware}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T Auto.ConselhosHardware}" Style="{StaticResource Text.H2}"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Advice}" ItemTemplate="{StaticResource A.Recommendation}" ItemsPanel="{StaticResource A.TwoColumns}"
                        Focusable="False" Margin="-7,0"/>
        </StackPanel>

        <StackPanel Visibility="{Binding HasAvoid, Converter={StaticResource BoolToVis}}">
          <DockPanel Margin="0,16,0,4">
            <c:Icon Data="{StaticResource Icon.Warning}" Size="18" Foreground="{StaticResource Brush.Bad}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T Auto.NaoRecomendadoEstePc}" Style="{StaticResource Text.H2}"/>
          </DockPanel>
          <TextBlock Text="{l:T Auto.ComunsGuiasMasSeu}" Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding AvoidList}" ItemTemplate="{StaticResource A.Recommendation}" ItemsPanel="{StaticResource A.TwoColumns}"
                        Focusable="False" Margin="-7,0"/>
        </StackPanel>

        <!-- ===== Agendamentos (resumo; configurar em Ajustes) ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
              <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
              <c:Icon Data="{StaticResource Icon.History}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
              <TextBlock Text="{l:T Settings.Agendamentos}" Style="{StaticResource Text.H2}"/>
              <ItemsControl ItemsSource="{Binding ScheduleLines}" Focusable="False" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,2,0,0"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:ExplainToggle Margin="0,4,0,0"
                               Content="{l:T Auto.VerificacaoSoLePc}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top" Command="{Binding OpenSettingsCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T Auto.ConfigurarAjustes}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
