<!--
  Automático: o PC detectado (destaque), o "Otimizar agora" com o plano resumido, as recomendações com o motivo, o que NÃO
  fazer neste PC, conselhos de hardware e a verificação semanal (somente leitura). Do tema, só chaves do contrato.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:AutomationPage}">
    <DataTemplate.Resources>
      <!-- Selo de texto simples (perfil). -->
      <DataTemplate x:Key="A.Chip">
        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Chip}" Padding="9,2,10,3" Margin="0,0,6,6">
          <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="NoWrap"/>
        </Border>
      </DataTemplate>

      <!-- Recomendação: barra lateral colorida pelo tom (âmbar = recomendado, ciano = revisar/medir, vermelho = evitar). -->
      <DataTemplate x:Key="A.Recommendation">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="bar" Background="{StaticResource Brush.TextDim}" CornerRadius="2" Margin="0,10"/>
            <StackPanel Grid.Column="1" Margin="16,12,12,12">
              <TextBlock x:Name="kind" Text="{Binding Kind}" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.TextMuted}"/>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,2,0,4"/>
              <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Gain}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                         Visibility="{Binding Gain, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Ver detalhes" Style="{StaticResource Button.Ghost}" VerticalAlignment="Top" Margin="0,12,12,0"
                    Command="{Binding DetailsCommand}" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="action">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="kind" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="signal">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Signal}"/>
            <Setter TargetName="kind" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Bad}"/>
            <Setter TargetName="kind" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,22"/>

        <!-- ===== Destaque: o PC detectado ===== -->
        <Border Style="{StaticResource Panel.Hero}" Padding="0" ClipToBounds="True">
          <Grid>
            <Rectangle Fill="{StaticResource Brush.Graticule}" Opacity="0.35" IsHitTestVisible="False" RadiusX="10" RadiusY="10"/>
            <StackPanel Margin="28,22,28,22">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Brush.Signal}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                <TextBlock Text="Perfil detectado" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
              <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Readout}"/>
              <ItemsControl ItemsSource="{Binding ProfileChips}" ItemTemplate="{StaticResource A.Chip}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ProfileNotes}" Focusable="False" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===== Otimizar agora ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,16,0,0" Padding="24,20" BorderBrush="{StaticResource Brush.TraceLine}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,28,0" MinWidth="120">
              <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="ações no plano" Style="{StaticResource Text.MetricLabel}"/>
              <TextBlock Text="{Binding PlanState}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Otimizar agora" Style="{StaticResource Text.H1}"/>
              <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Text.Body}" Margin="0,4,0,10"/>
              <ItemsControl ItemsSource="{Binding PlanRows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Level}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="12,0,0,0"/>
                      <TextBlock Style="{StaticResource Text.Body}">
                        <Run Text="•" Foreground="{StaticResource Brush.Trace}"/>
                        <Run Text="{Binding Title, Mode=OneWay}"/>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PlanGains}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                         Visibility="{Binding PlanGains, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding PlanSkipped}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='Fora do plano: {0}'}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,10,0,0"
                         Text="Só entra o que tem risco baixo e não pede escolha. Você vê o plano e confirma antes; mudanças de sistema pedem permissão ao Windows e criam um ponto de restauração."/>
              <WrapPanel Margin="0,14,0,0">
                <Button Content="Otimizar agora" Style="{StaticResource Button.Primary}" Command="{Binding OptimizeCommand}" Margin="0,0,10,0"/>
                <Button Content="Desfazer tudo" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,0,10,0"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Conferir de novo" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshPlanCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding Result}" Style="{StaticResource Text.Small}" Margin="0,10,0,0"
                         Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,6,0,0"
                         Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===== Recomendações ===== -->
        <TextBlock Text="Recomendações para este PC" Style="{StaticResource Text.H1}" Margin="0,26,0,10"/>
        <TextBlock Text="Nenhuma recomendação agora." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                   Visibility="{Binding Recommendations.Count, Converter={StaticResource ZeroToVisible}}"/>
        <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource A.Recommendation}" Focusable="False"/>

        <StackPanel Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Conselhos de hardware" Style="{StaticResource Text.H1}" Margin="0,20,0,10"/>
          <ItemsControl ItemsSource="{Binding Advice}" ItemTemplate="{StaticResource A.Recommendation}" Focusable="False"/>
        </StackPanel>

        <StackPanel Visibility="{Binding HasAvoid, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Não recomendado para este PC" Style="{StaticResource Text.H1}" Margin="0,20,0,4"/>
          <TextBlock Text="Ajustes comuns em guias que, no seu PC, não ajudam ou atrapalham." Style="{StaticResource Text.Small}"
                     Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding AvoidList}" ItemTemplate="{StaticResource A.Recommendation}" Focusable="False"/>
        </StackPanel>

        <!-- ===== Verificação semanal ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,20,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Verificação semanal" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                         Text="Somente leitura: gera um relatório e não muda nada. O NEXUS nunca agenda mudanças; aplicar é sempre com você presente."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox ItemsSource="{x:Static vm:AutomationPage.ScheduleChoices}" SelectedItem="{Binding SelectedSchedule}" MinWidth="120" Margin="0,0,10,0"/>
              <ToggleButton IsChecked="{Binding ScheduleOn, Mode=OneWay}" Command="{Binding ToggleScheduleCommand}" MinWidth="110">
                <ToggleButton.Style>
                  <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Content" Value="Desligada"/>
                    <Style.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Content" Value="Ligada"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ToggleButton.Style>
              </ToggleButton>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
