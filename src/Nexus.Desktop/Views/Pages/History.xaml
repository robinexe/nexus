<!--
  Histórico: linha do tempo das execuções registradas no diário (aberto só para leitura) e, ao lado, o que aconteceu com cada
  ajuste da execução escolhida (estado, original → desejado, observado, nota). Recursos locais no DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:HistoryPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="His.Shown"/>
      <opt:EmptyToCollapsedConverter x:Key="His.ShownWhenEmpty" Invert="True"/>
      <opt:OutcomeTextConverter x:Key="His.StateText"/>
      <opt:OutcomeToneConverter x:Key="His.StateTone"/>

      <!-- Item da linha do tempo: sem caixa; selecionado ganha fundo mais alto. -->
      <Style x:Key="His.Item" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="10,0,12,0">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Nó da linha do tempo: vazado em ciano; preenchido em âmbar na execução escolhida. -->
      <Style x:Key="His.Node" TargetType="Ellipse">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Fill" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter Property="Fill" Value="{StaticResource Brush.Trace}"/>
            <Setter Property="Stroke" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Situação da execução: "não encerrada" em âmbar (ainda tem algo valendo). -->
      <Style x:Key="His.RunStatus" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Status}" Value="não encerrada">
            <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="His.State" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding State, Converter={StaticResource His.StateTone}}" Value="good">
            <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State, Converter={StaticResource His.StateTone}}" Value="bad">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State, Converter={StaticResource His.StateTone}}" Value="change">
            <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="His.Arrow" TargetType="Path">
        <Setter Property="Data" Value="M0,5 L16,5 M11,0 L16,5 L11,10"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0"/>
      </Style>
      <Style x:Key="His.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="His.ValueNext" TargetType="TextBlock" BasedOn="{StaticResource His.Value}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>
      <Style x:Key="His.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
    </DataTemplate.Resources>

    <Grid Margin="24,24,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Cabeçalho -->
      <StackPanel Grid.ColumnSpan="3">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Coordenação e diário -->
      <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel.Inset}" Margin="0,16,0,16" Padding="14,10">
        <StackPanel>
          <TextBlock Text="{Binding Coordination}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}"
                     Visibility="{Binding Coordination, Converter={StaticResource His.Shown}}"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                     Visibility="{Binding Status, Converter={StaticResource His.Shown}}"/>
        </StackPanel>
      </Border>

      <!-- ===== Linha do tempo ===== -->
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="{Binding RunsTitle}" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
        <Grid>
          <StackPanel Visibility="{Binding Runs, Converter={StaticResource His.ShownWhenEmpty}}">
            <TextBlock Text="Nada registrado ainda" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                       Text="Quando o serviço aplicar algo, cada execução aparece aqui com o que mudou e como desfazer."/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource His.Item}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Visibility="{Binding Runs, Converter={StaticResource His.Shown}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Trilho vertical contínuo entre os itens -->
                  <Rectangle Width="1" Fill="{StaticResource Brush.Line}" HorizontalAlignment="Center"/>
                  <Ellipse Style="{StaticResource His.Node}" VerticalAlignment="Top" Margin="0,16,0,0"/>
                  <StackPanel Grid.Column="1" Margin="8,12,0,12">
                    <TextBlock Text="{Binding Started}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource His.RunStatus}"/>
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}">
                      <Run Text="{Binding Profile, Mode=OneWay}"/>
                      <Run Text="com catálogo"/>
                      <Run Text="{Binding Catalog, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel>

      <!-- ===== Detalhe da execução ===== -->
      <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="360"
                      Visibility="{Binding Selected, Converter={StaticResource His.ShownWhenEmpty}}">
            <TextBlock Text="Escolha uma execução" Style="{StaticResource Text.H2}" TextAlignment="Center"/>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" TextAlignment="Center" Margin="0,6,0,0"
                       Text="Aqui aparece o que aconteceu com cada ajuste: o valor original, o desejado e o que foi lido por último."/>
          </StackPanel>

          <DockPanel Margin="22,20,22,12" Visibility="{Binding Selected, Converter={StaticResource His.Shown}}"
                     opt:Reveal.Trigger="{Binding Selected}">
            <StackPanel DockPanel.Dock="Top" DataContext="{Binding Selected}">
              <TextBlock Text="{Binding Started}" Style="{StaticResource Text.H1}" FontFamily="{StaticResource Font.Numbers}"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0">
                <Run Text="{Binding Status, Mode=OneWay}"/>
                <Run Text="com o perfil"/>
                <Run Text="{Binding Profile, Mode=OneWay}"/>
              </TextBlock>
              <TextBlock Text="{Binding RunId}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                         FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding EntriesTitle}" Style="{StaticResource Text.MetricLabel}" Margin="0,16,0,6"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,12"
                            opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock Text="{Binding Action}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}"/>
                          <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                                     FontFamily="{StaticResource Font.Numbers}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     ToolTip="{Binding Target}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding State, Converter={StaticResource His.StateText}}" Style="{StaticResource His.State}"/>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MaxWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="original" Style="{StaticResource His.Caption}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Original}" Style="{StaticResource His.Value}" ToolTip="{Binding Original}"/>
                          <Path Grid.Column="2" Style="{StaticResource His.Arrow}"/>
                          <TextBlock Grid.Column="3" Text="desejado" Style="{StaticResource His.Caption}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Desired}" Style="{StaticResource His.ValueNext}" ToolTip="{Binding Desired}"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                          <TextBlock Text="lido por último" Style="{StaticResource His.Caption}"/>
                          <TextBlock Text="{Binding Observed}" Style="{StaticResource His.Value}" Foreground="{StaticResource Brush.Text}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                   Visibility="{Binding Note, Converter={StaticResource His.Shown}}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
