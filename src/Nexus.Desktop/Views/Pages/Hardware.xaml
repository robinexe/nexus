<!--
  Hardware (design system v2, docs/10-design-system.md):
    1. Destaque: ilustração do PC, quantos valores foram lidos (conta), anel "lidos direto da fonte" e o atalho para o diagnóstico.
    2. Três cartões: lidos direto, deduzidos e sem leitura (com o motivo).
    3. Uma seção por peça (processador, vídeo, memória, discos…) com ícone, contagem e os valores; a fonte de cada valor fica
       na dica (passe o mouse) e em "De onde vêm estes valores?". Tabelas (módulos, discos, monitores) recolhidas.
  Somente leitura. O ViewModel só ganhou números/ícones para a apresentação (TotalFacts, DetectedPercent, IconKey…).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:HardwarePage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Pc}" Title="{l:T Pg.ValoresLidosSeuPc}"
                     Number="{Binding TotalFacts}" IsLoading="{Binding IsLoading}"
                     Caption="{l:T Pg.CadaValorDizOnde}"
                     ActionText="{l:T Nav.VerDiagnostico}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="DiagnosticsPage"
                     SecondaryText="{l:T Pg.VoltarMeuPc}" SecondaryCommand="{x:Static shell:ShellCommands.Navigate}" SecondaryCommandParameter="OverviewPage">
          <StackPanel Width="164">
            <c:RingMeter Value="{Binding DetectedPercent}" Label="{l:T Pg.LidosDireto}" Width="136" Height="136" Thickness="11" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:T Pg.DiretoFonteSemDeducao}" Style="{StaticResource Text.Small}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== Três números ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="150" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="3" Margin="-7,0,-7,8" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding DetectedNumber}" Tone="Info"
                      Label="{l:T Pg.LidosDiretoFonte}" Detail="{l:T Pg.WindowsDriversFirmwareInformaram}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Sparkle}" Number="{Binding InferredNumber}"
                      Label="{l:T Pg.Deduzidos}" Detail="{l:T Pg.CalculadosPartirOutrosValores}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Search}" Number="{Binding UnavailableNumber}"
                      Label="{l:T Pg.SemLeitura}" Detail="{l:T Pg.MotivoApareceProprioItem}"/>
        </UniformGrid>

        <!-- ===== Seções ===== -->
        <TextBlock Text="{l:T Pg.PecaPeca}" Style="{StaticResource Text.H2}" Margin="0,22,0,12" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"/>
        <c:SkeletonLoader Shape="Lines" Lines="8" Margin="4,16,4,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SectionViewModel}">
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14" Padding="20,16,20,12">
                <StackPanel>
                  <!-- Cabeçalho: distintivo + título + contagem -->
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" Margin="0,0,12,0">
                      <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                      <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </Grid>

                  <!-- Valores: rótulo · valor · selo. Fonte na dica; observação em 1 linha. -->
                  <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8" Background="Transparent">
                          <Border.ToolTip>
                            <TextBlock>
                              <Run Text="{l:T Pg.Fonte}"/> <Run Text="{Binding Source, Mode=OneWay}"/>
                            </TextBlock>
                          </Border.ToolTip>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="260"/>
                              <ColumnDefinition Width="5*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                              <TextBlock Text="{Binding Value, TargetNullValue=—}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}"
                                         Foreground="{StaticResource Brush.Text}"/>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                         ToolTip="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}" Margin="0,1,0,0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Tabelas (módulos de memória, discos, monitores…), recolhidas -->
                  <ItemsControl ItemsSource="{Binding Tables}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                          <Expander Header="{Binding Header}" Margin="-6,0,0,4">
                            <StackPanel Margin="6,4,0,6">
                              <DockPanel Margin="0,0,0,6">
                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center">
                                  <Run Text="{l:T Pg.Fonte}"/> <Run Text="{Binding Source, Mode=OneWay}"/>
                                </TextBlock>
                              </DockPanel>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Margin="0,0,0,6"
                                         Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                              <ListView ItemsSource="{Binding Rows}" v:TableColumns.Source="{Binding Columns}" MaxHeight="380"/>
                            </StackPanel>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <c:ExplainToggle Header="{l:T Pg.OndeVemEstesValores}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Sources}" Style="{StaticResource Text.Small}"/>
                  </c:ExplainToggle>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
