<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:HardwarePage}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Facts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="250"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ToolTip>
                              <TextBlock>
                                <Run Text="Fonte: "/><Run Text="{Binding Source, Mode=OneWay}"/>
                              </TextBlock>
                            </Grid.ToolTip>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Value, TargetNullValue=—}"/>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Tables}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Expander Header="{Binding Header}" Margin="0,10,0,0">
                            <StackPanel Margin="0,6,0,0">
                              <DockPanel Margin="0,0,0,4">
                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                                <TextBlock Style="{StaticResource Small}"><Run Text="Fonte: "/><Run Text="{Binding Source, Mode=OneWay}"/></TextBlock>
                              </DockPanel>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Margin="0,0,0,4" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                              <ListView ItemsSource="{Binding Rows}" v:TableColumns.Source="{Binding Columns}" MaxHeight="380"/>
                            </StackPanel>
                          </Expander>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
