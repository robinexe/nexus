<!--
  Comparar: sessões marcadas "antes" (ciano) contra "depois" (âmbar). O veredito vem primeiro, com peso; depois as curvas
  sobrepostas e uma linha por métrica. Recursos locais em DataTemplate.Resources; do tema, só as chaves do contrato.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:m="clr-namespace:Nexus.Desktop.Views.Measure">
  <DataTemplate DataType="{x:Type vm:ComparePage}">
    <DataTemplate.Resources>
      <m:BoolVisibilityConverter x:Key="C.Vis"/>
      <m:BoolVisibilityConverter x:Key="C.VisNot" Invert="True"/>

      <!-- Delta: verde se melhorou, vermelho se piorou, neutro sem diferença relevante. -->
      <Style x:Key="C.Delta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.H1}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Better}" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Better}" Value="False">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Selo "comprovado": só aparece quando o intervalo de confiança inteiro passou da diferença mínima. -->
      <Style x:Key="C.ProvenChip" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,1,9,2"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.TextMuted}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Better}" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Better}" Value="False">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Faixa lateral do veredito, na cor do resultado. -->
      <Style x:Key="C.ToneBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="Good">
            <Setter Property="Background" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Bad">
            <Setter Property="Background" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Manchete: tamanho de display quando há veredito; um degrau menor na prévia (texto mais longo). -->
      <Style x:Key="C.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="LineHeight" Value="40"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsPaired}" Value="False">
            <Setter Property="FontSize" Value="{StaticResource Size.H1}"/>
            <Setter Property="LineHeight" Value="32"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Uma barra proporcional: trilho escuro e preenchimento escalado pela razão (0..1). -->
      <Style x:Key="C.Track" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- Lista curta das sessões usadas de um lado. -->
      <DataTemplate x:Key="C.SessionLine">
        <DockPanel Margin="0,3">
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Small}" Margin="12,0,0,0" TextWrapping="NoWrap">
            <Run Text="{Binding AverageFpsText, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/><Run Text=" FPS"/>
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=", " Foreground="{StaticResource Brush.TextMuted}"/><Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
          </TextBlock>
        </DockPanel>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,18"/>

        <!-- Estado vazio: como chegar a uma comparação -->
        <Border Style="{StaticResource Panel.Hero}" Padding="28,26" Visibility="{Binding Ready, Converter={StaticResource C.VisNot}}">
          <StackPanel>
            <TextBlock Text="Nada para comparar ainda" Style="{StaticResource Text.Display}"/>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,22"
                       Text="Aqui as sessões de antes de uma mudança enfrentam as de depois, e o NEXUS diz se a diferença passa da variação normal entre partidas."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="1" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Display}"
                           Foreground="{StaticResource Brush.Signal}" Margin="0,-6,14,0"/>
                <StackPanel>
                  <TextBlock Text="Grave o antes" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Signal}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                             Text="Na página Medir, grave 3 sessões do mesmo jeito e use Marcar como antes em cada uma."/>
                </StackPanel>
              </DockPanel>
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Left" Text="2" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Display}"
                           Foreground="{StaticResource Brush.Trace}" Margin="0,-6,14,0"/>
                <StackPanel>
                  <TextBlock Text="Mude e grave o depois" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Trace}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                             Text="Faça a mudança que quer testar, grave mais 3 no mesmo mapa e use Marcar como depois."/>
                </StackPanel>
              </DockPanel>
              <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Left" Text="3" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Display}"
                           Foreground="{StaticResource Brush.Text}" Margin="0,-6,14,0"/>
                <StackPanel>
                  <TextBlock Text="Volte aqui" Style="{StaticResource Text.H2}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                             Text="O NEXUS compara sessão com sessão e diz se melhorou, piorou ou se é só variação."/>
                </StackPanel>
              </DockPanel>
            </Grid>
            <Border Style="{StaticResource Panel.Inset}" Margin="0,24,0,0" Padding="14,10">
              <TextBlock Style="{StaticResource Text.Small}">
                <Run Text="Marcadas agora:"/>
                <Run Text="{Binding BeforeCountText, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/><Run Text=" antes e "/><Run Text="{Binding AfterCountText, Mode=OneWay}" Foreground="{StaticResource Brush.Trace}"/><Run Text=" depois."/>
              </TextBlock>
            </Border>
          </StackPanel>
        </Border>

        <!-- Com antes e depois -->
        <StackPanel Visibility="{Binding Ready, Converter={StaticResource C.Vis}}">

          <!-- O veredito -->
          <Border Style="{StaticResource Panel.Hero}" Padding="0" Margin="0,0,0,20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource C.ToneBar}" CornerRadius="10,0,0,10"/>
              <StackPanel Grid.Column="1" Margin="24,22,28,24">
                <TextBlock Text="{Binding VerdictLabel}" Style="{StaticResource Text.MetricLabel}"/>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource C.Headline}" Margin="0,6,0,16"/>
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <Border Width="22" Height="2" Background="{StaticResource Brush.Signal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                      <Run Text="Antes" Foreground="{StaticResource Brush.Signal}"/>
                      <Run Text="{Binding BeforeCountText, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="2" Background="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                      <Run Text="Depois" Foreground="{StaticResource Brush.Trace}"/>
                      <Run Text="{Binding AfterCountText, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                    </TextBlock>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- As duas curvas no mesmo eixo -->
          <Border Style="{StaticResource Panel.Card}" Padding="20,18" Margin="0,0,0,20">
            <StackPanel>
              <TextBlock Text="Frametime, antes e depois" Style="{StaticResource Text.H2}"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,3,0,12"
                         Text="A primeira sessão de cada lado, no mesmo eixo: ciano é antes, âmbar é depois. Mais baixo e mais reto é melhor; picos são engasgos."/>
              <Border Style="{StaticResource Panel.Inset}" Padding="10,12,14,8">
                <m:FrametimeChart Height="280" Points="{Binding AfterTrace}" SecondaryPoints="{Binding BeforeTrace}"
                                  Stroke="{StaticResource Brush.Trace}" SecondaryStroke="{StaticResource Brush.Signal}"
                                  GridBrush="{StaticResource Brush.Line}" LabelBrush="{StaticResource Brush.TextDim}"
                                  ToolTip="Tempo de cada quadro, em milissegundos. As linhas tracejadas marcam 60, 144 e 240 FPS. Triângulos no topo são picos acima da escala."/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Métrica por métrica -->
          <TextBlock Text="Métrica por métrica" Style="{StaticResource Text.H2}" Margin="2,0,0,10"/>
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10" Padding="20,16" ToolTip="{Binding Explanation}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Antes e depois, com barras proporcionais (o maior dos dois ocupa a barra inteira) -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Antes" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding BeforeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                 Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Border Grid.Column="2" Style="{StaticResource C.Track}">
                        <Border Background="{StaticResource Brush.Signal}" CornerRadius="2" RenderTransformOrigin="0,0.5" Opacity="0.85">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding BeforeRatio, Mode=OneWay}"/>
                          </Border.RenderTransform>
                        </Border>
                      </Border>

                      <TextBlock Grid.Row="1" Text="Depois" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AfterText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                 Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,0"/>
                      <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource C.Track}" Margin="0,8,0,0">
                        <Border Background="{StaticResource Brush.Trace}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                          <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding AfterRatio, Mode=OneWay}"/>
                          </Border.RenderTransform>
                        </Border>
                      </Border>
                    </Grid>

                    <!-- Diferença e selo -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                      <TextBlock Text="{Binding DeltaText}" Style="{StaticResource C.Delta}"/>
                      <Border Style="{StaticResource C.ProvenChip}" Visibility="{Binding Proven, Converter={StaticResource C.Vis}}"
                              ToolTip="O intervalo de confiança de 95% inteiro passou da diferença mínima que importa: não é variação normal.">
                        <TextBlock Text="comprovado" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.Text}"/>
                      </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Sentence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                               Margin="0,12,0,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Sessões usadas -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel.Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,6">
                  <Run Text="Antes" Foreground="{StaticResource Brush.Signal}"/>
                  <Run Text="{Binding BeforeCountText, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Before}" ItemTemplate="{StaticResource C.SessionLine}" Focusable="False"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,6">
                  <Run Text="Depois" Foreground="{StaticResource Brush.Trace}"/>
                  <Run Text="{Binding AfterCountText, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding After}" ItemTemplate="{StaticResource C.SessionLine}" Focusable="False"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Método -->
          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="2,16,0,0">
            <Run Text="Como o NEXUS calculou:" Foreground="{StaticResource Brush.TextMuted}"/>
            <Run Text="{Binding Method, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
