<!--
  Verificar arquivos (design system v2, docs/10-design-system.md):
    1. Destaque: lupa sobre documento, "arquivos verificados" contando durante a verificação, achados e arquivos/s à direita;
       ação principal "Verificação rápida".
    2. Progresso (tempo, barra, arquivo atual) e Desfazer do último isolamento.
    3. Como funciona: Lê → Pontua → Confirma (Defender) → Isola/Desfaz.
    4. Modos como cartões: completa (unidades), pasta/arquivos, ao vivo em Downloads; o motor em três números.
    5. Resultados agrupados por gravidade (cartões com selo e barra de pontos; o porquê de cada sinal recolhido), estados vazios.
  Leitura local; a única escrita (isolar, reversível) passa pelo aplicador via Host.ApplyAsync.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:ScannerPage}">
    <DataTemplate.Resources>
      <Style x:Key="Sc.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      </Style>
      <Style x:Key="Sc.Action" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>

      <!-- Distintivo redondo na cor do tom. -->
      <DataTemplate x:Key="Sc.Badge">
        <Grid Width="36" Height="36">
          <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="18"
                  Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
        </Grid>
      </DataTemplate>

      <!-- Cartão de modo: distintivo, título, frase curta; o conteúdo vem embaixo. -->
      <Style x:Key="Sc.ModeTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="Margin" Value="0,10,0,2"/>
      </Style>

      <!-- Um arquivo apontado: seleção, nome, pasta, selo com o veredito, barra de pontos, ações; sinais em "Por que isso?". -->
      <DataTemplate x:Key="Sc.FileRow" DataType="{x:Type vm:ScanFindingRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,11,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanQuarantine, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,0,0"
                      AutomationProperties.Name="{Binding FileName, StringFormat={l:T Scan.MarcarIsolarN}}" ToolTip="{l:T Scan.MarcarIsolarQuarentenaNexus}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/>
              <TextBlock Text="{Binding Folder}" Style="{StaticResource Sc.Code}" Margin="0,2,0,0" ToolTip="{Binding Folder}"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,3,0,0"/>
              <c:ExplainToggle Header="{l:T Scan.Apareceu}" Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding Hits}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScanHitRow}">
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PointsText}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                            <Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" · " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding Layer, Mode=OneWay}" Foreground="{StaticResource Brush.TextDim}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </c:ExplainToggle>
              <WrapPanel Margin="-8,4,0,0">
                <Button Style="{StaticResource Sc.Action}" Command="{Binding DefenderCommand}">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Security}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:T Scan.VerificarDefender}" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
                <Button Content="{l:T Disk.MostrarExplorer}" Style="{StaticResource Sc.Action}" Command="{Binding ExplorerCommand}"/>
                <Button Content="{l:T Scan.PropriedadesAssinatura}" Style="{StaticResource Sc.Action}" Command="{Binding PropertiesCommand}"/>
                <Button Style="{StaticResource Sc.Action}" Command="{Binding QuarantineCommand}">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Quarantine}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:T Scan.Isolar}" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
                <Button Content="{l:T Scan.Ignorar}" Style="{StaticResource Sc.Action}" Command="{Binding IgnoreCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,4,0,0"
                         Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Width="132" HorizontalAlignment="Right">
              <c:StatusChip Tone="{Binding Tone}" Text="{Binding VerdictText}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource Font.Numbers}" FontSize="18" HorizontalAlignment="Right" Margin="0,8,0,0"
                         Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScorePercent, Mode=OneWay}" Height="4" Margin="0,4,0,0"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                           AutomationProperties.Name="{Binding ScoreText, StringFormat={l:T Scan.PontosSuspeitaN}}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Scanner}" Title="{l:T Scan.ArquivosVerificados}"
                     Number="{Binding ScannedFiles}"
                     Caption="{l:T Scan.SoLeSuspeitoNao}"
                     ActionText="{l:T Sec.VerificacaoRapida}" Command="{Binding QuickScanCommand}"
                     SecondaryText="{l:T Sec.VerificarPasta}" SecondaryCommand="{Binding FolderScanCommand}">
          <StackPanel MinWidth="190">
            <TextBlock Text="{l:T Scan.AchadosRevisar}" Style="{StaticResource Text.Small}"/>
            <c:AnimatedNumber Value="{Binding FindingNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="30"
                              Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="{l:T Scan.Velocidade}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>
            <c:AnimatedNumber Value="{Binding FilesPerSecond}" Decimals="0" Suffix="{l:T Scan.ArquivosS}" FontFamily="{StaticResource Font.Numbers}" FontSize="18"
                              Foreground="{StaticResource Brush.Signal}"/>
            <Button Content="{l:T Scan.PararVerificacao}" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                    Margin="-8,6,0,0" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Progresso ===== -->
        <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,14" Visibility="{Binding ScanStatus, Converter={StaticResource NullToCollapsed}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Scan}" Size="17" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding FilesText}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Font.Numbers}" FontSize="24" Foreground="{StaticResource Brush.Trace}"
                           HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                <TextBlock Text="{l:T Sec.Tempo}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Foreground="{StaticResource Brush.Signal}"
                         Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{l:T Sec.VerificacaoAndamento}"/>
            <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource Sc.Code}" Margin="0,8,0,0" ToolTip="{Binding CurrentFile}"
                       Visibility="{Binding CurrentFile, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </Border>

        <!-- Desfazer o último isolamento -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Quarantine}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{l:T Scan.ArquivosIsoladosQuarentenaNexus}" Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{l:T Shell.Desfazer}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 3. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Pg.Le}" Text="{l:T Scan.AbreCadaArquivoSo}"/>
              <c:StepItem Icon="{StaticResource Icon.Warning}" Title="{l:T Scan.Pontua}" Text="{l:T Scan.SinaisSuspeitosSomamPontos}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Security}" Title="{l:T Settings.Confirma}" Text="{l:T Scan.PecaOpiniaoMicrosoftDefender}"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Scan.Isola}" Text="{l:T Scan.IsolarGuardarNaoApagar}" Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="{l:T Scan.MicrosoftDefenderSuaProtecao}"/>
          </StackPanel>
        </Border>

        <!-- ===== 4. Modos ===== -->
        <TextBlock Text="{l:T Scan.OutrasFormasVerificar}" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <UniformGrid Columns="3" Margin="-7,0,-7,16">
          <!-- Completa -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="{l:T Sec.VerificacaoCompleta}" Command="{Binding FullScanCommand}" Style="{StaticResource Button.Secondary}"
                      HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <StackPanel>
                <Grid Width="38" Height="38" HorizontalAlignment="Left">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Disk}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l:T Scan.Completa}" Style="{StaticResource Sc.ModeTitle}"/>
                <TextBlock Text="{l:T Scan.UnidadesMarcadasPodeLevar}" Style="{StaticResource Text.Small}"/>
                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,8,0,0" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScanDriveRow}">
                      <CheckBox Content="{Binding Root}" IsChecked="{Binding IsSelected}" Margin="0,0,14,4"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Pasta ou arquivos -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="{l:T Scan.Pasta}" Command="{Binding FolderScanCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                <Button Content="{l:T Scan.Arquivos}" Command="{Binding FileScanCommand}" Style="{StaticResource Button.Secondary}"/>
              </WrapPanel>
              <StackPanel>
                <Grid Width="38" Height="38" HorizontalAlignment="Left">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Page}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{l:T Scan.PastaOuArquivos}" Style="{StaticResource Sc.ModeTitle}"/>
                <TextBlock Text="{l:T Scan.BaixouAlgoFicouDuvida}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- Ao vivo -->
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <StackPanel>
              <Grid Width="38" Height="38" HorizontalAlignment="Left">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Bolt}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{l:T Scan.VivoDownloads}" Style="{StaticResource Sc.ModeTitle}"/>
              <TextBlock Text="{l:T Scan.VerificaCadaArquivoNovo}" Style="{StaticResource Text.Small}"/>
              <CheckBox IsChecked="{Binding LiveWatch}" Content="{l:T Scan.VigiarDownloads}" Margin="0,10,0,0"/>
              <TextBlock Text="{Binding LiveText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"
                         Visibility="{Binding LiveText, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <c:ExplainToggle Header="{l:T Scan.VerificacaoRapidaOlha}" Margin="0,0,0,16"
                         Content="{l:T Scan.RapidaDownloadsAreaTrabalho}"/>

        <!-- Motor: três números -->
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="150" Margin="0,0,0,16" Visibility="{Binding EngineLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="3" Margin="-7,0,-7,8" Visibility="{Binding EngineLoading, Converter={StaticResource FalseToVisible}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Code}" Number="{Binding RuleCount}" Label="{l:T Scan.RegrasPadrao}"
                      Detail="{l:T Scan.TecnicasComunsMalwareConferidas}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Catalog}" Number="{Binding HashCount}" Label="{l:T Scan.HashesImportados}"
                      Detail="{l:T Scan.ListasVoceTrouxeNada}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding IgnoreCount}" Label="{l:T Scan.Excecoes}"
                      Detail="{l:T Scan.ArquivosVoceMandouIgnorar}"/>
        </UniformGrid>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Left" Command="{Binding ImportHashesCommand}" Style="{StaticResource Button.Ghost}" Margin="-8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="{l:T Scan.ImportarListaHashes}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Left" Command="{Binding ImportRulesCommand}" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="{l:T Scan.ImportarRegras}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <c:ExplainToggle Header="{l:T Scan.DetalhesMotor}" Margin="12,0,0,0" Content="{Binding DatabaseText}"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Notice}" Padding="10,6" Margin="0,0,0,6">
                <DockPanel>
                  <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5. Resultados ===== -->
        <Grid Margin="0,12,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l:T Scan.Resultados}" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding QuarantineSelectedCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Quarantine}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{l:T Scan.IsolarSelecionados}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Button Content="{l:T Scan.LimparLista}" Style="{StaticResource Button.Ghost}" Command="{Binding ClearResultsCommand}"/>
          </StackPanel>
        </Grid>

        <c:EmptyState Illustration="{StaticResource Illo.Scanner}" Text="{l:T Scan.NenhumaVerificacaoAinda}"
                      Detail="{l:T Scan.ComecePelaRapidaOlha}"
                      ActionText="{l:T Sec.VerificacaoRapida}" Command="{Binding QuickScanCommand}"
                      Visibility="{Binding ShowNeverScanned, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="{l:T Scan.NenhumSinalSuspeito}"
                      Detail="{l:T Scan.UltimaVerificacaoNaoAchou}"
                      Visibility="{Binding ShowClean, Converter={StaticResource BoolToVis}}"/>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ScanFindingGroup}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Sc.Badge}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontFamily="{StaticResource Font.Numbers}" FontSize="26" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Sc.FileRow}" Focusable="False"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
