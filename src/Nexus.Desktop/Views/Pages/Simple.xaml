<!--
  Modo simples (pedido: "facilitar a vida do usuário leigo"). Seis telas, uma ideia cada, palavras simples, no máximo uma
  frase por elemento, letra maior e espaço de sobra. O único elemento marcante é o anel da saúde no Início; o resto é quieto.
    Início ....... anel com a palavra ("Seu PC está ótimo / pode melhorar / precisa de atenção"), UM botão "Otimizar meu PC com
                   segurança", no máximo 3 cartões "O que dá para melhorar" (frase + botão), "Tudo pode ser desfeito".
    Otimizar ..... antes: 4 itens e "Começar"; durante: anel do andamento e o item atual; depois: resumo, "Ver detalhes",
                   "Desfazer tudo". (Assistente completo no modo automático: AssistantPage.RunAutomaticAsync.)
    Limpar ....... "X GB podem ser liberados" + "Limpar agora"; lista só em "Ver o que será limpo".
    Jogos ........ cartão por jogo: "Medir FPS" e só as opções que valem para ele, em palavras simples.
    Problemas .... o que precisa de você, com "O que fazer"; o que está bem fica recolhido.
    Histórico .... "Hoje 14:30 — Limpeza: 12 itens limpos — Desfazer" e "Desfazer tudo".
  Lógica: ViewModels/Simple/SimplePages.cs (vitrines) e SimpleLogic.cs (pura, testada).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:sv="clr-namespace:Nexus.Desktop.ViewModels.Simple"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">

  <!-- ===== Estilos do modo simples (letra maior, mais ar) ===== -->
  <Style x:Key="S.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="LineHeight" Value="40"/>
  </Style>
  <Style x:Key="S.Lead" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
  </Style>
  <Style x:Key="S.Item" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="S.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
    <Setter Property="FontSize" Value="19"/>
    <Setter Property="Margin" Value="0,36,0,14"/>
  </Style>
  <Style x:Key="S.Card" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
    <Setter Property="Padding" Value="22,18"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="S.Big" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Padding" Value="26,14"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="S.Message" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.SignalSoft}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
  </Style>

  <!-- Célula clicável da faixa "Situação" do Início: ocupa a célula, lavagem leve no hover, divisória fina à direita. -->
  <Style x:Key="S.StripButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.LineSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="24,18"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>

  <!-- Botão de um clique com o resultado no lugar: [Ação] → "Aplicando…" → "✓ Feito — Desfazer". -->
  <DataTemplate x:Key="S.OneClick" DataType="{x:Type sv:OneClickAction}">
    <Grid VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,10,0"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource Button.Secondary}" Margin="0" MinWidth="110" Content="{Binding ActionText}" Command="{Binding ApplyCommand}"/>
      </StackPanel>
      <TextBlock Text="{l:T Simple.One.Working}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.LiveSetting="Polite">
        <c:Icon Data="{StaticResource Icon.Check}" Size="17" Foreground="{StaticResource Brush.Good}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Body}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Good}" VerticalAlignment="Center"/>
        <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.One.Undo}" Command="{Binding UndoCommand}" Margin="8,0,0,0"
                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
        <!-- Ligada junto com outras coisas: o desfazer fica no Histórico -->
        <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.One.InHistory}" Margin="8,0,0,0"
                Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="SimpleHistoryPage"
                Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- ================================================================== INÍCIO
       "Instrumento de precisão" (docs/14-redesign-brief.md): à esquerda a saúde em uma palavra e as 3 ações (Otimizar, Preparar
       para jogar, Desfazer); à direita o painel "Seu PC agora" ao vivo (ViewModels/Simple/HomeLive.cs); embaixo a faixa
       "Situação" e no máximo 3 melhorias numa lista só. -->
  <DataTemplate DataType="{x:Type sv:HomePage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <c:TwoUpPanel Ratio="0.40" Gap="24" StackBelow="940">
          <!-- Saúde e ações -->
          <Border Style="{StaticResource Panel.Card}" Padding="32,28">
            <StackPanel>
              <DockPanel>
                <Grid Width="112" Height="112" DockPanel.Dock="Left" Margin="0,0,22,0" AutomationProperties.Name="{Binding Headline}">
                  <Ellipse Stroke="{StaticResource Brush.Track}" StrokeThickness="8" Margin="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                  <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <c:ProcessRing Value="{Binding Score}" IsActive="False" Tone="{Binding Tone}" Thickness="8"/>
                    <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource Font.Numbers}" FontSize="30" Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Live.Health}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextDim}"/>
                  <TextBlock Text="{Binding Word}" FontFamily="{StaticResource Font.Display}" FontSize="40" Margin="0,2,0,0" TextWrapping="Wrap"
                             Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Body}" FontSize="16" LineHeight="24" Foreground="{StaticResource Brush.TextSoft}"
                         Margin="0,22,0,24" AutomationProperties.LiveSetting="Polite"/>
              <WrapPanel>
                <Button Style="{StaticResource S.Big}" Command="{Binding OptimizeCommand}" Margin="0,0,12,12" AutomationProperties.Name="{l:T Simple.Home.Optimize}"
                        ToolTip="{l:T Simple.Home.Optimize}">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Bolt}" Size="18" Margin="0,0,10,0"/>
                    <TextBlock Text="{l:T Home.OptimizeShort}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Padding="18,13" Margin="0,0,12,12"
                        Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="SimpleGamesPage" ToolTip="{l:T Home.PlayReadyTip}">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Games}" Size="18" Margin="0,0,10,0"/>
                    <TextBlock Text="{l:T Home.PlayReady}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
              <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,0,0,0"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="SimpleHistoryPage">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Undo}" Size="15" Margin="0,0,8,0"/>
                  <TextBlock Text="{l:T Home.UndoChanges}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Seu PC agora (ao vivo) -->
          <Border Style="{StaticResource Panel.Instrument}" DataContext="{Binding Live}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{l:T Live.Details}" Margin="0,-6,-8,0"
                        Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MonitorPage"/>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Good}" VerticalAlignment="Center" Margin="0,1,9,0"
                           c:Pulse.IsOn="{Binding IsReady}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{l:T Live.Title}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>

              <TextBlock Text="{l:T Live.Unavailable}" Style="{StaticResource Text.Small}" Margin="0,0,0,12"
                         Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.1*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Processador -->
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="156" Height="156">
                    <c:Gauge Value="{Binding CpuPercent}" Thickness="9" Label="{l:T Live.Cpu}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <c:SkeletonLoader Shape="Lines" Lines="1" Width="56" Visibility="{Binding IsWarmingUp, Converter={StaticResource BoolToVis}}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Font.Numbers}" FontSize="40" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                        <TextBlock Text="%" FontFamily="{StaticResource Font.Numbers}" FontSize="18" Foreground="{StaticResource Brush.TextMuted}" Margin="2,0,0,7" VerticalAlignment="Bottom"/>
                      </StackPanel>
                      <TextBlock Text="{Binding CpuDetail}" FontFamily="{StaticResource Font.Numbers}" FontSize="13.5" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{l:T Live.Cpu}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding CpuName}"/>
                  <TextBlock Text="{Binding CpuSentence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextSoft}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="170" Margin="0,6,0,0"
                             AutomationProperties.LiveSetting="Off"/>
                </StackPanel>

                <!-- Memória e disco -->
                <StackPanel Grid.Column="1" Margin="12,8,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{l:T Live.Ram}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding RamUsed}" FontFamily="{StaticResource Font.Numbers}" FontSize="26" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding RamTotal}" FontFamily="{StaticResource Font.Numbers}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" Margin="4,0,0,4" VerticalAlignment="Bottom" TextWrapping="NoWrap"/>
                  </StackPanel>
                  <Grid Height="6" Margin="0,8,0,8">
                    <Border Background="{StaticResource Brush.Track}" CornerRadius="3"/>
                    <Border x:Name="RamBar" CornerRadius="3" RenderTransformOrigin="0,0.5"
                            RenderTransform="{Binding RamFraction, Converter={StaticResource FractionScale}}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource Brush.Signal}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding RamWarn}" Value="True">
                              <Setter Property="Background" Value="{StaticResource Brush.Trace}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                  </Grid>
                  <TextBlock x:Name="RamSentence" Text="{Binding RamSentence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextSoft}"/>
                  <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,16"/>
                  <TextBlock Text="{l:T Live.Disk}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding DiskFree}" FontFamily="{StaticResource Font.Numbers}" FontSize="26" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                    <TextBlock Text="{l:T Live.Disk.FreeUnit}" FontFamily="{StaticResource Font.Numbers}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" Margin="4,0,0,4" VerticalAlignment="Bottom" TextWrapping="NoWrap"/>
                  </StackPanel>
                  <Grid Height="6" Margin="0,8,0,8">
                    <Border Background="{StaticResource Brush.Track}" CornerRadius="3"/>
                    <Border x:Name="DiskBar" CornerRadius="3" RenderTransformOrigin="0,0.5"
                            RenderTransform="{Binding DiskUsedFraction, Converter={StaticResource FractionScale}}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource Brush.Signal}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DiskWarn}" Value="True">
                              <Setter Property="Background" Value="{StaticResource Brush.Trace}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextSoft}">
                    <Run Text="{Binding DiskSentence, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding DiskTotal, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                  </TextBlock>
                </StackPanel>

                <!-- Placa de vídeo -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                  <Grid Width="156" Height="156">
                    <c:Gauge Value="{Binding GpuPercent}" Thickness="9" Label="{l:T Live.Gpu}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <c:SkeletonLoader Shape="Lines" Lines="1" Width="56" Visibility="{Binding IsWarmingUp, Converter={StaticResource BoolToVis}}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding GpuText}" FontFamily="{StaticResource Font.Numbers}" FontSize="40" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                        <TextBlock Text="%" FontFamily="{StaticResource Font.Numbers}" FontSize="18" Foreground="{StaticResource Brush.TextMuted}" Margin="2,0,0,7" VerticalAlignment="Bottom"/>
                      </StackPanel>
                      <TextBlock Text="{Binding GpuDetail}" FontFamily="{StaticResource Font.Numbers}" FontSize="13.5" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{l:T Live.Gpu}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  <TextBlock Text="{Binding GpuName}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GpuName}"/>
                  <TextBlock Text="{Binding GpuSentence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextSoft}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="170" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>

              <DockPanel Margin="0,18,0,0">
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="{l:T Live.CpuTempNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </c:TwoUpPanel>

        <!-- Situação: 4 leituras curtas, cada uma abre a página que explica -->
        <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,24,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="{l:T Live.Strip.Title}">
          <ItemsControl ItemsSource="{Binding Strip}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sv:StatusItem}">
                <Button Style="{StaticResource S.StripButton}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Page}"
                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Detail}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="V" Text="{Binding Value}" FontFamily="{StaticResource Font.Display}" FontSize="16" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,4"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsGood}" Value="True">
                    <Setter TargetName="V" Property="Foreground" Value="{StaticResource Brush.Good}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter TargetName="V" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- O que pode melhorar: no máximo 3, numa lista só (uma frase e um botão por linha). -->
        <TextBlock Text="{l:T Simple.Home.Improve}" Style="{StaticResource S.Section}" Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}"/>
        <Border Style="{StaticResource Panel.Card}" Padding="0" Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" AlternationCount="100">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sv:ImproveCardRow}">
                <Border x:Name="Row" Padding="24,18" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0">
                  <StackPanel>
                    <DockPanel>
                      <Grid Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,18,0">
                        <Border CornerRadius="10" Background="{StaticResource Brush.TraceSoft}"/>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ContentControl Content="{Binding OneClick}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"
                                        Visibility="{Binding IsOneClick, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource Button.Secondary}" Margin="0" Content="{Binding ActionText}" MinWidth="110"
                                Command="{Binding OpenCommand}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource Button.Secondary}" Margin="0" Content="{Binding ActionText}" MinWidth="110"
                                Command="{Binding ToggleHowToCommand}" Visibility="{Binding IsHowTo, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Text}" Style="{StaticResource S.Item}" FontSize="15.5" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding HowTo}" Style="{StaticResource S.Lead}" FontSize="14" Margin="58,10,0,0"
                               Visibility="{Binding ShowHowTo, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="{l:T Simple.Home.NothingToDo}" Detail="{l:T Simple.Home.NothingToDoDetail}"
                      Margin="0,30,0,0" Visibility="{Binding NoCards, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- ================================================================== OTIMIZAR (NEXUS Optimize)
       Antes: o que vai acontecer (4 etapas), a promessa de segurança e "Começar"; a Varredura parada ao lado.
       Durante: a Varredura girando (c:ScanSweep) — cada ponto só acende quando a etapa termina — e a lista do que acontece.
       Depois: o resumo, a saúde nova, "Ver detalhes", "Desfazer tudo" e o convite para medir (nunca uma promessa de FPS). -->
  <DataTemplate DataType="{x:Type sv:SimpleOptimizePage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource S.Message}" Visibility="{Binding Assistant.Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Assistant.Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <TextBlock Text="{l:T Opt.Brand}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Trace}" Margin="0,0,0,6"/>

        <!-- Antes -->
        <c:TwoUpPanel Ratio="0.48" Gap="32" StackBelow="900" Visibility="{Binding Assistant.AutoIdle, Converter={StaticResource BoolToVis}}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:T Simple.Home.Optimize}" Style="{StaticResource S.Title}"/>
            <TextBlock Text="{l:T Simple.Opt.Lead}" Style="{StaticResource S.Lead}" Margin="0,8,0,24"/>
            <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,0,0,20">
              <ItemsControl ItemsSource="{Binding Phases}" Focusable="False" AlternationCount="100">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sv:OptimizePhaseRow}">
                    <Border x:Name="Row" Padding="20,14" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0">
                      <DockPanel>
                        <Grid Width="36" Height="36" Margin="0,0,16,0">
                          <Border CornerRadius="9" Background="{StaticResource Brush.SignalSoft}"/>
                          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="18" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource S.Item}" FontSize="15.5"/>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
              <c:Icon Data="{StaticResource Icon.Lock}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T Simple.Opt.Safe}" Style="{StaticResource S.Lead}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource S.Big}" MinWidth="220" Command="{Binding Assistant.StartAutoCommand}" AutomationProperties.Name="{l:T Simple.Opt.Start}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Bolt}" Size="18" Margin="0,0,10,0"/>
                <TextBlock Text="{l:T Simple.Opt.Start}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Style="{StaticResource Panel.Instrument}" Padding="12,24">
            <c:ScanSweep Items="{Binding Phases}" IsActive="False" Height="380" AutomationProperties.Name="{l:T Opt.SweepName}"/>
          </Border>
        </c:TwoUpPanel>

        <!-- Durante: a Varredura -->
        <StackPanel Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{l:T Simple.Opt.Working}" Style="{StaticResource S.Title}"/>
          <TextBlock Text="{l:T Simple.Opt.WorkingLead}" Style="{StaticResource S.Lead}" Margin="0,8,0,24"/>
          <c:TwoUpPanel Ratio="0.58" Gap="32" StackBelow="900">
            <Border Style="{StaticResource Panel.Instrument}" Padding="12,24">
              <Grid>
                <c:ScanSweep Items="{Binding Phases}" IsActive="{Binding Running}" Height="400" AutomationProperties.Name="{l:T Opt.SweepName}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <c:AnimatedNumber Value="{Binding Percent}" Kind="Percent" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="56"
                                    Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"
                             TextAlignment="Center" MaxWidth="160" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{l:T Opt.Happening}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding Phases}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sv:OptimizePhaseRow}">
                    <DockPanel Margin="0,0,0,16">
                      <Grid Width="32" Height="32" Margin="0,0,14,0" c:Pulse.IsOn="{Binding IsCurrent}">
                        <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                        <c:Icon Data="{Binding StateIcon, Converter={StaticResource ResourceByKey}}" Size="16" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                HorizontalAlignment="Center"/>
                      </Grid>
                      <TextBlock x:Name="T" Text="{Binding Title}" Style="{StaticResource S.Item}" FontSize="15.5" Foreground="{StaticResource Brush.TextDim}"/>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Brush.Text}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Style="{StaticResource Panel.Notice}" Margin="0,6,0,0" Visibility="{Binding Assistant.ProcessView.IsWaiting, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T Simple.Opt.AnswerWindows}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              </Border>
              <DockPanel Margin="0,10,0,0">
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="{l:T Opt.NoInterrupt}" Style="{StaticResource Text.Small}"/>
              </DockPanel>
            </StackPanel>
          </c:TwoUpPanel>
        </StackPanel>

        <!-- Depois: resumo curto -->
        <Border Style="{StaticResource Panel.Card}" Padding="32,28" Visibility="{Binding Assistant.AutoDone, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Grid Width="72" Height="72" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,24,0">
              <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
              <c:Icon Data="{StaticResource Icon.Check}" Size="32" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel>
              <TextBlock Text="{Binding Assistant.AutoSummary}" Style="{StaticResource S.Title}" FontSize="30" AutomationProperties.LiveSetting="Assertive"/>
              <TextBlock Text="{Binding Home.Headline}" FontFamily="{StaticResource Font.Display}" FontSize="20" Margin="0,8,0,12"
                         Foreground="{Binding Home.Tone, Converter={StaticResource ToneBrush}}"/>
              <!-- A conta completa: o número grande é só o que mudou agora; aqui fica claro que tudo foi conferido. -->
              <StackPanel DataContext="{Binding Assistant.AutoTally}" Margin="0,0,0,20"
                          Visibility="{Binding Checked, Converter={StaticResource ZeroToVisible}, ConverterParameter=invert}">
                <WrapPanel Margin="0,0,0,12">
                  <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Margin="0,0,10,10" MinWidth="150">
                    <StackPanel>
                      <TextBlock Text="{Binding Applied}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Good}"/>
                      <TextBlock Text="{l:T Simple.Opt.TallyNow}" Style="{StaticResource Text.MetricLabel}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Margin="0,0,10,10" MinWidth="150">
                    <StackPanel>
                      <TextBlock Text="{Binding Already}" Style="{StaticResource Text.Metric}"/>
                      <TextBlock Text="{l:T Simple.Opt.TallyAlready}" Style="{StaticResource Text.MetricLabel}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Margin="0,0,10,10" MinWidth="150">
                    <StackPanel>
                      <TextBlock Text="{Binding NotHere}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.TextMuted}"/>
                      <TextBlock Text="{l:T Simple.Opt.TallyNotHere}" Style="{StaticResource Text.MetricLabel}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Margin="0,0,10,10" MinWidth="150"
                          Visibility="{Binding HasFailed, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding Failed}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Bad}"/>
                      <TextBlock Text="{l:T Simple.Opt.TallyFailed}" Style="{StaticResource Text.MetricLabel}"/>
                    </StackPanel>
                  </Border>
                </WrapPanel>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource S.Lead}" FontSize="14" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource S.Lead}" FontSize="14" Margin="0,4,0,0"/>
              </StackPanel>
              <TextBlock Text="{l:T Opt.MeasureInvite}" Style="{StaticResource S.Lead}" FontSize="14" Margin="0,0,0,24"/>
              <WrapPanel>
                <Button Style="{StaticResource S.Big}" Content="{l:T Simple.Opt.BackHome}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="HomePage"
                        Margin="0,0,10,10"/>
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Opt.MeasureNow}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                        Padding="18,12" Margin="0,0,10,10"/>
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Simple.Opt.Details}" Command="{Binding Assistant.OpenReportCommand}" Padding="18,12" Margin="0,0,10,10"/>
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding Assistant.UndoAllCommand}" Padding="12,12" Margin="0,0,10,10">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Undo}" Size="16" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T Simple.Opt.UndoAll}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Ajustes rápidos: um a um, ligar aplica e desligar desfaz (some enquanto a rodada automática trabalha). -->
        <StackPanel DataContext="{Binding QuickTweaks}" Margin="0,8,0,0"
                    Visibility="{Binding DataContext.Running, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource FalseToVisible}}">
          <TextBlock Text="{l:T Simple.Quick.Title}" Style="{StaticResource S.Section}"/>
          <TextBlock Text="{l:T Simple.Quick.Lead}" Style="{StaticResource S.Lead}" FontSize="15" Margin="0,-6,0,16"/>
          <TextBlock Text="{l:T Simple.Quick.Empty}" Style="{StaticResource S.Lead}" FontSize="15" Visibility="{Binding HasAny, Converter={StaticResource FalseToVisible}}"/>
          <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sv:QuickTweakGroup}">
                <Border Style="{StaticResource S.Card}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type sv:QuickTweakRow}">
                          <DockPanel Margin="0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Good}" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                              <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Title}"/>
                            </StackPanel>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                              <TextBlock Text="{Binding Sentence}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" Visibility="{Binding HasSentence, Converter={StaticResource BoolToVis}}"/>
                              <WrapPanel Margin="0,8,0,0">
                                <c:StatusChip Tone="Good" Text="{Binding RiskText}" Margin="0,0,8,0" Visibility="{Binding ShowRisk, Converter={StaticResource FalseToVisible}}"/>
                                <c:StatusChip Tone="Warn" Text="{Binding RiskText}" Margin="0,0,8,0" Visibility="{Binding ShowRisk, Converter={StaticResource BoolToVis}}"/>
                                <c:StatusChip Tone="Info" Text="{l:T Opt.Row.Undo}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                              </WrapPanel>
                              <!-- Recomendação por hardware: "Recomendado para o seu PC: …" (discreto) -->
                              <c:StatusChip Tone="Good" Text="{Binding FitNote}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding HasFitNote, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,4,0,0" Content="{Binding MoreText}" Command="{Binding ToggleMoreCommand}"
                  Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- ================================================================== LIMPAR -->
  <DataTemplate DataType="{x:Type sv:SimpleCleanPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="860" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource S.Message}" Visibility="{Binding Cleaning.Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Cleaning.Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <c:SkeletonLoader Shape="Lines" Lines="2" Width="320" HorizontalAlignment="Left" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
              <c:AnimatedNumber Value="{Binding Cleaning.SafeBytes}" Kind="Bytes" FontFamily="{StaticResource Font.Numbers}" FontSize="64" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{l:T Simple.Clean.CanFree}" Style="{StaticResource S.Title}" FontSize="28" Margin="0,-4,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Cleaning.RecoverableCaption}" Style="{StaticResource S.Lead}" Foreground="{StaticResource Brush.Trace}" Margin="0,12,0,0"
                       Visibility="{Binding ScanFailed, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{l:T Simple.Clean.Lead}" Style="{StaticResource S.Lead}" Margin="0,12,0,26"/>
            <Button Style="{StaticResource S.Big}" Command="{Binding Cleaning.CleanSafeCommand}" MinWidth="200">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Clean}" Size="19" Margin="0,0,10,0"/>
                <TextBlock Text="{l:T Simple.Clean.Now}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <Image Grid.Column="1" Source="{StaticResource Illo.Cleaning}" Width="240" Margin="24,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <c:EmptyState Illustration="{StaticResource Illo.Cleaning}" Text="{l:T Simple.Clean.Nothing}" Detail="{l:T Simple.Clean.NothingDetail}" Margin="0,24,0,0"
                      Visibility="{Binding NothingToClean, Converter={StaticResource BoolToVis}}"/>

        <WrapPanel Margin="-8,28,0,0">
          <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.Clean.SeeList}" Command="{Binding ToggleListCommand}" Margin="0,0,12,0"
                  Visibility="{Binding HasSomething, Converter={StaticResource BoolToVis}}"/>
          <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.Clean.Undo}" Command="{Binding Cleaning.UndoLastCommand}" Margin="0,0,12,0"/>
          <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.Clean.EmptyBin}" Command="{Binding Cleaning.PurgeAllCommand}"
                  ToolTip="{l:T Simple.Clean.EmptyBinTip}"/>
        </WrapPanel>

        <Border Style="{StaticResource Panel.Inset}" Padding="18,12" Margin="0,10,0,0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Cleaning.SafeItems}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CleaningSafeItem}">
                <DockPanel Margin="0,5">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="15" Foreground="{StaticResource Brush.Trace}" Margin="16,0,0,0"/>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- ================================================================== JOGOS -->
  <DataTemplate DataType="{x:Type sv:SimpleGamesPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="940" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource S.Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <TextBlock Text="{l:T Simple.Games.Title}" Style="{StaticResource S.Title}"/>
        <TextBlock Text="{l:T Simple.Games.Lead}" Style="{StaticResource S.Lead}" Margin="0,8,0,12"/>
        <DockPanel Margin="0,0,0,20">
          <c:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{StaticResource Brush.Signal}" Margin="0,2,8,0" VerticalAlignment="Top"/>
          <TextBlock Text="{l:T Simple.Games.GameBarTip}" Style="{StaticResource Text.Body}" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Modo de jogo do Windows (resumo) -->
        <Border Style="{StaticResource S.Card}" Margin="0,0,0,24">
          <DockPanel>
            <ContentControl DockPanel.Dock="Right" Margin="16,0,0,0" Content="{Binding GameModeAction}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"
                            Visibility="{Binding HasGameModeAction, Converter={StaticResource BoolToVis}}"/>
            <Grid Width="44" Height="44" Margin="0,0,16,0">
              <Ellipse Fill="{Binding GameModeTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{StaticResource Icon.Games}" Size="21" Foreground="{Binding GameModeTone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding GameModeText}" Style="{StaticResource S.Item}"/>
          </DockPanel>
        </Border>

        <!-- Limite de FPS do driver NVIDIA em todos os jogos (perfil global): o NEXUS só tira limite, nunca põe. -->
        <Border Style="{StaticResource S.Card}" Margin="0,0,0,24" Visibility="{Binding HasGlobalFps, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <ContentControl DockPanel.Dock="Right" Margin="16,0,0,0" Content="{Binding GlobalFpsAction}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"
                            Visibility="{Binding HasGlobalFpsAction, Converter={StaticResource BoolToVis}}"/>
            <Grid Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top">
              <Ellipse Fill="{Binding GlobalFpsTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{StaticResource Icon.Games}" Size="21" Foreground="{Binding GlobalFpsTone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding GlobalFpsText}" Style="{StaticResource S.Item}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- Modo jogo automático (desligado por padrão): aplica o conjunto escolhido quando um jogo abre e desfaz quando ele fecha. -->
        <Border Style="{StaticResource S.Card}" DataContext="{Binding GameMode}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" MinWidth="110" VerticalAlignment="Top"
                      Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"/>
              <Grid Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Games}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel>
                <TextBlock Text="{l:T GameAuto.Title}" Style="{StaticResource S.Item}" FontWeight="SemiBold"/>
                <TextBlock Text="{l:T GameAuto.Lead}" Style="{StaticResource S.Lead}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <!-- "Ativo agora: <jogo>" enquanto um jogo está aberto -->
                <c:StatusChip Tone="Good" Text="{Binding ActiveText}" HorizontalAlignment="Left" Margin="0,8,0,0"
                              Visibility="{Binding ActiveNow, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <Button Style="{StaticResource Button.Ghost}" Content="{l:T GameAuto.RetryUndo}" Command="{Binding RetryUndoCommand}" HorizontalAlignment="Left" Margin="-8,4,0,0"
                        Visibility="{Binding UndoFailed, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False" Margin="0,6,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- O que ele faz: cada ação do conjunto com caixa de marcar (a escolha vale a partir da próxima partida) -->
                <TextBlock Text="{l:T GameAuto.WhatItDoes}" Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,14,0,2"/>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sv:GameModeActionRow}">
                      <DockPanel Margin="0,4">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding Available}" VerticalAlignment="Top" Margin="0,2,10,0"
                                  AutomationProperties.Name="{Binding Text}"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T GameAuto.NothingChosen}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding NothingChosen, Converter={StaticResource BoolToVis}}"/>

                <!-- Folga antes de desfazer (relançamentos e telas de carregamento) -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="{l:T GameAuto.StopDelay}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox ItemsSource="{Binding StopDelayOptions}" SelectedItem="{Binding StopDelay}" DisplayMemberPath="Label" MinWidth="130"
                            AutomationProperties.Name="{l:T GameAuto.StopDelay}"/>
                </StackPanel>
                <TextBlock Text="{l:T GameAuto.Honest}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Teste do mouse (só diagnóstico) -->
        <Border Style="{StaticResource S.Card}" Margin="0,0,0,24">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" MinWidth="110" VerticalAlignment="Center"
                    Content="{l:T Mouse.Open}" Command="{Binding TestMouseCommand}"/>
            <Grid Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top">
              <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
              <c:Icon Data="{StaticResource Icon.Measure}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel>
              <TextBlock Text="{l:T Mouse.Title}" Style="{StaticResource S.Item}" FontWeight="SemiBold"/>
              <TextBlock Text="{l:T Mouse.CardLead}" Style="{StaticResource S.Lead}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <c:SkeletonLoader Shape="Lines" Lines="5" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Measure}" Text="{l:T Simple.Games.None}" Detail="{l:T Simple.Games.NoneDetail}"
                      ActionText="{l:T Simple.Games.Measure}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                      Visibility="{Binding NoGames, Converter={StaticResource BoolToVis}}"/>

        <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type sv:SimpleGameRow}">
              <Border Style="{StaticResource S.Card}">
                <StackPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" Command="{Binding MeasureCommand}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Measure}" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T Simple.Games.Measure}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <!-- Laboratório A/B: comparar uma partida com e sem um ajuste (só com opções para testar) -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding CompareCommand}" VerticalAlignment="Center"
                            ToolTip="{l:T Simple.Games.CompareTip}" Visibility="{Binding HasCompare, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.AbLab}" Size="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T Simple.Games.Compare}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource Brush.SurfaceHi}" Margin="0,0,16,0">
                      <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Font.Display}" FontSize="22" Foreground="{StaticResource Brush.Trace}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="19" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="64,10,0,0" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type sv:GameOption}">
                        <DockPanel Margin="0,6">
                          <ContentControl DockPanel.Dock="Right" Margin="16,0,0,0" Content="{Binding Action}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"/>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Text}"/>
                            <!-- Selo discreto da recomendação por hardware ("Recomendado para o seu PC: …") -->
                            <c:StatusChip Tone="{Binding FitTone}" Text="{Binding FitNote}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                          Visibility="{Binding HasFitNote, Converter={StaticResource BoolToVis}}"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- "Aplicar o recomendado para este PC": um clique, confirmação, desfazer (só quando há opção recomendada ainda desligada) -->
                  <DockPanel Margin="64,10,0,0" Visibility="{Binding HasApplyRecommended, Converter={StaticResource BoolToVis}}">
                    <ContentControl DockPanel.Dock="Right" Margin="16,0,0,0" Content="{Binding ApplyRecommended}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"/>
                    <TextBlock Text="{l:T Simple.Games.RecommendedLead}" Style="{StaticResource Text.Body}" FontSize="14" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel>
                  <!-- Estado atual lido do jogo e aviso (Fortnite: "Agora: Modo desempenho · limite 141 FPS"; "feche o Fortnite antes") -->
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" FontSize="14" Foreground="{StaticResource Brush.Signal}" Margin="64,10,0,0"
                             TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                  <DockPanel Margin="64,6,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                    <c:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,8,0" VerticalAlignment="Top"
                            Visibility="{Binding IsRunning, Converter={StaticResource FalseToVisible}}"/>
                    <c:Icon Data="{StaticResource Icon.Warning}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,2,8,0" VerticalAlignment="Top"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Body}" FontSize="14" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"/>
                  </DockPanel>
                  <!-- Por que travou? (última partida medida deste jogo) -->
                  <DockPanel Margin="64,10,0,0" Visibility="{Binding HasStutterVerdict, Converter={StaticResource BoolToVis}}">
                    <c:Icon Data="{StaticResource Icon.Warning}" Size="15" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,8,0" VerticalAlignment="Top"
                            ToolTip="{l:T Simple.Games.StutterTip}"/>
                    <TextBlock Text="{Binding StutterVerdict}" Style="{StaticResource Text.Body}" FontSize="14" Foreground="{StaticResource Brush.TextDim}"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- ================================================================== PROBLEMAS -->
  <DataTemplate DataType="{x:Type sv:SimpleProblemsPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="900" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource S.Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
        </Border>
        <TextBlock Text="{l:T Simple.Problems.Title}" Style="{StaticResource S.Title}"/>
        <TextBlock Text="{Binding CountText}" Style="{StaticResource S.Lead}" Margin="0,8,0,24" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"/>

        <c:SkeletonLoader Shape="Lines" Lines="5" Margin="0,20,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="{l:T Simple.Problems.None}" Detail="{l:T Simple.Problems.NoneDetail}" Margin="0,24,0,0"
                      Visibility="{Binding NoItems, Converter={StaticResource BoolToVis}}"/>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type sv:ProblemRow}">
              <Border Style="{StaticResource S.Card}">
                <DockPanel>
                  <Grid Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ContentControl Content="{Binding Fix}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"
                                    Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource Button.Secondary}" Margin="0" MinWidth="110" Content="{Binding ActionText}"
                            Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                            Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource Button.Secondary}" Margin="0" MinWidth="110" Content="{Binding LinkText}"
                            Command="{Binding OpenCommand}" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource S.Item}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource S.Lead}" FontSize="15" Margin="0,6,0,0">
                      <Run Text="{l:T Simple.Card.WhatToDo}" Foreground="{StaticResource Brush.Signal}"/><Run Text=": "/><Run Text="{Binding WhatToDo, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <c:ExplainToggle Header="{Binding FineHeader}" Margin="0,18,0,0" Visibility="{Binding HasFine, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding FineTopics}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <c:StatusChip Tone="Good" Text="{Binding}" Margin="0,0,8,8"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:ExplainToggle>

        <!-- O jogo fechou sozinho? Juntar informações do travamento (só leitura; ZIP onde você escolher). -->
        <TextBlock Text="{l:T Crash.Section}" Style="{StaticResource S.Section}"/>
        <Border Style="{StaticResource S.Card}" DataContext="{Binding Crash}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="16,0,0,0" MinWidth="110" VerticalAlignment="Center"
                      Content="{l:T Crash.Read}" Command="{Binding ReadCommand}"/>
              <Grid Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel>
                <TextBlock Text="{l:T Crash.Title}" Style="{StaticResource S.Item}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{l:T Crash.Lead}" Style="{StaticResource S.Lead}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{l:T Crash.Reading}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Trace}" Margin="60,12,0,0"
                       Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Margin="60,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding Headline}" Style="{StaticResource S.Item}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
              <ItemsControl ItemsSource="{Binding Advice}" Focusable="False" Margin="0,8,0,0" Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Text.Body}" FontSize="15" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" Margin="0,2">
                      <Run Text="→ " Foreground="{StaticResource Brush.Signal}"/><Run Text="{Binding Mode=OneWay}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Games}" Focusable="False" Margin="0,12,0,0" Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type sv:CrashGameRow}">
                    <DockPanel Margin="0,6">
                      <ContentControl DockPanel.Dock="Right" Margin="16,0,0,0" Content="{Binding KeepDumps}" ContentTemplate="{StaticResource S.OneClick}" Focusable="False"
                                      Visibility="{Binding HasKeepDumps, Converter={StaticResource BoolToVis}}"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{l:T Crash.DumpsNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,8,0,0" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource Button.Primary}" Margin="0" Content="{l:T Crash.Save}" Command="{Binding SaveCommand}"/>
                <Button Style="{StaticResource Button.Ghost}" Margin="10,0,0,0" Content="{l:T Crash.OpenFolder}" Command="{Binding OpenFolderCommand}"
                        Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
              <TextBlock Text="{l:T Crash.Privacy}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" Margin="60,8,0,0"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- ================================================================== HISTÓRICO -->
  <DataTemplate DataType="{x:Type sv:SimpleHistoryPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="900" HorizontalAlignment="Stretch">
        <Border Style="{StaticResource S.Message}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding UndoAllCommand}" Padding="16,10" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Undo}" Size="16" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T Simple.Hist.UndoAll}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{l:T Simple.Hist.Title}" Style="{StaticResource S.Title}"/>
        </DockPanel>
        <TextBlock Text="{l:T Simple.Hist.Lead}" Style="{StaticResource S.Lead}" Margin="0,8,0,24"/>

        <c:EmptyState Illustration="{StaticResource Illo.History}" Text="{l:T Simple.Hist.None}" Detail="{l:T Simple.Hist.NoneDetail}"
                      Visibility="{Binding NoRows, Converter={StaticResource BoolToVis}}"/>

        <Border Style="{StaticResource Panel.Card}" Padding="22,6" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sv:SimpleHistoryRow}">
                <DockPanel Margin="0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource Button.Ghost}" Content="{l:T Simple.Hist.Undo}" Command="{Binding UndoCommand}"
                            Visibility="{Binding Active, Converter={StaticResource BoolToVis}}"/>
                    <c:StatusChip Tone="Neutral" Text="{l:T Simple.Hist.UndoneChip}" Visibility="{Binding Undone, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="170" FontFamily="{StaticResource Font.Numbers}" FontSize="15"
                             Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding What}" Style="{StaticResource S.Item}" FontSize="16"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,18,0,0" Content="{l:T Simple.Hist.SeeAll}"
                Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="HistoryPage"/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
  <!-- ================================================================== FERRAMENTAS AVANÇADAS -->
  <DataTemplate DataType="{x:Type sv:AdvancedToolsPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1100" HorizontalAlignment="Stretch">
        <TextBlock Text="{l:T Simple.Adv.Title}" Style="{StaticResource S.Title}"/>
        <TextBlock Text="{l:T Simple.Adv.Lead}" Style="{StaticResource S.Lead}" Margin="0,8,0,24"/>
        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="-7,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type sv:AdvancedTile}">
              <Button Margin="7" Padding="18,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                      AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}" ToolTip="{Binding Description}">
                <DockPanel>
                  <Grid Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="22" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Display}" FontSize="17" Foreground="{StaticResource Brush.Text}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel Margin="-8,22,0,0">
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding ExportCommand}" ToolTip="{l:T Shell.SalvaTudoFoiLido}" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Export}" Size="15" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T Shell.ExportarLeitura}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding RelaunchAsAdminCommand}" ToolTip="{l:T Shell.AlgumasLeiturasSoAparecem}"
                  Visibility="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Security}" Size="15" Margin="0,0,7,0"/>
              <TextBlock Text="{l:T Shell.VerTudoAdministrador}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
