<!--
  Limpeza (página-modelo do design system v2, docs/10-design-system.md). Quatro abas:
    Limpar ...... destaque "X GB" que conta, como funciona (varre → guarda → desfaz → esvazia), espaço antes/depois, categorias
                  como cartões com ícone (explicação de cada item recolhida em "Por que isso?"), Lixeira e ferramentas do Windows.
    Quarentena .. quanto ainda pode voltar, esvaziar (irreversível, botões Danger), lotes com Restaurar/Esvaziar ou estado vazio.
    Histórico ... quatro números (recuperado no mês/no total, na quarentena, limpo no mês), 12 meses, sessões, CSV.
    Regras ...... regras do usuário em JSON (texto longo recolhido).
  A lógica é a mesma do CleaningPage (só foram expostos números para a apresentação: RecoverableBytes, SelectedBytes, FreeBytes…).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:CleaningPage}">
    <DataTemplate.Resources>
      <!-- Linha de regra: caixa, título, etiquetas, tamanho; a explicação fica em "Por que isso?". Avisos continuam visíveis. -->
      <DataTemplate x:Key="C.RuleRow" DataType="{x:Type vm:CleaningRuleRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,9,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,0,0"
                      Visibility="{Binding CanClean, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding Title}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Tags}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,1,0,0"
                         Visibility="{Binding Tags, Converter={StaticResource NullToCollapsed}}"/>
              <Border Style="{StaticResource Panel.Notice}" Padding="8,5" Margin="0,6,0,0"
                      Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                  <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                  <Button Content="{Binding ToolLabel}" Command="{Binding OpenToolCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                          Margin="-8,4,0,0" Visibility="{Binding IsMeasureOnly, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="96">
              <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                         Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding FilesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                         HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="170"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Conteúdo da aba: ícone + nome. -->
      <DataTemplate x:Key="C.TabHeader">
        <StackPanel Orientation="Horizontal">
          <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" Size="16" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Abas -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CleaningTabs" Content="Limpar" Tag="{StaticResource Icon.Clean}"
                       ContentTemplate="{StaticResource C.TabHeader}" IsChecked="{Binding IsCleanTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CleaningTabs" Content="Quarentena" Tag="{StaticResource Icon.Quarantine}"
                       ContentTemplate="{StaticResource C.TabHeader}" IsChecked="{Binding IsQuarantineTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CleaningTabs" Content="Histórico" Tag="{StaticResource Icon.History}"
                       ContentTemplate="{StaticResource C.TabHeader}" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CleaningTabs" Content="Regras" Tag="{StaticResource Icon.Code}"
                       ContentTemplate="{StaticResource C.TabHeader}" IsChecked="{Binding IsRulesTab, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ================================================================ LIMPAR -->
        <StackPanel Visibility="{Binding IsCleanTab, Converter={StaticResource BoolToVis}}">
          <c:HeroPanel Illustration="{StaticResource Illo.Cleaning}" Title="Dá para liberar"
                       Number="{Binding RecoverableBytes}" Kind="Bytes" IsLoading="{Binding Scanning}"
                       Caption="Medido agora, sem mexer em nada. O que sai vai para a quarentena e pode voltar."
                       ActionText="Limpar selecionados" Command="{Binding CleanCommand}"
                       SecondaryText="Desfazer última limpeza" SecondaryCommand="{Binding UndoLastCommand}">
            <StackPanel MinWidth="170">
              <TextBlock Text="Marcado agora" Style="{StaticResource Text.Small}"/>
              <c:AnimatedNumber Value="{Binding SelectedBytes}" Kind="Bytes" FontFamily="{StaticResource Font.Numbers}" FontSize="26"
                                Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding QuarantineText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,8" MaxWidth="200"/>
              <Button Command="{Binding RescanCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Medir de novo" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="Parar medição" Command="{Binding CancelScanCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                      Margin="-8,0,0,0" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </c:HeroPanel>

          <!-- Programas abertos: o cache deles é pulado -->
          <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding HasOpenApps, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding OpenAppsWarning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
            </DockPanel>
          </Border>

          <!-- Como funciona -->
          <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
            <StackPanel>
              <c:HowItWorks>
                <c:StepItem Icon="{StaticResource Icon.Search}" Title="Varre" Text="Mede caches e temporários. Medir não mexe em nada."/>
                <c:StepItem Icon="{StaticResource Icon.Quarantine}" Title="Guarda" Text="O que você limpa vai para a quarentena, no mesmo disco." Tone="Warn"/>
                <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Mudou de ideia? Restaure o lote inteiro." Tone="Good"/>
                <c:StepItem Icon="{StaticResource Icon.Trash}" Title="Esvazia" Text="Só aqui o espaço volta. Apaga de vez, com confirmação dupla." Tone="Bad"/>
              </c:HowItWorks>
              <c:ExplainToggle Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding RecoverableCaption}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding QuarantineNote}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="380"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
              <!-- Espaço antes/depois -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <c:Icon Data="{StaticResource Icon.Disk}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SystemDrive, StringFormat='Espaço livre no disco {0}'}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
                  </DockPanel>
                  <c:BeforeAfter Before="{Binding FreeBytes}" After="{Binding FreeAfterBytes}" Kind="Bytes"
                                 BeforeLabel="Livre agora" AfterLabel="Depois de esvaziar"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,10,0,0"
                             Text="Conta com o que está marcado. O espaço volta quando a quarentena é esvaziada."/>
                </StackPanel>
              </Border>

              <!-- Categorias como cartões -->
              <c:SkeletonLoader Shape="Lines" Lines="6" Margin="4,8,4,16" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CleaningCategoryGroup}">
                    <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Grid Width="38" Height="38" Margin="0,0,12,0">
                            <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                            <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                          </Grid>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Small}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource Font.Numbers}" FontSize="22"
                                     Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="12,0,14,0"/>
                          <CheckBox Grid.Column="3" IsChecked="{Binding AllSelected}" IsThreeState="False" VerticalAlignment="Center" Content="Todos"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Marcar todos: {0}'}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource C.RuleRow}" Focusable="False"/>
                        <TextBlock Text="{Binding NotFoundText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"
                                   Visibility="{Binding HasNotFound, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Coluna lateral: Lixeira e ferramentas do Windows -->
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                  <DockPanel>
                    <c:Icon Data="{StaticResource Icon.Trash}" Size="18" Foreground="{StaticResource Brush.Bad}" Margin="0,0,8,0"/>
                    <TextBlock Text="Lixeira" Style="{StaticResource Text.H2}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding RecycleText}" FontFamily="{StaticResource Font.Numbers}" FontSize="18"
                             Foreground="{StaticResource Brush.Text}" Margin="0,8,0,4"/>
                  <c:StatusChip Tone="Bad" Text="Esvaziar não tem desfazer" Margin="0,0,0,10"/>
                  <ComboBox ItemsSource="{Binding RecycleDrives}" SelectedItem="{Binding RecycleDrive}" DisplayMemberPath="Label"
                            AutomationProperties.Name="Unidade da Lixeira"/>
                  <Button Content="Esvaziar Lixeira" Command="{Binding EmptyRecycleBinCommand}" Style="{StaticResource Button.Danger}" Margin="0,8,0,0"/>
                  <Button Content="Abrir a Lixeira" Command="{Binding OpenRecycleBinCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Panel.Card}" Padding="16,14">
                <StackPanel>
                  <DockPanel>
                    <c:Icon Data="{StaticResource Icon.Windows}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                    <TextBlock Text="Ferramentas do Windows" Style="{StaticResource Text.H2}"/>
                  </DockPanel>
                  <TextBlock Text="Atualizações antigas do Windows: use a ferramenta oficial, você vê e escolhe."
                             Style="{StaticResource Text.Small}" Margin="0,6,0,4"/>
                  <c:ExplainToggle Margin="0,0,0,8" Content="{Binding DiskCleanupNote}"/>
                  <Button Content="Abrir a Limpeza de Disco" Command="{Binding OpenDiskCleanupCommand}" Style="{StaticResource Button.Secondary}"/>
                  <Button Content="Configurações › Armazenamento" Command="{Binding OpenStorageSettingsCommand}" Style="{StaticResource Button.Ghost}"
                          HorizontalAlignment="Left" Margin="-8,6,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ================================================================ QUARENTENA -->
        <StackPanel Visibility="{Binding IsQuarantineTab, Converter={StaticResource BoolToVis}}">
          <c:HeroPanel Illustration="{StaticResource Illo.History}" Title="Na quarentena"
                       Number="{Binding RecoverableQuarantineBytes}" Kind="Bytes"
                       Caption="Ainda pode voltar. Ocupa o disco até você esvaziar.">
            <StackPanel MinWidth="230">
              <Button Content="Esvaziar quarentena" Command="{Binding PurgeAllCommand}" Style="{StaticResource Button.Danger}" Margin="0"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding PurgeAgeOptions}" SelectedItem="{Binding PurgeAge}" DisplayMemberPath="Label" MinWidth="96"
                          AutomationProperties.Name="Idade mínima dos lotes"/>
                <Button Content="Esvaziar mais antigos" Command="{Binding PurgeOlderCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"/>
              </StackPanel>
              <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Atualizar" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </c:HeroPanel>

          <c:ExplainToggle Margin="0,0,0,14" Content="{Binding QuarantineNote}"/>

          <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,14"
                  Visibility="{Binding HasExpirySuggestion, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0"/>
              <TextBlock Grid.Column="1" Text="{Binding ExpirySuggestion}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Content="Esvaziar estes" Command="{Binding PurgeExpiredCommand}" Style="{StaticResource Button.Danger}" Margin="12,0,0,0"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Lembrar de esvaziar depois de" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Só avisa. O NEXUS nunca apaga sozinho." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ExpiryOptions}" SelectedItem="{Binding Expiry}" DisplayMemberPath="Label" MinWidth="120"
                        VerticalAlignment="Center" AutomationProperties.Name="Expiração da quarentena"/>
            </Grid>
          </Border>

          <c:EmptyState Illustration="{StaticResource Illo.Cleaning}" Text="A quarentena está vazia."
                        Detail="O que você limpar aparece aqui e pode voltar até ser esvaziado."
                        ActionText="Ir para Limpar" Command="{Binding ShowCleanCommand}"
                        Visibility="{Binding HasBatches, Converter={StaticResource FalseToVisible}}"/>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Visibility="{Binding HasBatches, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="Limpezas na quarentena" Style="{StaticResource Text.H2}"/>
              <ItemsControl ItemsSource="{Binding Batches}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:QuarantineBatchRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                          <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                          <c:Icon Data="{StaticResource Icon.Quarantine}" Size="17" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock Text="{Binding WhenText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Text="{Binding RulesText}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding RulesText}"/>
                          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                   Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="NoWrap"/>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="120">
                          <Button Command="{Binding RestoreCommand}" Style="{StaticResource Button.Secondary}" Margin="0"
                                  Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                              <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                              <TextBlock Text="Restaurar" TextWrapping="NoWrap"/>
                            </StackPanel>
                          </Button>
                          <Button Content="Esvaziar" Command="{Binding PurgeCommand}" Style="{StaticResource Button.Danger}" Margin="0,6,0,0"
                                  Visibility="{Binding CanPurge, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ HISTÓRICO -->
        <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
          <UniformGrid Columns="4" Margin="-7,0,-7,16">
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.TrendUp}" Number="{Binding RecoveredMonthBytes}" Kind="Bytes" Tone="Good"
                        Label="Recuperado neste mês" Detail="Quarentena e Lixeira esvaziadas."/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding RecoveredTotalBytes}" Kind="Bytes" Tone="Good"
                        Label="Recuperado no total" Detail="Espaço que voltou de verdade."/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Quarantine}" Number="{Binding RecoverableQuarantineBytes}" Kind="Bytes" Tone="Warn"
                        Label="Na quarentena" Detail="Volta ao esvaziar."/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Clean}" Number="{Binding CleanedMonthBytes}" Kind="Bytes"
                        Label="Limpo neste mês" Detail="{Binding RestoredTotalText, StringFormat='Devolvido no total: {0}'}"/>
          </UniformGrid>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Últimos 12 meses" Style="{StaticResource Text.H2}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="10" Height="10" Background="{StaticResource Brush.Trace}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="limpo" Style="{StaticResource Text.Small}" Margin="6,0,14,0"/>
                  <Border Width="10" Height="10" Background="{StaticResource Brush.Good}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="recuperado de verdade" Style="{StaticResource Text.Small}" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Months}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:MonthBar}">
                    <StackPanel ToolTip="{Binding Tooltip}" Background="Transparent">
                      <Grid Height="92">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                          <Border Width="10" Height="{Binding CleanedHeight}" Background="{StaticResource Brush.Trace}" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"/>
                          <Border Width="10" Height="{Binding RecoveredHeight}" Background="{StaticResource Brush.Good}" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.LineSoft}" VerticalAlignment="Bottom"/>
                      </Grid>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <c:EmptyState Illustration="{StaticResource Illo.History}" Text="Nenhuma limpeza ainda."
                        Detail="Quando você limpar, cada sessão aparece aqui com o tamanho e o que foi feito."
                        ActionText="Ir para Limpar" Command="{Binding ShowCleanCommand}"
                        Visibility="{Binding HasHistory, Converter={StaticResource FalseToVisible}}"/>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Todas as limpezas" Style="{StaticResource Text.H2}"/>
                <Button Grid.Column="1" Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Secondary}" Margin="0">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Export}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Exportar CSV" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
              </Grid>
              <c:ExplainToggle Header="De onde vêm estes números?" Margin="0,4,0,0"
                               Content="Dos manifestos da quarentena (o que foi movido, devolvido e esvaziado) e do diário do NEXUS, lidos sem alterar nada."/>
              <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:HistorySessionRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock Text="{Binding WhenText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Text="{Binding RulesText}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding RulesText}"/>
                          <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="16" Foreground="{StaticResource Brush.Trace}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ REGRAS -->
        <StackPanel Visibility="{Binding IsRulesTab, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Code}" Size="24" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Suas regras de limpeza" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Arquivos .json com pastas do seu perfil. Tudo vai para a quarentena e pode voltar."
                           Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding RulesFolder}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding RulesFolderProblem}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,4,0,0"
                           Visibility="{Binding RulesFolderProblem, Converter={StaticResource NullToCollapsed}}"/>
                <c:ExplainToggle Header="O que pode e o que não pode" Margin="0,6,0,0">
                  <StackPanel>
                    <TextBlock Text="Só pastas do seu perfil (AppData, Temp, pastas com nome dentro do perfil), nunca pastas pessoais, de segredos do Windows ou do sistema. Valem só na sua conta, nunca como administrador." Style="{StaticResource Text.Small}"/>
                    <TextBlock Text="Guia com exemplos: docs/modules/cleaning-rules-guide.md (junto do NEXUS). Na primeira vez, a pasta ganha um exemplo comentado e desativado." Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                  </StackPanel>
                </c:ExplainToggle>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="200">
                <Button Content="Abrir pasta de regras" Command="{Binding OpenRulesFolderCommand}" Style="{StaticResource Button.Primary}" Margin="0"/>
                <Button Content="Recarregar" Command="{Binding ReloadRulesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"/>
                <Button Content="Ver na aba Limpar" Command="{Binding ShowCleanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Arquivos" Style="{StaticResource Text.H2}"/>
              <ItemsControl ItemsSource="{Binding RuleFiles}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:UserRuleFileRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
                              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
