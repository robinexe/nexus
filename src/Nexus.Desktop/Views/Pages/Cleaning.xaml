<!--
  Limpeza: resumo "X recuperáveis", categorias com caixas e tamanhos, limpar selecionados (pelo aplicador, para a quarentena),
  desfazer e histórico. Do tema, só as chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:CleaningPage}">
    <DataTemplate.Resources>
      <!-- Linha de regra: caixa, título, etiquetas, tamanho. -->
      <DataTemplate x:Key="C.RuleRow" DataType="{x:Type vm:CleaningRuleRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,0,0"
                      Visibility="{Binding CanClean, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding Title}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Tags}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"
                         Visibility="{Binding Tags, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
              <Border Background="{StaticResource Brush.WarnBg}" CornerRadius="{StaticResource Radius.Control}" Padding="8,5" Margin="0,6,0,0"
                      Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </Border>
              <Button Content="{Binding ToolLabel}" Command="{Binding OpenToolCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                      Margin="0,6,0,0" Visibility="{Binding IsMeasureOnly, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="110">
              <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                         Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding FilesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                         HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="180"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24,28,28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="380"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Resumo grande + ação principal -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,20">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding RecoverableCaption}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
              <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
              <Border Background="{StaticResource Brush.WarnBg}" CornerRadius="{StaticResource Radius.Control}" Padding="10,6" Margin="0,10,0,0"
                      Visibility="{Binding HasOpenApps, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OpenAppsWarning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </Border>
              <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"
                         Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="210">
              <Button Content="Limpar selecionados" Command="{Binding CleanCommand}" Style="{StaticResource Button.Primary}"/>
              <Button Content="Desfazer última limpeza" Command="{Binding UndoLastCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"/>
              <Button Content="Medir de novo" Command="{Binding RescanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"/>
              <Button Content="Parar medição" Command="{Binding CancelScanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,4,0,0"
                      Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
              <ProgressBar IsIndeterminate="{Binding Scanning}" Height="3" Margin="0,8,0,0"
                           Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Categorias -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Categories}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CleaningCategoryGroup}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding AllSelected}" IsThreeState="False" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name, StringFormat='Marcar todos: {0}'}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                               Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource C.RuleRow}" Focusable="False"/>
                  <TextBlock Text="{Binding NotFoundText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"
                             Visibility="{Binding HasNotFound, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Coluna lateral: quarentena e histórico -->
        <StackPanel Grid.Row="2" Grid.Column="2">
          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Quarentena" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{Binding QuarantineText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                         Foreground="{StaticResource Brush.Trace}" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding QuarantineNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Histórico de limpezas" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                         Visibility="{Binding HistoryEmptyText, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CleaningBatchRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding WhenText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
                        </Grid>
                        <TextBlock Text="{Binding RulesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                        <Button Content="Restaurar" Command="{Binding RestoreCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
