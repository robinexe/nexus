<!--
  Limpeza em quatro abas: Limpar (medição, limpar selecionados, Lixeira, ferramentas do Windows), Quarentena (lotes, desfazer,
  esvaziar: irreversível, botões Danger), Histórico (totais, meses, sessões, CSV) e Regras (regras do usuário em JSON).
  Do tema, só as chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml); estilos novos ficam em DataTemplate.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:CleaningPage}">
    <DataTemplate.Resources>
      <!-- Abas do topo: sublinhado âmbar na aba ativa (mesmo desenho da página Catálogo). -->
      <Style x:Key="C.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.H2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,28,0"/>
        <Setter Property="GroupName" Value="CleaningTabs"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Background="Transparent">
                <ContentPresenter Margin="0,0,0,8"/>
                <Border x:Name="Underline" Height="2" Background="{StaticResource Brush.Trace}" Opacity="0" CornerRadius="1"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Underline" Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                  <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Linha de regra: caixa, título, etiquetas, tamanho. -->
      <DataTemplate x:Key="C.RuleRow" DataType="{x:Type vm:CleaningRuleRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,0,0"
                      Visibility="{Binding CanClean, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding Title}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Tags}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"
                         Visibility="{Binding Tags, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding ExpectedGain}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
              <Border Background="{StaticResource Brush.WarnBg}" CornerRadius="{StaticResource Radius.Control}" Padding="8,5" Margin="0,6,0,0"
                      Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </Border>
              <Button Content="{Binding ToolLabel}" Command="{Binding OpenToolCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                      Margin="0,6,0,0" Visibility="{Binding IsMeasureOnly, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="110">
              <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                         Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding FilesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                         HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="180"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Número grande + rótulo (totais do histórico). -->
      <Style x:Key="C.Total" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.H1}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28">
        <!-- Cabeçalho -->
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>

        <!-- Abas -->
        <StackPanel Orientation="Horizontal" Margin="0,18,0,16">
          <RadioButton Style="{StaticResource C.Tab}" Content="Limpar" IsChecked="{Binding IsCleanTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource C.Tab}" Content="Quarentena" IsChecked="{Binding IsQuarantineTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource C.Tab}" Content="Histórico" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource C.Tab}" Content="Regras" IsChecked="{Binding IsRulesTab, Mode=TwoWay}"/>
        </StackPanel>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,0,0,12"
                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>

        <!-- ================================================================ LIMPAR -->
        <Grid Visibility="{Binding IsCleanTab, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="320"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Resumo grande + ação principal -->
          <Border Grid.ColumnSpan="3" Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding RecoverableText}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
                <TextBlock Text="{Binding RecoverableCaption}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding QuarantineText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                <Border Background="{StaticResource Brush.WarnBg}" CornerRadius="{StaticResource Radius.Control}" Padding="10,6" Margin="0,10,0,0"
                        Visibility="{Binding HasOpenApps, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding OpenAppsWarning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="210">
                <Button Content="Limpar selecionados" Command="{Binding CleanCommand}" Style="{StaticResource Button.Primary}"/>
                <Button Content="Desfazer última limpeza" Command="{Binding UndoLastCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"/>
                <Button Content="Medir de novo" Command="{Binding RescanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"/>
                <Button Content="Parar medição" Command="{Binding CancelScanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,4,0,0"
                        Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
                <ProgressBar IsIndeterminate="{Binding Scanning}" Height="3" Margin="0,8,0,0"
                             Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Categorias -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CleaningCategoryGroup}">
                <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding AllSelected}" IsThreeState="False" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Name, StringFormat='Marcar todos: {0}'}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                 Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource C.RuleRow}" Focusable="False"/>
                    <TextBlock Text="{Binding NotFoundText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"
                               Visibility="{Binding HasNotFound, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Coluna lateral: Lixeira e ferramentas do Windows -->
          <StackPanel Grid.Row="1" Grid.Column="2">
            <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Lixeira" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding RecycleText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                           Foreground="{StaticResource Brush.Trace}" Margin="0,6,0,0"/>
                <TextBlock Text="Esvaziar apaga de vez: não passa pela quarentena e não tem desfazer. Confira antes."
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,8"/>
                <ComboBox ItemsSource="{Binding RecycleDrives}" SelectedItem="{Binding RecycleDrive}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Unidade da Lixeira"/>
                <Button Content="Esvaziar Lixeira" Command="{Binding EmptyRecycleBinCommand}" Style="{StaticResource Button.Danger}" Margin="0,8,0,0"/>
                <Button Content="Abrir a Lixeira" Command="{Binding OpenRecycleBinCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel.Card}" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Ferramentas do Windows" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding DiskCleanupNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,8"/>
                <Button Content="Abrir a Limpeza de Disco" Command="{Binding OpenDiskCleanupCommand}" Style="{StaticResource Button.Secondary}"/>
                <Button Content="Configurações › Armazenamento" Command="{Binding OpenStorageSettingsCommand}" Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- ================================================================ QUARENTENA -->
        <StackPanel Visibility="{Binding IsQuarantineTab, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding RecoverableQuarantineText}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
                <TextBlock Text="na quarentena (ainda pode voltar; ocupa o disco até ser esvaziado)" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding QuarantineNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="240">
                <Button Content="Esvaziar quarentena" Command="{Binding PurgeAllCommand}" Style="{StaticResource Button.Danger}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ComboBox ItemsSource="{Binding PurgeAgeOptions}" SelectedItem="{Binding PurgeAge}" DisplayMemberPath="Label" MinWidth="96"
                            AutomationProperties.Name="Idade mínima dos lotes"/>
                  <Button Content="Esvaziar mais antigos" Command="{Binding PurgeOlderCommand}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,14"
                  Visibility="{Binding HasExpirySuggestion, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ExpirySuggestion}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Esvaziar estes" Command="{Binding PurgeExpiredCommand}" Style="{StaticResource Button.Danger}" Margin="12,0,0,0"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Expiração automática (opcional)" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Ligada, o NEXUS só avisa quando há limpezas mais velhas que isso e sugere esvaziar. Nunca apaga sozinho."
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ExpiryOptions}" SelectedItem="{Binding Expiry}" DisplayMemberPath="Label" MinWidth="120"
                        VerticalAlignment="Center" AutomationProperties.Name="Expiração da quarentena"/>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Limpezas na quarentena" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                         Visibility="{Binding HistoryEmptyText, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding Batches}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:QuarantineBatchRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock Text="{Binding WhenText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Text="{Binding RulesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                   Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="NoWrap"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="120">
                          <Button Content="Restaurar" Command="{Binding RestoreCommand}" Style="{StaticResource Button.Secondary}"
                                  Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"/>
                          <Button Content="Esvaziar" Command="{Binding PurgeCommand}" Style="{StaticResource Button.Danger}" Margin="0,6,0,0"
                                  Visibility="{Binding CanPurge, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ HISTÓRICO -->
        <StackPanel Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding RecoveredMonthText}" Style="{StaticResource C.Total}" Foreground="{StaticResource Brush.Good}"/>
                <TextBlock Text="recuperado de verdade neste mês" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{Binding RecoveredTotalText}" Style="{StaticResource C.Total}" Foreground="{StaticResource Brush.Good}"/>
                <TextBlock Text="recuperado de verdade no total (quarentena e Lixeira esvaziadas)" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="{Binding RecoverableQuarantineText}" Style="{StaticResource C.Total}" Foreground="{StaticResource Brush.Trace}"/>
                <TextBlock Text="na quarentena (recuperável ao esvaziar)" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
              <StackPanel Grid.Column="3">
                <TextBlock Text="{Binding CleanedMonthText}" Style="{StaticResource C.Total}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{Binding RestoredTotalText, StringFormat='limpo neste mês · devolvido no total: {0}'}" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Últimos 12 meses" Style="{StaticResource Text.H2}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="10" Height="10" Background="{StaticResource Brush.Trace}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="limpo (foi para a quarentena)" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,14,0"/>
                  <Border Width="10" Height="10" Background="{StaticResource Brush.Good}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="recuperado de verdade" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Months}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:MonthBar}">
                    <StackPanel ToolTip="{Binding Tooltip}" Background="Transparent">
                      <Grid Height="92">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                          <Border Width="10" Height="{Binding CleanedHeight}" Background="{StaticResource Brush.Trace}" CornerRadius="2,2,0,0" VerticalAlignment="Bottom"/>
                          <Border Width="10" Height="{Binding RecoveredHeight}" Background="{StaticResource Brush.Good}" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.LineSoft}" VerticalAlignment="Bottom"/>
                      </Grid>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Todas as limpezas" Style="{StaticResource Text.H2}"/>
                <Button Grid.Column="1" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource Button.Secondary}"/>
              </Grid>
              <TextBlock Text="Fonte: manifestos da quarentena (o que foi movido, devolvido e esvaziado) e o diário do NEXUS, lido sem alterar nada."
                         Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                         Visibility="{Binding HistoryEmptyText, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:HistorySessionRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock Text="{Binding WhenText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Text="{Binding RulesText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ REGRAS -->
        <StackPanel Visibility="{Binding IsRulesTab, Converter={StaticResource BoolToVis}}">
          <Border Style="{StaticResource Panel.Hero}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Suas regras de limpeza" Style="{StaticResource Text.H2}"/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                           Text="Arquivos .json no mesmo formato das regras do NEXUS. Só pastas do seu perfil (AppData, Temp, pastas com nome dentro do perfil), nunca pastas pessoais, de segredos do Windows ou do sistema. Tudo vai para a quarentena e pode voltar. Valem só na sua conta, nunca como administrador."/>
                <TextBlock Text="{Binding RulesFolder}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding RulesFolderProblem}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,4,0,0"
                           Visibility="{Binding RulesFolderProblem, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"
                           Text="Guia com exemplos: docs/modules/cleaning-rules-guide.md (junto do NEXUS). Na primeira vez, a pasta ganha um exemplo comentado e desativado."/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="210">
                <Button Content="Abrir pasta de regras" Command="{Binding OpenRulesFolderCommand}" Style="{StaticResource Button.Primary}"/>
                <Button Content="Recarregar" Command="{Binding ReloadRulesCommand}" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0"/>
                <Button Content="Ver na aba Limpar" Command="{Binding ShowCleanCommand}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource Panel.Card}" Padding="16,14">
            <StackPanel>
              <TextBlock Text="Arquivos" Style="{StaticResource Text.H2}"/>
              <ItemsControl ItemsSource="{Binding RuleFiles}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:UserRuleFileRow}">
                    <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
                              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                  <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
