<!--
  Assistente completo (design system v2, docs/10-design-system.md).
    Tela inicial: destaque com a trilha com bandeira (Illo.Assistant), "13 etapas", começar/retomar; como funciona
                  (Verifica → Explica → Você confirma → Relatório); a trilha das 13 etapas com ícone (mostra o que já foi feito).
    Passo a passo: a trilha visual (nó com ícone por etapa: âmbar = agora, verde = feita, riscada = pulada; clicar volta a uma
                  etapa já liberada); destaque da etapa com a ilustração do módulo, o que verifica e o anel de progresso que
                  enche a cada etapa; "Por que importa" recolhido; o que encontrei em cartões; recomendação + ação principal;
                  mudanças com selo de risco (explicação em "Por que isso?"); revisar, botões da etapa e notas.
    Relatório:    3 cartões (aplicadas, de fora, para você) + cada número com barras antes → depois quando os dois lados são
                  números da mesma unidade; próximo passo; abrir/exportar/concluir.
  Desfazer tudo continua visível (botão perigo). A lógica é a mesma do AssistantPage; só foram expostos dados de apresentação.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:AssistantPage}">
    <DataTemplate.Resources>
      <!-- Nó da trilha: disco com o ícone da etapa, trilho dos dois lados e o nome. -->
      <DataTemplate x:Key="As.Node" DataType="{x:Type vm:StepChip}">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding GoCommand}" Padding="0,4" Margin="0" HorizontalContentAlignment="Stretch"
                ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="38"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="LeftRail" Height="2" Fill="{StaticResource Brush.Line}"/>
              <Rectangle x:Name="RightRail" Grid.Column="1" Height="2" Fill="{StaticResource Brush.Line}"/>
            </Grid>
            <Grid Width="36" Height="36">
              <Ellipse x:Name="Disc" Fill="{StaticResource Brush.Surface}" Stroke="{Binding Tone, Converter={StaticResource ToneBrush}}" StrokeThickness="2"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                      Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="Name" Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Text.Small}" FontSize="11.5" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
          </Grid>
        </Button>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsFirst}" Value="True">
            <Setter TargetName="LeftRail" Property="Visibility" Value="Hidden"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsLast}" Value="True">
            <Setter TargetName="RightRail" Property="Visibility" Value="Hidden"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsDone}" Value="True">
            <Setter TargetName="LeftRail" Property="Fill" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="RightRail" Property="Fill" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Brush.GoodSoft}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Brush.Text}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsSkipped}" Value="True">
            <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Mudança proposta (com marcação): selo de risco visível; explicação recolhida. -->
      <DataTemplate x:Key="As.Change" DataType="{x:Type vm:ChangeRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="{Binding Title}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding BeforeAfter}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" FontFamily="{StaticResource Font.Numbers}"
                         Margin="0,2,0,0" Visibility="{Binding HasBeforeAfter, Converter={StaticResource BoolToVis}}"/>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
              <c:StatusChip Tone="{Binding RiskTone}" Text="{Binding RiskChip}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding LevelChip}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- O que só o usuário pode fazer (comprar RAM, XMP, driver no site oficial). -->
      <DataTemplate x:Key="As.UserAction" DataType="{x:Type vm:UserActionRow}">
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Abrir página" Style="{StaticResource Button.Ghost}" Command="{Binding OpenCommand}" VerticalAlignment="Top"
                    Margin="12,0,0,0" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"/>
            <c:Icon Data="{StaticResource Icon.User}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,1,12,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- Mensagem da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ================================================================ TELA INICIAL -->
        <StackPanel Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}">
          <c:HeroPanel Illustration="{StaticResource Illo.Assistant}" Title="Deixe o PC otimizado, passo a passo"
                       Number="{x:Static vm:AssistantPage.StepCount}" Suffix=" etapas" Caption="{Binding StartText}"
                       ActionText="{Binding StartActionText}" Command="{Binding StartActionCommand}"
                       SecondaryText="{Binding RestartText}" SecondaryCommand="{Binding StartCommand}">
            <StackPanel Width="200">
              <c:StatusChip Tone="Good" Text="Tudo pode ser desfeito" HorizontalAlignment="Left"/>
              <c:StatusChip Tone="Info" Text="Você confirma cada grupo" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <c:StatusChip Tone="Info" Text="Relatório no fim" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <Button Content="Desfazer tudo que o assistente fez" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,14,0,0"
                      HorizontalAlignment="Left" Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </c:HeroPanel>

          <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Text="Como funciona" Style="{StaticResource Text.H2}" Margin="0,0,0,14"/>
              <c:HowItWorks>
                <c:StepItem Icon="{StaticResource Icon.Search}" Title="Verifica" Text="Cada etapa lê uma parte do PC. Ler não muda nada."/>
                <c:StepItem Icon="{StaticResource Icon.Info}" Title="Explica" Text="Mostra os números e o que recomenda, com o risco."/>
                <c:StepItem Icon="{StaticResource Icon.Check}" Title="Você confirma" Text="Nada é aplicado sem o seu clique." Tone="Warn"/>
                <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Relatório e desfazer" Text="No fim, antes → depois. Tudo pode voltar." Tone="Good"/>
              </c:HowItWorks>
              <c:ExplainToggle Margin="0,12,0,0"
                               Content="13 etapas: segurança primeiro, depois limpeza, programas, inicialização, privacidade, drivers, memória e desempenho. Leva de 10 a 20 minutos e dá para parar e retomar quando quiser."/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ TRILHA (início e passo a passo) -->
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" VerticalAlignment="Bottom"/>
          <TextBlock Text="As 13 etapas" Style="{StaticResource Text.H2}"/>
        </DockPanel>
        <Border Style="{StaticResource Panel.Card}" Padding="10,10,10,8" Margin="0,0,0,18">
          <ItemsControl ItemsSource="{Binding StepBar}" ItemTemplate="{StaticResource As.Node}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>

        <!-- ================================================================ PASSO A PASSO -->
        <StackPanel Visibility="{Binding InFlow, Converter={StaticResource BoolToVis}}">

          <!-- Destaque da etapa -->
          <c:HeroPanel Illustration="{Binding StepIllustrationKey, Converter={StaticResource ResourceByKey}}" Title="{Binding StepCounter}"
                       ValueText="{Binding StepTitle}" Caption="{Binding StepChecks}">
            <StackPanel Width="164">
              <c:RingMeter Value="{Binding ProgressPercent}" Label="concluído" Width="136" Height="136" Thickness="11" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </c:HeroPanel>
          <c:ExplainToggle Header="Por que importa?" Margin="0,0,0,16">
            <TextBlock Text="{Binding StepWhy}" Style="{StaticResource Text.Small}"/>
          </c:ExplainToggle>

          <!-- Verificando -->
          <Border Style="{StaticResource Panel.Card}" Padding="20,16" Margin="0,0,0,14" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Button.Ghost}" Command="{Binding CancelScanCommand}"/>
                <c:Icon Data="{Binding StepIconKey, Converter={StaticResource ResourceByKey}}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
              <c:SkeletonLoader Shape="Tiles" Columns="3" Height="110"/>
            </StackPanel>
          </Border>

          <!-- Etapa normal -->
          <StackPanel Visibility="{Binding ShowStep, Converter={StaticResource BoolToVis}}">
            <StackPanel Visibility="{Binding IsNormalStep, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="O que encontrei" Style="{StaticResource Text.H2}" Margin="0,0,0,10" Visibility="{Binding HasFacts, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding FactCards}" Focusable="False" Margin="-6,0,-6,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:FactCard}">
                    <c:StatTile Margin="6,0,6,12" Icon="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Value="{Binding Value}"
                                Label="{Binding Label}" Detail="{Binding Detail}" Tone="{Binding Tone}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False"/>

              <!-- Recomendação + ação principal -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <DockPanel>
                    <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                      <c:Icon Data="{StaticResource Icon.Sparkle}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                      <TextBlock Text="Recomendo" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                      <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                 Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource As.Change}" Focusable="False" Margin="0,12,0,0"
                                Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding Choosing}"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="Aplicar recomendado" Style="{StaticResource Button.Primary}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Aplicar marcados" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Escolher" Style="{StaticResource Button.Secondary}" Command="{Binding ChooseCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Continuar" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding NoChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Seguir sem aplicar" Style="{StaticResource Button.Ghost}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Pular etapa" Style="{StaticResource Button.Ghost}" Command="{Binding SkipCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Para revisar (nada é aplicado) -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,14,0,0" Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <c:Icon Data="{StaticResource Icon.Search}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0"/>
                    <TextBlock Text="Para você revisar" Style="{StaticResource Text.H2}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Review}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Botões da etapa -->
              <ItemsControl ItemsSource="{Binding Extras}" Focusable="False" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,4">
                      <c:Icon Data="{StaticResource Icon.Info}" Size="13" Foreground="{StaticResource Brush.Signal}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                      <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ===== Relatório final ===== -->
            <StackPanel Visibility="{Binding IsReportStep, Converter={StaticResource BoolToVis}}">
              <UniformGrid Columns="3" Margin="-7,0,-7,16">
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding ReportAppliedNumber}" Tone="Good"
                            Label="Mudanças aplicadas" Detail="Todas com desfazer registrado."/>
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Info}" Number="{Binding ReportSkippedNumber}"
                            Label="Ficaram de fora" Detail="Cada uma com o motivo no relatório."/>
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.User}" Number="{Binding ReportUserActionsNumber}" Tone="Warn"
                            Label="Para você fazer" Detail="O que só você pode resolver."/>
              </UniformGrid>

              <TextBlock Text="Antes → depois" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding ReportCards}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ReportMetricCard}">
                    <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14" Padding="18,14">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}"/>
                        <c:BeforeAfter Before="{Binding Before}" After="{Binding After}" Kind="{Binding Kind}" HigherIsBetter="{Binding HigherIsBetter}"
                                       BeforeLabel="Antes" AfterLabel="Depois" Margin="0,10,0,0"
                                       Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Readout}" Margin="0,6,0,0"
                                   Visibility="{Binding NoBars, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False" Margin="0,6,0,0"/>

              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <DockPanel>
                    <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                      <c:Icon Data="{StaticResource Icon.ArrowRight}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                      <TextBlock Text="Próximo passo" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                      <TextBlock Text="{Binding ReportNextStep}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenReportCommand}" Margin="0,0,10,8">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Page}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Abrir relatório" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" Margin="0,0,10,8">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Export}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Exportar" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <Button Content="Concluir" Style="{StaticResource Button.Secondary}" Command="{Binding FinishCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding ReportPath}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ReportPath}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Resultado da etapa anterior -->
            <Border Background="{StaticResource Brush.GoodSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,14,0,0"
                    Visibility="{Binding StepResult, Converter={StaticResource NullToCollapsed}}" opt:Reveal.Trigger="{Binding StepResult}">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding StepResult}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- Navegação -->
          <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
            <WrapPanel>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" Margin="0,0,10,8">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                    <c:Icon.RenderTransform>
                      <ScaleTransform ScaleX="-1"/>
                    </c:Icon.RenderTransform>
                  </c:Icon>
                  <TextBlock Text="Voltar" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="Parar e continuar depois" Style="{StaticResource Button.Ghost}" Command="{Binding StopCommand}" Margin="0,0,10,8"/>
              <Button Content="Desfazer tudo que o assistente fez" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,0,10,8"
                      Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
