<!--
  Assistente completo: tela inicial (começar / retomar), barra de etapas, a etapa atual (o que verifica, por que importa, números
  grandes do que encontrou, a recomendação e uma ação principal) e o relatório final. Do tema, só chaves do contrato de
  Controls.xaml; estilos locais em DataTemplate.Resources. O redesign fino virá com o design system v2.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels">
  <DataTemplate DataType="{x:Type vm:AssistantPage}">
    <DataTemplate.Resources>
      <FontFamily x:Key="As.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

      <!-- Posição na barra de etapas: âmbar = atual, verde = feita, apagada = pulada/pendente. -->
      <DataTemplate x:Key="As.StepChip">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding GoCommand}" Margin="0,0,4,4" Padding="8,4" ToolTip="{Binding Name}">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="dot" Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource Brush.Line}" Margin="0,0,6,0">
              <TextBlock x:Name="num" Text="{Binding Number}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextDim}"/>
            </Border>
            <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          </StackPanel>
        </Button>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding State}" Value="current">
            <Setter TargetName="dot" Property="Background" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="num" Property="Foreground" Value="{StaticResource Brush.Bg}"/>
            <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.Text}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="done">
            <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="num" Property="Foreground" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="skipped">
            <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Número grande do que foi encontrado. -->
      <DataTemplate x:Key="As.Fact">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="16,12" MinWidth="170" MaxWidth="320">
          <StackPanel>
            <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource Text.Readout}"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good">
            <Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn">
            <Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Mudança proposta (com marcação). -->
      <DataTemplate x:Key="As.Change">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,6" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="bar" Background="{StaticResource Brush.Good}" CornerRadius="2" Margin="0,8"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="12,12,4,0" ToolTip="Marcar para aplicar"/>
            <StackPanel Grid.Column="2" Margin="6,10,14,10">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding BeforeAfter}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"
                         Visibility="{Binding HasBeforeAfter, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="warn">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- O que só o usuário pode fazer (comprar RAM, XMP, driver no site oficial). -->
      <DataTemplate x:Key="As.UserAction">
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Abrir página" Style="{StaticResource Button.Ghost}" Command="{Binding OpenCommand}" VerticalAlignment="Top"
                    Margin="12,0,0,0" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"/>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,22"/>

        <!-- ===== Tela inicial ===== -->
        <Border Style="{StaticResource Panel.Hero}" Padding="0" ClipToBounds="True" Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Rectangle Fill="{StaticResource Brush.Graticule}" Opacity="0.35" IsHitTestVisible="False" RadiusX="10" RadiusY="10"/>
            <Grid Margin="28,26">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource As.Icons}" FontSize="56" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Top" Margin="0,4,26,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Deixe o PC otimizado, passo a passo" Style="{StaticResource Text.H1}"/>
                <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                           Text="13 etapas: segurança primeiro, depois limpeza, programas, inicialização, privacidade, drivers, memória e desempenho. Você vê os números, confirma cada grupo e recebe um relatório no fim. Tudo pode ser desfeito."/>
                <TextBlock Text="{Binding StartText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,10,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                  <Button Content="Retomar de onde parei" Style="{StaticResource Button.Primary}" Command="{Binding ResumeCommand}" Margin="0,0,10,0"
                          Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}"/>
                  <Button Content="Começar" Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" Margin="0,0,10,0"
                          Visibility="{Binding HasSaved, Converter={StaticResource FalseToVisible}}"/>
                  <Button Content="Começar de novo" Style="{StaticResource Button.Secondary}" Command="{Binding StartCommand}" Margin="0,0,10,0"
                          Visibility="{Binding HasSaved, Converter={StaticResource BoolToVis}}"/>
                  <Button Content="Desfazer tudo que o assistente fez" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}"
                          Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <!-- ===== Passo a passo ===== -->
        <StackPanel Visibility="{Binding InFlow, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding StepBar}" ItemTemplate="{StaticResource As.StepChip}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <DockPanel Margin="0,6,0,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="12,0,0,0"/>
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" VerticalAlignment="Center"/>
          </DockPanel>

          <!-- Cabeçalho da etapa -->
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StepGlyph}" FontFamily="{StaticResource As.Icons}" FontSize="40" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Top" Margin="0,6,20,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding StepCounter}" Style="{StaticResource Text.MetricLabel}"/>
              <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Display}"/>
              <TextBlock Text="{Binding StepChecks}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0">
                <Run Text="Por que importa:" Foreground="{StaticResource Brush.Signal}"/>
                <Run Text="{Binding StepWhy, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </Grid>

          <!-- Verificando -->
          <Border Style="{StaticResource Panel.Card}" Padding="20,16" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Button.Ghost}" Command="{Binding CancelScanCommand}"/>
              <StackPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Body}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Etapa normal -->
          <StackPanel Visibility="{Binding ShowStep, Converter={StaticResource BoolToVis}}">
            <StackPanel Visibility="{Binding IsNormalStep, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="O que encontrei" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource As.Fact}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False" Margin="0,4,0,0"/>

              <!-- Recomendação + ação principal -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <TextBlock Text="Recomendo" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                  <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                             Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                  <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource As.Change}" Focusable="False" Margin="0,12,0,0"
                                Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="Aplicar recomendado" Style="{StaticResource Button.Primary}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Aplicar marcados" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Escolher" Style="{StaticResource Button.Secondary}" Command="{Binding ChooseCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Continuar" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding NoChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Seguir sem aplicar" Style="{StaticResource Button.Ghost}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Pular etapa" Style="{StaticResource Button.Ghost}" Command="{Binding SkipCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Para revisar (nada é aplicado) -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Para você revisar" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Review}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="12,0,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Botões da etapa -->
              <ItemsControl ItemsSource="{Binding Extras}" Focusable="False" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,4">
                      <Run Text="•" Foreground="{StaticResource Brush.Signal}"/>
                      <Run Text="{Binding Mode=OneWay}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Relatório final -->
            <StackPanel Visibility="{Binding IsReportStep, Converter={StaticResource BoolToVis}}">
              <WrapPanel>
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="18,14" MinWidth="170">
                  <StackPanel>
                    <TextBlock Text="{Binding ReportApplied}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Good}"/>
                    <TextBlock Text="mudanças aplicadas" Style="{StaticResource Text.MetricLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="18,14" MinWidth="170">
                  <StackPanel>
                    <TextBlock Text="{Binding ReportSkipped}" Style="{StaticResource Text.Metric}"/>
                    <TextBlock Text="ficaram de fora (com o motivo)" Style="{StaticResource Text.MetricLabel}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="18,14" MinWidth="170">
                  <StackPanel>
                    <TextBlock Text="{Binding ReportUserActions}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
                    <TextBlock Text="para você fazer" Style="{StaticResource Text.MetricLabel}"/>
                  </StackPanel>
                </Border>
              </WrapPanel>

              <TextBlock Text="Números" Style="{StaticResource Text.Label}" Margin="0,6,0,6"/>
              <ItemsControl ItemsSource="{Binding ReportMetrics}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="16,12" MinWidth="200" MaxWidth="340">
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Readout}"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                                   Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False" Margin="0,6,0,0"/>

              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <TextBlock Text="Próximo passo" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                  <TextBlock Text="{Binding ReportNextStep}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="Abrir relatório" Style="{StaticResource Button.Primary}" Command="{Binding OpenReportCommand}" Margin="0,0,10,8"/>
                    <Button Content="Exportar" Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" Margin="0,0,10,8"/>
                    <Button Content="Concluir" Style="{StaticResource Button.Secondary}" Command="{Binding FinishCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding ReportPath}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding StepResult}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,12,0,0"
                       Visibility="{Binding StepResult, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>

          <!-- Navegação -->
          <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
            <WrapPanel>
              <Button Content="Voltar" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" Margin="0,0,10,8"/>
              <Button Content="Parar e continuar depois" Style="{StaticResource Button.Ghost}" Command="{Binding StopCommand}" Margin="0,0,10,8"/>
              <Button Content="Desfazer tudo que o assistente fez" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,0,10,8"
                      Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
          </Border>
        </StackPanel>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,12,0,0"
                   Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
