<!--
  Assistente completo (design system v2, docs/10-design-system.md).
    Tela inicial: destaque com a trilha com bandeira (Illo.Assistant), "13 etapas", começar/retomar; como funciona
                  (Verifica → Explica → Você confirma → Relatório); a trilha das 13 etapas com ícone (mostra o que já foi feito).
    Passo a passo: a trilha visual (nó com ícone por etapa: âmbar = agora, verde = feita, riscada = pulada; clicar volta a uma
                  etapa já liberada); destaque da etapa com a ilustração do módulo, o que verifica e o anel de progresso que
                  enche a cada etapa; "Por que importa" recolhido; o que encontrei em cartões; recomendação + ação principal;
                  mudanças com selo de risco (explicação em "Por que isso?"); revisar, botões da etapa e notas.
    Relatório:    3 cartões (aplicadas, de fora, para você) + cada número com barras antes → depois quando os dois lados são
                  números da mesma unidade; próximo passo; abrir/exportar/concluir.
  Desfazer tudo continua visível (botão perigo). A lógica é a mesma do AssistantPage; só foram expostos dados de apresentação.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:AssistantPage}">
    <DataTemplate.Resources>
      <!-- Nó da trilha: disco com o ícone da etapa, trilho dos dois lados e o nome. -->
      <DataTemplate x:Key="As.Node" DataType="{x:Type vm:StepChip}">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding GoCommand}" Padding="0,4" Margin="0" HorizontalContentAlignment="Stretch"
                ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="38"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="LeftRail" Height="2" Fill="{StaticResource Brush.Line}"/>
              <Rectangle x:Name="RightRail" Grid.Column="1" Height="2" Fill="{StaticResource Brush.Line}"/>
            </Grid>
            <Grid Width="36" Height="36">
              <Ellipse x:Name="Disc" Fill="{StaticResource Brush.Surface}" Stroke="{Binding Tone, Converter={StaticResource ToneBrush}}" StrokeThickness="2"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                      Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="Name" Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Text.Small}" FontSize="11.5" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
          </Grid>
        </Button>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsFirst}" Value="True">
            <Setter TargetName="LeftRail" Property="Visibility" Value="Hidden"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsLast}" Value="True">
            <Setter TargetName="RightRail" Property="Visibility" Value="Hidden"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsDone}" Value="True">
            <Setter TargetName="LeftRail" Property="Fill" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="RightRail" Property="Fill" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Brush.GoodSoft}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="Disc" Property="Fill" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Brush.Text}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsSkipped}" Value="True">
            <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Mudança proposta (com marcação): selo de risco visível; explicação recolhida. -->
      <DataTemplate x:Key="As.Change" DataType="{x:Type vm:ChangeRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="{Binding Title}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding BeforeAfter}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" FontFamily="{StaticResource Font.Numbers}"
                         Margin="0,2,0,0" Visibility="{Binding HasBeforeAfter, Converter={StaticResource BoolToVis}}"/>
              <!-- Recomendação por hardware ("Recomendado para o seu PC" / "Não indicado para notebook") -->
              <c:StatusChip Tone="{Binding FitTone}" Text="{Binding FitNote}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            Visibility="{Binding HasFitNote, Converter={StaticResource BoolToVis}}"/>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
              <c:StatusChip Tone="{Binding RiskTone}" Text="{Binding RiskChip}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding LevelChip}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- O que só o usuário pode fazer (comprar RAM, XMP, driver no site oficial). -->
      <DataTemplate x:Key="As.UserAction" DataType="{x:Type vm:UserActionRow}">
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:T Asst.AbrirPagina}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenCommand}" VerticalAlignment="Top"
                    Margin="12,0,0,0" Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"/>
            <c:Icon Data="{StaticResource Icon.User}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,1,12,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <!-- Linha do feed da tela de progresso: ícone de estado (pulsa quando roda), título e o detalhe (estimativa em itálico). -->
      <DataTemplate x:Key="As.FeedRow" DataType="{x:Type vm:ProcessFeedRow}">
        <Grid x:Name="Row" Margin="0,5" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StatusText}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="Badge" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Top" c:Pulse.IsOn="{Binding IsRunning}">
            <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}" Stroke="{Binding Tone, Converter={StaticResource ToneBrush}}" StrokeThickness="1"/>
            <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="13" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
            <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding Detail}"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="12,2,0,0"
                     VerticalAlignment="Top" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsChild}" Value="True">
            <Setter TargetName="Row" Property="Margin" Value="36,2,0,2"/>
            <Setter TargetName="Badge" Property="Width" Value="18"/>
            <Setter TargetName="Badge" Property="Height" Value="18"/>
            <Setter TargetName="Title" Property="FontSize" Value="13"/>
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsRunning}" Value="True">
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsPending}" Value="True">
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsEstimate}" Value="True">
            <Setter TargetName="Detail" Property="FontStyle" Value="Italic"/>
            <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- Mensagem da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ================================================================ TELA DE PROGRESSO (enquanto a etapa trabalha)
             Painel de telemetria: anel com %, tempo restante suavizado, decorrido, o que acontece agora (com selo "estimativa"
             quando é pelo tempo típico), barra das 13 etapas e o feed de tarefas com estado. Laços (varredura, giro, pulso) só
             com as animações do Windows ligadas. -->
        <Border Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.TraceLine}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True" Margin="0,0,0,18" SnapsToDevicePixels="True"
                Visibility="{Binding ProcessView.IsVisible, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding ProcessView.IsVisible}"
                AutomationProperties.Name="{l:T Asst.AndamentoEtapa}">
          <Grid>
            <Rectangle Fill="{StaticResource Brush.Graticule}" Opacity="0.35"/>
            <Rectangle>
              <Rectangle.Fill>
                <RadialGradientBrush Center="0.22,0.38" GradientOrigin="0.22,0.38" RadiusX="0.55" RadiusY="0.9">
                  <GradientStop Color="#22FFB547" Offset="0"/>
                  <GradientStop Color="#00FFB547" Offset="1"/>
                </RadialGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <c:ScanlineOverlay IsActive="{Binding ProcessView.IsRunning}"/>
            <!-- Cantoneiras de mira (HUD) -->
            <Path Data="M0,16 L0,0 L16,0" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
            <Path Data="M0,0 L16,0 L16,16" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
            <Path Data="M0,0 L0,16 L16,16" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Opacity="0.7"/>
            <Path Data="M16,0 L16,16 L0,16" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Opacity="0.7"/>

            <StackPanel Margin="30,24,30,22" DataContext="{Binding ProcessView}">
              <!-- Cabeçalho: modo · etapa, título e o selo "ao vivo" -->
              <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="{StaticResource Radius.Chip}" Padding="10,4"
                        Background="{Binding RingTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding RingTone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" Margin="0,0,7,0"
                             c:Pulse.IsOn="{Binding IsRunning}"/>
                    <TextBlock Text="{l:T Shell.Vivo}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{l:T Shell.Concluido}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"
                               Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Border>
                <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                  <Ellipse Fill="{StaticResource Brush.TraceSoft}" Stroke="{StaticResource Brush.TraceLine}" StrokeThickness="1"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Signal}" FontFamily="{StaticResource Font.Numbers}" FontSize="14">
                    <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Position, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </DockPanel>

              <!-- Anel + telemetria -->
              <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="236" Height="236" VerticalAlignment="Top">
                  <c:ProcessRing Value="{Binding Percent}" IsActive="{Binding IsRunning}" Tone="{Binding RingTone}" Thickness="13"/>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:AnimatedNumber Value="{Binding Percent}" Kind="Percent" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="58"
                                      Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Off"/>
                    <TextBlock Text="{l:T Shell.Concluido}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Margin="34,6,0,0">
                  <UniformGrid Columns="2" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="{l:T Shell.TempoRestante}" Style="{StaticResource Text.MetricLabel}"/>
                      <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource Font.Numbers}" FontSize="30" Foreground="{StaticResource Brush.Trace}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" AutomationProperties.Name="{l:T Shell.TempoRestante}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{l:T Shell.Decorrido}" Style="{StaticResource Text.MetricLabel}"/>
                      <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Font.Numbers}" FontSize="30" Foreground="{StaticResource Brush.Signal}"
                                 TextWrapping="NoWrap" Margin="0,2,0,0" AutomationProperties.Name="{l:T Shell.TempoDecorrido}"/>
                    </StackPanel>
                  </UniformGrid>

                  <Border Background="{StaticResource Brush.SurfaceLow}" BorderThickness="3,1,1,1"
                          CornerRadius="{StaticResource Radius.Control}" Padding="14,10">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFinished}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Chip}" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Top" Visibility="{Binding CurrentIsEstimate, Converter={StaticResource BoolToVis}}"
                                ToolTip="{l:T Asst.AplicadorRespondeFimCada}">
                          <TextBlock Text="{l:T Shell.Estimativa}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" FontSize="11.5"/>
                        </Border>
                        <TextBlock Text="{l:T Shell.Agora}" Style="{StaticResource Text.MetricLabel}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Text.Body}" FontSize="15" Margin="0,4,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding CurrentText}" AutomationProperties.LiveSetting="Polite"/>
                      <TextBlock Text="{Binding SummaryText}" FontFamily="{StaticResource Font.Numbers}" FontSize="22" Foreground="{StaticResource Brush.Good}" Margin="0,6,0,0"
                                 TextWrapping="Wrap" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding IsFinished}"
                                 AutomationProperties.LiveSetting="Assertive"/>
                      <TextBlock Text="{l:T Asst.RespondaJanelaConfirmacaoContinuar}" Style="{StaticResource Text.Small}"
                                 Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </Border>

                  <!-- Barra das 13 etapas -->
                  <DockPanel Margin="0,18,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}"/>
                    <TextBlock Text="{l:T Asst.N13Etapas}" Style="{StaticResource Text.MetricLabel}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Segments}" Focusable="False" Margin="-2,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ProcessSegment}">
                        <Border x:Name="Seg" Height="9" CornerRadius="2" Margin="2,0" Background="{StaticResource Brush.SurfaceHi}" ToolTip="{Binding Tip}"
                                AutomationProperties.Name="{Binding Tip}" c:Pulse.IsOn="{Binding IsCurrent}"/>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource Brush.Good}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource Brush.Line}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource Brush.Trace}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <!-- Feed: cada tarefa com estado; resultados do aplicador recuados embaixo do lote -->
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="{l:T Shell.AtualizaSozinho}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                <TextBlock Text="{l:T Shell.EstaAcontecendo}" Style="{StaticResource Text.H2}"/>
              </DockPanel>
              <Border Style="{StaticResource Panel.Inset}" Padding="14,8">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource As.FeedRow}" Focusable="False"/>
              </Border>

              <!-- Cancelar só onde é de verdade (leitura); aplicando, diz por que não. -->
              <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="{l:T Asst.CancelarLeitura}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding DataContext.CancelScanCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsApply, Converter={StaticResource BoolToVis}}">
                  <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{x:Static vm:AssistantProcess.CancelNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" MaxWidth="760"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Conteúdo normal da página (some enquanto a tela de progresso está na frente e volta com uma revelação curta) -->
        <StackPanel Visibility="{Binding ProcessView.IsHidden, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding ProcessView.IsHidden}">

        <!-- ================================================================ TELA INICIAL -->
        <StackPanel Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}">
          <c:HeroPanel Illustration="{StaticResource Illo.Assistant}" Title="{l:T Asst.DeixePcOtimizadoPasso}"
                       Number="{x:Static vm:AssistantPage.StepCount}" Suffix="{l:T Asst.Etapas}" Caption="{Binding StartText}"
                       ActionText="{Binding StartActionText}" Command="{Binding StartActionCommand}"
                       SecondaryText="{Binding RestartText}" SecondaryCommand="{Binding StartCommand}">
            <StackPanel Width="200">
              <c:StatusChip Tone="Good" Text="{l:T Asst.TudoPodeSerDesfeito}" HorizontalAlignment="Left"/>
              <c:StatusChip Tone="Info" Text="{l:T Asst.VoceConfirmaCadaGrupo}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <c:StatusChip Tone="Info" Text="{l:T Asst.RelatorioFim}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <Button Content="{l:T Asst.DesfazerTudoAssistenteFez}" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,14,0,0"
                      HorizontalAlignment="Left" Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </c:HeroPanel>

          <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Text="{l:T Asst.ComoFunciona}" Style="{StaticResource Text.H2}" Margin="0,0,0,14"/>
              <c:HowItWorks>
                <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Asst.Verifica}" Text="{l:T Asst.CadaEtapaLeParte}"/>
                <c:StepItem Icon="{StaticResource Icon.Info}" Title="{l:T Asst.Explica}" Text="{l:T Asst.MostraNumerosRecomendaRisco}"/>
                <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Pg.VoceConfirma}" Text="{l:T Pg.NadaAplicadoSemSeu}" Tone="Warn"/>
                <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Asst.RelatorioDesfazer}" Text="{l:T Asst.FimAntesDepoisTudo}" Tone="Good"/>
              </c:HowItWorks>
              <c:ExplainToggle Margin="0,12,0,0"
                               Content="{l:T Asst.N13EtapasSegurancaPrimeiro}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================================================================ TRILHA (início e passo a passo) -->
        <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" VerticalAlignment="Bottom"/>
          <TextBlock Text="{l:T Asst.N13Etapas}" Style="{StaticResource Text.H2}"/>
        </DockPanel>
        <Border Style="{StaticResource Panel.Card}" Padding="10,10,10,8" Margin="0,0,0,18">
          <ItemsControl ItemsSource="{Binding StepBar}" ItemTemplate="{StaticResource As.Node}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>

        <!-- ================================================================ PASSO A PASSO -->
        <StackPanel Visibility="{Binding InFlow, Converter={StaticResource BoolToVis}}">

          <!-- Destaque da etapa -->
          <c:HeroPanel Illustration="{Binding StepIllustrationKey, Converter={StaticResource ResourceByKey}}" Title="{Binding StepCounter}"
                       ValueText="{Binding StepTitle}" Caption="{Binding StepChecks}">
            <StackPanel Width="164">
              <c:RingMeter Value="{Binding ProgressPercent}" Label="{l:T Shell.Concluido}" Width="136" Height="136" Thickness="11" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </c:HeroPanel>
          <c:ExplainToggle Header="{l:T Asst.Importa}" Margin="0,0,0,16">
            <TextBlock Text="{Binding StepWhy}" Style="{StaticResource Text.Small}"/>
          </c:ExplainToggle>

          <!-- Verificando -->
          <Border Style="{StaticResource Panel.Card}" Padding="20,16" Margin="0,0,0,14" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="{l:T Asst.Cancelar}" Style="{StaticResource Button.Ghost}" Command="{Binding CancelScanCommand}"/>
                <c:Icon Data="{Binding StepIconKey, Converter={StaticResource ResourceByKey}}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
              <c:SkeletonLoader Shape="Tiles" Columns="3" Height="110"/>
            </StackPanel>
          </Border>

          <!-- Etapa normal -->
          <StackPanel Visibility="{Binding ShowStep, Converter={StaticResource BoolToVis}}">
            <StackPanel Visibility="{Binding IsNormalStep, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{l:T Asst.Encontrei}" Style="{StaticResource Text.H2}" Margin="0,0,0,10" Visibility="{Binding HasFacts, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding FactCards}" Focusable="False" Margin="-6,0,-6,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:FactCard}">
                    <c:StatTile Margin="6,0,6,12" Icon="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Value="{Binding Value}"
                                Label="{Binding Label}" Detail="{Binding Detail}" Tone="{Binding Tone}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False"/>

              <!-- Recomendação + ação principal -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <DockPanel>
                    <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                      <c:Icon Data="{StaticResource Icon.Sparkle}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                      <TextBlock Text="{l:T Asst.Recomendo}" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                      <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding ChangesSummary}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                 Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource As.Change}" Focusable="False" Margin="0,12,0,0"
                                Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding Choosing}"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="{l:T Asst.AplicarRecomendado}" Style="{StaticResource Button.Primary}" Command="{Binding ApplyRecommendedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:T Asst.AplicarMarcados}" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedCommand}" Margin="0,0,10,8"
                            Visibility="{Binding Choosing, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:T Asst.Escolher}" Style="{StaticResource Button.Secondary}" Command="{Binding ChooseCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:T Asst.Continuar}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding NoChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:T Asst.SeguirSemAplicar}" Style="{StaticResource Button.Ghost}" Command="{Binding ContinueCommand}" Margin="0,0,10,8"
                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{l:T Asst.PularEtapa}" Style="{StaticResource Button.Ghost}" Command="{Binding SkipCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Para revisar (nada é aplicado) -->
              <Border Style="{StaticResource Panel.Card}" Margin="0,14,0,0" Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <c:Icon Data="{StaticResource Icon.Search}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0"/>
                    <TextBlock Text="{l:T Asst.VoceRevisar}" Style="{StaticResource Text.H2}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Review}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Botões da etapa -->
              <ItemsControl ItemsSource="{Binding Extras}" Focusable="False" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,4">
                      <c:Icon Data="{StaticResource Icon.Info}" Size="13" Foreground="{StaticResource Brush.Signal}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                      <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ===== Relatório final ===== -->
            <StackPanel Visibility="{Binding IsReportStep, Converter={StaticResource BoolToVis}}">
              <UniformGrid Columns="3" Margin="-7,0,-7,16">
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding ReportAppliedNumber}" Tone="Good"
                            Label="{l:T Asst.MudancasAplicadas}" Detail="{l:T Asst.TodasDesfazerRegistrado}"/>
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Info}" Number="{Binding ReportSkippedNumber}"
                            Label="{l:T Asst.FicaramFora}" Detail="{l:T Asst.CadaMotivoRelatorio}"/>
                <c:StatTile Margin="7,0" Icon="{StaticResource Icon.User}" Number="{Binding ReportUserActionsNumber}" Tone="Warn"
                            Label="{l:T Asst.VoceFazer}" Detail="{l:T Asst.SoVocePodeResolver}"/>
              </UniformGrid>

              <TextBlock Text="{l:T Asst.AntesDepois}" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding ReportCards}" Focusable="False" Margin="-7,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ReportMetricCard}">
                    <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14" Padding="18,14">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}"/>
                        <c:BeforeAfter Before="{Binding Before}" After="{Binding After}" Kind="{Binding Kind}" HigherIsBetter="{Binding HigherIsBetter}"
                                       BeforeLabel="{l:T Shell.Antes}" AfterLabel="{l:T Shell.Depois}" Margin="0,10,0,0"
                                       Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Readout}" Margin="0,6,0,0"
                                   Visibility="{Binding NoBars, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding UserActions}" ItemTemplate="{StaticResource As.UserAction}" Focusable="False" Margin="0,6,0,0"/>

              <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,0" Padding="22,18" BorderBrush="{StaticResource Brush.TraceLine}">
                <StackPanel>
                  <DockPanel>
                    <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                      <c:Icon Data="{StaticResource Icon.ArrowRight}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                      <TextBlock Text="{l:T Asst.ProximoPasso}" Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Trace}"/>
                      <TextBlock Text="{Binding ReportNextStep}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenReportCommand}" Margin="0,0,10,8">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Page}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{l:T Settings.AbrirRelatorio}" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" Margin="0,0,10,8">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Export}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{l:T Asst.Exportar}" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <Button Content="{l:T Asst.Concluir}" Style="{StaticResource Button.Secondary}" Command="{Binding FinishCommand}" Margin="0,0,10,8"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding ReportPath}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ReportPath}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Resultado da etapa anterior -->
            <Border Background="{StaticResource Brush.GoodSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,14,0,0"
                    Visibility="{Binding StepResult, Converter={StaticResource NullToCollapsed}}" opt:Reveal.Trigger="{Binding StepResult}">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding StepResult}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- Navegação -->
          <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
            <WrapPanel>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}" Margin="0,0,10,8">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                    <c:Icon.RenderTransform>
                      <ScaleTransform ScaleX="-1"/>
                    </c:Icon.RenderTransform>
                  </c:Icon>
                  <TextBlock Text="{l:T Asst.Voltar}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="{l:T Asst.PararContinuarDepois}" Style="{StaticResource Button.Ghost}" Command="{Binding StopCommand}" Margin="0,0,10,8"/>
              <Button Content="{l:T Asst.DesfazerTudoAssistenteFez}" Style="{StaticResource Button.Danger}" Command="{Binding UndoAllCommand}" Margin="0,0,10,8"
                      Visibility="{Binding CanUndoAll, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
          </Border>
        </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
