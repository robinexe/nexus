<!--
  Laboratório da memória RAM (design system v2, docs/10-design-system.md):
    1. Destaque: pente + slot vazio (Illo.Ram), memória instalada contando, selo do modo de canal, "Medir velocidade".
    2. Slots e canais desenhados: cada pente encaixa no slot ao aparecer; slot vazio tracejado ("cabe mais um").
    3. Canal único explicado: antes → depois "1 pente × 2 pentes = a banda dobra" e como resolver em 3 passos.
    4. Velocidade medida: barras que enchem (teórico × leitura/escrita/cópia), latência; vazio = EmptyState.
    5. O que encontramos: cartões com selo; passos e fontes em "Por que isso?"; "Voltar para automático" + Desfazer.
    6. Impacto em jogos, memória do Windows agora (dois anéis), módulos instalados, medições anteriores, honestidade.
  Única escrita: "Voltar para automático" (arquivo de paginação), pelo aplicador, com Desfazer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:MemoryLabPage}">
    <DataTemplate.Resources>

      <!-- Um chip de memória no desenho do pente. -->
      <Style x:Key="Mem.Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SignalSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="2,0"/>
      </Style>

      <!-- Slot: pente desenhado (placa, 8 chips, contatos dourados com o chanfro) que desce e encaixa ao aparecer,
           ou slot vazio tracejado "cabe mais um pente". Detalhes técnicos na dica. -->
      <DataTemplate x:Key="Mem.Slot" DataType="{x:Type vm:MemSlotRow}">
        <StackPanel Width="270" Margin="0,0,0,12" ToolTip="{Binding Tip}" Background="Transparent">
          <DockPanel Margin="2,0,2,4">
            <TextBlock x:Name="size" DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="15"
                       Foreground="{StaticResource Brush.Trace}" TextWrapping="NoWrap"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </DockPanel>
          <Grid Height="70">
            <!-- O soquete na placa-mãe -->
            <Border Height="14" VerticalAlignment="Bottom" CornerRadius="3" Background="{StaticResource Brush.Bg}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"/>
            <!-- O pente -->
            <Grid x:Name="stick" Margin="8,0,8,5">
              <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
              </Grid.RenderTransform>
              <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-22" To="0"
                                       Duration="{x:Static shell:ShellMotion.Count}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static shell:ShellMotion.Count}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>
              <Border CornerRadius="4,4,2,2" Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.Signal}" BorderThickness="1.2"/>
              <UniformGrid Rows="1" Columns="8" Margin="10,9,10,20">
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
                <Border Style="{StaticResource Mem.Chip}"/>
              </UniformGrid>
              <!-- Contatos dourados com o chanfro -->
              <Grid Height="7" VerticalAlignment="Bottom" Margin="9,0,9,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Brush.Trace}" Opacity="0.75" CornerRadius="1"/>
                <Border Grid.Column="2" Background="{StaticResource Brush.Trace}" Opacity="0.75" CornerRadius="1"/>
              </Grid>
            </Grid>
            <!-- Slot vazio -->
            <Grid x:Name="empty" Margin="8,0,8,5" Visibility="Collapsed">
              <Rectangle RadiusX="4" RadiusY="4" Stroke="{StaticResource Brush.TextDim}" StrokeDashArray="4 3" StrokeThickness="1.2"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:Icon Data="{StaticResource Icon.Plus}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,8,0"/>
                <TextBlock Text="Vazio: cabe mais um pente" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="2,4,2,0"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Occupied}" Value="False">
            <Setter TargetName="stick" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="empty" Property="Visibility" Value="Visible"/>
            <Setter TargetName="size" Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Channel" DataType="{x:Type vm:MemChannelGroup}">
        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,14,0" Padding="16,12,16,4">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Brush.Good}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock x:Name="state" Text="  em uso" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource Mem.Slot}" Focusable="False"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding HasMemory}" Value="False">
            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.TextDim}"/>
            <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter TargetName="state" Property="Text" Value="  parado, sem pente"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Barra de banda: enche ao aparecer. Teórico em cinza (referência), medidos em âmbar. -->
      <DataTemplate x:Key="Mem.Bar" DataType="{x:Type vm:MemBarRow}">
        <Grid Margin="0,0,0,12" ToolTip="{Binding Detail}" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" Height="14" Margin="0,0,12,0" VerticalAlignment="Center">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
            <Grid RenderTransformOrigin="0,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="0"/>
              </Grid.RenderTransform>
              <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1"
                                       Duration="{x:Static shell:ShellMotion.Count}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>
              <Rectangle x:Name="bar" Fill="{StaticResource Brush.Trace}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5" RenderTransform="{Binding Fraction, Converter={StaticResource FractionScale}}">
              </Rectangle>
            </Grid>
          </Grid>
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" MinWidth="180"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsTheory}" Value="True">
            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Field" DataType="{x:Type vm:MemField}">
        <StackPanel Width="230" Margin="0,0,16,10">
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}"/>
          <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
        </StackPanel>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Source" DataType="{x:Type vm:MemSourceRow}">
        <Button Command="{Binding OpenCommand}" ToolTip="{Binding Url}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,0,0,0" Padding="8,2">
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Page}" Size="13" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
      </DataTemplate>

      <!-- Achado: distintivo, título, selo, evidência e recomendação (até 2 linhas cada). Passos e fontes recolhidos.
           A ação reversível (arquivo de paginação) e o Desfazer ficam sempre à vista. -->
      <DataTemplate x:Key="Mem.Finding" DataType="{x:Type vm:MemFindingRow}">
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
              <Ellipse Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                      Foreground="{Binding ToneKind, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1">
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneKind}" Text="{Binding SeverityText}" VerticalAlignment="Top" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}" Margin="0,4,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Evidence}"/>
              <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                         MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Recommendation}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                <Button Content="Voltar para automático" Style="{StaticResource Button.Secondary}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
                <Button Command="{Binding RevertCommand}" Style="{StaticResource Button.Secondary}" Margin="0"
                        Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
              <c:ExplainToggle Margin="0,4,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,3">
                          <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" Foreground="{StaticResource Brush.Trace}" Margin="0,2,6,0" VerticalAlignment="Top"/>
                          <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Mem.Source}" Focusable="False" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação / erro de leitura -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Ram}" Title="Memória instalada"
                     Number="{Binding InstalledBytes}" Kind="Bytes" ValueText="{Binding HeroFallback}" IsLoading="{Binding IsLoading}" Caption="{Binding Headline}"
                     ActionText="Medir velocidade (≈ 15 s)" Command="{Binding MeasureCommand}"
                     SecondaryText="{Binding CancelText}" SecondaryCommand="{Binding CancelCommand}">
          <StackPanel Width="230">
            <c:StatusChip Tone="{Binding ChannelTone}" Text="{Binding ChannelModeText}" HorizontalAlignment="Left"
                          Visibility="{Binding ChannelModeText, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="{Binding SlotsText}" FontFamily="{StaticResource Font.Numbers}" FontSize="18" Foreground="{StaticResource Brush.Text}" Margin="0,10,0,2"/>
            <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Text.Small}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,8,0,0"
                       Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Slots e canais ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,20">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.Ram}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Onde estão os pentes" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="Cada canal é uma estrada até o processador. Canal sem pente fica parado." Style="{StaticResource Text.Small}" Margin="0,0,0,14"/>
            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="4,0,4,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource Mem.Channel}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <c:ExplainToggle Header="De onde vem este desenho?" Margin="0,8,0,0" Content="{Binding ChannelText}"/>
          </StackPanel>
        </Border>

        <!-- ===== 3. Canal único explicado ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,20" Visibility="{Binding IsSingleChannel, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:StatusChip DockPanel.Dock="Right" Tone="Warn" Text="Canal único" VerticalAlignment="Top"/>
              <c:Icon Data="{StaticResource Icon.TrendUp}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,0,8,0"/>
              <TextBlock Text="Um segundo pente igual dobra a estrada" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="Com 1 pente só um canal trabalha. Com 2 pentes iguais, os dois canais trabalham juntos."
                       Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Visibility="{Binding ShowDualDemo, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Largura de banda teórica (GB/s)" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                <c:BeforeAfter Before="{Binding TheoryGbps}" After="{Binding DualTheoryGbps}" BeforeLabel="1 pente (agora)" AfterLabel="2 pentes iguais"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding GamingHeadline}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Faixas de testes públicos, não promessa: depende do jogo e da placa de vídeo." Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                <c:ExplainToggle Margin="0,4,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding GamingDetail}" Style="{StaticResource Text.Small}"/>
                    <TextBlock Text="{Binding TheoryText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                    <ItemsControl ItemsSource="{Binding GamingSources}" ItemTemplate="{StaticResource Mem.Source}" Focusable="False" Margin="0,6,0,0"/>
                  </StackPanel>
                </c:ExplainToggle>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,16,0,0" Visibility="{Binding ShowUpgradeSteps, Converter={StaticResource BoolToVis}}">
              <c:HowItWorks>
                <c:StepItem Icon="{StaticResource Icon.Search}" Title="Compre igual" Text="Mesmo tamanho, tipo e velocidade do pente que já está aí."/>
                <c:StepItem Icon="{StaticResource Icon.Plus}" Title="Encaixe no vazio" Text="PC desligado e fora da tomada. O slot tracejado acima." Tone="Warn"/>
                <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Meça de novo" Text="O dual channel liga sozinho. Compare aqui o antes e depois." Tone="Good"/>
              </c:HowItWorks>
            </Border>
          </StackPanel>
        </Border>

        <!-- ===== 4. Velocidade medida ===== -->
        <TextBlock Text="Velocidade medida" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <c:EmptyState Illustration="{StaticResource Illo.Ram}" Text="Velocidade ainda não medida."
                      Detail="Uns 15 segundos lendo e escrevendo na memória. Feche jogos e deixe o carregador ligado. Não muda nada."
                      ActionText="Medir velocidade" Command="{Binding MeasureCommand}" Margin="0,0,0,20"
                      Visibility="{Binding HasBars, Converter={StaticResource FalseToVisible}}"/>
        <Grid Margin="0,0,0,20" Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="260"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <c:Icon Data="{StaticResource Icon.Measure}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Largura de banda" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <WrapPanel Margin="0,4,0,12">
                <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.TextDim}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="teórico (o máximo da configuração)" Style="{StaticResource Text.Small}" Margin="0,0,16,0"/>
                <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.Trace}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="medido agora" Style="{StaticResource Text.Small}"/>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource Mem.Bar}" Focusable="False"/>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                         MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Verdict}"/>
              <c:ExplainToggle Header="Como foi medido" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{Binding TheoryText}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding LatencyDetail}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <c:StatTile Icon="{StaticResource Icon.Bolt}" Label="Leitura" Value="—" Number="{Binding ReadGbps}" Decimals="1" Suffix=" GB/s"
                        Detail="Quanto o processador consegue puxar por segundo." Margin="0,0,0,14"/>
            <c:StatTile Icon="{StaticResource Icon.History}" Label="Latência da RAM" Value="—" Number="{Binding LatencyNs}" Decimals="1" Suffix=" ns"
                        Detail="Espera por cada ida à memória. Menor é melhor."/>
          </StackPanel>
        </Grid>

        <!-- ===== 5. O que encontramos ===== -->
        <TextBlock Text="O que encontramos" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <c:SkeletonLoader Shape="Lines" Lines="4" Margin="4,0,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource Mem.Finding}" Focusable="False" Margin="0,0,0,8"/>

        <!-- ===== 6. Memória do Windows agora ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,20">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Command="{Binding RefreshStateCommand}" Style="{StaticResource Button.Ghost}" Margin="0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <c:Icon Data="{StaticResource Icon.Windows}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Memória do Windows agora" Style="{StaticResource Text.H2}" FontSize="15.5" VerticalAlignment="Center"/>
            </DockPanel>
            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="4,0,4,8" Visibility="{Binding HasState, Converter={StaticResource FalseToVisible}}"/>
            <Grid Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <c:RingMeter Value="{Binding UsedPercent}" WarnAt="85" BadAt="95" HigherIsBetter="False" Label="em uso" Width="118" Height="118" Thickness="10"/>
              <c:RingMeter Grid.Column="1" Value="{Binding CommitPercent}" WarnAt="80" BadAt="90" HigherIsBetter="False" Label="do limite"
                           Width="118" Height="118" Thickness="10" Margin="18,0,0,0"/>
              <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                           Text="O que importa é o segundo anel: memória prometida aos programas perto do limite (RAM + arquivo de paginação)."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="Em cache, pronta para devolver:" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <c:AnimatedNumber Value="{Binding StandbyBytes}" Kind="Bytes" FontFamily="{StaticResource Font.Numbers}" FontSize="16" Foreground="{StaticResource Brush.Signal}"/>
                </StackPanel>
                <c:ExplainToggle Header="Todos os números do Windows" Margin="0,4,0,0">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding WindowsState}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MemField}">
                          <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="200"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StateNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                               Visibility="{Binding StateNote, Converter={StaticResource NullToCollapsed}}"/>
                  </StackPanel>
                </c:ExplainToggle>
                <Button Content="Quem está usando a memória?" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,2,0,0"
                        Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MemoryDoctorPage"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Honestidade: sem "limpador de RAM" (o aviso continua visível; a explicação, recolhida) -->
        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,20">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,1,10,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="Por que não há &quot;limpador de RAM&quot;: memória livre vira cache de propósito, e esvaziar não acelera."
                         Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <c:ExplainToggle Margin="0,2,0,0" Content="{x:Static vm:MemoryLabPage.MythText}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Módulos instalados -->
        <TextBlock Text="Pentes instalados" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Modules}" Focusable="False" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MemModuleRow}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon Data="{StaticResource Icon.Ram}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{Binding Decoded}" Style="{StaticResource Text.Readout}" FontSize="19" LineHeight="26" Margin="0,2,0,2"/>
                    <TextBlock Text="{Binding Confidence}" Style="{StaticResource Text.Small}"/>
                    <c:ExplainToggle Header="Ficha completa do pente" Margin="0,4,0,0">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource Mem.Field}" Focusable="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Medições anteriores -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,20" Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.History}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Medições anteriores" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="{Binding CompareText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,0,0,10"
                       Visibility="{Binding CompareText, Converter={StaticResource NullToCollapsed}}"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Quando" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="1" Text="Configuração" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="2" Text="Leitura" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="3" Text="Escrita" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="4" Text="Cópia" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="5" Text="Latência" Style="{StaticResource Text.Label}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MemRunRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding When}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Configuration}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 ToolTip="{Binding Configuration}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Read}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Write}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Grid.Column="4" Text="{Binding Copy}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Grid.Column="5" Text="{Binding Latency}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Banda em GB/s. Arquivos em %LocalAppData%\NEXUS\lab\memory." Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <c:ExplainToggle Header="O que dá para ver sem driver?" Margin="0,0,0,14" Content="{x:Static vm:MemoryLabPage.NoDriverText}"/>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
