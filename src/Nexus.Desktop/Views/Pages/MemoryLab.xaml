<!--
  Laboratório da memória RAM: cabeçalho com a configuração (destaque para single channel), diagrama de slots por canal,
  ficha de cada módulo (SMBIOS + número de peça decodificado), medição de banda vs teórico e latência, achados com fontes,
  impacto em jogos, estado da memória do Windows e comparação com medições anteriores.
  Única escrita: "Voltar para automático" (arquivo de paginação), pelo aplicador, com Desfazer.
  Recursos locais em DataTemplate.Resources; do tema, só chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels">
  <DataTemplate DataType="{x:Type vm:MemoryLabPage}">
    <DataTemplate.Resources>

      <!-- Cor por gravidade/tom: bad (vermelho), warn (âmbar), good (verde), demais (ciano). -->
      <Style x:Key="Mem.Tone" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Severity}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Severity}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Mem.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Slot: ocupado (preenchido, ciano) ou vazio (tracejado). -->
      <DataTemplate x:Key="Mem.Slot" DataType="{x:Type vm:MemSlotRow}">
        <Grid Width="168" Height="62" Margin="0,0,0,8" ToolTip="{Binding Tip}">
          <Border x:Name="fill" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.SignalSoft}"
                  BorderBrush="{StaticResource Brush.Signal}" BorderThickness="1"/>
          <Rectangle x:Name="dash" RadiusX="6" RadiusY="6" Stroke="{StaticResource Brush.TextDim}" StrokeDashArray="4 3" StrokeThickness="1" Visibility="Collapsed"/>
          <StackPanel Margin="12,8">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock x:Name="size" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}" Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Occupied}" Value="False">
            <Setter TargetName="fill" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
            <Setter TargetName="size" Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Channel" DataType="{x:Type vm:MemChannelGroup}">
        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,12,0" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Signal}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource Mem.Slot}" Focusable="False"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding HasMemory}" Value="False">
            <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Field" DataType="{x:Type vm:MemField}">
        <StackPanel Width="230" Margin="0,0,16,10">
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}"/>
          <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}"/>
        </StackPanel>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Bar" DataType="{x:Type vm:MemBarRow}">
        <Grid Margin="0,0,0,12" ToolTip="{Binding Detail}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" Height="14" Margin="0,0,12,0" VerticalAlignment="Center">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
            <Rectangle x:Name="bar" Fill="{StaticResource Brush.Trace}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
              <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Fraction}"/>
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" MinWidth="190"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Label}" Value="Teórico">
            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Source" DataType="{x:Type vm:MemSourceRow}">
        <Button Content="{Binding Title}" Command="{Binding OpenCommand}" ToolTip="{Binding Url}" Style="{StaticResource Button.Ghost}"
                HorizontalAlignment="Left" Margin="-8,0,0,0" Padding="8,2"/>
      </DataTemplate>

      <DataTemplate x:Key="Mem.Finding" DataType="{x:Type vm:MemFindingRow}">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding SeverityText}" Style="{StaticResource Mem.Tone}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,2,0,6"/>
            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
            <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0" Focusable="False"
                          Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="›" Foreground="{StaticResource Brush.Trace}" Style="{StaticResource Text.Body}"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Body}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
              <Button Content="Voltar para automático" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
              <Button Content="Desfazer" Style="{StaticResource Button.Secondary}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"/>
            <TextBlock Text="Fontes" Style="{StaticResource Text.Label}" Margin="0,8,0,2"/>
            <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Mem.Source}" Focusable="False"/>
          </StackPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,28" MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,16"/>

        <!-- Cabeçalho: a configuração em uma linha -->
        <Border Style="{StaticResource Panel.Hero}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Sua memória" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Mem.Headline}" Margin="0,4,0,6"/>
            <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Body}"/>
            <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- Diagrama de slots -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Slots e canais" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding ChannelText}" Style="{StaticResource Text.Small}" Margin="0,2,0,12"/>
            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource Mem.Channel}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Módulos -->
        <TextBlock Text="Módulos instalados" Style="{StaticResource Text.H2}" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MemModuleRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{Binding Decoded}" Style="{StaticResource Text.Readout}" Margin="0,2,0,2"/>
                  <TextBlock Text="{Binding Confidence}" Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
                  <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource Mem.Field}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Medição -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,4,0,16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Banda e latência medidas" Style="{StaticResource Text.H2}"/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,16,0"
                           Text="Lê, escreve e copia blocos de centenas de MB com todas as threads (várias passadas, mediana) e mede a latência seguindo ponteiros aleatórios num bloco maior que o cache. Leva uns 15 segundos; feche jogos e deixe o carregador ligado. Não muda nada no sistema."/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Cancelar" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding Measuring, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Medir banda e latência" Style="{StaticResource Button.Primary}" Command="{Binding MeasureCommand}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding TheoryText}" Style="{StaticResource Text.Body}" Margin="0,10,0,10"/>
            <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource Mem.Bar}" Focusable="False"/>
            <Border Style="{StaticResource Panel.Inset}" Margin="0,4,0,0" Padding="14,10">
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Body}"/>
            </Border>
            <Grid Margin="0,14,0,0" Visibility="{Binding HasBars, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Latência da RAM" Style="{StaticResource Text.MetricLabel}"/>
                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding LatencyDetail}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Achados -->
        <TextBlock Text="O que encontramos" Style="{StaticResource Text.H2}" Margin="0,0,0,8"/>
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource Mem.Finding}" Focusable="False"/>

        <!-- Impacto em jogos -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Impacto estimado em jogos" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{Binding GamingHeadline}" Style="{StaticResource Text.H2}" Margin="0,2,0,6"/>
            <TextBlock Text="{Binding GamingDetail}" Style="{StaticResource Text.Body}"/>
            <TextBlock Text="Faixas de testes públicos, não uma promessa: o efeito real depende do jogo, da resolução e da placa de vídeo." Style="{StaticResource Text.Small}" Margin="0,6,0,6"/>
            <ItemsControl ItemsSource="{Binding GamingSources}" ItemTemplate="{StaticResource Mem.Source}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Estado do Windows -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Memória do Windows agora" Style="{StaticResource Text.H2}"/>
              <Button Grid.Column="1" Content="Ler de novo" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshStateCommand}"/>
            </Grid>
            <TextBlock Text="{Binding StateNote}" Style="{StaticResource Text.Small}" Margin="0,2,0,8"/>
            <ItemsControl ItemsSource="{Binding WindowsState}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MemField}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Comparação -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16" Visibility="{Binding HasRuns, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Medições anteriores" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding CompareText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Trace}" Margin="0,4,0,10"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Quando" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="1" Text="Configuração" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="2" Text="Leitura" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="3" Text="Escrita" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="4" Text="Cópia" Style="{StaticResource Text.Label}"/>
              <TextBlock Grid.Column="5" Text="Latência" Style="{StaticResource Text.Label}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MemRunRow}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Body}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Configuration}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding Read}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Write}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Copy}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Latency}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Banda em GB/s. Arquivos em %LocalAppData%\NEXUS\lab\memory." Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- Honestidade -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Por que não há &quot;limpador de RAM&quot;" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{x:Static vm:MemoryLabPage.MythText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel.Inset}" Padding="16,12">
          <StackPanel>
            <TextBlock Text="O que dá para ver sem driver" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{x:Static vm:MemoryLabPage.NoDriverText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
