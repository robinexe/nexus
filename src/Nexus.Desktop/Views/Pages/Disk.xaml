<!--
  Espaço em disco (design system v2, docs/10-design-system.md):
    1. Destaque: SSD + "X GB livres" contando na unidade escolhida, anel de % usado, "Analisar esta unidade" / "Escolher uma pasta…".
    2. Unidades como cartões com anel pequeno. Como funciona: lê → desenha → explica → você decide.
    3. Lendo: números contando ao vivo (bytes e arquivos) + esqueleto no lugar do mapa. Sem análise: estado vazio com a ação.
    4. Resultado: 4 números; o treemap em destaque (blocos crescem ao entrar numa pasta) com "Nesta pasta" ao lado; os maiores
       arquivos como cartões (cor = tipo, a mesma do mapa); por tipo; pastas conhecidas explicadas (selo de tom; detalhe recolhido).
    5. Exclusão segura (irreversível) numa seção vermelha recolhida; o selo "Sem desfazer" fica sempre visível.
  A lógica é a mesma do DiskPage (só foram expostos números para a apresentação: FreeBytes, UsedPercentValue, ScannedBytes…).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:disk="clr-namespace:Nexus.Desktop.Views.Modules.Disk">
  <DataTemplate DataType="{x:Type vm:DiskPage}">
    <DataTemplate.Resources>
      <!-- Barra fina de proporção (0..1). -->
      <Style x:Key="D.Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid>
                <Border x:Name="PART_Track" Background="{StaticResource Brush.Bg}" CornerRadius="2"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="D.Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>
      <!-- Cartão de unidade (lista com seleção). -->
      <Style x:Key="D.VolumeItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="card" Width="236" Margin="0,0,12,12" Padding="14,12" Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
                  <Setter TargetName="card" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Linha clicável sem cara de botão. -->
      <Style x:Key="D.RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bg" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="8,6">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Hover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.SignalSoft}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Título de seção com ícone. -->
      <DataTemplate x:Key="D.SectionTitle">
        <StackPanel Orientation="Horizontal">
          <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding}" Style="{StaticResource Text.H2}" FontSize="15.5" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>
      <!-- Linha da lista recolhida dos maiores arquivos. -->
      <DataTemplate x:Key="D.FileLine" DataType="{x:Type vm:DiskFileRow}">
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="10" Height="10" CornerRadius="2" Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding Path}"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource D.Num}" VerticalAlignment="Center" Margin="12,0"/>
          <Button Grid.Column="3" Content="{l:T Disk.Explorer}" Style="{StaticResource Button.Ghost}" VerticalAlignment="Center"
                  Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}"
                  ToolTip="{l:T Disk.MostrarExplorerSoAbre}" AutomationProperties.Name="{Binding Name, StringFormat={l:T Disk.MostrarExplorerN}}"/>
        </Grid>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque: espaço livre da unidade escolhida ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Disk}" Title="{Binding HeroTitle}"
                     Number="{Binding FreeBytes}" Kind="Bytes" IsLoading="{Binding VolumesLoading}"
                     Caption="{l:T Disk.VejaOcupaDiscoPasta}"
                     ActionText="{l:T Disk.AnalisarEstaUnidade}" Command="{Binding AnalyzeVolumeCommand}"
                     SecondaryText="{l:T Disk.EscolherPasta}" SecondaryCommand="{Binding AnalyzeFolderCommand}">
          <StackPanel Width="170">
            <c:RingMeter Value="{Binding UsedPercentValue}" WarnAt="85" BadAt="95" HigherIsBetter="False" Label="{l:T Disk.Usado}"
                         Width="128" Height="128" Thickness="10" HorizontalAlignment="Center"/>
            <TextBlock DataContext="{Binding SelectedVolume}" Text="{Binding MediaText}" Style="{StaticResource Text.Small}"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Unidades ===== -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ContentControl Content="{l:T Disk.Unidades}" Tag="{StaticResource Icon.Disk}" ContentTemplate="{StaticResource D.SectionTitle}" Focusable="False"/>
          <Button Grid.Column="1" Command="{Binding RefreshVolumesCommand}" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="{l:T Disk.AtualizarUnidades}" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
        </Grid>
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="86" Margin="0,4,0,12" Visibility="{Binding VolumesLoading, Converter={StaticResource BoolToVis}}"/>
        <ListBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" ItemContainerStyle="{StaticResource D.VolumeItem}"
                 Background="Transparent" BorderThickness="0" Margin="0,4,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{l:T Disk.Unidades}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DiskVolumeRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <c:RingMeter Value="{Binding UsedPercentValue}" WarnAt="85" BadAt="95" HigherIsBetter="False"
                             Width="54" Height="54" Thickness="5" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{Binding MediaText}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock x:Name="free" Text="{Binding FreeShort}" Style="{StaticResource D.Num}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding AlmostFull}" Value="True">
                  <Setter TargetName="free" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Como funciona -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <c:HowItWorks>
            <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Pg.Le}" Text="{l:T Disk.MedePastasArquivosSo}"/>
            <c:StepItem Icon="{StaticResource Icon.Disk}" Title="{l:T Disk.Desenha}" Text="{l:T Disk.CadaBlocoMapaTem}" Tone="Warn"/>
            <c:StepItem Icon="{StaticResource Icon.Info}" Title="{l:T Asst.Explica}" Text="{l:T Disk.DizCadaPastaGrande}"/>
            <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Disk.VoceDecide}" Text="{l:T Disk.AbraExplorerOuUse}" Tone="Good"/>
          </c:HowItWorks>
        </Border>

        <!-- ===== 3. Lendo: números ao vivo + esqueleto do mapa ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16" Visibility="{Binding Scanning, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{l:T Disk.LidoAteAgora}" Style="{StaticResource Text.Small}"/>
                <c:AnimatedNumber Value="{Binding ScannedBytes}" Kind="Bytes" FontFamily="{StaticResource Font.Numbers}" FontSize="28" Foreground="{StaticResource Brush.Trace}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,24,0">
                <TextBlock Text="{l:T Clean.Arquivos}" Style="{StaticResource Text.Small}"/>
                <c:AnimatedNumber Value="{Binding ScannedFiles}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="28" Foreground="{StaticResource Brush.Text}"/>
              </StackPanel>
              <c:StatusChip Grid.Column="2" Tone="Info" Text="{l:T Disk.SoLeitura}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Button Grid.Column="3" Content="{l:T Asst.Cancelar}" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar IsIndeterminate="{Binding Scanning, Mode=OneWay}" Height="3" Margin="0,12,0,8"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
            <c:SkeletonLoader Shape="Tiles" Columns="4" Height="180" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <c:EmptyState Illustration="{StaticResource Illo.Disk}" Text="{l:T Disk.AindaSemMapaDesta}"
                      Detail="{l:T Disk.AnaliseLePastasMostra}"
                      ActionText="{l:T Disk.AnalisarEstaUnidade}" Command="{Binding AnalyzeVolumeCommand}" Margin="0,0,0,16"
                      Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- ===== 4. Resultado ===== -->
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <UniformGrid Columns="4" Margin="-7,0,-7,8">
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Disk}" Number="{Binding ResultBytes}" Kind="Bytes" Tone="Warn"
                        Label="{l:T Disk.Analisado}" Detail="{Binding ResultTimeText}"/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Page}" Number="{Binding ResultFiles}" Decimals="0"
                        Label="{l:T Clean.Arquivos}" Detail="{l:T Disk.Contados}"/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Catalog}" Number="{Binding ResultFolders}" Decimals="0"
                        Label="{l:T Disk.Pastas}" Detail="{l:T Disk.LinksJuncoesNaoSao}"/>
            <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Lock}" Number="{Binding ResultSkipped}" Decimals="0"
                        Label="{l:T Disk.PastasPuladas}" Detail="{Binding ResultSkippedDetail}"/>
          </UniformGrid>
          <c:ExplainToggle Header="{l:T Clean.OndeVemEstesNumeros}" Margin="0,0,0,14" Content="{Binding Summary}"/>

          <!-- Mapa em destaque -->
          <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{l:T Disk.MapaDisco}" Tag="{StaticResource Icon.Disk}" ContentTemplate="{StaticResource D.SectionTitle}" Focusable="False"/>
                <TextBlock Grid.Column="1" Text="{Binding FolderTitle}" Style="{StaticResource D.Num}" Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderTitle}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="12" Height="12" CornerRadius="2" Background="#163A48" BorderBrush="{StaticResource Brush.Signal}" BorderThickness="1" VerticalAlignment="Center"/>
                  <TextBlock Text="{l:T Disk.PastaCliqueEntrar}" Style="{StaticResource Text.Small}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                  <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Trace}" VerticalAlignment="Center"/>
                  <TextBlock Text="{l:T Disk.ArquivoCorTipo}" Style="{StaticResource Text.Small}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Migalhas de pão -->
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}" Command="{Binding UpCommand}" Margin="-8,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.ChevronUp}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{l:T Disk.Subir}" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskCrumb}">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Label}" Style="{StaticResource Button.Ghost}" Padding="4,2"
                                Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="2,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.2*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*" MinWidth="230"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel.Inset}" Padding="4">
                  <disk:TreemapView Height="460" Tiles="{Binding Tiles}" OpenCommand="{Binding OpenTileCommand}"
                                    AutomationProperties.Name="{l:T Disk.MapaDiscoCliqueNuma}"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel.Inset}" Padding="10,12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T Disk.NestaPasta}" Style="{StaticResource Text.H2}" FontSize="14.5" Margin="8,0,0,8"/>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Focusable="False">
                      <ItemsControl ItemsSource="{Binding Children}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:DiskFolderRow}">
                            <Button Style="{StaticResource D.RowButton}" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                              <StackPanel>
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource D.Num}" Foreground="{StaticResource Brush.Trace}" Margin="8,0,0,0"/>
                                  <c:Icon Data="{StaticResource Icon.Catalog}" Size="14" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource D.Bar}" Value="{Binding Fraction, Mode=OneWay}" Margin="0,5,0,0"/>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Maiores arquivos como cartões -->
          <ContentControl Content="{l:T Disk.MaioresArquivos}" Tag="{StaticResource Icon.TrendUp}" ContentTemplate="{StaticResource D.SectionTitle}" Focusable="False" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding TopCards}" Focusable="False" Margin="-7,0,-7,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DiskFileRow}">
                <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="7,0,7,14">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="36" Height="36" Margin="0,0,10,0">
                        <Ellipse Fill="{StaticResource Brush.SurfaceHi}"/>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="18" Foreground="{Binding ColorHex}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="NoWrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="20" Foreground="{StaticResource Brush.Trace}"
                                 VerticalAlignment="Center" TextWrapping="NoWrap" Margin="8,0,0,0"/>
                    </Grid>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0"
                            Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}"
                            AutomationProperties.Name="{Binding Name, StringFormat={l:T Disk.MostrarExplorerN}}">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{l:T Disk.MostrarExplorer}" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <StackPanel Margin="0,10,0,0">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 ToolTip="{Binding Path}"/>
                      <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 ToolTip="{Binding Path}"/>
                      <ProgressBar Style="{StaticResource D.Bar}" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding ColorHex}" Margin="0,8,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState Illustration="{StaticResource Illo.Disk}" Text="{l:T Disk.NenhumArquivoGrandeAqui}" Detail="{l:T Disk.EstaPastaSoTem}"
                        Visibility="{Binding HasTopFiles, Converter={StaticResource FalseToVisible}}" Margin="0,0,0,14"/>
          <Border Style="{StaticResource Panel.Inset}" Padding="14,6,14,10" Margin="0,0,0,16" Visibility="{Binding HasMoreFiles, Converter={StaticResource BoolToVis}}">
            <c:ExplainToggle Header="{Binding MoreFilesHeader}">
              <ItemsControl ItemsSource="{Binding MoreFiles}" ItemTemplate="{StaticResource D.FileLine}" Focusable="False" Margin="0,6,0,0"/>
            </c:ExplainToggle>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="260"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Por tipo (a mesma cor do mapa) -->
            <Border Style="{StaticResource Panel.Card}" Padding="16,14" VerticalAlignment="Top">
              <StackPanel>
                <ContentControl Content="{l:T Disk.Tipo}" Tag="{StaticResource Icon.Apps}" ContentTemplate="{StaticResource D.SectionTitle}" Focusable="False" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskCategoryRow}">
                      <Grid Margin="0,0,0,12" ToolTip="{Binding FilesText}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="16" Foreground="{Binding ColorHex}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource D.Num}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource D.Num}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                          </DockPanel>
                          <ProgressBar Style="{StaticResource D.Bar}" Height="6" Value="{Binding Fraction, Mode=OneWay}" Foreground="{Binding ColorHex}" Margin="0,5,0,0"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Pastas conhecidas explicadas -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="16,14" VerticalAlignment="Top">
              <StackPanel>
                <ContentControl Content="{l:T Disk.SaoCoisasGrandes}" Tag="{StaticResource Icon.Info}" ContentTemplate="{StaticResource D.SectionTitle}" Focusable="False" Margin="0,0,0,6"/>
                <TextBlock Text="{l:T Disk.NenhumaPastaConhecidaNesta}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                           Visibility="{Binding HasInsights, Converter={StaticResource FalseToVisible}}"/>
                <ItemsControl ItemsSource="{Binding Insights}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskInsightRow}">
                      <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                            <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                                    Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                          </Grid>
                          <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                            <c:StatusChip Tone="{Binding Tone}" Text="{Binding KindLabel}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"
                                       MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Advice}"/>
                            <c:ExplainToggle Margin="0,2,0,0">
                              <StackPanel>
                                <TextBlock Text="{Binding What}" Style="{StaticResource Text.Small}"/>
                                <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                                <TextBox Text="{Binding Command, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="280"
                                         FontFamily="Consolas" Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}"
                                         ToolTip="{l:T Disk.ComandoOficialCopieRode}"
                                         AutomationProperties.Name="{l:T Disk.ComandoOficialCopiar}"/>
                              </StackPanel>
                            </c:ExplainToggle>
                          </StackPanel>
                          <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Numbers}" FontSize="18" Foreground="{StaticResource Brush.Trace}"
                                       HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                            <Button Content="{l:T Disk.MostrarExplorer}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" Margin="0,2,-8,0"
                                    Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Path}"
                                    AutomationProperties.Name="{Binding Title, StringFormat={l:T Disk.MostrarExplorerN}}"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- ===== 5. Exclusão segura: recolhida, vermelha, irreversível ===== -->
        <Border Style="{StaticResource Panel.Card}" BorderBrush="{StaticResource Brush.Bad}" Background="{StaticResource Brush.BadSoft}" Padding="12,8,16,8" Margin="0,24,0,0">
          <StackPanel>
            <Expander Margin="0" AutomationProperties.Name="{l:T Disk.ExclusaoSeguraIrreversivel}">
              <Expander.Header>
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Right" Tone="Bad" Text="{l:T Disk.SemDesfazer}" VerticalAlignment="Center"/>
                  <c:Icon Data="{StaticResource Icon.Trash}" Size="18" Foreground="{StaticResource Brush.Bad}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T Disk.ExclusaoSegura}" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Bad}" FontSize="15.5"/>
                    <TextBlock Text="{l:T Disk.ApagaArquivoNinguemRecuperar}" Style="{StaticResource Text.Small}"/>
                  </StackPanel>
                </DockPanel>
              </Expander.Header>
              <Grid Margin="28,4,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                  <c:HowItWorks Margin="0,0,0,8">
                    <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Priv.Escolhe}" Text="{l:T Disk.ArquivoComumForaWindows}"/>
                    <c:StepItem Icon="{StaticResource Icon.Bolt}" Title="{l:T Disk.Sobrescreve}" Text="{l:T Disk.DadosAleatoriosCimaConteudo}" Tone="Warn"/>
                    <c:StepItem Icon="{StaticResource Icon.Trash}" Title="{l:T Disk.Apaga}" Text="{l:T Disk.SemLixeiraSemQuarentena}" Tone="Bad"/>
                  </c:HowItWorks>
                  <c:ExplainToggle>
                    <StackPanel>
                      <TextBlock Style="{StaticResource Text.Small}"
                                 Text="{l:T Disk.NexusGravaDadosAleatorios}"/>
                      <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                 Text="{l:T Disk.SsdNvmeSobrescritaNao}"/>
                    </StackPanel>
                  </c:ExplainToggle>
                </StackPanel>
                <Button Grid.Column="1" Content="{l:T Disk.EscolherArquivo}" Style="{StaticResource Button.Danger}" Command="{Binding SecureDeleteCommand}"
                        VerticalAlignment="Center" AutomationProperties.Name="{l:T Disk.ExclusaoSeguraArquivoIrreversivel}"/>
              </Grid>
            </Expander>
            <Border Style="{StaticResource Panel.Notice}" Padding="10,8" Margin="0,6,0,4" Visibility="{Binding SecureDeleteNote, Converter={StaticResource NullToCollapsed}}">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding SecureDeleteNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
