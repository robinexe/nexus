<!--
  Atualizar drivers (design system v2, docs/10-design-system.md):
    1. Destaque: chip com seta, "N atualizações" contando depois da busca (esqueleto durante), contagens por grupo à direita;
       ação principal "Procurar atualizações".
    2. Placa de vídeo em destaque: ilustração, nome, selos (dedicada/integrada, fabricante), versão, idade do driver em dias na
       cor do veredito, e os botões oficiais (página e app do fabricante).
    3. Como funciona: Procura → Escolhe → Instala → Desfaz.
    4. Atualizações agrupadas (recomendadas, opcionais, vídeo) em cartões com selos (tipo, tem/sem desfazer); detalhes recolhidos.
       Estados vazios antes de procurar e quando está tudo em dia.
  Leitura direto da biblioteca Nexus.DriverUpdates; escrita só pelo aplicador (Host.ApplyAsync/RevertAsync, no ViewModel).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:DriverUpdatesPage}">
    <DataTemplate.Resources>
      <Style x:Key="DU.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="DU.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="DU.Count" TargetType="c:AnimatedNumber">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Decimals" Value="0"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
      </Style>

      <!-- Uma atualização: seleção, dispositivo + selos, versão (antes → depois), estado; detalhes em "Por que isso?". -->
      <DataTemplate x:Key="DU.Row" DataType="{x:Type vm:DriverUpdateRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Incluir em Instalar selecionadas"
                      AutomationProperties.Name="{Binding Title, StringFormat='Incluir na instalação: {0}'}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
            <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Top" Margin="1,3,0,0"
                    Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
              <TextBlock Text="{Binding VersionLine}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
              <WrapPanel Margin="0,6,0,0">
                <c:StatusChip Tone="{Binding BadgeTone}" Text="{Binding Badge}" Margin="0,0,6,4"/>
                <c:StatusChip Tone="{Binding RollbackTone}" Text="{Binding RollbackChip}" Icon="{StaticResource Icon.Undo}" Margin="0,0,6,4"/>
              </WrapPanel>
              <TextBlock Text="{Binding Blocked}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,2,0,0"
                         Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"
                         Foreground="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding UpdateTitle}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding RollbackText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="Detalhes" Style="{StaticResource DU.Link}" Command="{Binding DetailsCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat='Detalhes: {0}'}"/>
              <Button Style="{StaticResource DU.Small}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Placa de vídeo em destaque: ilustração, nome e selos, versão, idade em dias na cor do veredito, botões oficiais. -->
      <DataTemplate x:Key="DU.Gpu" DataType="{x:Type vm:GpuDriverCard}">
        <Border Style="{StaticResource Panel.Hero}" Padding="20,18" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource Illo.Gpu}" Width="150" Height="112" Stretch="Uniform" Margin="-8,-6,16,-6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <WrapPanel>
                <c:StatusChip Tone="Info" Text="{Binding KindChip}" Icon="{StaticResource Icon.Gpu}" Margin="0,0,6,6"/>
                <c:StatusChip Tone="Neutral" Text="{Binding VendorName}" Margin="0,0,6,6"/>
              </WrapPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="18"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0">
                <Run Text="Versão "/><Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
              </TextBlock>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"
                         Foreground="{Binding LevelTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
              <WrapPanel Margin="0,12,0,0">
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenPageCommand}" Margin="0,0,8,0"
                        Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageLabel}" TextWrapping="NoWrap"/>
                    <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button Content="{Binding AppLabel}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenAppCommand}"
                        Visibility="{Binding HasApp, Converter={StaticResource BoolToVis}}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="130">
              <TextBlock Text="Idade do driver" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              <c:AnimatedNumber Value="{Binding AgeNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="40" HorizontalAlignment="Right"
                                Foreground="{Binding LevelTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
              <TextBlock Text="dias" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Cabeçalho de grupo: distintivo, nome, frase curta e a contagem. -->
      <Style x:Key="DU.GroupCount" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding RebootNotice, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding RebootNotice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Drivers}" Title="Atualizações de driver"
                     Number="{Binding UpdatesNumber}" ValueText="{Binding HeroValueText}" IsLoading="{Binding Searching}"
                     Caption="{Binding HeroCaption}"
                     ActionText="Procurar atualizações" Command="{Binding SearchCommand}"
                     SecondaryText="Abrir Windows Update" SecondaryCommand="{Binding OpenWindowsUpdateCommand}">
          <StackPanel MinWidth="200">
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding RecommendedNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Good}"/>
              <c:StatusChip Tone="Good" Text="recomendadas" HorizontalAlignment="Left"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding OptionalNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Trace}"/>
              <c:StatusChip Tone="Warn" Text="opcionais" HorizontalAlignment="Left"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding GraphicsNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Signal}"/>
              <c:StatusChip Tone="Info" Text="de vídeo" Icon="{StaticResource Icon.Gpu}" HorizontalAlignment="Left"/>
            </DockPanel>
            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" MaxWidth="220"
                       Visibility="{Binding SearchStatus, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="Cancelar busca" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,4,0,0"
                    Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Desfazer a última instalação -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="O driver anterior foi guardado. Algo estranho? Volte para ele." Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding UndoLabel}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Placa de vídeo em destaque ===== -->
        <DockPanel Margin="0,4,0,12">
          <c:ExplainToggle DockPanel.Dock="Right" Header="Quando atualizar?" Content="{Binding WhenToUpdateGpu}" VerticalAlignment="Center"/>
          <TextBlock Text="Sua placa de vídeo" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
        </DockPanel>
        <c:SkeletonLoader Shape="Hero" Height="150" Margin="0,0,0,14" Visibility="{Binding LoadingGpus, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource DU.Gpu}" Focusable="False"/>
        <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,6"
                   Visibility="{Binding GpuNote, Converter={StaticResource NullToCollapsed}}"/>
        <c:ExplainToggle Header="Quem instala o driver de vídeo?" Margin="0,0,0,20"
                         Content="O NEXUS só abre a página ou o app oficial; o download e a instalação são feitos por você, no instalador do fabricante (que também tem a opção de voltar à versão anterior). Prefira a versão estável mais recente."/>

        <!-- ===== 3. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Procura" Text="Pergunta ao Windows Update. Só versões testadas para o seu PC."/>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="Escolhe" Text="Marque o que quer. Opcionais só se algo não funciona."/>
              <c:StepItem Icon="{StaticResource Icon.Drivers}" Title="Instala" Text="Cria um ponto de restauração e guarda o driver atual." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Algo estranho? Volte ao driver anterior." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="Só fontes oficiais: o próprio Windows Update e os sites dos fabricantes. Nada de 'driver booster'. Atualizar driver corrige falhas e compatibilidade; não deixa o PC mais rápido por si só. Se está tudo funcionando, não é obrigatório."/>
          </StackPanel>
        </Border>

        <!-- ===== 4. Atualizações agrupadas ===== -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Error}" Size="16" Foreground="{StaticResource Brush.Bad}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <c:EmptyState Illustration="{StaticResource Illo.Drivers}" Text="Ainda não procurou."
                      Detail="A busca usa o próprio Windows Update. Nada é instalado sem você escolher."
                      ActionText="Procurar atualizações" Command="{Binding SearchCommand}"
                      Visibility="{Binding ShowNotSearched, Converter={StaticResource BoolToVis}}"/>
        <c:SkeletonLoader Shape="Lines" Lines="6" Margin="4,4,4,16" Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="Tudo em dia."
                      Detail="{Binding Summary}"
                      Visibility="{Binding ShowNoUpdates, Converter={StaticResource BoolToVis}}"/>

        <!-- Recomendadas -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="RecommendedCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
                <c:Icon Data="{StaticResource Icon.Check}" Size="19" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Recomendadas pelo Windows" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Testadas pela Microsoft para o seu hardware." Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <Button Grid.Column="2" Content="Marcar todas" Style="{StaticResource DU.Link}" Command="{Binding SelectRecommendedCommand}"/>
              <TextBlock Grid.Column="3" Text="{Binding RecommendedCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Good}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Opcionais -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="OptionalCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Plus}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Opcionais" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Só se um aparelho estiver com problema ou o fabricante pedir." Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding OptionalCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Trace}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Optional}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Vídeo pelo Windows Update -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="GraphicsCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Gpu}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Placa de vídeo (pelo Windows Update)" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Compare a versão com a do fabricante antes de instalar." Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding GraphicsCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Signal}"/>
            </Grid>
            <Border Style="{StaticResource Panel.Notice}" Padding="10,6" Margin="0,0,0,6">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="Às vezes o Windows Update oferece um driver de vídeo MAIS ANTIGO que o do site do fabricante. Nesse caso, não instale."
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Graphics}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Instalar -->
        <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Visibility="{Binding HasOffers, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="Uma confirmação lista tudo antes. Pede administrador. O Windows pode pedir reinício." Style="{StaticResource Text.Small}"
                         Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding InstallSelectedCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Drivers}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="Instalar selecionadas" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
