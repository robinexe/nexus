<!--
  Atualizar drivers: Windows Update (busca em leitura, instalação pelo aplicador) e placa de vídeo (página/app oficial).
  Leitura direto da biblioteca Nexus.DriverUpdates; escrita só pelo aplicador (Host.ApplyAsync/RevertAsync, no ViewModel).
  Do tema, só chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml); estilos próprios em DataTemplate.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels">
  <DataTemplate DataType="{x:Type vm:DriverUpdatesPage}">
    <DataTemplate.Resources>
      <Style x:Key="DU.Section" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="20,16,20,18"/>
      </Style>
      <Style x:Key="DU.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="DU.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- Selo de texto com cor por "Tone" (good/bad/trace/signal/muted). -->
      <Style x:Key="DU.Tone" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="trace"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="signal"><Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Veredito da idade do driver de vídeo (good/info/warn/bad). -->
      <Style x:Key="DU.Level" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Level}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Uma atualização: seleção, dispositivo, versões, detalhes, desfazer possível ou não, estado e botões. -->
      <DataTemplate x:Key="DU.Row" DataType="{x:Type vm:DriverUpdateRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,9,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Incluir em Instalar selecionadas"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Badge}" Style="{StaticResource DU.Tone}" Margin="10,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding VersionLine}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" FontFamily="{StaticResource Font.Display}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding UpdateTitle}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding RollbackText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Blocked}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,2,0,0"
                         Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource DU.Tone}" Margin="0,3,0,0"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Detalhes" Style="{StaticResource DU.Link}" Command="{Binding DetailsCommand}"/>
              <Button Content="Desfazer" Style="{StaticResource DU.Small}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Placa de vídeo: versão, idade, veredito e os botões oficiais. -->
      <DataTemplate x:Key="DU.Gpu" DataType="{x:Type vm:GpuDriverCard}">
        <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="Versão do driver" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Trace}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Data e idade" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Text="{Binding Age}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource DU.Level}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="{Binding PageLabel}" Style="{StaticResource DU.Link}" Command="{Binding OpenPageCommand}"
                      Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}"/>
              <Button Content="{Binding AppLabel}" Style="{StaticResource DU.Small}" Command="{Binding OpenAppCommand}" Margin="8,6,0,0"
                      Visibility="{Binding HasApp, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
        <!-- Cabeçalho -->
        <StackPanel Margin="0,0,0,18">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
          <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                     Text="Só fontes oficiais: o próprio Windows Update e os sites dos fabricantes. Nada de 'driver booster'. Atualizar driver corrige falhas e compatibilidade; não deixa o PC mais rápido por si só. Se está tudo funcionando, não é obrigatório."/>
        </StackPanel>

        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding RebootNotice, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding RebootNotice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
        </Border>
        <Border Style="{StaticResource Panel.Inset}" Padding="12,8" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
        </Border>

        <!-- Windows Update -->
        <Border Style="{StaticResource DU.Section}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Windows Update" Style="{StaticResource Text.H2}"/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"
                           Text="Drivers que a Microsoft testou para o seu hardware, inclusive as 'atualizações opcionais'. Instalar cria um ponto de restauração e guarda o driver atual para Desfazer."/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Procurar atualizações" Style="{StaticResource Button.Primary}" Command="{Binding SearchCommand}" Padding="16,8"/>
                <Button Content="Cancelar" Style="{StaticResource DU.Small}" Command="{Binding CancelCommand}"
                        Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                       Visibility="{Binding SearchStatus, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,10,0,0" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
              <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}"/>
            </Border>

            <!-- Recomendadas -->
            <StackPanel Margin="0,16,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RecommendedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Recomendadas pelo Windows" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                <Button Content="Marcar todas" Style="{StaticResource DU.Link}" Command="{Binding SelectRecommendedCommand}"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource DU.Row}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Opcionais -->
            <StackPanel Margin="0,16,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OptionalCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Opcionais" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"
                         Text="O Windows não instala estas sozinho. Instale só se um aparelho estiver com problema ou o fabricante recomendar."/>
              <ItemsControl ItemsSource="{Binding Optional}" ItemTemplate="{StaticResource DU.Row}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Vídeo pelo Windows Update -->
            <StackPanel Margin="0,16,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GraphicsCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Placa de vídeo (pelo Windows Update)" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"
                         Text="Confira a versão: às vezes o Windows Update oferece um driver de vídeo MAIS ANTIGO que o do site do fabricante. Nesse caso, não instale."/>
              <ItemsControl ItemsSource="{Binding Graphics}" ItemTemplate="{StaticResource DU.Row}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Instalar selecionadas" Style="{StaticResource Button.Primary}" Command="{Binding InstallSelectedCommand}" Padding="16,8"/>
              <Button Content="{Binding UndoLabel}" Style="{StaticResource DU.Small}" Command="{Binding UndoCommand}"
                      Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
              <Button Content="Abrir Windows Update" Style="{StaticResource DU.Link}" Command="{Binding OpenWindowsUpdateCommand}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"
                       Text="Uma confirmação lista tudo antes. Pede administrador. O Windows pode pedir reinício para concluir."/>
          </StackPanel>
        </Border>

        <!-- Placa de vídeo -->
        <Border Style="{StaticResource DU.Section}">
          <StackPanel>
            <TextBlock Text="Placa de vídeo" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding WhenToUpdateGpu}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,12"/>
            <ItemsControl ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource DU.Gpu}"/>
            <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                       Visibility="{Binding GpuNote, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                       Text="O NEXUS só abre a página ou o app oficial; o download e a instalação são feitos por você, no instalador do fabricante (que também tem a opção de voltar à versão anterior)."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
