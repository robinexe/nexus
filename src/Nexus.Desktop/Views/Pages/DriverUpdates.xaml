<!--
  Atualizar drivers (design system v2, docs/10-design-system.md):
    1. Destaque: chip com seta, "N atualizações" contando depois da busca (esqueleto durante), contagens por grupo à direita;
       ação principal "Procurar atualizações".
    1b. Dispositivos sem driver (código de problema 28, 1, 18… lido ao abrir): nome, código, significado e hardware ID, com
       "Procurar no Windows Update" (o WU oferece drivers para aparelhos sem driver). Sem nenhum: uma linha verde.
    2. Placa de vídeo em destaque: ilustração, nome, selos (dedicada/integrada, fabricante), versão, idade do driver em dias na
       cor do veredito; "Procurar versão nova" (consulta oficial da NVIDIA/AMD) e o botão principal "Baixar e instalar <versão>
       (<tamanho>)" com progresso no próprio cartão (%, MB/s, tempo restante → "Conferindo assinatura…" → aplicador). Em dia:
       "Em dia: x é a mais nova". Página/app oficiais ficam como links pequenos.
    3. Como funciona: Procura → Escolhe → Instala → Desfaz.
    4. Atualizações agrupadas (recomendadas, opcionais, vídeo) em cartões com selos (tipo, tem/sem desfazer); detalhes recolhidos.
       Estados vazios antes de procurar e quando está tudo em dia.
  Leitura direto da biblioteca Nexus.DriverUpdates; escrita só pelo aplicador (Host.ApplyAsync/RevertAsync, no ViewModel).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:DriverUpdatesPage}">
    <DataTemplate.Resources>
      <Style x:Key="DU.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="DU.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="DU.Count" TargetType="c:AnimatedNumber">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Decimals" Value="0"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
      </Style>

      <!-- Uma atualização: seleção, dispositivo + selos, versão (antes → depois), estado; detalhes em "Por que isso?". -->
      <DataTemplate x:Key="DU.Row" DataType="{x:Type vm:DriverUpdateRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="{l:T Drv.IncluirInstalarSelecionadas}"
                      AutomationProperties.Name="{Binding Title, StringFormat={l:T Drv.IncluirInstalacaoN}}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
            <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Top" Margin="1,3,0,0"
                    Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
              <TextBlock Text="{Binding VersionLine}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" FontFamily="{StaticResource Font.Numbers}" Margin="0,2,0,0"/>
              <WrapPanel Margin="0,6,0,0">
                <c:StatusChip Tone="{Binding BadgeTone}" Text="{Binding Badge}" Margin="0,0,6,4"/>
                <c:StatusChip Tone="{Binding RollbackTone}" Text="{Binding RollbackChip}" Icon="{StaticResource Icon.Undo}" Margin="0,0,6,4"/>
              </WrapPanel>
              <TextBlock Text="{Binding Blocked}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,2,0,0"
                         Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite"
                         Foreground="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding UpdateTitle}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding RollbackText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Content="{l:T Pg.Detalhes}" Style="{StaticResource DU.Link}" Command="{Binding DetailsCommand}"
                      AutomationProperties.Name="{Binding Title, StringFormat={l:T Drv.DetalhesN}}"/>
              <Button Content="{l:T Drv.Instalar}" Style="{StaticResource DU.Small}" Command="{Binding InstallCommand}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding Title, StringFormat={l:T Drv.InstalarN}}"/>
              <Button Style="{StaticResource DU.Small}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Shell.Desfazer}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Placa de vídeo em destaque: ilustração, nome e selos, versão, idade em dias na cor do veredito, botões oficiais. -->
      <DataTemplate x:Key="DU.Gpu" DataType="{x:Type vm:GpuDriverCard}">
        <Border Style="{StaticResource Panel.Hero}" Padding="20,18" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource Illo.Gpu}" Width="150" Height="112" Stretch="Uniform" Margin="-8,-6,16,-6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <WrapPanel>
                <c:StatusChip Tone="Info" Text="{Binding KindChip}" Icon="{StaticResource Icon.Gpu}" Margin="0,0,6,6"/>
                <c:StatusChip Tone="Neutral" Text="{Binding VendorName}" Margin="0,0,6,6"/>
              </WrapPanel>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="18"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0">
                <Run Text="{l:T Drv.Versao}"/><Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"/>
              </TextBlock>
              <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"
                         Foreground="{Binding LevelTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>

              <!-- Versão nova do fabricante: procurar, baixar e instalar no NEXUS -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding CanUpdateInApp, Converter={StaticResource BoolToVis}}">
                <DockPanel Visibility="{Binding CheckMessage, Converter={StaticResource NullToCollapsed}}">
                  <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Check}" Size="14" Margin="0,1,6,0" VerticalAlignment="Top"
                          Foreground="{StaticResource Brush.Good}" Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{Binding CheckMessage}" Style="{StaticResource Text.Body}" AutomationProperties.LiveSetting="Polite"
                             Foreground="{Binding CheckTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                </DockPanel>
                <TextBlock Text="{Binding ReleaseLine}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>

                <!-- Progresso no próprio cartão -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding Working, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding Phase}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
                  <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="6" Margin="0,6,0,4" MaxWidth="460" HorizontalAlignment="Stretch"
                               Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}"
                             Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,6,0,0"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock Text="{Binding Result}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Good}" Margin="0,6,0,0"
                           Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Polite"/>

                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallCommand}" Margin="0,0,8,6"
                          Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Drivers}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding InstallLabel}" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                  <Button Content="{l:T Drv.PausarDownload}" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,8,6"
                          Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}"/>
                  <Button Content="{l:T Drv.BaixarAbrirAssistenteOficial}" Style="{StaticResource Button.Secondary}" Command="{Binding AutoDetectCommand}" Margin="0,0,8,6"
                          Visibility="{Binding HasAutoDetect, Converter={StaticResource BoolToVis}}"/>
                  <Button Style="{StaticResource Button.Secondary}" Command="{Binding CheckCommand}" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="{l:T Drv.ProcurarVersaoNova}" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource Button.Secondary}" Command="{Binding RevertCommand}" Margin="0,0,8,6"
                          Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                      <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                      <TextBlock Text="{l:T Drv.DesfazerVoltarDriverAnterior}" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>

              <!-- Links oficiais (secundários) -->
              <WrapPanel Margin="-10,4,0,0">
                <Button Style="{StaticResource DU.Link}" Command="{Binding OpenPageCommand}"
                        Visibility="{Binding HasPage, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageLabel}" TextWrapping="NoWrap"/>
                    <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" Margin="4,0,0,0"/>
                  </StackPanel>
                </Button>
                <Button Content="{Binding AppLabel}" Style="{StaticResource DU.Link}" Command="{Binding OpenAppCommand}"
                        Visibility="{Binding HasApp, Converter={StaticResource BoolToVis}}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="130">
              <TextBlock Text="{l:T Drv.IdadeDriver}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              <c:AnimatedNumber Value="{Binding AgeNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="40" HorizontalAlignment="Right"
                                Foreground="{Binding LevelTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
              <TextBlock Text="{l:T Drv.Dias}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Cabeçalho de grupo: distintivo, nome, frase curta e a contagem. -->
      <Style x:Key="DU.GroupCount" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding RebootNotice, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding RebootNotice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Drivers}" Title="{l:T Drv.AtualizacoesDriver}"
                     Number="{Binding UpdatesNumber}" ValueText="{Binding HeroValueText}"
                     Caption="{Binding HeroCaption}"
                     ActionText="{l:T Asst.ProcurarAtualizacoes}" Command="{Binding SearchCommand}"
                     SecondaryText="{l:T Drv.AbrirWindowsUpdate}" SecondaryCommand="{Binding OpenWindowsUpdateCommand}">
          <StackPanel MinWidth="200">
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding RecommendedNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Good}"/>
              <c:StatusChip Tone="Good" Text="{l:T Drv.Recomendadas}" HorizontalAlignment="Left"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding OptionalNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Trace}"/>
              <c:StatusChip Tone="Warn" Text="{l:T Drv.Opcionais}" HorizontalAlignment="Left"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding GraphicsNumber}" Style="{StaticResource DU.Count}" Foreground="{StaticResource Brush.Signal}"/>
              <c:StatusChip Tone="Info" Text="{l:T Drv.Video}" Icon="{StaticResource Icon.Gpu}" HorizontalAlignment="Left"/>
            </DockPanel>
            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" MaxWidth="220"
                       Visibility="{Binding SearchStatus, Converter={StaticResource NullToCollapsed}}" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="{l:T Drv.CancelarBusca}" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,4,0,0"
                    Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Desfazer a última instalação -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{l:T Drv.DriverAnteriorFoiGuardado}" Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding UndoLabel}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== Dispositivos sem driver (código de problema do Gerenciador de Dispositivos) ===== -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14"
                Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.BadSoft}"/>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="19" Foreground="{StaticResource Brush.Bad}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:T Drv.DispositivosSemDriver}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding MissingSummary}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding MissingCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Bad}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding MissingDevices}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8,0,7">
                    <StackPanel>
                      <DockPanel>
                        <c:StatusChip DockPanel.Dock="Right" Tone="Bad" Text="{Binding CodeText}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Meaning}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                                 Visibility="{Binding HardwareId, Converter={StaticResource NullToCollapsed}}">
                        <Run Text="{l:T Drv.HardwareId}"/><Run Text="{Binding HardwareId, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}"/>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MissingAdvice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"/>
            <WrapPanel Margin="0,10,0,0">
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Asst.ProcurarWindowsUpdate}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="{l:T Drv.AbrirAtualizacoesOpcionais}" Style="{StaticResource Button.Ghost}" Command="{Binding OpenWindowsUpdateCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding MissingSummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Good}" Margin="0,0,0,14"
                   Visibility="{Binding MissingCount, Converter={StaticResource ZeroToVisible}}"/>

        <!-- ===== 2. Placa de vídeo em destaque ===== -->
        <DockPanel Margin="0,4,0,12">
          <c:ExplainToggle DockPanel.Dock="Right" Header="{l:T Drv.QuandoAtualizar}" Content="{Binding WhenToUpdateGpu}" VerticalAlignment="Center"/>
          <TextBlock Text="{l:T Drv.SuaPlacaVideo}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
        </DockPanel>
        <c:SkeletonLoader Shape="Hero" Height="150" Margin="0,0,0,14" Visibility="{Binding LoadingGpus, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource DU.Gpu}" Focusable="False"/>
        <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,6"
                   Visibility="{Binding GpuNote, Converter={StaticResource NullToCollapsed}}"/>
        <c:ExplainToggle Header="{l:T Drv.ComoNexusBaixaInstala}" Margin="0,0,0,20"
                         Content="{l:T Drv.VersaoMaisNovaVem}"/>

        <!-- ===== 3. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Drv.Procura}" Text="{l:T Drv.PerguntaWindowsUpdateSo}"/>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Priv.Escolhe}" Text="{l:T Drv.MarqueQuerOpcionaisSo}"/>
              <c:StepItem Icon="{StaticResource Icon.Drivers}" Title="{l:T Drv.Instala}" Text="{l:T Drv.CriaPontoRestauracaoGuarda}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Pg.Desfaz}" Text="{l:T Drv.AlgoEstranhoVolteDriver}" Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="{l:T Drv.SoFontesOficiaisProprio}"/>
          </StackPanel>
        </Border>

        <!-- ===== 4. Atualizações agrupadas ===== -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Error}" Size="16" Foreground="{StaticResource Brush.Bad}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <c:EmptyState Illustration="{StaticResource Illo.Drivers}" Text="{l:T Shell.AindaNaoProcurou}"
                      Detail="{l:T Drv.BuscaUsaProprioWindows}"
                      ActionText="{l:T Asst.ProcurarAtualizacoes}" Command="{Binding SearchCommand}"
                      Visibility="{Binding ShowNotSearched, Converter={StaticResource BoolToVis}}"/>
        <c:SkeletonLoader Shape="Lines" Lines="6" Margin="4,4,4,16" Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.Security}" Text="{l:T Drv.TudoDia}"
                      Detail="{Binding Summary}"
                      Visibility="{Binding ShowNoUpdates, Converter={StaticResource BoolToVis}}"/>

        <!-- Recomendadas -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="RecommendedCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
                <c:Icon Data="{StaticResource Icon.Check}" Size="19" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:T Drv.RecomendadasPeloWindows}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Drv.TestadasPelaMicrosoftSeu}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:T Drv.MarcarTodas}" Style="{StaticResource DU.Link}" Command="{Binding SelectRecommendedCommand}"/>
                <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallRecommendedCommand}" Margin="8,0,0,0" Padding="12,6">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Drivers}" Size="14" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding InstallRecommendedLabel}" TextWrapping="NoWrap"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding RecommendedCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Good}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Opcionais -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="OptionalCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                <c:Icon Data="{StaticResource Icon.Plus}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:T Drv.Opcionais2}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Drv.SoAparelhoEstiverProblema}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding OptionalCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Trace}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Optional}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Vídeo pelo Windows Update -->
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <Border.Visibility>
            <Binding Path="GraphicsCount" Converter="{StaticResource ZeroToVisible}" ConverterParameter="invert"/>
          </Border.Visibility>
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,12,0">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{StaticResource Icon.Gpu}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:T Drv.PlacaVideoPeloWindows}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Drv.CompareVersaoFabricanteAntes}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding GraphicsCount}" Style="{StaticResource DU.GroupCount}" Foreground="{StaticResource Brush.Signal}"/>
            </Grid>
            <Border Style="{StaticResource Panel.Notice}" Padding="10,6" Margin="0,0,0,6">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="{l:T Drv.VezesWindowsUpdateOferece}"
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Graphics}" ItemTemplate="{StaticResource DU.Row}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- Instalar -->
        <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Visibility="{Binding HasOffers, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <TextBlock Text="{l:T Drv.ConfirmacaoListaTudoAntes}" Style="{StaticResource Text.Small}"
                         Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding InstallSelectedCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Drivers}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{l:T Drv.InstalarSelecionadas}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
