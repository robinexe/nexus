<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <!--
    "Meu PC" (página-modelo do design system v2, docs/10-design-system.md):
      1. Destaque: ilustração do PC, nome do PC, anel "itens em ordem" do diagnóstico, ação principal (medir uma partida).
      2. Seu equipamento: 4 cartões (processador, placa de vídeo, memória, disco), cada um com ilustração e 1 número; clicar abre a página.
      3. O que o NEXUS recomenda agora: 3 cartões com ação (pontos de atenção primeiro; depois sugestões seguras).
      4. Como o NEXUS trabalha: 4 passos. O resto do que foi lido fica recolhido.
    Navegação: ShellCommands.Navigate com o nome do tipo da página (sem depender do MainViewModel).
  -->
  <DataTemplate DataType="{x:Type vm:OverviewPage}">
    <DataTemplate.Resources>
      <!-- Cartão de recomendação: ícone do módulo, selo, título curto, motivo de 1 linha e o verbo que abre a página. -->
      <DataTemplate x:Key="O.Recommendation" DataType="{x:Type vm:OverviewCard}">
        <Border Style="{StaticResource Panel.Card}" Margin="7,0">
          <DockPanel>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource Button.Secondary}"
                    Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                    AutomationProperties.Name="{Binding ActionText}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ActionText}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
            <StackPanel>
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" VerticalAlignment="Top" Tone="{Binding Tone}" Text="{Binding Value}"
                              Visibility="{Binding Value, Converter={StaticResource NullToCollapsed}}"/>
                <Grid Width="38" Height="38" HorizontalAlignment="Left">
                  <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                          Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                </Grid>
              </DockPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5" Margin="0,12,0,4" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Pc}" Title="{l:T Nav.MeuPc}"
                     ValueText="{Binding HeroTitle}" Caption="{Binding HeroCaption}" IsLoading="{Binding IsLoading}"
                     ActionText="{l:T Nav.MedirPartida}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                     SecondaryText="{l:T Nav.VerDiagnostico}" SecondaryCommand="{x:Static shell:ShellCommands.Navigate}" SecondaryCommandParameter="DiagnosticsPage">
          <StackPanel Width="164">
            <c:RingMeter Value="{Binding HealthScore}" WarnAt="80" BadAt="50" Label="{l:T Pg.Ordem}" Width="136" Height="136" Thickness="11"
                         HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding HealthCaption}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Seu equipamento ===== -->
        <TextBlock Text="{l:T Pg.SeuEquipamento}" Style="{StaticResource Text.H2}" Margin="0,6,0,12"/>
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="196" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="4" Margin="-7,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
          <c:StatTile Margin="7,0" Illustration="{StaticResource Illo.Cpu}" Label="{l:T Pg.Processador}"
                      Number="{Binding Cpu.Number}" Suffix="{Binding Cpu.Suffix}" Value="{Binding Cpu.Value}" Detail="{Binding Cpu.Note}"
                      Trend="{Binding Cpu.Trend}" TrendTone="{Binding Cpu.TrendTone}"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Cpu.Target}"/>
          <c:StatTile Margin="7,0" Illustration="{StaticResource Illo.Gpu}" Label="{l:T Pg.PlacaVideo}" Kind="Bytes"
                      Number="{Binding Gpu.Number}" Value="{Binding Gpu.Value}" Detail="{Binding Gpu.Note}"
                      Trend="{Binding Gpu.Trend}" TrendTone="{Binding Gpu.TrendTone}"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Gpu.Target}"/>
          <c:StatTile Margin="7,0" Illustration="{StaticResource Illo.Ram}" Label="{l:T Pg.MemoriaRam}" Kind="Bytes"
                      Number="{Binding Ram.Number}" Value="{Binding Ram.Value}" Detail="{Binding Ram.Note}"
                      Trend="{Binding Ram.Trend}" TrendTone="{Binding Ram.TrendTone}"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Ram.Target}"/>
          <c:StatTile Margin="7,0" Illustration="{StaticResource Illo.Disk}" Label="{l:T Pg.DiscoSistema}" Kind="Bytes"
                      Number="{Binding Disk.Number}" Value="{Binding Disk.Value}" Detail="{Binding Disk.Note}"
                      Trend="{Binding Disk.Trend}" TrendTone="{Binding Disk.TrendTone}"
                      Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Disk.Target}"/>
        </UniformGrid>

        <!-- ===== 3. Recomendações ===== -->
        <TextBlock Text="{l:T Pg.NexusRecomendaAgora}" Style="{StaticResource Text.H2}" Margin="0,30,0,12"/>
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="170" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource O.Recommendation}" Focusable="False" Margin="-7,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== 4. Como o NEXUS trabalha ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,18,8,18" Margin="0,30,0,0">
          <StackPanel>
            <TextBlock Text="{l:T Pg.ComoNexusTrabalha}" Style="{StaticResource Text.H2}" Margin="0,0,0,16"/>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Pg.Le}" Text="{l:T Pg.LeHardwareWindowsLer}"/>
              <c:StepItem Icon="{StaticResource Icon.Sparkle}" Title="{l:T Pg.Sugere}" Text="{l:T Pg.MostraValePenaRisco}"/>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Pg.VoceConfirma}" Text="{l:T Pg.NadaAplicadoSemSeu}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Pg.Desfaz}" Text="{l:T Pg.TudoFicaRegistradoPode}" Tone="Good"/>
            </c:HowItWorks>
          </StackPanel>
        </Border>

        <!-- ===== Detalhes recolhidos: o resto do que foi lido ===== -->
        <c:ExplainToggle Header="{l:T Pg.VerTudoFoiLido}" Margin="0,22,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding OtherCards}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OverviewCard}">
                  <StackPanel Margin="0,4,18,10">
                    <DockPanel>
                      <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.MetricLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" FontSize="15.5" Foreground="{StaticResource Brush.Text}" Margin="0,3,0,1"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Footer}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"
                       Visibility="{Binding Footer, Converter={StaticResource NullToCollapsed}}"/>
            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,0" Content="{l:T Pg.VerTodoHardware}"
                    Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="HardwarePage"/>
          </StackPanel>
        </c:ExplainToggle>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
