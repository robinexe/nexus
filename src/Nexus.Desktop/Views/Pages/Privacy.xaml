<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:PrivacyPage}">
    <StackPanel Margin="28,24,28,28">
      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
