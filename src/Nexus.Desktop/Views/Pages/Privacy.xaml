<!--
  Privacidade: placar (itens protegidos / itens que se aplicam a este Windows), perfis Recomendado / Rígido / Personalizado,
  lista por tema com interruptor, "o que você perde" e detalhes técnicos com fonte. A página só lê; aplicar e desfazer passam
  pelo aplicador (Host.ApplyAsync / Host.RevertAsync). Do tema, só as chaves do contrato; estilos locais em DataTemplate.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:PrivacyPage}">
    <DataTemplate.Resources>
      <!-- Selo do estado do item: verde protegido, âmbar parcial, vermelho exposto, apagado quando não se aplica. -->
      <DataTemplate x:Key="P.Status">
        <Border x:Name="chip" CornerRadius="{StaticResource Radius.Chip}" Padding="9,2,10,3" BorderThickness="1"
                BorderBrush="{StaticResource Brush.Line}" HorizontalAlignment="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="dot" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{StaticResource Brush.TextDim}"/>
            <TextBlock x:Name="label" Text="{Binding StatusText}" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                       Foreground="{StaticResource Brush.TextDim}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding StatusKey}" Value="Protected">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.GoodSoft}"/>
            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusKey}" Value="Partial">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusKey}" Value="Exposed">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Bad}"/>
            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.BadSoft}"/>
            <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Bad}"/>
            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Interruptor (CheckBox com cara de chave): ciano quando marcado. -->
      <Style x:Key="P.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="{StaticResource Brush.Bg}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"/>
                <Ellipse x:Name="knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="5,0,0,0" Fill="{StaticResource Brush.TextMuted}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.SignalSoft}"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                  <Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Signal}"/>
                  <Setter TargetName="knob" Property="Margin" Value="21,0,0,0"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,18"/>

        <!-- Placar e perfis -->
        <Border Style="{StaticResource Panel.Hero}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="260"/>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Nível de privacidade" Style="{StaticResource Text.MetricLabel}"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource Font.Numbers}" FontSize="52" Foreground="{StaticResource Brush.Text}"
                           TextWrapping="NoWrap" VerticalAlignment="Bottom"/>
                <TextBlock Text="protegidos" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="10,0,0,12"
                           VerticalAlignment="Bottom" TextWrapping="NoWrap"/>
              </StackPanel>
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding ScoreFraction, Mode=OneWay}" Height="6" Margin="0,4,0,10"
                           Foreground="{StaticResource Brush.Good}"/>
              <TextBlock Text="{Binding ScoreCaption}" Style="{StaticResource Text.Body}"/>
              <TextBlock Text="{Binding BuildNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,0"
                         Text="Nada aqui aumenta o FPS. O ganho é de privacidade e de menos propaganda. Cada item diz o que você perde, e tudo pode ser desfeito."/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Primary}" Command="{Binding ApplyRecommendedCommand}" Height="44" HorizontalAlignment="Stretch"
                      ToolTip="Aplica só o que não tira nada relevante. Mostra a lista e pede confirmação antes.">
                <TextBlock Text="Aplicar recomendado" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.H2}" Foreground="{StaticResource Brush.Bg}"/>
              </Button>
              <TextBlock Text="{Binding RecommendedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,5,0,12" TextAlignment="Center"/>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding ApplyStrictCommand}" Content="Aplicar rígido" HorizontalAlignment="Stretch"
                      ToolTip="Recomendado + itens com perdas reais (relatórios de erro, Copilot, Widgets, sincronização...). Cada perda aparece na confirmação."/>
              <TextBlock Text="{Binding StrictText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,5,0,12" TextAlignment="Center"/>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding ApplySelectedCommand}" Content="Aplicar marcados (personalizado)" HorizontalAlignment="Stretch"
                      ToolTip="Aplica só os itens com o interruptor ligado na lista abaixo."/>
              <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,5,0,0" TextAlignment="Center"/>
              <Button Style="{StaticResource Button.Ghost}" Command="{Binding UndoCommand}" Content="Desfazer a última aplicação" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                      Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                      ToolTip="Volta os valores que o NEXUS mudou ao que eram antes (pelo diário). Também dá para desfazer na página Aplicar."/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource Panel.Notice}" Margin="0,12,0,0" Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding LastResult}" Style="{StaticResource Text.Body}"/>
        </Border>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"/>

        <!-- Ações da lista -->
        <DockPanel Margin="0,22,0,6" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="Itens por tema" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding RescanCommand}" Content="Ler de novo" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" Content="Desmarcar tudo" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectStrictCommand}" Content="Marcar rígido" Margin="8,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectRecommendedCommand}" Content="Marcar recomendado" Margin="8,0,0,0"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,10"
                   Text="Interruptor ligado = entra em &quot;Aplicar marcados&quot;. Itens já protegidos ficam travados: para voltar, use Desfazer ou as Configurações do Windows."/>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,10,0,4">
                <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextMuted}"
                             VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Theme}" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="16,14">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Style="{StaticResource P.Switch}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,2,14,0"
                                    ToolTip="Ligado: entra em &quot;Aplicar marcados&quot;."/>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
                            <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0">
                              <Run Text="O que você perde: " Foreground="{StaticResource Brush.Trace}"/><Run Text="{Binding Loses, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,4,0,0"
                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                              <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
                              <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleDetailsCommand}" Content="Detalhes técnicos" Margin="10,0,0,0" Padding="6,2"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,6">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                                      <TextBox Text="{Binding Where, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,3,0,0"
                                               FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.Signal}" TextWrapping="Wrap"/>
                                      <TextBlock Text="{Binding Values}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
                                      <TextBlock Text="{Binding Mechanism}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
                                      <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,3,0,0"
                                               FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                                               ToolTip="Fonte. Selecione e copie para abrir no navegador."/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Margin="14,0,0,0" HorizontalAlignment="Right">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource P.Status}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                       HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Só leitura: permissões que são escolha do usuário, e o serviço de telemetria (outra página). -->
        <TextBlock Text="Permissões e serviços (só leitura)" Style="{StaticResource Text.H2}" Margin="0,22,0,4"/>
        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,10"
                   Text="Câmera e microfone não são bloqueados às cegas: Discord, chat de voz e transmissões dependem deles. O NEXUS mostra o estado e abre a tela certa."/>
        <ItemsControl ItemsSource="{Binding InfoRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                    <TextBlock Text="{Binding State}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Command="{Binding OpenCommand}" Content="Abrir Configurações"
                          VerticalAlignment="Center" Margin="14,0,0,0" Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
