<!--
  Privacidade (design system v2, docs/10-design-system.md):
    1. Destaque: olho + escudo, "X itens protegidos" contando, anel com a % protegida, "Aplicar recomendado" / "Desfazer".
    2. Como funciona: Lê → Escolhe → Aplica → Desfaz.
    3. Três perfis como cartões (Recomendado, Rígido, Personalizado), cada um com quantos itens faltam e o botão.
    4. Temas como cartões (ícone, "x de y protegidos", barra) com um interruptor por item; "o que você perde" em 1 linha e
       o resto (resumo, onde mexe, fonte) recolhido em "Por que isso?". Avisos de risco continuam visíveis.
    5. Permissões só de leitura (câmera, microfone…) com o botão que abre a tela certa do Windows.
  A página só lê; aplicar e desfazer passam pelo aplicador (Host.ApplyAsync / Host.RevertAsync).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:PrivacyPage}">
    <DataTemplate.Resources>
      <!-- Interruptor (CheckBox com cara de chave): ciano quando ligado; a bolinha desliza. -->
      <Style x:Key="P.Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Border x:Name="track" Width="38" Height="20" CornerRadius="10" Background="{StaticResource Brush.Bg}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"/>
                <Ellipse x:Name="knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="5,0,0,0" Fill="{StaticResource Brush.TextMuted}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.SignalSoft}"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                  <Setter TargetName="knob" Property="Fill" Value="{StaticResource Brush.Signal}"/>
                  <Setter TargetName="knob" Property="Margin" Value="21,0,0,0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Barra fina de progresso do tema (verde = protegido). -->
      <Style x:Key="P.ThemeBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{Binding Tone, Converter={StaticResource ToneBrush}}"/>
      </Style>

      <!-- Um item: interruptor, título + selo, o que você perde em 1 linha, aviso visível, detalhes recolhidos. -->
      <DataTemplate x:Key="P.ItemRow" DataType="{x:Type vm:PrivacyItemRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,11,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Style="{StaticResource P.Switch}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect, Mode=OneWay}" Margin="0,1,0,0"
                      AutomationProperties.Name="{Binding Title, StringFormat='Incluir em Aplicar marcados: {0}'}"
                      ToolTip="Ligado: entra em &quot;Aplicar marcados&quot;."/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}"/>
              <DockPanel Margin="0,3,0,0" ToolTip="{Binding Loses}">
                <TextBlock Text="Você perde:" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,0,5,0" TextWrapping="NoWrap"/>
                <TextBlock Text="{Binding Loses}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Style="{StaticResource Panel.Notice}" Padding="8,5" Margin="0,6,0,0"
                      Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                  <c:Icon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                </DockPanel>
              </Border>
              <c:ExplainToggle Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0">
                    <Run Text="O que você perde: " Foreground="{StaticResource Brush.Trace}"/><Run Text="{Binding Loses, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                  <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PrivacyActionRow}">
                        <Border Style="{StaticResource Panel.Inset}" Padding="10,8" Margin="0,0,0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                            <TextBox Text="{Binding Where, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,3,0,0"
                                     FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.Signal}" TextWrapping="Wrap"
                                     AutomationProperties.Name="Onde fica"/>
                            <TextBlock Text="{Binding Values}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding Mechanism}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
                            <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,3,0,0"
                                     FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                                     AutomationProperties.Name="Fonte" ToolTip="Fonte. Selecione e copie para abrir no navegador."/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="110">
              <c:StatusChip Tone="{Binding StatusTone}" Text="{Binding StatusText}" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                         HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Cartão de perfil: nome, quantos itens faltam (número que conta), legenda curta e o botão. -->
      <Style x:Key="P.ProfileNumber" TargetType="c:AnimatedNumber">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Privacy}" Title="Itens protegidos"
                     Number="{Binding ProtectedNumber}" IsLoading="{Binding IsLoading}"
                     Caption="{Binding ProtectedCaption}"
                     ActionText="Aplicar recomendado" Command="{Binding ApplyRecommendedCommand}"
                     SecondaryText="Desfazer última aplicação" SecondaryCommand="{Binding UndoCommand}">
          <StackPanel Width="170">
            <c:RingMeter Value="{Binding ScorePercent}" WarnAt="70" BadAt="40" Label="protegido" Width="132" Height="132" Thickness="11"
                         HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding RecommendedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Resultado da última aplicação (com o lembrete de sair e entrar na conta) -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1" Text="{Binding LastResult}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Confere cada item no Windows. Ler não muda nada."/>
              <c:StepItem Icon="{StaticResource Icon.Privacy}" Title="Escolhe" Text="Ligue o que quer proteger. Cada item diz o que você perde." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Lock}" Title="Aplica" Text="Mostra a lista e pede confirmação antes de mexer."/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Mudou de ideia? Os valores voltam ao que eram." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Small}"
                           Text="Nada aqui aumenta o FPS. O ganho é de privacidade e de menos propaganda e sugestões. Cada item mostra o que você perde, e tudo pode ser desfeito aqui ou na página Aplicar."/>
                <TextBlock Text="{Binding ScoreCaption}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding BuildNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>

        <!-- ===== 3. Perfis ===== -->
        <TextBlock Text="Escolha um nível" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
        <UniformGrid Columns="3" Margin="-7,0,-7,22">
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Aplicar recomendado" Command="{Binding ApplyRecommendedCommand}" Style="{StaticResource Button.Secondary}"
                      HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <StackPanel>
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Right" Tone="Good" Text="sem perdas relevantes" VerticalAlignment="Top"/>
                  <Grid Width="38" Height="38" HorizontalAlignment="Left">
                    <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
                    <c:Icon Data="{StaticResource Icon.Check}" Size="19" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
                  </Grid>
                </DockPanel>
                <TextBlock Text="Recomendado" Style="{StaticResource Text.H2}" Margin="0,10,0,0"/>
                <c:AnimatedNumber Value="{Binding RecommendedNumber}" Suffix=" faltam" Style="{StaticResource P.ProfileNumber}"/>
                <TextBlock Text="Tira propaganda e coleta sem tirar nada que você usa." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Aplicar rígido" Command="{Binding ApplyStrictCommand}" Style="{StaticResource Button.Secondary}"
                      HorizontalAlignment="Left" Margin="0,12,0,0"
                      ToolTip="Recomendado + itens com perdas reais (relatórios de erro, Copilot, Widgets, sincronização...). Cada perda aparece na confirmação."/>
              <StackPanel>
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Right" Tone="Warn" Text="tem perdas" VerticalAlignment="Top"/>
                  <Grid Width="38" Height="38" HorizontalAlignment="Left">
                    <Ellipse Fill="{StaticResource Brush.TraceSoft}"/>
                    <c:Icon Data="{StaticResource Icon.Lock}" Size="19" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
                  </Grid>
                </DockPanel>
                <TextBlock Text="Rígido" Style="{StaticResource Text.H2}" Margin="0,10,0,0"/>
                <c:AnimatedNumber Value="{Binding StrictNumber}" Suffix=" faltam" Style="{StaticResource P.ProfileNumber}"/>
                <TextBlock Text="Recomendado + Copilot, Widgets, sincronização. Você perde recursos." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Panel.Card}" Margin="7,0">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Aplicar marcados" Command="{Binding ApplySelectedCommand}" Style="{StaticResource Button.Secondary}"
                      HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Aplica só os itens com o interruptor ligado na lista abaixo."/>
              <StackPanel>
                <Grid Width="38" Height="38" HorizontalAlignment="Left">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Settings}" Size="19" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Personalizado" Style="{StaticResource Text.H2}" Margin="0,10,0,0"/>
                <c:AnimatedNumber Value="{Binding SelectedNumber}" Suffix=" marcados" Style="{StaticResource P.ProfileNumber}" Foreground="{StaticResource Brush.Signal}"/>
                <TextBlock Text="Só os interruptores que você ligou na lista abaixo." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </UniformGrid>

        <!-- ===== 4. Temas ===== -->
        <DockPanel Margin="0,0,0,10" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="Por tema" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Command="{Binding RescanCommand}" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" Content="Desligar tudo" Margin="4,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectStrictCommand}" Content="Ligar rígido" Margin="4,0,0,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding SelectRecommendedCommand}" Content="Ligar recomendado" Margin="4,0,0,0"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,12"
                   Text="Interruptor ligado = entra em &quot;Aplicar marcados&quot;. Itens já protegidos ficam travados: para voltar, use Desfazer."/>

        <c:SkeletonLoader Shape="Lines" Lines="8" Margin="4,4,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyThemeGroup}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" Margin="0,0,12,0">
                      <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                      <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                              Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Theme}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="120" Margin="12,0,0,0">
                      <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Font.Numbers}" FontSize="20" HorizontalAlignment="Right"
                                 Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                      <ProgressBar Style="{StaticResource P.ThemeBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,4,0,0"
                                   AutomationProperties.Name="{Binding CountText}"/>
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource P.ItemRow}" Focusable="False"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 5. Permissões (só leitura) ===== -->
        <TextBlock Text="Permissões dos apps" Style="{StaticResource Text.H2}" Margin="0,10,0,4"/>
        <DockPanel Margin="0,0,0,12">
          <c:StatusChip DockPanel.Dock="Left" Tone="Info" Text="só leitura" Margin="0,0,10,0" VerticalAlignment="Top"/>
          <c:ExplainToggle Header="Por que o NEXUS não bloqueia?"
                           Content="Câmera e microfone não são bloqueados às cegas: Discord, chat de voz e transmissões dependem deles. O NEXUS mostra o estado e abre a tela certa do Windows para você decidir app por app."/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding InfoRows}" Focusable="False" Margin="-7,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyInfoRow}">
              <Border Style="{StaticResource Panel.Card}" Margin="7,0,7,14" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}"/>
                    <TextBlock Text="{Binding State}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"/>
                    <c:ExplainToggle Margin="0,2,0,0" Content="{Binding Text}"/>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="-8,2,0,0"
                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Abrir no Windows" TextWrapping="NoWrap"/>
                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
