<!--
  Laboratório do processador (design system v2, docs/10-design-system.md):
    1. Destaque: chip + "núcleo mais rápido" em GHz contando (antes de medir: quantos núcleos), base × turbo medido, Medir / Teste sustentado.
    2. Quatro números: núcleos/threads, todos carregados, cache L3, latência da RAM.
    3. Como funciona: cronometra → mede o cache → aperta todos → corrige (com desfazer). Método completo em "Por que isso?".
    4. O que segura o processador: cartões com selo, evidência e botão de correção; explicação e fonte recolhidas.
    5. Gráficos (CpuCharts.cs, entram da esquerda para a direita): GHz por núcleo, núcleo a núcleo, curva de cache, frequência no tempo.
    6. Ficha técnica recolhida (CPUID, caches, recursos, histórico).
  Medir não muda nada no PC. As correções do plano de energia vão pelo aplicador (Host.ApplyAsync), com confirmação e desfazer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell"
                    xmlns:cpu="clr-namespace:Nexus.Desktop.Views.Modules.CpuLab">
  <DataTemplate DataType="{x:Type vm:CpuLabPage}">
    <DataTemplate.Resources>

      <!-- Amostra de cor da legenda dos gráficos (linha curta). -->
      <Style x:Key="Cpu.Swatch" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
      </Style>
      <Style x:Key="Cpu.LegendText" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <!-- Achado: distintivo pelo tom, título, selo, evidência (o que foi medido) e o botão de correção.
           Explicação, instrução e fonte ficam em "Por que isso?". -->
      <DataTemplate x:Key="Cpu.Finding" DataType="{x:Type vm:CpuFindingRow}">
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
              <Ellipse Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                      Foreground="{Binding ToneKind, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneKind}" Text="{Binding SeverityText}" VerticalAlignment="Top" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                         MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/>
              <c:ExplainToggle Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}"/>
                  <TextBlock Text="{Binding Instruction}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"
                             Visibility="{Binding HasInstruction, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
            <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Secondary}"
                    VerticalAlignment="Top" Margin="0" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Barra de um núcleo: enche ao aparecer (ShellMotion.Count; parada com animações desligadas).
           Âmbar = o mais rápido, ciano = núcleo de economia (E), cinza = os outros. -->
      <DataTemplate x:Key="Cpu.CoreBar" DataType="{x:Type vm:CpuCoreBar}">
        <Grid Margin="0,0,0,9" ToolTip="{Binding Tip}" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="78"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" Height="12" VerticalAlignment="Center">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
            <Grid RenderTransformOrigin="0,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="0"/>
              </Grid.RenderTransform>
              <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1"
                                       Duration="{x:Static shell:ShellMotion.Count}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>
              <Rectangle x:Name="bar" Fill="{StaticResource Brush.TextDim}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5" RenderTransform="{Binding Fraction, Converter={StaticResource FractionScale}}">
              </Rectangle>
            </Grid>
          </Grid>
          <TextBlock x:Name="value" Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.TextMuted}" TextWrapping="NoWrap" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Efficiency}" Value="True">
            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Best}" Value="True">
            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Trace}"/>
            <Setter TargetName="value" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Recurso do processador: selo verde (presente) ou apagado (ausente); o significado fica na dica. -->
      <DataTemplate x:Key="Cpu.Feature" DataType="{x:Type vm:CpuFeatureChip}">
        <Border x:Name="chip" BorderThickness="1" BorderBrush="{StaticResource Brush.Line}" Background="{StaticResource Brush.SurfaceLow}"
                CornerRadius="{StaticResource Radius.Chip}" Padding="9,3" Margin="0,0,8,8" ToolTip="{Binding Tip}">
          <StackPanel Orientation="Horizontal">
            <c:Icon x:Name="mark" Data="{StaticResource Icon.Close}" Size="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,5,0"/>
            <TextBlock x:Name="name" Text="{Binding Name}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" Foreground="{StaticResource Brush.TextDim}"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Present}" Value="True">
            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="name" Property="Foreground" Value="{StaticResource Brush.Good}"/>
            <Setter TargetName="mark" Property="Data" Value="{StaticResource Icon.Check}"/>
            <Setter TargetName="mark" Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Cpu.Fact" DataType="{x:Type vm:CpuFactRow}">
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,2,12,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Body}"/>
            <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="Cpu.Line">
        <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Margin="0,0,0,4"/>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação / erro -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Cpu}" Title="{Binding HeroTitle}"
                     Number="{Binding HeroNumber}" Decimals="{Binding HeroDecimals}" Suffix="{Binding HeroSuffix}" IsLoading="{Binding IsLoading}"
                     Caption="{Binding HeroName}"
                     ActionText="Medir (≈ 20 s)" Command="{Binding MeasureCommand}"
                     SecondaryText="Teste sustentado" SecondaryCommand="{Binding SustainedCommand}">
          <StackPanel Width="250">
            <TextBlock Text="{Binding HeroLine}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
            <c:BeforeAfter Margin="0,10,0,0" Before="{Binding BaseGhz}" After="{Binding BestGhz}"
                           BeforeLabel="Base de fábrica (GHz)" AfterLabel="Medido no turbo (GHz)"
                           Visibility="{Binding HasTurboCompare, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Teste sustentado de" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding SustainedChoices}" SelectedItem="{Binding SustainedSeconds}" Width="64" Margin="8,0,6,0"
                        IsEnabled="{Binding Idle}" AutomationProperties.Name="Duração do teste sustentado, em segundos"/>
              <TextBlock Text="s" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="-8,6,0,0">
              <Button Command="{Binding RefreshCommand}" Style="{StaticResource Button.Ghost}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="Cancelar medição" Command="{Binding CancelCommand}" Style="{StaticResource Button.Ghost}"
                      Visibility="{Binding Measuring, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </StackPanel>
        </c:HeroPanel>

        <!-- Medindo agora -->
        <Border Style="{StaticResource Panel.Card}" Padding="16,12" Margin="0,0,0,14" Visibility="{Binding Measuring, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Measure}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,8,0,0"
                           AutomationProperties.Name="Progresso da medição"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Aviso de energia (bateria) continua visível -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding PowerNotice, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Bolt}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding PowerNotice}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
          </DockPanel>
        </Border>
        <TextBlock Text="{Binding IdentityNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Trace}" Margin="0,0,0,12"
                   Visibility="{Binding IdentityNote, Converter={StaticResource NullToCollapsed}}"/>

        <!-- ===== 2. Quatro números ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="170" Margin="0,0,0,20" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="4" Margin="-7,0,-7,20" Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Cpu}" Label="Núcleos / threads" Value="{Binding CoreThreadText}" Detail="{Binding CoreDetail}"/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Bolt}" Label="Com todos trabalhando" Value="—" Number="{Binding AllCoreGhz}" Decimals="2" Suffix=" GHz"
                      Detail="Média de todos os núcleos juntos. Meça para ver."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Hardware}" Label="Cache L3" Value="—" Number="{Binding L3Bytes}" Kind="Bytes"
                      Detail="Memória rapidíssima dentro do chip."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Ram}" Label="Ida até a RAM" Value="—" Number="{Binding RamLatencyNs}" Decimals="0" Suffix=" ns"
                      Detail="Quanto o processador espera a memória. Menor é melhor."/>
        </UniformGrid>
        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,-6,0,20" Visibility="{Binding SingleChannel, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.Ram}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                       Text="Só 1 pente de memória: o processador recebe metade da largura de banda possível."/>
            <Button Grid.Column="2" Content="Ver a memória" Style="{StaticResource Button.Ghost}" Margin="12,0,0,0"
                    Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MemoryLabPage"/>
          </Grid>
        </Border>

        <!-- ===== 3. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Cronometra" Text="Cada núcleo sozinho, com a thread presa nele: GHz reais."/>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Mede o cache" Text="Dados cada vez maiores mostram L1, L2, L3 e a RAM."/>
              <c:StepItem Icon="{StaticResource Icon.Bolt}" Title="Aperta todos" Text="Todos os núcleos juntos: o clock cai com calor ou potência?" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Corrige" Text="Só o plano de energia, com sua confirmação e desfazer." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Header="Como cada medição funciona" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Medir não muda nada no PC. Sem driver de kernel: só a instrução CPUID, APIs do Windows e cronômetro."
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="{x:Static vm:CpuLabPage.MethodText}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>

        <!-- ===== 4. O que segura o processador ===== -->
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="0" VerticalAlignment="Center"
                  Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="Desfazer a última correção" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="O que segura o processador" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="O que foi lido ou medido e o que fazer. Depois de corrigir, meça de novo." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <c:SkeletonLoader Shape="Lines" Lines="4" Margin="4,0,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource Cpu.Finding}" Focusable="False" Margin="0,0,0,8"/>

        <!-- ===== 5. Gráficos ===== -->
        <TextBlock Text="O que a medição mostrou" Style="{StaticResource Text.H2}" Margin="0,8,0,12"/>
        <c:EmptyState Illustration="{StaticResource Illo.Cpu}" Text="Ainda não medido."
                      Detail="Em uns 20 segundos: GHz de cada núcleo, cache, memória e núcleo a núcleo. Feche jogos antes."
                      ActionText="Medir (≈ 20 s)" Command="{Binding MeasureCommand}" Margin="0,0,0,14"
                      Visibility="{Binding HasQuick, Converter={StaticResource FalseToVisible}}"/>

        <Grid Margin="0,0,0,14" Visibility="{Binding HasQuick, Converter={StaticResource BoolToVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <c:Icon Data="{StaticResource Icon.Measure}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="GHz de cada núcleo" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <WrapPanel Margin="0,4,0,12">
                <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Trace}"/>
                <TextBlock Text="o mais rápido" Style="{StaticResource Cpu.LegendText}"/>
                <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.TextDim}"/>
                <TextBlock Text="os outros" Style="{StaticResource Cpu.LegendText}"/>
                <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Signal}" Visibility="{Binding HasEfficiencyCores, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="núcleos de economia (E)" Style="{StaticResource Cpu.LegendText}" Visibility="{Binding HasEfficiencyCores, Converter={StaticResource BoolToVis}}"/>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding CoreBars}" ItemTemplate="{StaticResource Cpu.CoreBar}" Focusable="False"/>
              <c:ExplainToggle Header="O que isso quer dizer?" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding CoreSummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <TextBlock Text="O Windows manda as tarefas mais pesadas para o núcleo mais rápido (o &quot;preferido&quot;). Diferença pequena entre núcleos é normal."
                             Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                </StackPanel>
              </c:ExplainToggle>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <c:Icon Data="{StaticResource Icon.Network}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
                <TextBlock Text="Conversa entre núcleos" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              </DockPanel>
              <WrapPanel Margin="0,4,0,12">
                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Good}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="perto (rápido)" Style="{StaticResource Cpu.LegendText}"/>
                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Trace}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="médio" Style="{StaticResource Cpu.LegendText}"/>
                <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Bad}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="longe (lento)" Style="{StaticResource Cpu.LegendText}"/>
              </WrapPanel>
              <cpu:CoreMatrixHeatmap Matrix="{Binding Matrix}" HorizontalAlignment="Left" MinHeight="120"
                                     AutomationProperties.Name="Mapa de calor da latência entre núcleos, em nanossegundos"/>
              <TextBlock Text="Números em nanossegundos: o tempo de um dado ir de um núcleo a outro." Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>
              <c:ExplainToggle Margin="0,2,0,0" Content="{Binding ClusterText}" Visibility="{Binding ClusterText, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Curva de cache -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14" Visibility="{Binding HasQuick, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.TrendUp}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Quanto mais longe o dado, mais demora" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="Cada degrau é um andar da memória: L1, L2, L3 e, no alto, a RAM." Style="{StaticResource Text.Small}"/>
            <WrapPanel Margin="0,8,0,10">
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Trace}"/>
              <TextBlock Text="medido agora" Style="{StaticResource Cpu.LegendText}"/>
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.TextDim}"/>
              <TextBlock Text="medição anterior" Style="{StaticResource Cpu.LegendText}"/>
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Signal}" Height="1"/>
              <TextBlock Text="tamanho que o chip declara" Style="{StaticResource Cpu.LegendText}"/>
            </WrapPanel>
            <Border Style="{StaticResource Panel.Inset}" Padding="4">
              <cpu:LatencyCurveChart Height="280" Points="{Binding Latency}" Steps="{Binding Steps}" Declared="{Binding Declared}" Previous="{Binding PreviousLatency}"
                                     AutomationProperties.Name="Curva de latência do cache e da memória"/>
            </Border>
            <c:ExplainToggle Header="Os números de cada degrau" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="{Binding LatencySummary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                <ItemsControl ItemsSource="{Binding CacheComparisons}" ItemTemplate="{StaticResource Cpu.Line}" Focusable="False" Margin="0,6,0,0"/>
                <TextBlock Text="Escala logarítmica nos dois eixos. Acima de alguns MB entra também o custo de tradução de páginas (TLB), como em qualquer programa real."
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>

        <!-- Frequência no tempo -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Command="{Binding SustainedCommand}" Style="{StaticResource Button.Secondary}" Margin="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Bolt}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Teste sustentado" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <c:Icon Data="{StaticResource Icon.Monitor}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="O clock aguenta com todos trabalhando?" Style="{StaticResource Text.H2}" FontSize="15.5" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Uma queda depois do início é limite de calor ou de potência." Style="{StaticResource Text.Small}"/>
            <WrapPanel Margin="0,8,0,10">
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Trace}"/>
              <TextBlock Text="agora" Style="{StaticResource Cpu.LegendText}"/>
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.TextDim}"/>
              <TextBlock Text="teste anterior" Style="{StaticResource Cpu.LegendText}"/>
              <Border Style="{StaticResource Cpu.Swatch}" Background="{StaticResource Brush.Signal}" Height="1"/>
              <TextBlock Text="base de fábrica" Style="{StaticResource Cpu.LegendText}"/>
            </WrapPanel>
            <Border Style="{StaticResource Panel.Inset}" Padding="4">
              <cpu:FrequencyTimeChart Height="200" Series="{Binding Series}" Previous="{Binding PreviousSeries}" BaseGhz="{Binding BaseGhz}"
                                      AutomationProperties.Name="Frequência média dos núcleos ao longo do teste"/>
            </Border>
            <TextBlock Text="{Binding SustainedText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"
                       Visibility="{Binding SustainedText, Converter={StaticResource NullToCollapsed}}"/>
            <c:ExplainToggle Header="E a escala com várias threads?" Margin="0,2,0,0" Content="{Binding ScalingText}"
                             Visibility="{Binding ScalingText, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </Border>

        <!-- Comparação -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.History}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Comparado com a medição anterior" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="Diferenças abaixo de 2% são ruído de medição." Style="{StaticResource Text.Small}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Comparison}" ItemTemplate="{StaticResource Cpu.Line}" Focusable="False"/>
          </StackPanel>
        </Border>

        <!-- ===== 6. Ficha técnica (avançado, recolhida) ===== -->
        <Expander Margin="0,0,0,14">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Code}" Size="16" Margin="0,0,8,0"/>
              <TextBlock Text="Ficha técnica: CPUID, caches e recursos" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Expander.Header>
          <Border Style="{StaticResource Panel.Card}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding IdentityRows}" ItemTemplate="{StaticResource Cpu.Fact}" Focusable="False"/>
              <TextBlock Text="Caches" Style="{StaticResource Text.Label}" Margin="0,10,0,6"/>
              <ListView ItemsSource="{Binding Caches}" Focusable="False" MaxHeight="220">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Nível" DisplayMemberBinding="{Binding Level}" Width="70"/>
                    <GridViewColumn Header="Tamanho" DisplayMemberBinding="{Binding Size}" Width="100"/>
                    <GridViewColumn Header="Associatividade" DisplayMemberBinding="{Binding Ways}" Width="130"/>
                    <GridViewColumn Header="Linha" DisplayMemberBinding="{Binding Line}" Width="90"/>
                    <GridViewColumn Header="Compartilhada por" DisplayMemberBinding="{Binding SharedBy}" Width="150"/>
                  </GridView>
                </ListView.View>
              </ListView>
              <TextBlock Text="Recursos (passe o mouse para ver o que cada um faz)" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
              <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource Cpu.Feature}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="{Binding HistoryText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
