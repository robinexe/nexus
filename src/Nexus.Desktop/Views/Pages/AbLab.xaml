<!--
  Laboratório A/B — "Comparar com e sem" (design system v2, docs/10-design-system.md; interface simples §9):
    1. Destaque ....... ilustração do Medir, título e uma frase: o NEXUS prova neste PC se um ajuste ajuda num jogo.
    2. Escolha ........ o jogo (cartões da tela Jogos + jogos já medidos), os ajustes a testar (caixas), A/B ou A/B/A e se
                        desfaz sozinho; "Começar o teste" (uma confirmação com o consentimento de aplicar/desfazer).
    3. Em andamento ... "Partida 1 de 2: jogue sem o ajuste", barra do progresso, o que o Medir está vendo, última observação
                        (partida curta demais…), Cancelar. No fim sem desfazer automático: "Manter mesmo assim? / Desfazer".
    4. Resultado ...... "Ajudou / Não ajudou / Inconclusivo" com os números (FPS médio, 1% low, piores momentos, engasgos),
                        antes → depois por métrica com selo honesto, avisos visíveis, método recolhido.
    5. Histórico ...... as últimas comparações.
  Lógica em Nexus.Measurement/AbLab (sem WPF); escrita só pelo aplicador (IModuleHost) no ViewModel (AbLabPage.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:AbLabPage}">
    <DataTemplate.Resources>
      <!-- Um ajuste candidato: caixa + título + o que o último teste disse -->
      <DataTemplate x:Key="Ab.Candidate" DataType="{x:Type vm:AbCandidateRow}">
        <DockPanel Margin="0,5">
          <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="{Binding Title}"/>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastText}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{Binding LastTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                       Visibility="{Binding HasLast, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </DockPanel>
      </DataTemplate>

      <!-- Uma métrica do resultado: nome + selo honesto + diferença, e as barras antes → depois -->
      <DataTemplate x:Key="Ab.Metric" DataType="{x:Type vm:AbMetricRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
              <c:StatusChip Tone="{Binding VerdictTone}" Text="{Binding VerdictText}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <c:BeforeAfter Before="{Binding Before}" After="{Binding After}" HigherIsBetter="{Binding HigherIsBetter}"
                             BeforeLabel="{l:T Ab.Without}" AfterLabel="{l:T Ab.With}"/>
              <TextBlock Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="0,4,0,0">
                <Run Text="{Binding BeforeText, Mode=OneWay}" Foreground="{StaticResource Brush.Signal}"/><Run Text="  →  " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding AfterText, Mode=OneWay}" Foreground="{StaticResource Brush.Trace}"/>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="Ab.Warning">
        <DockPanel Margin="0,3">
          <c:Icon Data="{StaticResource Icon.Info}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,8,0" VerticalAlignment="Top"/>
          <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
        </DockPanel>
      </DataTemplate>

      <DataTemplate x:Key="Ab.HistoryRow" DataType="{x:Type vm:AbHistoryRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
          <DockPanel>
            <c:StatusChip DockPanel.Dock="Right" Tone="{Binding Tone}" Text="{Binding OutcomeText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1100">

        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <!-- ================================================================ 1. DESTAQUE -->
        <c:HeroPanel Illustration="{StaticResource Illo.Measure}" Title="{l:T Ab.Hero.Title}" ValueText="{l:T Ab.Hero.Value}"
                     Caption="{l:T Ab.Hero.Caption}" Margin="0,0,0,20">
          <StackPanel>
            <c:StatusChip Tone="Info" Text="{l:T Ab.Hero.Chip}" HorizontalAlignment="Left"/>
            <TextBlock Text="{l:T Ab.Hero.Note}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" MaxWidth="320" TextWrapping="Wrap"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- PresentMon ausente: sem partidas medidas não há teste -->
        <Border Style="{StaticResource Panel.Notice}" Padding="16,12" Margin="0,0,0,16" Visibility="{Binding MissingPresentMon, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{l:T Ab.OpenMeasure}" Margin="16,0,0,0" VerticalAlignment="Center"
                    Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"/>
            <c:Icon Data="{StaticResource Icon.Warning}" Size="18" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{l:T Ab.NoPresentMon}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>

        <!-- ================================================================ 2. ESCOLHA -->
        <Border Style="{StaticResource Panel.Card}" Padding="20,16,20,18" Margin="0,0,0,16" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshGamesCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Ab.Setup.Reread}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <TextBlock Text="{l:T Ab.Setup.Title}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
            </DockPanel>

            <c:HowItWorks Margin="0,0,0,14">
              <c:StepItem Icon="{StaticResource Icon.Games}" Title="{l:T Ab.How.1}" Text="{l:T Ab.How.1Text}"/>
              <c:StepItem Icon="{StaticResource Icon.Apply}" Title="{l:T Ab.How.2}" Text="{l:T Ab.How.2Text}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Games}" Title="{l:T Ab.How.3}" Text="{l:T Ab.How.3Text}"/>
              <c:StepItem Icon="{StaticResource Icon.Check}" Title="{l:T Ab.How.4}" Text="{l:T Ab.How.4Text}" Tone="Good"/>
            </c:HowItWorks>

            <c:SkeletonLoader Shape="Lines" Lines="3" Visibility="{Binding IsLoadingGames, Converter={StaticResource BoolToVis}}"/>
            <c:EmptyState Illustration="{StaticResource Illo.Measure}" Text="{l:T Ab.Setup.NoGames}" Detail="{l:T Ab.Setup.NoGamesDetail}"
                          ActionText="{l:T Ab.OpenMeasure}" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                          Visibility="{Binding NoGames, Converter={StaticResource BoolToVis}}"/>

            <Grid Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1.4*"/>
              </Grid.ColumnDefinitions>
              <!-- Jogo -->
              <StackPanel>
                <TextBlock Text="{l:T Ab.Setup.Game}" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding GameChoices}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{l:T Ab.Setup.Game}"/>
                <TextBlock Text="{l:T Ab.Setup.Design}" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
                <CheckBox IsChecked="{Binding UseAba}" AutomationProperties.Name="{l:T Ab.Setup.Aba}">
                  <StackPanel>
                    <TextBlock Text="{l:T Ab.Setup.Aba}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="{l:T Ab.Setup.AbaDetail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding AskAtEnd}" Margin="0,10,0,0" AutomationProperties.Name="{l:T Ab.Setup.Ask}">
                  <StackPanel>
                    <TextBlock Text="{l:T Ab.Setup.Ask}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="{l:T Ab.Setup.AskDetail}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding PlaysText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,14,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <!-- Ajustes -->
              <StackPanel Grid.Column="2">
                <TextBlock Text="{l:T Ab.Setup.Tweaks}" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
                <TextBlock Text="{l:T Ab.Setup.NoTweaks}" Style="{StaticResource Text.Small}" Visibility="{Binding NoCandidates, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding SelectedGame.Candidates}" ItemTemplate="{StaticResource Ab.Candidate}" Focusable="False"
                              Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{l:T Ab.Setup.OneAtATime}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button Style="{StaticResource Button.Primary}" Content="{l:T Ab.Start}" Command="{Binding StartCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ================================================================ 3. EM ANDAMENTO -->
        <Border Style="{StaticResource Panel.Hero}" Padding="22,18,24,20" Margin="0,0,0,16" Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{Binding ActiveHeadline}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.H1}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding StepDetail}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <ProgressBar Value="{Binding PlayProgress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,14,0,0"
                         Visibility="{Binding IsWorking, Converter={StaticResource FalseToVisible}}"/>
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>

            <!-- Esperando o usuário jogar: o que o Medir está vendo -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsWaitingForPlay, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Measure}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding MeasureHint}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
              </DockPanel>
              <TextBlock Text="{l:T Ab.AutoMeasureOff}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Visibility="{Binding AutoMeasureOff, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{l:T Ab.SameSceneTip}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Fim sem desfazer automático: a pergunta -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsAsking, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{Binding AskText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource Button.Primary}" Content="{l:T Ab.Keep}" Command="{Binding KeepCommand}"/>
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Ab.Undo}" Command="{Binding UndoCommand}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>

            <DockPanel Margin="0,12,0,0" Visibility="{Binding HasLastNote, Converter={StaticResource BoolToVis}}">
              <c:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,8,0" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding LastNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
            <TextBlock Text="{Binding QueueText}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource Button.Ghost}" Content="{l:T Ab.Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <!-- ================================================================ 4. RESULTADO -->
        <Border Style="{StaticResource Panel.Card}" Padding="20,16,20,18" Margin="0,0,0,16" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
          <StackPanel DataContext="{Binding Result}">
            <DockPanel>
              <c:StatusChip DockPanel.Dock="Right" Tone="{Binding OutcomeTone}" Text="{Binding OutcomeText}" Margin="12,0,0,0" VerticalAlignment="Top"/>
              <StackPanel>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource Ab.Metric}" Focusable="False" Margin="0,14,0,0"
                          Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource Ab.Warning}" Focusable="False" Margin="0,10,0,0"
                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"/>
            <c:ExplainToggle Margin="0,8,0,0" Visibility="{Binding HasMethod, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="{Binding Method}" Style="{StaticResource Text.Small}" TextWrapping="Wrap"/>
                <TextBlock Text="{l:T Ab.Method.Explain}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>
        <Button Style="{StaticResource Button.Secondary}" Content="{l:T Ab.NewTest}" Command="{Binding DismissResultCommand}" HorizontalAlignment="Left" Margin="0,-4,0,20"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>

        <!-- ================================================================ 5. HISTÓRICO -->
        <Border Style="{StaticResource Panel.Card}" Padding="20,16,20,14" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="{l:T Ab.History.Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource Ab.HistoryRow}" Focusable="False"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
