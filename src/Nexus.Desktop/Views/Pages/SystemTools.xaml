<!--
  Ferramentas do sistema: rede, Wi-Fi, drivers, apps do Windows e pontos de restauração.
  Leitura direto da biblioteca Nexus.SystemTools; escrita só pelo aplicador (Host.ApplyAsync/RevertAsync, no ViewModel).
  Do tema, só chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml); estilos próprios em DataTemplate.Resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <DataTemplate DataType="{x:Type vm:SystemToolsPage}">
    <DataTemplate.Resources>
      <Style x:Key="ST.Section" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="20,16,20,18"/>
      </Style>
      <Style x:Key="ST.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ST.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- Selo de texto com cor por "Tone" (good/bad/trace/signal/muted). -->
      <Style x:Key="ST.Tone" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="trace"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="signal"><Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Linha de ação: o que é, estado, motivo de proteção e os botões Remover / Desfazer. -->
      <DataTemplate x:Key="ST.Row" DataType="{x:Type vm:SystemActionRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,9,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Badge}" Style="{StaticResource ST.Tone}" Margin="10,1,0,0" VerticalAlignment="Center"
                           Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}"/>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Blocked}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                         Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource ST.Tone}" Margin="0,3,0,0"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Content="Remover" Style="{StaticResource ST.Small}" Command="{Binding ApplyCommand}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
              <Button Content="Desfazer" Style="{StaticResource ST.Small}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
              <Button Content="{Binding ExtraLabel}" Style="{StaticResource ST.Link}" Command="{Binding ExtraCommand}"
                      Visibility="{Binding ExtraLabel, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,28" MaxWidth="1100" HorizontalAlignment="Stretch">
        <!-- Cabeçalho -->
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                       Text="Nada aqui acelera jogos: são ferramentas de manutenção. Toda remoção guarda um backup antes e tem Desfazer; o que não tem volta é dito na confirmação."/>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Button Content="Ler de novo" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Padding="14,7"/>
          </StackPanel>
        </Grid>
        <Border Style="{StaticResource Panel.Inset}" Padding="12,8" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
        </Border>

        <!-- Rede -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <TextBlock Text="Rede" Style="{StaticResource Text.H2}"/>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,12"
                       Text="Limpar caches resolve sites que não abrem depois de trocar de DNS ou de roteador. Não melhora ping nem velocidade."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Cache DNS" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Text="{Binding DnsEntries}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
                  <TextBlock Text="{Binding DnsCaption}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/>
                  <Button Content="Limpar cache DNS" Style="{StaticResource Button.Primary}" Command="{Binding FlushDnsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  <TextBlock Text="Sem administrador. Nada a desfazer: o cache se refaz sozinho." Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Panel.Inset}" Padding="14,10" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="Cache ARP" Style="{StaticResource Text.MetricLabel}"/>
                  <TextBlock Text="{Binding ArpEntries}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}"/>
                  <TextBlock Text="endereços dinâmicos da rede local" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}"/>
                  <Button Content="Limpar cache ARP" Style="{StaticResource Button.Secondary}" Command="{Binding FlushArpCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  <TextBlock Text="Pede administrador. Nada a desfazer: as entradas voltam em segundos." Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                           Text="Reset de Winsock/TCP-IP: só para conexão quebrada (não acelera). Exige reinício e apaga IP/DNS/VPN configurados à mão, sem como desfazer. Por isso o NEXUS não faz sozinho: use a Redefinição de rede do Windows."/>
                <Button Grid.Column="1" Content="Abrir configurações de rede" Style="{StaticResource ST.Link}" Command="{Binding OpenNetworkCommand}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Wi-Fi -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <TextBlock Text="Redes Wi-Fi salvas" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding WifiNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,4"/>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,8"
                       Text="Remover redes antigas evita conexões automáticas a redes que você não usa. Antes de remover, o NEXUS guarda o perfil com a senha, criptografado pelo Windows."/>
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding WifiProfiles}" ItemTemplate="{StaticResource ST.Row}"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Drivers -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Drivers no repositório do Windows" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding DriverNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBlock Text="{Binding DriverCandidates}" Style="{StaticResource Text.Metric}" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Right"/>
                <TextBlock Text="versões antigas sem uso" Style="{StaticResource Text.MetricLabel}" HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,8"
                       Text="Nunca removido: driver em uso, disco/controladoras/sistema/USB/teclado, e vídeo ou rede sem versão mais nova. A remoção é feita sem /force: o Windows recusa se algum aparelho usar o pacote."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <CheckBox Content="Mostrar só versões antigas sem uso" IsChecked="{Binding OnlyCandidates}" VerticalAlignment="Center"/>
              <Button Content="Backup de todos os drivers" Style="{StaticResource ST.Small}" Command="{Binding BackupDriversCommand}" Margin="18,0,0,0"/>
              <Button Content="Abrir backups" Style="{StaticResource ST.Link}" Command="{Binding OpenDriverBackupsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding DriverBackupInfo}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,6"/>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Drivers}" ItemTemplate="{StaticResource ST.Row}"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Apps do Windows -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <TextBlock Text="Apps pré-instalados do Windows" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding AppxNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,4"/>
            <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,8"
                       Text="Só apps de uma lista fechada, só para o seu usuário. Store, Instalador de Aplicativo (winget), bibliotecas, Segurança do Windows e componentes do sistema nunca aparecem aqui. Desfazer é limitado: se os arquivos do app não estiverem mais no PC, reinstale pela Store."/>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ST.Row}"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Pontos de restauração -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <TextBlock Text="Pontos de restauração" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="{Binding ProtectionStatus}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,2"/>
            <TextBlock Text="{Binding RestoreNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button Content="Criar ponto agora" Style="{StaticResource Button.Primary}" Command="{Binding CreateRestorePointCommand}"/>
              <Button Content="Restaurar o sistema…" Style="{StaticResource ST.Small}" Command="{Binding OpenRestoreCommand}"/>
              <Button Content="Proteção do Sistema" Style="{StaticResource ST.Link}" Command="{Binding OpenProtectionCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding RestorePoints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RestorePointRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding When}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
