<!--
  Ferramentas do sistema (design system v2, docs/10-design-system.md):
    1. Destaque: rede, "itens para arrumar" (versões antigas de driver sem uso + redes Wi-Fi esquecidas) contando, três números
       à direita (cache DNS, redes salvas, pontos de restauração); ação principal "Criar ponto de restauração".
    2. Como funciona: Lê → Guarda → Remove → Desfaz.
    3. Seções como cartões, cada uma com a sua ilustração e um número: Rede (Illo.Network), Wi-Fi (Illo.Network),
       Drivers (Illo.Drivers), Apps do Windows (Illo.Programs), Pontos de restauração (Illo.History). Explicações longas e
       regras de proteção em "Por que isso?"; o motivo de um item travado continua visível.
  Leitura direto da biblioteca Nexus.SystemTools; escrita só pelo aplicador (Host.ApplyAsync/RevertAsync, no ViewModel).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:SystemToolsPage}">
    <DataTemplate.Resources>
      <Style x:Key="ST.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ST.Link" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ST.Section" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="20,16,20,18"/>
      </Style>
      <!-- Ilustração pequena no cabeçalho de cada seção. -->
      <Style x:Key="ST.Illo" TargetType="Image">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="-6,-6,12,-4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Uniform"/>
      </Style>
      <Style x:Key="ST.Number" TargetType="c:AnimatedNumber">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Decimals" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
      </Style>

      <!-- Linha de ação: seleção para o lote, nome + selo, detalhe em 1 linha, motivo de proteção visível, Remover / Desfazer. -->
      <DataTemplate x:Key="ST.Row" DataType="{x:Type vm:SystemActionRow}">
        <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,9,0,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="{l:T Tools.IncluirRemoverSelecionados}"
                      AutomationProperties.Name="{Binding Title, StringFormat={l:T Tools.IncluirLoteN}}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
            <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Top" Margin="1,3,0,0"
                    Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <DockPanel>
                <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneValue}" Text="{Binding Badge}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Detail}"/>
              <TextBlock Text="{Binding Blocked}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                         Visibility="{Binding Blocked, Converter={StaticResource NullToCollapsed}}"/>
              <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                         Foreground="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=text}"
                         Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="{l:T Meas.Remover}" Style="{StaticResource ST.Small}" Command="{Binding ApplyCommand}"
                      Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
              <Button Style="{StaticResource ST.Small}" Command="{Binding RevertCommand}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Shell.Desfazer}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="{Binding ExtraLabel}" Style="{StaticResource ST.Link}" Command="{Binding ExtraCommand}"
                      Visibility="{Binding ExtraLabel, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Network}" Title="{l:T Tools.Arrumar}"
                     Number="{Binding FixableNumber}" IsLoading="{Binding IsLoading}"
                     Caption="{l:T Tools.DriversAntigosSemUso}"
                     ActionText="{l:T Tools.CriarPontoRestauracao}" Command="{Binding CreateRestorePointCommand}"
                     SecondaryText="{l:T Shell.LerNovo}" SecondaryCommand="{Binding RefreshCommand}">
          <StackPanel MinWidth="200">
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding DnsNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="20"
                                Foreground="{StaticResource Brush.Text}" Margin="12,0,0,0"/>
              <TextBlock Text="{l:T Tools.CacheDns}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding WifiNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="20"
                                Foreground="{StaticResource Brush.Text}" Margin="12,0,0,0"/>
              <TextBlock Text="{l:T Tools.RedesWiFiSalvas}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
              <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding RestorePointNumber}" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="20"
                                Foreground="{StaticResource Brush.Text}" Margin="12,0,0,0"/>
              <TextBlock Text="{l:T Tools.PontosRestauracao}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <c:StatusChip Tone="{Binding ProtectionTone}" Text="{Binding ProtectionChip}" HorizontalAlignment="Left"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Desfazer o último lote -->
        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,14" Visibility="{Binding CanUndoBatch, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{l:T Tools.UltimoLoteGuardouBackup}" Style="{StaticResource Text.Small}"
                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoBatchCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding UndoBatchLabel}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="{l:T Pg.Le}" Text="{l:T Tools.ListaRedesDriversApps}"/>
              <c:StepItem Icon="{StaticResource Icon.Export}" Title="{l:T Clean.Guarda}" Text="{l:T Tools.AntesRemoverSalvaBackup}"/>
              <c:StepItem Icon="{StaticResource Icon.Trash}" Title="{l:T Tools.Remove}" Text="{l:T Tools.SoVoceMarcouDepois}" Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="{l:T Pg.Desfaz}" Text="{l:T Tools.BotaoDesfazerLinhaOu}" Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="{l:T Tools.NadaAquiAceleraJogos}"/>
          </StackPanel>
        </Border>

        <!-- ===== 3a. Rede ===== -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Image DockPanel.Dock="Left" Source="{StaticResource Illo.Network}" Style="{StaticResource ST.Illo}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Mon.Rede}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Tools.SiteNaoAbreDepois}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <UniformGrid Columns="2" Margin="-6,0">
              <Border Style="{StaticResource Panel.Inset}" Padding="14,12" Margin="6,0">
                <StackPanel>
                  <DockPanel>
                    <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding DnsNumber}" Style="{StaticResource ST.Number}"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{l:T Tools.CacheDns2}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Text="{Binding DnsCaption}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </DockPanel>
                  <Button Content="{l:T Tools.LimparCacheDns}" Style="{StaticResource Button.Secondary}" Command="{Binding FlushDnsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  <c:StatusChip Tone="Info" Text="{l:T Tools.SemAdministradorRefazSozinho}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Panel.Inset}" Padding="14,12" Margin="6,0">
                <StackPanel>
                  <DockPanel>
                    <c:AnimatedNumber DockPanel.Dock="Right" Value="{Binding ArpNumber}" Style="{StaticResource ST.Number}"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{l:T Tools.CacheArp}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                      <TextBlock Text="{l:T Tools.EnderecosRedeLocal}" Style="{StaticResource Text.Small}"/>
                    </StackPanel>
                  </DockPanel>
                  <Button Content="{l:T Tools.LimparCacheArp}" Style="{StaticResource Button.Secondary}" Command="{Binding FlushArpCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  <c:StatusChip Tone="Warn" Text="{l:T Tools.PedeAdministradorVoltaSegundos}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{l:T Tools.ConexaoQuebradaUseRedefinicao}"
                             Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  <c:ExplainToggle Content="{l:T Tools.ResetWinsockTcpIp}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{l:T Tools.AbrirConfiguracoesRede}" Style="{StaticResource ST.Link}" Command="{Binding OpenNetworkCommand}" VerticalAlignment="Top"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- ===== 3b. Wi-Fi ===== -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Image DockPanel.Dock="Left" Source="{StaticResource Illo.Network}" Style="{StaticResource ST.Illo}"/>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <c:AnimatedNumber Value="{Binding OldWifiNumber}" Style="{StaticResource ST.Number}"/>
                <TextBlock Text="{l:T Tools.SemUsoHa6}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Tools.RedesWiFiSalvas}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding WifiNote}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <c:ExplainToggle Margin="0,0,0,6"
                             Content="{l:T Tools.RemoverRedesAntigasEvita}"/>
            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="0,4,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl ItemsSource="{Binding WifiProfiles}" ItemTemplate="{StaticResource ST.Row}" Focusable="False"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasWifi, Converter={StaticResource BoolToVis}}">
              <Button Content="{l:T Tools.RemoverSelecionadas}" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveSelectedWifiCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== 3c. Drivers ===== -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Image DockPanel.Dock="Left" Source="{StaticResource Illo.Drivers}" Style="{StaticResource ST.Illo}"/>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <c:AnimatedNumber Value="{Binding DriverCandidatesNumber}" Style="{StaticResource ST.Number}"/>
                <TextBlock Text="{l:T Tools.VersoesAntigasSemUso}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Tools.DriversGuardadosWindows}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{Binding DriverNote}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <c:ExplainToggle Header="{l:T Tools.NuncaRemovido}" Margin="0,0,0,8"
                             Content="{l:T Tools.DriverUsoDiscoControladoras}"/>
            <WrapPanel Margin="0,0,0,6">
              <CheckBox Content="{l:T Tools.MostrarSoVersoesAntigas}" IsChecked="{Binding OnlyCandidates}" VerticalAlignment="Center" Margin="0,0,18,6"/>
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding BackupDriversCommand}" Margin="0,0,4,6">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Export}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Tools.BackupTodosDrivers}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="{l:T Tools.AbrirBackups}" Style="{StaticResource ST.Link}" Command="{Binding OpenDriverBackupsCommand}" Margin="4,0,0,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding DriverBackupInfo}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,6"/>
            <c:SkeletonLoader Shape="Lines" Lines="4" Margin="0,4,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl ItemsSource="{Binding Drivers}" ItemTemplate="{StaticResource ST.Row}" Focusable="False"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="{l:T Tools.RemoverSelecionados}" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveSelectedDriversCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== 3d. Apps do Windows ===== -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Image DockPanel.Dock="Left" Source="{StaticResource Illo.Programs}" Style="{StaticResource ST.Illo}"/>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <c:AnimatedNumber Value="{Binding AppsNumber}" Style="{StaticResource ST.Number}"/>
                <TextBlock Text="{l:T Tools.AppsLista}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Tools.AppsVemWindows}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Tools.SoListaFechadaSo}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <c:StatusChip Tone="Warn" Text="{l:T Tools.DesfazerLimitadoVezesPreciso}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
            <c:ExplainToggle Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="{Binding AppxNote}" Style="{StaticResource Text.Small}"/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                           Text="{l:T Tools.StoreInstaladorAplicativoWinget}"/>
              </StackPanel>
            </c:ExplainToggle>
            <c:SkeletonLoader Shape="Lines" Lines="4" Margin="0,4,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ST.Row}" Focusable="False"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
              <Button Content="{l:T Tools.RemoverSelecionados}" Style="{StaticResource Button.Secondary}" Command="{Binding RemoveSelectedAppsCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== 3e. Pontos de restauração ===== -->
        <Border Style="{StaticResource ST.Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Image DockPanel.Dock="Left" Source="{StaticResource Illo.History}" Style="{StaticResource ST.Illo}"/>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <c:AnimatedNumber Value="{Binding RestorePointNumber}" Style="{StaticResource ST.Number}" Foreground="{StaticResource Brush.Good}"/>
                <TextBlock Text="{l:T Tools.PontosPc}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Tools.PontosRestauracao}" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="{l:T Tools.FotoSistemaVoltarAtras}" Style="{StaticResource Text.Small}"/>
              </StackPanel>
            </DockPanel>
            <c:StatusChip Tone="{Binding ProtectionTone}" Text="{Binding ProtectionStatus}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,8">
              <Button Style="{StaticResource Button.Secondary}" Command="{Binding CreateRestorePointCommand}" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Tools.CriarPontoAgora}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <Button Content="{l:T Tools.RestaurarSistema}" Style="{StaticResource Button.Secondary}" Command="{Binding OpenRestoreCommand}" Margin="0,0,4,6"/>
              <Button Content="{l:T Tools.ProtecaoSistema}" Style="{StaticResource ST.Link}" Command="{Binding OpenProtectionCommand}" Margin="4,0,0,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding RestoreNote}" Style="{StaticResource Text.Small}" Margin="0,0,0,6"/>
            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="0,4,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding RestorePoints}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RestorePointRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="28" Height="28" Margin="0,0,12,0">
                        <Ellipse Fill="{StaticResource Brush.GoodSoft}"/>
                        <c:Icon Data="{StaticResource Icon.History}" Size="14" Foreground="{StaticResource Brush.Good}" HorizontalAlignment="Center"/>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding When}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Description}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
