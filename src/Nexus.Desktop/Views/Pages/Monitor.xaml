<!--
  Monitor: medidores ao vivo (1 Hz, só com a página aberta), núcleos, motores da GPU, processos, discos/rede, saúde dos discos e
  temperaturas que o Windows de fato expõe. Somente leitura: nenhum botão aqui muda o sistema.
  Sem animação: valores e gráficos trocam de uma vez a cada leitura (respeita as animações desligadas do Windows).
  Recursos locais em DataTemplate.Resources; do tema, só as chaves do contrato (Tokens.xaml / Controls.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:mon="clr-namespace:Nexus.Desktop.Views.Monitor">
  <DataTemplate DataType="{x:Type vm:MonitorPage}">
    <DataTemplate.Resources>

      <!-- Cor por tom: info (ciano), good (verde), warn (âmbar), bad (vermelho). -->
      <Style x:Key="Mon.ToneText" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good"><Setter Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Medidor: rótulo, número grande (Bahnschrift), mini-gráfico de 5 min e detalhe. A cor do traço vem do Tag. -->
      <DataTemplate x:Key="Mon.Gauge" DataType="{x:Type vm:MonitorGauge}">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10" Padding="16,14">
          <StackPanel>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Metric}"/>
              <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.MetricLabel}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
            </StackPanel>
            <Border Style="{StaticResource Panel.Inset}" Padding="0" Margin="0,8,0,0" Height="48">
              <mon:Sparkline Series="{Binding Series}" GridBrush="{StaticResource Brush.Graticule}"
                             Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                             ToolTip="Últimos 5 minutos"/>
            </Border>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" MinHeight="34"/>
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- Linha com barra horizontal (motor da GPU, disco, adaptador de rede). -->
      <DataTemplate x:Key="Mon.Meter" DataType="{x:Type vm:MeterRow}">
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="52"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Right"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,5,0,0">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="2.5"/>
            <Rectangle Fill="{StaticResource Brush.Signal}" RadiusX="2.5" RadiusY="2.5" RenderTransformOrigin="0,0.5">
              <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Fraction}"/>
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="Mon.Activity" DataType="{x:Type vm:ActivityRow}">
        <StackPanel Margin="0,0,0,4">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Mon.Meter}" Margin="0,0,0,-6"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,0,0,8"/>
        </StackPanel>
      </DataTemplate>

      <!-- Barra vertical de um núcleo lógico. -->
      <DataTemplate x:Key="Mon.Core" DataType="{x:Type vm:CoreBar}">
        <Grid Width="12" Height="64" Margin="0,0,4,4" ToolTip="{Binding Tip}" Background="{StaticResource Brush.Bg}">
          <Rectangle x:Name="bar" Fill="{StaticResource Brush.Signal}" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
              <ScaleTransform ScaleY="{Binding Fraction}"/>
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Hot}" Value="True">
            <Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <Style x:Key="Mon.Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <!-- Some quando o texto está vazio. -->
      <Style x:Key="Mon.HideEmpty" TargetType="Border" BasedOn="{StaticResource Panel.Notice}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding UnavailableNote}" Value="">
            <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,28">

        <!-- Cabeçalho -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0"
                       Text="Só leitura: o monitor não muda nada no PC. A coleta usa os mesmos contadores do Gerenciador de Tarefas e para sozinha quando você sai da página."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
            <Ellipse x:Name="liveDot" Width="8" Height="8" Fill="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap"/>
            <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Style="{StaticResource Button.Secondary}"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,8,0,0"/>

        <!-- Gargalo -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,14,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="toneBar" Width="3" Fill="{StaticResource Brush.Signal}" Margin="0,0,14,0" RadiusX="1.5" RadiusY="1.5"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="O que está limitando agora (média dos últimos 10 s)" Style="{StaticResource Text.Label}"/>
              <TextBlock x:Name="toneTitle" Text="{Binding BottleneckTitle}" Style="{StaticResource Text.H2}" Foreground="{StaticResource Brush.Signal}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding BottleneckText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                         Text="É uma leitura dos contadores do Windows, não do jogo por dentro: confirme com uma medição de frametime na página Medir."/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Medidores -->
        <UniformGrid Columns="5" Margin="0,0,-10,0">
          <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource Mon.Gauge}" Tag="{StaticResource Brush.Trace}" Focusable="False"/>
          <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource Mon.Gauge}" Tag="{StaticResource Brush.Signal}" Focusable="False"/>
          <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource Mon.Gauge}" Tag="{StaticResource Brush.Trace}" Focusable="False"/>
          <ContentControl Content="{Binding Disk}" ContentTemplate="{StaticResource Mon.Gauge}" Tag="{StaticResource Brush.Signal}" Focusable="False"/>
          <ContentControl Content="{Binding Net}" ContentTemplate="{StaticResource Mon.Gauge}" Tag="{StaticResource Brush.Signal}" Focusable="False"/>
        </UniformGrid>

        <!-- Núcleos + GPU -->
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock Text="CPU por núcleo lógico" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Small}" Margin="0,2,0,10"/>
              <ItemsControl ItemsSource="{Binding Cores}" ItemTemplate="{StaticResource Mon.Core}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0"
                         Text="Âmbar = núcleo a 90% ou mais. Passe o mouse para ver a frequência efetiva. O Windows move threads entre núcleos, então um jogo limitado por uma thread nem sempre aparece como um núcleo cravado em 100%."/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="GPU por motor" Style="{StaticResource Text.H2}"/>
              <TextBlock Text="O uso da GPU é o do motor mais ocupado (mesma regra do Gerenciador de Tarefas)." Style="{StaticResource Text.Small}" Margin="0,2,0,10"/>
              <ItemsControl ItemsSource="{Binding GpuEngines}" ItemTemplate="{StaticResource Mon.Meter}" Focusable="False"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Processos + discos/rede -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Processos mais pesados" Style="{StaticResource Text.H2}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Por CPU" GroupName="MonSort" IsChecked="{Binding SortByCpu, Mode=OneWay}" Command="{Binding SortByCpuCommand}" Margin="0,0,12,0"/>
                  <RadioButton Content="Por memória" GroupName="MonSort" IsChecked="{Binding SortByMemory, Mode=OneWay}" Command="{Binding SortByMemoryCommand}"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Processo" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Memória" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="GPU" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ProcessRow}">
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="60"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Pid, StringFormat=' · PID {0}'}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Mon.Num}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Mon.Num}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Gpu}" Style="{StaticResource Mon.Num}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                         Text="CPU = % da máquina inteira (todos os núcleos), atualizada a cada 2 s. Memória = conjunto de trabalho. Processos protegidos do Windows aparecem sem CPU."/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Discos" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
              <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource Mon.Activity}" Focusable="False"/>
              <TextBlock Text="Rede" Style="{StaticResource Text.H2}" Margin="0,6,0,10"/>
              <ItemsControl ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource Mon.Activity}" Focusable="False"/>
              <TextBlock Style="{StaticResource Text.Small}" Text="A barra da rede é o uso em relação à velocidade do link informada pelo adaptador."/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Saúde dos discos -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Saúde dos discos" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="O que o próprio Windows sabe do disco (estado de saúde e contadores de confiabilidade/SMART)." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Ler de novo" Command="{Binding RefreshHealthCommand}" Style="{StaticResource Button.Ghost}" VerticalAlignment="Top"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding DiskHealth}" Margin="0,12,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiskHealthRow}">
                  <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"/>
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Small}"/>
                        <TextBlock Text="{Binding Readings}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                                   Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Reasons}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource Mon.ToneText}" VerticalAlignment="Top" Margin="16,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding DiskHealthNote}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Temperaturas -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Temperaturas" Style="{StaticResource Text.H2}"/>
            <ItemsControl ItemsSource="{Binding Temperatures}" Margin="0,8,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                             Foreground="{StaticResource Brush.Text}" Margin="0,0,0,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TemperatureNote}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Contadores que o Windows não ofereceu -->
        <Border Style="{StaticResource Mon.HideEmpty}">
          <StackPanel>
            <TextBlock Text="Leituras indisponíveis neste PC" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{Binding UnavailableNote}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Running}" Value="True">
        <Setter TargetName="liveDot" Property="Fill" Value="{StaticResource Brush.Good}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding BottleneckTone}" Value="warn">
        <Setter TargetName="toneBar" Property="Fill" Value="{StaticResource Brush.Trace}"/>
        <Setter TargetName="toneTitle" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding BottleneckTone}" Value="good">
        <Setter TargetName="toneBar" Property="Fill" Value="{StaticResource Brush.Good}"/>
        <Setter TargetName="toneTitle" Property="Foreground" Value="{StaticResource Brush.Good}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
