<!--
  Monitor (design system v2, docs/10-design-system.md). Somente leitura: nenhum botão aqui muda o sistema.
    1. Destaque ....... cartão-veredito "o que limita agora" (média de 10 s) com a ilustração, o veredito em âmbar/verde/ciano,
                        distintivo com ícone do tom, Pausar/Retomar e o atalho para confirmar medindo uma partida.
    2. Medidores ...... CPU, GPU e memória como anéis (RingMeter) + mini-gráfico de 5 min; disco e rede com número e mini-gráfico.
    3. Núcleos e motores da GPU, processos mais pesados (com barra), discos/rede, saúde dos discos (selos), temperaturas.
    4. Como funciona (Lê → Aponta → Confirme) e o que o Windows não ofereceu, recolhidos.
  Coleta a 1 Hz só com a página aberta (MonitorPage). Anéis e números contam até a leitura nova (0,7 s); com as animações do
  Windows desligadas, trocam de uma vez. O mini-gráfico (Views.Monitor.Sparkline) nunca anima.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:mon="clr-namespace:Nexus.Desktop.Views.Monitor"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:MonitorPage}">
    <DataTemplate.Resources>

      <!--
        Medidor em anel (CPU, GPU, memória): ícone + nome, anel com a % no centro, mini-gráfico de 5 min e 2 linhas de detalhe.
        Tag do ContentControl = pincel do traço/anel. Faixas só na memória (pouca memória livre é problema de verdade);
        CPU/GPU altas num jogo são normais, então não ficam vermelhas.
      -->
      <DataTemplate x:Key="Mon.Ring" DataType="{x:Type vm:MonitorGauge}">
        <Border Style="{StaticResource Panel.Card}" Margin="7,0" Padding="18,14,18,16">
          <StackPanel>
            <DockPanel>
              <Grid Width="34" Height="34" Margin="0,0,10,0">
                <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource ResourceByKey}}" Size="17"
                        Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <c:RingMeter x:Name="ring" Value="{Binding Number}" Label="em uso" Width="128" Height="128" Thickness="11" Margin="0,12,0,10"
                         HorizontalAlignment="Center" Accent="{StaticResource Brush.Signal}"
                         AutomationProperties.Name="{Binding Label, StringFormat='{}{0} em uso'}"/>
            <Border Style="{StaticResource Panel.Inset}" Padding="0" Height="40">
              <mon:Sparkline Series="{Binding Series}" GridBrush="{StaticResource Brush.Graticule}" Stroke="{StaticResource Brush.Signal}" ToolTip="Últimos 5 minutos"/>
            </Border>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,8,0,0" MinHeight="34" MaxHeight="36"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <!-- Memória: faixas (85% atenção, 95% problema), porque pouca memória livre é problema de verdade. -->
          <DataTrigger Binding="{Binding Label}" Value="Memória">
            <Setter TargetName="ring" Property="WarnAt" Value="85"/>
            <Setter TargetName="ring" Property="BadAt" Value="95"/>
            <Setter TargetName="ring" Property="HigherIsBetter" Value="False"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Medidor compacto (disco, rede): ícone, número grande, unidade e mini-gráfico ao lado. -->
      <DataTemplate x:Key="Mon.Compact" DataType="{x:Type vm:MonitorGauge}">
        <Border Style="{StaticResource Panel.Card}" Margin="7,0" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto" MinWidth="120"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
              <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
              <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource ResourceByKey}}" Size="17"
                      Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="0,0,14,0">
              <TextBlock Text="{Binding Label}" Style="{StaticResource Text.MetricLabel}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" FontSize="30" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.MetricLabel}" VerticalAlignment="Bottom" Margin="4,0,0,6" TextWrapping="NoWrap"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Panel.Inset}" Padding="0" Height="40">
                <mon:Sparkline Series="{Binding Series}" GridBrush="{StaticResource Brush.Graticule}" Stroke="{StaticResource Brush.Signal}" ToolTip="Últimos 5 minutos"/>
              </Border>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Detail}"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Linha com barra horizontal (motor da GPU, disco, adaptador de rede). -->
      <DataTemplate x:Key="Mon.Meter" DataType="{x:Type vm:MeterRow}">
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="52"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Right"/>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,5,0,0">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
            <Rectangle Fill="{StaticResource Brush.Signal}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5" RenderTransform="{Binding Fraction, Converter={StaticResource FractionScale}}">
            </Rectangle>
          </Grid>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="Mon.Activity" DataType="{x:Type vm:ActivityRow}">
        <StackPanel Margin="0,0,0,4">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Mon.Meter}" Margin="0,0,0,-6"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Small}" Margin="0,0,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Detail}"/>
        </StackPanel>
      </DataTemplate>

      <!-- Barra vertical de um núcleo lógico (âmbar = 90% ou mais). -->
      <DataTemplate x:Key="Mon.Core" DataType="{x:Type vm:CoreBar}">
        <Grid Width="14" Height="72" Margin="0,0,5,5" ToolTip="{Binding Tip}">
          <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
          <Border x:Name="bar" Background="{StaticResource Brush.Signal}" CornerRadius="3" RenderTransformOrigin="0.5,1" RenderTransform="{Binding Fraction, Converter={StaticResource FractionScale}, ConverterParameter=Y}">
          </Border>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Hot}" Value="True">
            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <Style x:Key="Mon.Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <!-- Título de cartão com distintivo de ícone (Tag = chave do ícone). -->
      <DataTemplate x:Key="Mon.CardTitle">
        <DockPanel Margin="0,0,0,10">
          <Grid Width="34" Height="34" Margin="0,0,10,0">
            <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
            <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}, Converter={StaticResource ResourceByKey}}" Size="17"
                    Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
          </Grid>
          <TextBlock Text="{Binding}" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
        </DockPanel>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Falha de leitura -->
        <Border Background="{StaticResource Brush.BadSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Error}" Size="16" Foreground="{StaticResource Brush.Bad}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ================================================================ 1. CARTÃO-VEREDITO -->
        <c:HeroPanel Illustration="{StaticResource Illo.Monitor}" Title="O que limita agora"
                     ValueText="{Binding BottleneckTitle}" Caption="{Binding BottleneckText}" IsLoading="{Binding IsWarmingUp}"
                     Accent="{Binding BottleneckToneValue, Converter={StaticResource ToneBrush}}"
                     ActionText="Medir uma partida para confirmar" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                     SecondaryText="{Binding ToggleText}" SecondaryCommand="{Binding ToggleCommand}">
          <StackPanel Width="170">
            <Grid Width="84" Height="84" HorizontalAlignment="Center">
              <Ellipse Fill="{Binding BottleneckToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <c:Icon Data="{Binding BottleneckIconKey, Converter={StaticResource ResourceByKey}}" Size="38"
                      Foreground="{Binding BottleneckToneValue, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource Brush.TextDim}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Running}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Brush.Good}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="150"/>
            </StackPanel>
            <c:ExplainToggle Margin="0,8,0,0" HorizontalAlignment="Center"
                             Content="Média dos últimos 10 s, com os mesmos contadores do Gerenciador de Tarefas. É uma leitura de fora do jogo: confirme medindo o frametime em Medir. A coleta para sozinha quando você sai desta página."/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ================================================================ 2. MEDIDORES -->
        <c:SkeletonLoader Shape="Tiles" Columns="3" Height="300" Margin="0,0,0,14" Visibility="{Binding IsWarmingUp, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Visibility="{Binding IsWarmingUp, Converter={StaticResource FalseToVisible}}">
          <UniformGrid Columns="3" Margin="-7,0,-7,14">
            <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource Mon.Ring}" Tag="Icon.Cpu" Focusable="False"/>
            <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource Mon.Ring}" Tag="Icon.Gpu" Focusable="False"/>
            <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource Mon.Ring}" Tag="Icon.Ram" Focusable="False"/>
          </UniformGrid>
          <UniformGrid Columns="2" Margin="-7,0,-7,20">
            <ContentControl Content="{Binding Disk}" ContentTemplate="{StaticResource Mon.Compact}" Tag="Icon.Disk" Focusable="False"/>
            <ContentControl Content="{Binding Net}" ContentTemplate="{StaticResource Mon.Compact}" Tag="Icon.Network" Focusable="False"/>
          </UniformGrid>
        </StackPanel>

        <!-- ================================================================ 3. NÚCLEOS + GPU -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}">
            <StackPanel>
              <ContentControl Content="Processador, núcleo a núcleo" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Cpu" Focusable="False"/>
              <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Small}" Margin="0,-4,0,10" Visibility="{Binding CpuName, Converter={StaticResource NullToCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding Cores}" ItemTemplate="{StaticResource Mon.Core}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Brush.Signal}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="em uso" Style="{StaticResource Text.Small}" Margin="0,0,14,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Brush.Trace}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="90% ou mais" Style="{StaticResource Text.Small}"/>
              </StackPanel>
              <c:ExplainToggle Margin="0,4,0,0"
                               Content="Passe o mouse num núcleo para ver a frequência efetiva. O Windows move as tarefas entre núcleos, então um jogo limitado por uma tarefa só nem sempre aparece como um núcleo cravado em 100%."/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
            <StackPanel>
              <ContentControl Content="Placa de vídeo, por motor" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Gpu" Focusable="False"/>
              <ItemsControl ItemsSource="{Binding GpuEngines}" ItemTemplate="{StaticResource Mon.Meter}" Focusable="False"/>
              <TextBlock Text="Sem contadores de GPU neste PC." Style="{StaticResource Text.Small}"
                         Visibility="{Binding GpuEngines.Count, Converter={StaticResource ZeroToVisible}}"/>
              <c:ExplainToggle Margin="0,2,0,0" Content="O uso da GPU é o do motor mais ocupado, a mesma regra do Gerenciador de Tarefas."/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ================================================================ PROCESSOS + DISCOS/REDE -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel.Card}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                  <RadioButton Style="{StaticResource Tab.Underline}" Content="Por CPU" GroupName="MonSort" IsChecked="{Binding SortByCpu, Mode=OneWay}"
                               Command="{Binding SortByCpuCommand}" Margin="0,0,18,0" FontSize="{StaticResource Size.Body}"/>
                  <RadioButton Style="{StaticResource Tab.Underline}" Content="Por memória" GroupName="MonSort" IsChecked="{Binding SortByMemory, Mode=OneWay}"
                               Command="{Binding SortByMemoryCommand}" Margin="0" FontSize="{StaticResource Size.Body}"/>
                </StackPanel>
                <ContentControl Content="Programas mais pesados" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Apps" Focusable="False"/>
              </DockPanel>
              <Grid Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Programa" Style="{StaticResource Text.Label}"/>
                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Memória" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="GPU" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
              </Grid>
              <c:SkeletonLoader Shape="Lines" Lines="6" Visibility="{Binding IsWarmingUp, Converter={StaticResource BoolToVis}}"/>
              <ItemsControl ItemsSource="{Binding Processes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ProcessRow}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="60"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal" ToolTip="{Binding Pid, StringFormat='PID {0}'}">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Mon.Num}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Mon.Num}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Gpu}" Style="{StaticResource Mon.Num}"/>
                      <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,4,0,0">
                        <Border Background="{StaticResource Brush.Bg}" CornerRadius="1.5"/>
                        <Rectangle Fill="{StaticResource Brush.Trace}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5" RenderTransform="{Binding CpuFraction, Converter={StaticResource FractionScale}}">
                        </Rectangle>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:ExplainToggle Margin="0,2,0,0"
                               Content="CPU = % da máquina inteira (todos os núcleos), atualizada a cada 2 s. Memória = conjunto de trabalho. Processos protegidos do Windows aparecem sem CPU. Passe o mouse no nome para ver o PID."/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
            <StackPanel>
              <ContentControl Content="Discos" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Disk" Focusable="False"/>
              <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource Mon.Activity}" Focusable="False"/>
              <ContentControl Content="Rede" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Network" Focusable="False" Margin="0,6,0,0"/>
              <ItemsControl ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource Mon.Activity}" Focusable="False"/>
              <TextBlock Text="A barra da rede é o uso em relação à velocidade do link." Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ================================================================ SAÚDE DOS DISCOS -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Command="{Binding RefreshHealthCommand}" Style="{StaticResource Button.Ghost}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
              <ContentControl Content="Saúde dos discos" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Security" Focusable="False"/>
            </DockPanel>
            <c:SkeletonLoader Shape="Lines" Lines="3" Margin="0,0,0,8" Visibility="{Binding HealthLoading, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding DiskHealth}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" Margin="-7,0"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiskHealthRow}">
                  <Border Style="{StaticResource Panel.Inset}" Margin="7,0,7,10">
                    <StackPanel>
                      <DockPanel>
                        <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ToneValue}" Text="{Binding LevelText}" VerticalAlignment="Top" Margin="10,0,0,0"/>
                        <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                          <Ellipse Fill="{Binding ToneValue, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                          <c:Icon Data="{StaticResource Icon.Disk}" Size="17" Foreground="{Binding ToneValue, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                          <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Text="{Binding Readings}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                                 Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                      <c:ExplainToggle Margin="0,2,0,0" Content="{Binding Reasons}" Visibility="{Binding Reasons, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:ExplainToggle Header="Critérios e o que o Windows informa" Content="{Binding DiskHealthNote}"/>
          </StackPanel>
        </Border>

        <!-- ================================================================ TEMPERATURAS -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <ContentControl Content="Temperaturas" ContentTemplate="{StaticResource Mon.CardTitle}" Tag="Icon.Bolt" Focusable="False"/>
            <ItemsControl ItemsSource="{Binding Temperatures}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,6">
                    <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.Text}"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Visibility="{Binding Temperatures.Count, Converter={StaticResource ZeroToVisible}}">
              <c:Icon Data="{StaticResource Icon.Info}" Size="14" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="Este PC não expõe nenhum sensor de temperatura ao Windows." Style="{StaticResource Text.Small}"/>
            </DockPanel>
            <c:ExplainToggle Margin="0,4,0,0" Content="{Binding TemperatureNote}"/>
          </StackPanel>
        </Border>

        <!-- ================================================================ COMO FUNCIONA + INDISPONÍVEIS -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16">
          <StackPanel>
            <TextBlock Text="Como o monitor funciona" Style="{StaticResource Text.H2}" Margin="0,0,0,14"/>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Contadores do Windows, 1 vez por segundo. Ler não muda nada."/>
              <c:StepItem Icon="{StaticResource Icon.Monitor}" Title="Aponta" Text="Mostra o que está no limite: processador, placa ou memória." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Confirme" Text="Meça uma partida em Medir para ver o efeito no jogo." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Header="Leituras indisponíveis neste PC" Content="{Binding UnavailableNote}" Margin="0,12,0,0"
                             Visibility="{Binding UnavailableNote, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

  </DataTemplate>
</ResourceDictionary>
