<!--
  "Testar sem aplicar": escolha dos ajustes, simulação local (dry-run) e a prévia do que mudaria, agrupada por resultado.
  Os resultados entram em sequência depois de simular. Recursos locais ficam no próprio DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:PlanPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Plan.Shown"/>
      <opt:EmptyToCollapsedConverter x:Key="Plan.ShownWhenEmpty" Invert="True"/>

      <Style x:Key="Plan.Arrow" TargetType="Path">
        <Setter Property="Data" Value="M0,5 L16,5 M11,0 L16,5 L11,10"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0"/>
      </Style>
      <Style x:Key="Plan.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Plan.Next" TargetType="TextBlock" BasedOn="{StaticResource Plan.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>

      <!-- Cor de cada resultado: âmbar muda, verde já está, apagado não se aplica, vermelho bloqueada. -->
      <Style x:Key="Plan.KindMark" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="Pending">
            <Setter Property="Background" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="AlreadyConfigured">
            <Setter Property="Background" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Blocked">
            <Setter Property="Background" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Plan.KindCount" TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="Pending">
            <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="AlreadyConfigured">
            <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Blocked">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
          <!-- Zero fica apagado, qualquer que seja o grupo. -->
          <DataTrigger Binding="{Binding Count}" Value="0">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Plan.Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="Margin" Value="0,8,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
      </Style>
    </DataTemplate.Resources>

    <Grid Margin="24,24,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Cabeçalho -->
      <StackPanel Grid.ColumnSpan="3">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Aviso: aqui nada é aplicado -->
      <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Panel.Notice}" Margin="0,16,0,16">
        <TextBlock Text="{Binding BlockedNotice}" Style="{StaticResource Text.Body}"/>
      </Border>

      <!-- ===== Escolha ===== -->
      <Border Grid.Row="2" Style="{StaticResource Panel.Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Escolha o que testar" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="Só aparecem os ajustes que dá pra ler neste PC." Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Simular" Command="{Binding SimulateCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"/>
            <TextBlock Text="Relendo o estado do PC…" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,8,0,0"
                       Visibility="{Binding Busy, Converter={StaticResource Plan.Shown}}"/>
          </StackPanel>

          <Grid>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Top"
                       Text="Nenhum ajuste pode ser simulado ainda. Use Ler novamente no topo da janela."
                       Visibility="{Binding Candidates.Count, Converter={StaticResource Plan.ShownWhenEmpty}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include}" Margin="0,0,0,12" VerticalContentAlignment="Top" Cursor="Hand">
                      <StackPanel Margin="4,-2,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"/>
                        <Grid Margin="0,3,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Current}" Style="{StaticResource Plan.Now}" ToolTip="{Binding Current}"/>
                          <Path Grid.Column="1" Style="{StaticResource Plan.Arrow}" Margin="8,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Plan.Next}" ToolTip="{Binding Desired}"/>
                        </Grid>
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ===== Resultado ===== -->
      <Grid Grid.Row="2" Grid.Column="2">
        <!-- Antes de simular -->
        <Border Style="{StaticResource Panel.Inset}" Padding="28" VerticalAlignment="Top"
                Visibility="{Binding HasResult, Converter={StaticResource Plan.ShownWhenEmpty}}">
          <StackPanel MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Text="Nada simulado ainda" Style="{StaticResource Text.H2}"/>
            <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                       Text="Marque os ajustes à esquerda e clique em Simular. A gente relê o PC e mostra, item por item, o que mudaria e o que já está certo."/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>

        <!-- Depois de simular -->
        <DockPanel Visibility="{Binding HasResult, Converter={StaticResource Plan.Shown}}">
          <!-- Mostrador: quantos em cada resultado -->
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Groups}" opt:Reveal.Trigger="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Panel.Inset}" Margin="0,0,8,0" Padding="14,10">
                  <StackPanel>
                    <TextBlock Text="{Binding Count}" Style="{StaticResource Plan.KindCount}"/>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.MetricLabel}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,10,0,6"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,14,0,0" opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True"
                              Visibility="{Binding Count, Converter={StaticResource Plan.Shown}}">
                    <!-- Cabeçalho do grupo -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Plan.KindMark}" Width="3" CornerRadius="1.5" Margin="0,2,12,2"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.H2}">
                          <Run Text="{Binding Title, Mode=OneWay}"/>
                          <Run Text="{Binding Count, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextMuted}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Small}"/>
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="15,0,0,6"
                                  opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                              <Grid Margin="0,6,0,0" Visibility="{Binding ShowsChange, Converter={StaticResource Plan.Shown}}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="agora" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Observed}" Style="{StaticResource Plan.Now}" MaxWidth="220" ToolTip="{Binding Observed}"/>
                                <Path Grid.Column="2" Style="{StaticResource Plan.Arrow}"/>
                                <TextBlock Grid.Column="3" Text="depois" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding Desired}" Style="{StaticResource Plan.Next}" ToolTip="{Binding Desired}"/>
                              </Grid>
                              <Border Style="{StaticResource Plan.Tag}" Visibility="{Binding AfterReboot, Converter={StaticResource Plan.Shown}}">
                                <TextBlock Text="Entra no segundo lote, depois de reiniciar" Style="{StaticResource Text.Small}"/>
                              </Border>
                              <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                                         Visibility="{Binding Reason, Converter={StaticResource Plan.Shown}}"/>
                              <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"
                                         FontFamily="{StaticResource Font.Numbers}" Margin="0,6,0,0"
                                         Visibility="{Binding Key, Converter={StaticResource Plan.Shown}}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
