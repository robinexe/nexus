<!--
  "Testar sem aplicar" (design system v2, docs/10-design-system.md). Primeiro passo do caminho seguro
  Simular → Confirmar → Registrar → Desfazer (o mesmo trilho aparece em Aplicar e Histórico, cada passo abre a página dele).
    1. Destaque: quantos mudariam (conta depois de simular), "Simular" (âmbar), quantos estão marcados agora.
    2. O trilho com "Você está aqui".
    3. Esquerda: o que testar (os mesmos marcados de Aplicar). Direita: 4 cartões (mudaria, já está, não se aplica, bloqueada)
       e os itens agrupados com agora → depois; antes de simular, estado vazio com o próximo passo.
  Nada é aplicado aqui. Recursos locais no próprio DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:PlanPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Plan.Shown"/>

      <!-- Passo do caminho seguro: distintivo, número + verbo, 1 frase; o passo desta página fica âmbar com "Você está aqui". -->
      <DataTemplate x:Key="F.Step" DataType="{x:Type vm:FlowStep}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Button.Ghost}" Padding="0" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                  Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                  AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Text}">
            <Border x:Name="Card" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                  <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                          Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" TextWrapping="NoWrap">
                    <Run Text="{Binding Number, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextDim}"/>
                    <Run Text="{Binding Title, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Small}" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  <c:StatusChip x:Name="Here" Tone="Warn" Text="Você está aqui" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <c:Icon x:Name="Arrow" Grid.Column="1" Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{StaticResource Brush.TextDim}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.TraceLine}"/>
            <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.TraceSoft}"/>
            <Setter TargetName="Here" Property="Visibility" Value="Visible"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsLast}" Value="True">
            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Agora (ciano) → depois (âmbar). -->
      <Style x:Key="Plan.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Plan.Next" TargetType="TextBlock" BasedOn="{StaticResource Plan.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Settings}" Title="Mudariam no seu PC"
                     Number="{Binding HeroNumber}" ValueText="{Binding HeroValueText}" IsLoading="{Binding Busy}"
                     Caption="A gente relê o PC e mostra o que mudaria. Nada é aplicado."
                     ActionText="Simular" Command="{Binding SimulateCommand}"
                     SecondaryText="Ir para Aplicar" SecondaryCommand="{x:Static shell:ShellCommands.Navigate}" SecondaryCommandParameter="BrokerPage">
          <StackPanel MinWidth="170">
            <TextBlock Text="Marcados agora" Style="{StaticResource Text.Small}"/>
            <c:AnimatedNumber Value="{Binding SelectedCount}" FontFamily="{StaticResource Font.Numbers}" FontSize="26" Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,8" MaxWidth="200"/>
            <c:StatusChip Tone="Info" Text="Só lê, nunca escreve"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== Caminho seguro ===== -->
        <TextBlock Text="O caminho de toda mudança" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Flow}" ItemTemplate="{StaticResource F.Step}" Focusable="False" Margin="0,0,0,22">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
          </Grid.ColumnDefinitions>

          <!-- ===== Escolha ===== -->
          <Border Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Grid Width="34" Height="34" Margin="0,0,10,0">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Catalog}" Size="17" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="O que testar" Style="{StaticResource Text.H2}"/>
                  <TextBlock Text="Só os ajustes que dá pra ler neste PC." Style="{StaticResource Text.Small}"/>
                </StackPanel>
              </DockPanel>

              <c:EmptyState Illustration="{StaticResource Illo.Settings}" Text="Nada para testar ainda."
                            Detail="Os ajustes aparecem quando a leitura do PC terminar."
                            ActionText="Ver o que dá pra ajustar" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="CatalogPage"
                            Visibility="{Binding HasCandidates, Converter={StaticResource FalseToVisible}}"/>

              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560"
                            Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                        <CheckBox IsChecked="{Binding Include}" VerticalContentAlignment="Top" Cursor="Hand" AutomationProperties.Name="{Binding Title}">
                          <StackPanel Margin="4,-2,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                            <Grid Margin="0,3,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Current}" Style="{StaticResource Plan.Now}" ToolTip="{Binding Current}"/>
                              <c:Icon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Size="13" Foreground="{StaticResource Brush.TextDim}" Margin="6,0"/>
                              <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Plan.Next}" ToolTip="{Binding Desired}"/>
                            </Grid>
                          </StackPanel>
                        </CheckBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- ===== Resultado ===== -->
          <StackPanel Grid.Column="2">
            <c:SkeletonLoader Shape="Tiles" Columns="4" Height="140" Margin="0,0,0,14" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>

            <!-- Antes de simular -->
            <c:EmptyState Illustration="{StaticResource Illo.Settings}" Text="Nada simulado ainda."
                          Detail="Marque à esquerda e simule: item por item, o que mudaria e o que já está certo."
                          ActionText="Simular" Command="{Binding SimulateCommand}"
                          Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,8,0,0" Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}"/>

            <!-- Depois de simular -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
              <UniformGrid Columns="4" Margin="-6,0,-6,10">
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.ArrowRight}" Number="{Binding PendingCount}" Tone="Warn"
                            Label="Mudaria" Detail="Hoje está diferente."/>
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.Check}" Number="{Binding AlreadyCount}" Tone="Good"
                            Label="Já está assim" Detail="Nada a fazer."/>
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.Info}" Number="{Binding NotApplicableCount}"
                            Label="Não se aplica" Detail="Não serve para este PC."/>
                <c:StatTile Margin="6,0" Icon="{StaticResource Icon.Lock}" Number="{Binding BlockedCount}" Tone="Bad"
                            Label="Bloqueada" Detail="Algo impede com segurança."/>
              </UniformGrid>
              <c:ExplainToggle Header="Resumo da simulação" Content="{Binding Summary}" Margin="0,0,0,4"/>

              <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type opt:PlanGroup}">
                    <StackPanel Margin="0,14,0,0" opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True"
                                Visibility="{Binding Count, Converter={StaticResource Plan.Shown}}">
                      <!-- Cabeçalho do grupo -->
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="30" Height="30" Margin="0,0,10,0">
                          <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="15"
                                  Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource Text.H2}">
                            <Run Text="{Binding Title, Mode=OneWay}"/>
                            <Run Text="{Binding Count, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextMuted}"/>
                          </TextBlock>
                          <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Small}"/>
                        </StackPanel>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource Panel.Card}" Padding="14,12" Margin="40,0,0,6"
                                    opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                              <StackPanel>
                                <DockPanel>
                                  <c:StatusChip DockPanel.Dock="Right" Tone="Info" Text="Depois de reiniciar" Margin="8,0,0,0"
                                                Visibility="{Binding AfterReboot, Converter={StaticResource BoolToVis}}"/>
                                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
                                </DockPanel>
                                <Grid Margin="0,6,0,0" Visibility="{Binding ShowsChange, Converter={StaticResource BoolToVis}}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="agora" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Observed}" Style="{StaticResource Plan.Now}" MaxWidth="220" ToolTip="{Binding Observed}"/>
                                  <c:Icon Grid.Column="2" Data="{StaticResource Icon.ArrowRight}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="8,0"/>
                                  <TextBlock Grid.Column="3" Text="depois" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                  <TextBlock Grid.Column="4" Text="{Binding Desired}" Style="{StaticResource Plan.Next}" ToolTip="{Binding Desired}"/>
                                </Grid>
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Reason}" Visibility="{Binding Reason, Converter={StaticResource Plan.Shown}}"/>
                                <c:ExplainToggle Header="Detalhes técnicos" Margin="0,2,0,0" Visibility="{Binding Key, Converter={StaticResource Plan.Shown}}">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}"/>
                                    <TextBlock Text="{Binding Batch}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                                  </StackPanel>
                                </c:ExplainToggle>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Próximo passo do caminho -->
              <Border Style="{StaticResource Panel.Inset}" Padding="16,12" Margin="0,18,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"
                          Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="BrokerPage" AutomationProperties.Name="Ir para Aplicar">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Ir para Aplicar" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <c:Icon Data="{StaticResource Icon.Apply}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                             Text="Gostou? Em Aplicar você confirma, o original fica guardado e dá para desfazer."/>
                </DockPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
