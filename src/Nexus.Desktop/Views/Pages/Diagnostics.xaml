<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:v="clr-namespace:Nexus.Desktop.Views">
  <!-- Diagnóstico: contadores por severidade e cada achado com cor, evidência e o que significa. Nada de "ganho garantido". -->
  <DataTemplate DataType="{x:Type vm:DiagnosticsPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Display}"/>
        <TextBlock Text="Pistas tiradas da configuração do seu PC. Cada uma mostra a evidência. Só ler não muda nada."
                   Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,20"/>

        <!-- Contadores -->
        <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,0,0,14" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20,14,12,16">
              <TextBlock Text="{Binding AttentionCount}" Style="{StaticResource Text.Metric}" FontSize="36" Foreground="{StaticResource Brush.Trace}"/>
              <TextBlock Text="para conferir" Style="{StaticResource Text.MetricLabel}"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1,0,0,0">
              <StackPanel Margin="20,14,12,16">
                <TextBlock Text="{Binding InfoCount}" Style="{StaticResource Text.Metric}" FontSize="36" Foreground="{StaticResource Brush.Signal}"/>
                <TextBlock Text="informativos" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1,0,0,0">
              <StackPanel Margin="20,14,12,16">
                <TextBlock Text="{Binding OkCount}" Style="{StaticResource Text.Metric}" FontSize="36" Foreground="{StaticResource Brush.Good}"/>
                <TextBlock Text="como deveriam" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1,0,0,0">
              <StackPanel Margin="20,14,12,16">
                <TextBlock Text="{Binding UnavailableCount}" Style="{StaticResource Text.Metric}" FontSize="36" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="sem dados para avaliar" Style="{StaticResource Text.MetricLabel}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Lembrete honesto -->
        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,18" Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="2" Margin="0,2,12,2" Background="{StaticResource Brush.Signal}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Opacity="0.85"
                       Text="Nenhum achado garante FPS a mais. Use como pista: meça uma partida, mude uma coisa por vez e meça de novo."/>
          </Grid>
        </Border>

        <TextBlock Text="Esperando a leitura do PC terminar." Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}"
                   Visibility="{Binding HasFindings, Converter={StaticResource FalseToVisible}}"/>

        <!-- Achados: atenção primeiro -->
        <ItemsControl ItemsSource="{Binding Ordered}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Padding="0" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Faixa de severidade -->
                  <Border Width="3" CornerRadius="7,0,0,7" Background="{Binding Severity, Converter={StaticResource StatusTone}}"/>
                  <StackPanel Grid.Column="1" Margin="18,14,20,16">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                        <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource Chip}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="16"/>
                    </DockPanel>

                    <!-- Evidência -->
                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>

                    <!-- O que isso quer dizer -->
                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityHint}}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>

                    <!-- Base da conclusão + ajuste relacionado -->
                    <WrapPanel Margin="0,10,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Base da conclusão" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ContentPresenter Content="{Binding Basis}" ContentTemplate="{StaticResource Chip}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                  Visibility="{Binding RelatedActionId, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center">
                          <Run Text="Ajuste relacionado:"/> <Run Text="{Binding RelatedActionId, Mode=OneWay}"/>
                        </TextBlock>
                        <Button Style="{StaticResource Button.Ghost}" Margin="6,0,0,0" Content="Ver ajuste"
                                ToolTip="Abre a lista de ajustes. Nada é aplicado."
                                Command="{Binding DataContext.ShowCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
