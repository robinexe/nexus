<!--
  Diagnóstico (design system v2, docs/10-design-system.md):
    1. Destaque: pulso, quantos pontos pedem conferência (conta), anel "itens em ordem" (mesma conta do Meu PC), medir uma partida.
    2. Quatro cartões: para conferir, para saber, em ordem, sem dados.
    3. Como o diagnóstico funciona: Lê → Compara → Aponta → Você mede. Lembrete honesto: nenhum achado garante FPS.
    4. Achados como cartões (atenção primeiro): ícone do módulo, selo, evidência em 2 linhas, botão para a página que resolve;
       o que o selo quer dizer e a base da conclusão ficam em "Por que isso?".
  Somente leitura.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:DiagnosticsPage}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Diagnostics}" Title="Pontos para conferir"
                     Number="{Binding AttentionNumber}" IsLoading="{Binding IsLoading}"
                     Caption="Pistas da configuração, cada uma com a evidência. Ler não muda nada."
                     ActionText="Medir uma partida" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="MeasurePage"
                     SecondaryText="Ver os ajustes" SecondaryCommand="{x:Static shell:ShellCommands.Navigate}" SecondaryCommandParameter="CatalogPage">
          <StackPanel Width="164">
            <c:RingMeter Value="{Binding HealthScore}" WarnAt="80" BadAt="50" Label="em ordem" Width="136" Height="136" Thickness="11"
                         HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding HealthCaption}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== Quatro números ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="150" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="4" Margin="-7,0" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Warning}" Number="{Binding AttentionNumber}" Tone="Warn"
                      Label="Para conferir" Detail="Pode valer uma olhada. Meça antes."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Info}" Number="{Binding InfoNumber}" Tone="Info"
                      Label="Para saber" Detail="Informação útil, sem problema."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Check}" Number="{Binding OkNumber}" Tone="Good"
                      Label="Em ordem" Detail="Como deveriam estar."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Search}" Number="{Binding UnavailableNumber}"
                      Label="Sem dados" Detail="Não deu para avaliar neste PC."/>
        </UniformGrid>

        <!-- ===== Como funciona ===== -->
        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,22,0,0">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Hardware, drivers e Windows. Ler nunca muda nada."/>
              <c:StepItem Icon="{StaticResource Icon.Diagnostics}" Title="Compara" Text="Confere com regras documentadas, uma a uma."/>
              <c:StepItem Icon="{StaticResource Icon.Warning}" Title="Aponta" Text="Mostra a evidência e onde resolver." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Measure}" Title="Você mede" Text="Uma partida antes e outra depois dizem se mudou." Tone="Good"/>
            </c:HowItWorks>
            <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,14,14,0">
              <DockPanel>
                <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                           Text="Nenhum achado garante FPS a mais. Mude uma coisa por vez e meça de novo."/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ===== Achados ===== -->
        <DockPanel Margin="0,26,0,12">
          <c:StatusChip DockPanel.Dock="Right" Tone="Good" Text="Nada pede atenção agora" VerticalAlignment="Center"
                        Visibility="{Binding NoAttention, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="O que foi encontrado" Style="{StaticResource Text.H2}"/>
        </DockPanel>
        <c:SkeletonLoader Shape="Lines" Lines="6" Margin="4,8,4,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:FindingCard}">
              <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                            Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                               MaxHeight="38" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsOwnerAction, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="Só você pode fazer: o NEXUS não mexe em BIOS nem em hardware." Style="{StaticResource Text.Small}"
                                 Foreground="{StaticResource Brush.TextDim}"/>
                      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="Ganho medido:" Foreground="{StaticResource Brush.Trace}"/> <Run Text="{Binding OwnerGain, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <c:ExplainToggle Margin="0,2,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Small}"/>
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsOwnerAction, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="{Binding OwnerExplanation}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap"/>
                          <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,4,0,0" Command="{Binding OpenSourceCommand}"
                                  ToolTip="{Binding OwnerSourceUrl}" AutomationProperties.Name="Abrir a fonte no navegador">
                            <TextBlock Text="{Binding OwnerSource}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Signal}"/>
                          </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityHint}}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <TextBlock Text="Base da conclusão" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <ContentPresenter Content="{Binding Basis}" ContentTemplate="{StaticResource Chip}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                   Visibility="{Binding HasRelatedAction, Converter={StaticResource BoolToVis}}">
                          <Run Text="Ajuste relacionado:"/> <Run Text="{Binding RelatedActionId, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}"/>
                        </TextBlock>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="150">
                    <c:StatusChip Tone="{Binding Tone}" Text="{Binding SeverityText}" HorizontalAlignment="Right"/>
                    <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                            AutomationProperties.Name="{Binding ActionText}" Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ActionText}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" Margin="0,4,-8,0" Content="Ver ajuste"
                            ToolTip="Abre a lista de ajustes. Nada é aplicado."
                            Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="CatalogPage"
                            Visibility="{Binding HasRelatedAction, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
