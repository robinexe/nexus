<!--
  "O que dá pra ajustar": vitrine dos ajustes do catálogo (agora no seu PC e depois do ajuste), detalhe em linguagem simples e
  a seção "Mitos que não aplicamos". Somente leitura. Recursos locais ficam no próprio DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:CatalogPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Cat.Shown"/>
      <opt:EmptyToCollapsedConverter x:Key="Cat.ShownWhenEmpty" Invert="True"/>

      <!-- Abas do topo: ajustes / mitos. Sublinhado âmbar na aba ativa. -->
      <Style x:Key="Cat.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.H2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,28,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <StackPanel Background="Transparent">
                <ContentPresenter Margin="0,0,0,8"/>
                <Border x:Name="Underline" Height="2" Background="{StaticResource Brush.Trace}" Opacity="0" CornerRadius="1"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Underline" Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                  <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Item da lista de ajustes: superfície discreta; selecionado ganha fundo mais alto e traço âmbar à esquerda. -->
      <Style x:Key="Cat.Item" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}"
                      BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                  <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1.5"
                          Background="{StaticResource Brush.Trace}" Opacity="0"/>
                  <ContentPresenter Margin="16,12,14,12"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                  <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Seta "agora → depois" desenhada (não é glifo). -->
      <Style x:Key="Cat.Arrow" TargetType="Path">
        <Setter Property="Data" Value="M0,5 L16,5 M11,0 L16,5 L11,10"/>
        <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0"/>
      </Style>

      <!-- Valor lido agora (ciano) e valor desejado (âmbar). -->
      <Style x:Key="Cat.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Cat.Next" TargetType="TextBlock" BasedOn="{StaticResource Cat.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>

      <!-- Situação da leitura: verde se já está assim, âmbar se mudaria, vermelho se a leitura falhou. -->
      <Style x:Key="Cat.State" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding ReadState}" Value="same">
            <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ReadState}" Value="change">
            <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ReadState}" Value="error">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Etiqueta neutra (duração, reinício, permissão). -->
      <Style x:Key="Cat.Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="Margin" Value="0,6,6,0"/>
      </Style>

      <!-- Títulos das seções do detalhe. -->
      <Style x:Key="Cat.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="Margin" Value="0,18,0,4"/>
      </Style>
      <Style x:Key="Cat.Prose" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
      </Style>

      <!-- Veredito do mito: vermelho quando não é recomendado, neutro quando só não ajuda. -->
      <Style x:Key="Cat.Verdict" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Cat.VerdictMark" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Background" Value="{StaticResource Brush.Line}"/>
        <Setter Property="Margin" Value="0,3,14,3"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="bad">
            <Setter Property="Background" Value="{StaticResource Brush.Bad}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </DataTemplate.Resources>

    <Grid Margin="24,24,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Cabeçalho -->
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Abas -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
        <RadioButton x:Name="ActionsTab" Style="{StaticResource Cat.Tab}" IsChecked="True" Content="{Binding RowsTitle}"/>
        <RadioButton x:Name="MythsTab" Style="{StaticResource Cat.Tab}" Content="{Binding MythsTitle}"/>
      </StackPanel>

      <!-- ===== Ajustes: lista + detalhe ===== -->
      <Grid Grid.Row="2"
            Visibility="{Binding IsChecked, ElementName=ActionsTab, Converter={StaticResource Cat.Shown}}"
            opt:Reveal.Trigger="{Binding IsChecked, ElementName=ActionsTab}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" MinWidth="320"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="6*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Top"
                   Text="O catálogo ainda não foi lido. Use Ler novamente no topo da janela."
                   Visibility="{Binding Rows, Converter={StaticResource Cat.ShownWhenEmpty}}"/>

        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 ItemContainerStyle="{StaticResource Cat.Item}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding Rows, Converter={StaticResource Cat.Shown}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"
                           Margin="0,0,10,0"/>
                <ContentPresenter Grid.Column="1" Content="{Binding ReadLabel}" ContentTemplate="{StaticResource Chip}"
                                  ToolTip="Como o NEXUS lê este valor no seu PC"/>

                <!-- Agora → depois -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding CurrentShown}" Style="{StaticResource Cat.Now}" ToolTip="{Binding CurrentShown}"/>
                  <Path Grid.Column="1" Style="{StaticResource Cat.Arrow}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Cat.Next}" ToolTip="{Binding Desired}"/>
                </Grid>

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0">
                  <TextBlock Text="{Binding ReadStateText}" Style="{StaticResource Cat.State}" Margin="0,6,10,0"/>
                  <Border Style="{StaticResource Cat.Tag}">
                    <TextBlock Text="{Binding ClassificationText}" Style="{StaticResource Text.Small}"/>
                  </Border>
                  <Border Style="{StaticResource Cat.Tag}">
                    <TextBlock Text="{Binding PersistenceText}" Style="{StaticResource Text.Small}"/>
                  </Border>
                  <Border Style="{StaticResource Cat.Tag}" Visibility="{Binding NeedsRestart, Converter={StaticResource Cat.Shown}}">
                    <TextBlock Text="{Binding RebootText}" Style="{StaticResource Text.Small}"/>
                  </Border>
                  <Border Style="{StaticResource Cat.Tag}" Visibility="{Binding NeedsAdmin, Converter={StaticResource Cat.Shown}}">
                    <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Small}"/>
                  </Border>
                </WrapPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Detalhe do ajuste escolhido -->
        <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
          <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="340"
                        Visibility="{Binding Selected, Converter={StaticResource Cat.ShownWhenEmpty}}">
              <TextBlock Text="Escolha um ajuste na lista" Style="{StaticResource Text.H2}" TextAlignment="Center"/>
              <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" TextAlignment="Center" Margin="0,6,0,0"
                         Text="Aqui aparece o que ele faz, os riscos, como conferir e como desfazer."/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Selected, Converter={StaticResource Cat.Shown}}">
              <StackPanel DataContext="{Binding Selected}" Margin="22,20,22,22" opt:Reveal.Trigger="{Binding}">
                <TextBlock Text="{Binding ClassificationText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0"/>

                <!-- Comparativo agora → depois -->
                <Border Style="{StaticResource Panel.Inset}" Margin="0,16,0,0" Padding="16,14">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Agora no seu PC" Style="{StaticResource Text.MetricLabel}"/>
                      <TextBlock Text="{Binding CurrentShown}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                 Foreground="{StaticResource Brush.Signal}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Path Grid.Column="1" Style="{StaticResource Cat.Arrow}" Margin="14,18,14,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Depois do ajuste" Style="{StaticResource Text.MetricLabel}"/>
                      <TextBlock Text="{Binding Desired}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                 Foreground="{StaticResource Brush.Trace}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                      <TextBlock Text="{Binding ReadStateText}" Style="{StaticResource Cat.State}"/>
                      <TextBlock Text="{Binding ReadError}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,4,0,0"
                                 Visibility="{Binding ReadError, Converter={StaticResource Cat.Shown}}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Ficha rápida -->
                <UniformGrid Columns="3" Margin="0,14,0,0">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Duração" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding PersistenceText}" Style="{StaticResource Text.Body}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Quando vale" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding RebootText}" Style="{StaticResource Text.Body}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Permissão" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Body}" Margin="0,2,0,0"/>
                  </StackPanel>
                </UniformGrid>

                <TextBlock Text="O que faz" Style="{StaticResource Cat.Heading}"/>
                <TextBlock Text="{Binding Mechanism}" Style="{StaticResource Cat.Prose}"/>

                <StackPanel Visibility="{Binding Condition, Converter={StaticResource Cat.Shown}}">
                  <TextBlock Text="Quando vale a pena" Style="{StaticResource Cat.Heading}"/>
                  <TextBlock Text="{Binding Condition}" Style="{StaticResource Cat.Prose}"/>
                </StackPanel>

                <TextBlock Text="Riscos" Style="{StaticResource Cat.Heading}"/>
                <TextBlock Text="{Binding Risks}" Style="{StaticResource Cat.Prose}"/>

                <StackPanel Visibility="{Binding Verification, Converter={StaticResource Cat.Shown}}">
                  <TextBlock Text="Como conferir" Style="{StaticResource Cat.Heading}"/>
                  <TextBlock Text="{Binding Verification}" Style="{StaticResource Cat.Prose}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Revert, Converter={StaticResource Cat.Shown}}">
                  <TextBlock Text="Como desfazer" Style="{StaticResource Cat.Heading}"/>
                  <TextBlock Text="{Binding Revert}" Style="{StaticResource Cat.Prose}"/>
                </StackPanel>

                <Border Style="{StaticResource Panel.Notice}" Margin="0,18,0,0"
                        Visibility="{Binding NotInstantiableReason, Converter={StaticResource Cat.Shown}}">
                  <StackPanel>
                    <TextBlock Text="Fica de fora da simulação por enquanto" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                    <TextBlock Text="{Binding NotInstantiableReason}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>

                <!-- Evidências, da mais forte para a mais fraca -->
                <TextBlock Text="De onde vem" Style="{StaticResource Cat.Heading}"/>
                <ItemsControl ItemsSource="{Binding EvidenceItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Medidor de força da evidência: 5 níveis -->
                        <Grid Width="40" Height="5" VerticalAlignment="Top" Margin="0,7,12,0" ToolTip="{Binding LevelText}">
                          <Border Background="{StaticResource Brush.Line}" CornerRadius="2.5"/>
                          <Border Background="{StaticResource Brush.Signal}" CornerRadius="2.5" HorizontalAlignment="Left" Width="{Binding MeterWidth}"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding LevelText}" Style="{StaticResource Text.Body}"/>
                          <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Alvo técnico, recolhido -->
                <Expander Margin="0,18,0,0">
                  <Expander.Header>
                    <TextBlock Text="Detalhes técnicos" Style="{StaticResource Text.Small}"/>
                  </Expander.Header>
                  <StackPanel Margin="0,8,0,0"
                              opt:Reveal.Trigger="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}">
                    <TextBlock Style="{StaticResource Text.Small}">
                      <Run Text="Identificador" Foreground="{StaticResource Brush.TextDim}"/>
                      <LineBreak/>
                      <Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0">
                      <Run Text="Mecanismo de leitura e escrita" Foreground="{StaticResource Brush.TextDim}"/>
                      <LineBreak/>
                      <Run Text="{Binding Handler, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"/>
                    </TextBlock>
                    <TextBlock Text="Alvo" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,2"/>
                    <Border Style="{StaticResource Panel.Inset}" Padding="10,8">
                      <ItemsControl ItemsSource="{Binding TargetLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                       FontFamily="{StaticResource Font.Numbers}" TextWrapping="Wrap"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0">
                      <Run Text="Como aplicar" Foreground="{StaticResource Brush.TextDim}"/>
                      <LineBreak/>
                      <Run Text="{Binding ApplyLabel, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== Mitos que não aplicamos ===== -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=MythsTab, Converter={StaticResource Cat.Shown}}"
                    opt:Reveal.Trigger="{Binding IsChecked, ElementName=MythsTab}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
          <Border Style="{StaticResource Panel.Hero}">
            <StackPanel>
              <TextBlock Text="Dica de fórum não é medição" Style="{StaticResource Text.Display}"/>
              <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                         Text="Estes ajustes circulam em vídeos, scripts e packs de otimização, mas ficam fora do NEXUS. Para cada um, o motivo em poucas palavras e, quando existe, a fonte."/>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,20,0,0"
                     Text="Nenhum mito carregado. O catálogo ainda não foi lido."
                     Visibility="{Binding Myths, Converter={StaticResource Cat.ShownWhenEmpty}}"/>

          <ItemsControl ItemsSource="{Binding Myths}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,16"
                        opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="170"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Cat.VerdictMark}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Verdict}" Style="{StaticResource Cat.Verdict}" Margin="0,1,16,0"/>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}"/>
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                 Visibility="{Binding HasSource, Converter={StaticResource Cat.Shown}}">
                        <Run Text="Fonte:"/>
                        <Run Text="{Binding Source, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
