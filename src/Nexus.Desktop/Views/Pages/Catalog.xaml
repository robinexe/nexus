<!--
  "O que dá pra ajustar" (design system v2, docs/10-design-system.md). Vitrine dos ajustes do catálogo, somente leitura.
    1. Destaque: controles deslizantes, quantos ajustes existem (conta), "Testar sem aplicar" (âmbar); à direita quantos
       mudariam, quantos já estão assim e quantos estão marcados.
    2. O caminho de toda mudança (Simular → Confirmar → Registrar → Desfazer; cada passo abre a página dele).
    3. Abas com ícone: Ajustes (lista com ícone e selo + detalhe) e Mitos que não aplicamos.
       No detalhe: agora → depois, ficha rápida em selos, risco visível, como desfazer visível, "Incluir no teste"; mecanismo,
       quando vale, como conferir e as fontes ficam em "Por que isso?"; o alvo técnico em "Detalhes técnicos".
  Recursos locais no próprio DataTemplate.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:CatalogPage}">
    <DataTemplate.Resources>
      <opt:EmptyToCollapsedConverter x:Key="Cat.Shown"/>
      <opt:EmptyToCollapsedConverter x:Key="Cat.ShownWhenEmpty" Invert="True"/>

      <!-- Conteúdo da aba: ícone + nome. -->
      <DataTemplate x:Key="Cat.TabHeader">
        <StackPanel Orientation="Horizontal">
          <c:Icon Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" Size="16" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>

      <!-- Passo do caminho seguro (mesmo desenho de Testar sem aplicar, Aplicar e Histórico). -->
      <DataTemplate x:Key="F.Step" DataType="{x:Type vm:FlowStep}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource Button.Ghost}" Padding="0" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                  Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="{Binding Target}"
                  AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Text}">
            <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                  <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                  <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                          Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Display}" TextWrapping="NoWrap">
                    <Run Text="{Binding Number, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.TextDim}"/>
                    <Run Text="{Binding Title, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Small}" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <c:Icon x:Name="Arrow" Grid.Column="1" Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{StaticResource Brush.TextDim}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsLast}" Value="True">
            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Item da lista de ajustes: superfície discreta; selecionado ganha fundo mais alto e traço âmbar à esquerda. -->
      <Style x:Key="Cat.Item" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Bd" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}"
                      BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                  <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1.5"
                          Background="{StaticResource Brush.Trace}" Opacity="0"/>
                  <ContentPresenter Margin="14,12,14,12"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                  <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Valor lido agora (ciano) e valor desejado (âmbar). -->
      <Style x:Key="Cat.Now" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Cat.Next" TargetType="TextBlock" BasedOn="{StaticResource Cat.Now}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/>
      </Style>

      <!-- Selo neutro da ficha rápida: ícone + texto. -->
      <Style x:Key="Cat.Fact" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.LineSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180" HorizontalAlignment="Stretch">

        <!-- ===== Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Settings}" Title="Ajustes que o NEXUS conhece"
                     Number="{Binding RowsNumber}" IsLoading="{Binding IsLoading}"
                     Caption="Cada um mostra o valor de agora e o depois. Nada é aplicado aqui."
                     ActionText="Testar sem aplicar" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="PlanPage"
                     SecondaryText="Ver os mitos" SecondaryCommand="{Binding ShowMythsCommand}">
          <StackPanel MinWidth="200">
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Left" Value="{Binding ChangeCount}" FontFamily="{StaticResource Font.Numbers}" FontSize="24"
                                Foreground="{StaticResource Brush.Trace}" MinWidth="52"/>
              <TextBlock Text="mudariam neste PC" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <c:AnimatedNumber DockPanel.Dock="Left" Value="{Binding SameCount}" FontFamily="{StaticResource Font.Numbers}" FontSize="24"
                                Foreground="{StaticResource Brush.Good}" MinWidth="52"/>
              <TextBlock Text="já estão assim" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel>
              <c:AnimatedNumber DockPanel.Dock="Left" Value="{Binding IncludedCount}" FontFamily="{StaticResource Font.Numbers}" FontSize="24"
                                Foreground="{StaticResource Brush.Text}" MinWidth="52"/>
              <TextBlock Text="marcados para testar" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== Caminho seguro ===== -->
        <TextBlock Text="Do ajuste ao desfazer" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Flow}" ItemTemplate="{StaticResource F.Step}" Focusable="False" Margin="0,0,0,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== Abas ===== -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CatalogTabs" Content="{Binding RowsTitle}" Tag="{StaticResource Icon.Catalog}"
                       ContentTemplate="{StaticResource Cat.TabHeader}" IsChecked="{Binding IsActionsTab, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="CatalogTabs" Content="{Binding MythsTitle}" Tag="{StaticResource Icon.Warning}"
                       ContentTemplate="{StaticResource Cat.TabHeader}" IsChecked="{Binding IsMythsTab, Mode=TwoWay}"/>
        </StackPanel>

        <!-- ===== Ajustes: lista + detalhe ===== -->
        <StackPanel Visibility="{Binding IsActionsTab, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding IsActionsTab}">
          <c:SkeletonLoader Shape="Lines" Lines="8" Margin="4,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Style="{StaticResource Text.Small}" HorizontalAlignment="Center" Margin="0,8,0,0"
                     Text="O catálogo aparece quando a leitura do PC terminar."
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

          <Grid Height="660" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*" MinWidth="320"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="6*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource Cat.Item}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ajustes do catálogo">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CatalogRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                      <Ellipse Fill="{Binding ReadTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                      <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="17"
                              Foreground="{Binding ReadTone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                      <DockPanel>
                        <c:StatusChip DockPanel.Dock="Right" Tone="{Binding ReadTone}" Text="{Binding ReadChipText}" Margin="8,0,0,0" VerticalAlignment="Top"
                                      ToolTip="{Binding ReadStateText}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}" Foreground="{StaticResource Brush.Text}"/>
                      </DockPanel>
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MaxWidth="220"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentShown}" Style="{StaticResource Cat.Now}" ToolTip="{Binding CurrentShown}"/>
                        <c:Icon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Desired}" Style="{StaticResource Cat.Next}" ToolTip="{Binding Desired}"/>
                      </Grid>
                      <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ClassificationText, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding PersistenceText, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding PrivilegeText, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detalhe do ajuste escolhido -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
              <Grid>
                <c:EmptyState Illustration="{StaticResource Illo.Settings}" Text="Escolha um ajuste na lista."
                              Detail="Aqui aparece o que ele faz, o risco e como desfazer."
                              VerticalAlignment="Center" Visibility="{Binding Selected, Converter={StaticResource Cat.ShownWhenEmpty}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Selected, Converter={StaticResource Cat.Shown}}">
                  <StackPanel DataContext="{Binding Selected}" Margin="22,20,22,22" opt:Reveal.Trigger="{Binding}">
                    <DockPanel>
                      <Grid Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="22" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel>
                        <TextBlock Text="{Binding ClassificationText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>

                    <!-- Agora → depois -->
                    <Border Style="{StaticResource Panel.Inset}" Margin="0,16,0,0" Padding="16,14">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Agora no seu PC" Style="{StaticResource Text.MetricLabel}"/>
                          <TextBlock Text="{Binding CurrentShown}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                     Foreground="{StaticResource Brush.Signal}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <c:Icon Grid.Column="1" Data="{StaticResource Icon.ArrowRight}" Size="20" Foreground="{StaticResource Brush.TextDim}" Margin="14,16,14,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Depois do ajuste" Style="{StaticResource Text.MetricLabel}"/>
                          <TextBlock Text="{Binding Desired}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.H2}"
                                     Foreground="{StaticResource Brush.Trace}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                          <c:StatusChip Tone="{Binding ReadTone}" Text="{Binding ReadStateText}" HorizontalAlignment="Left"/>
                          <TextBlock Text="{Binding ReadError}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,6,0,0"
                                     Visibility="{Binding ReadError, Converter={StaticResource Cat.Shown}}"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- Ficha rápida em selos -->
                    <UniformGrid Columns="3" Margin="0,12,-8,0">
                      <Border Style="{StaticResource Cat.Fact}" ToolTip="Duração">
                        <DockPanel>
                          <c:Icon Data="{StaticResource Icon.History}" Size="15" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                          <TextBlock Text="{Binding PersistenceText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                        </DockPanel>
                      </Border>
                      <Border Style="{StaticResource Cat.Fact}" ToolTip="Quando vale">
                        <DockPanel>
                          <c:Icon Data="{StaticResource Icon.Refresh}" Size="15" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                          <TextBlock Text="{Binding RebootText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                        </DockPanel>
                      </Border>
                      <Border Style="{StaticResource Cat.Fact}" ToolTip="Permissão">
                        <DockPanel>
                          <c:Icon Data="{StaticResource Icon.Lock}" Size="15" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                          <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                        </DockPanel>
                      </Border>
                    </UniformGrid>

                    <!-- O que faz (2 linhas) -->
                    <TextBlock Text="{Binding Mechanism}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,16,0,0"
                               MaxHeight="44" TextTrimming="CharacterEllipsis"/>

                    <!-- Risco: sempre visível -->
                    <Border Style="{StaticResource Panel.Notice}" Padding="10,8" Margin="0,12,0,0">
                      <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Warning}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                          <Run Text="Risco:" FontWeight="SemiBold"/> <Run Text="{Binding Risks, Mode=OneWay}"/>
                        </TextBlock>
                      </DockPanel>
                    </Border>

                    <!-- Como desfazer: sempre visível -->
                    <Border Background="{StaticResource Brush.GoodSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,8,0,0"
                            Visibility="{Binding Revert, Converter={StaticResource Cat.Shown}}">
                      <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Undo}" Size="15" Foreground="{StaticResource Brush.Good}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                          <Run Text="Desfazer:" FontWeight="SemiBold"/> <Run Text="{Binding Revert, Mode=OneWay}"/>
                        </TextBlock>
                      </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Panel.Notice}" Margin="0,8,0,0" Padding="10,8"
                            Visibility="{Binding NotInstantiableReason, Converter={StaticResource Cat.Shown}}">
                      <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Info}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                          <Run Text="Fora do teste por enquanto:" FontWeight="SemiBold"/> <Run Text="{Binding NotInstantiableReason, Mode=OneWay}"/>
                        </TextBlock>
                      </DockPanel>
                    </Border>

                    <!-- Incluir no teste (mesma marcação de Testar sem aplicar e Aplicar) -->
                    <DockPanel Margin="0,14,0,0" Visibility="{Binding CanSimulate, Converter={StaticResource BoolToVis}}">
                      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0"
                              Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="PlanPage" AutomationProperties.Name="Testar sem aplicar">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Testar sem aplicar" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                          <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" Margin="6,0,0,0"/>
                        </StackPanel>
                      </Button>
                      <CheckBox IsChecked="{Binding Include}" Content="Incluir no teste" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Por que isso? -->
                    <c:ExplainToggle Margin="0,12,0,0">
                      <StackPanel>
                        <TextBlock Text="O que faz" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Mechanism}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                        <StackPanel Visibility="{Binding Condition, Converter={StaticResource Cat.Shown}}">
                          <TextBlock Text="Quando vale a pena" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                          <TextBlock Text="{Binding Condition}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Verification, Converter={StaticResource Cat.Shown}}">
                          <TextBlock Text="Como conferir" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                          <TextBlock Text="{Binding Verification}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="De onde vem" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding EvidenceItems}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Medidor de força da evidência: 5 níveis -->
                                <Grid Width="40" Height="5" VerticalAlignment="Top" Margin="0,7,12,0" ToolTip="{Binding LevelText}">
                                  <Border Background="{StaticResource Brush.Line}" CornerRadius="2.5"/>
                                  <Border Background="{StaticResource Brush.Signal}" CornerRadius="2.5" HorizontalAlignment="Left" Width="{Binding MeterWidth}"/>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding LevelText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                                  <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Small}"/>
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </c:ExplainToggle>

                    <!-- Alvo técnico, recolhido -->
                    <c:ExplainToggle Header="Detalhes técnicos" Margin="0,4,0,0">
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Small}">
                          <Run Text="Identificador" Foreground="{StaticResource Brush.TextDim}"/>
                          <LineBreak/>
                          <Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0">
                          <Run Text="Mecanismo de leitura e escrita" Foreground="{StaticResource Brush.TextDim}"/>
                          <LineBreak/>
                          <Run Text="{Binding Handler, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"/>
                        </TextBlock>
                        <TextBlock Text="Alvo" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,8,0,2"/>
                        <Border Style="{StaticResource Panel.Inset}" Padding="10,8">
                          <ItemsControl ItemsSource="{Binding TargetLines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                           FontFamily="{StaticResource Font.Numbers}" TextWrapping="Wrap"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0">
                          <Run Text="Como aplicar" Foreground="{StaticResource Brush.TextDim}"/>
                          <LineBreak/>
                          <Run Text="{Binding ApplyLabel, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,8,0,0">
                          <Run Text="Como o NEXUS lê este valor" Foreground="{StaticResource Brush.TextDim}"/>
                          <LineBreak/>
                          <Run Text="{Binding ReadLabelText, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- ===== Mitos que não aplicamos ===== -->
        <StackPanel Visibility="{Binding IsMythsTab, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding IsMythsTab}">
          <Border Style="{StaticResource Panel.Inset}" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
              <Grid Width="46" Height="46" Margin="0,0,16,0">
                <Ellipse Fill="{StaticResource Brush.BadSoft}"/>
                <c:Icon Data="{StaticResource Icon.Warning}" Size="22" Foreground="{StaticResource Brush.Bad}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Dica de fórum não é medição" Style="{StaticResource Text.H2}"/>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                           Text="Circulam em vídeos e packs de otimização, mas ficam fora do NEXUS. O motivo de cada um está aqui."/>
              </StackPanel>
            </DockPanel>
          </Border>

          <c:EmptyState Illustration="{StaticResource Illo.Settings}" Text="Nenhum mito carregado."
                        Detail="Eles aparecem quando o catálogo for lido." ActionText="Ver os ajustes" Command="{Binding ShowActionsCommand}"
                        Visibility="{Binding Myths, Converter={StaticResource Cat.ShownWhenEmpty}}"/>

          <ItemsControl ItemsSource="{Binding Myths}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type opt:MythItem}">
                <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="0,0,10,10" opt:Reveal.OnLoad="True" opt:Reveal.Stagger="True">
                  <StackPanel>
                    <DockPanel>
                      <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Ellipse Fill="{Binding ChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                        <c:Icon Data="{StaticResource Icon.Close}" Size="16" Foreground="{Binding ChipTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
                        <c:StatusChip Tone="{Binding ChipTone}" Text="{Binding Verdict}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}" Margin="0,10,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Reason}"/>
                    <c:ExplainToggle Margin="0,2,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Small}"/>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"
                                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                          <Run Text="Fonte:"/> <Run Text="{Binding Source, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
