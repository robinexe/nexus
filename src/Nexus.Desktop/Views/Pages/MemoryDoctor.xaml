<!--
  Memória: diagnóstico (design system v2, docs/10-design-system.md):
    1. Destaque: gráfico subindo (Illo.MemoryDoctor), memória em uso contando, anel da pressão (% do limite de memória comprometida),
       "Ler agora" / "Recomeçar histórico".
    2. Para onde vai a RAM: barra empilhada (em uso | modificada | cache | livre) que enche ao aparecer; detalhes recolhidos.
    3. Suspeitos: cartões com selo, evidência, sparkline da memória e as duas ações lado a lado (resolver agora = temporária,
       resolver de vez = permanente), com Desfazer à vista. Nada fora do normal = EmptyState.
    4. Vigiar enquanto jogo, maiores consumidores (com sparkline), últimas horas (gráfico com legenda) e linha do tempo.
  Escrita só pelo aplicador (Host.ApplyAsync) a partir do ViewModel; aqui só ligações.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
                    xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell">
  <DataTemplate DataType="{x:Type vm:MemoryDoctorPage}">
    <DataTemplate.Resources>

      <Style x:Key="Doc.LegendText" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Margin" Value="0,0,18,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
      </Style>

      <DataTemplate x:Key="Doc.Source" DataType="{x:Type vm:MemSourceRow}">
        <Button Command="{Binding OpenCommand}" ToolTip="{Binding Url}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="-8,0,0,0" Padding="8,2">
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Page}" Size="13" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
      </DataTemplate>

      <!-- Uma solução: título, selo (administrador · reversível / sem desfazer), o que faz e quanto dura; custo em "Por que isso?".
           Botão e Desfazer sempre à vista. -->
      <DataTemplate x:Key="Doc.Fix" DataType="{x:Type vm:DoctorFixRow}">
        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,8" Padding="12,10">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
            <c:StatusChip Tone="{Binding BadgeTone}" Text="{Binding Badge}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Text.Small}" Margin="0,6,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding WhatItDoes}"/>
            <TextBlock Text="{Binding HowLong}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding HowLong}"/>
            <c:ExplainToggle Margin="0,2,0,0">
              <StackPanel>
                <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Text.Small}"/>
                <TextBlock Text="{Binding HowLong}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Cost}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"/>
              </StackPanel>
            </c:ExplainToggle>
            <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasButton, Converter={StaticResource BoolToVis}}">
              <Button Content="{Binding ButtonText}" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
              <Button Command="{Binding RevertCommand}" Style="{StaticResource Button.Secondary}" Margin="0"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                  <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T Shell.Desfazer}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,4,0,0"
                       Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}"/>
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- Suspeito: distintivo, título, selo, evidência medida, sparkline e as duas colunas de solução. -->
      <DataTemplate x:Key="Doc.Suspect" DataType="{x:Type vm:DoctorSuspectRow}">
        <Border Style="{StaticResource Panel.Card}" Padding="18,14" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" Margin="0,0,14,0" VerticalAlignment="Top">
                <Ellipse Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
                <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="19"
                        Foreground="{Binding ToneKind, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
                <TextBlock Text="{Binding Evidence}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.Text}"
                           Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}"/>
              </StackPanel>
              <c:StatusChip Grid.Column="2" Tone="{Binding ToneKind}" Text="{Binding SeverityText}" VerticalAlignment="Top"/>
            </Grid>
            <StackPanel Margin="52,10,0,0" Visibility="{Binding HasTrend, Converter={StaticResource BoolToVis}}">
              <c:Sparkline Values="{Binding Trend}" Height="42" Stroke="{Binding ToneKind, Converter={StaticResource ToneBrush}}"
                           Fill="{Binding ToneKind, Converter={StaticResource ToneBrush}, ConverterParameter=soft}"/>
              <TextBlock Text="{Binding TrendLabel}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
            <c:ExplainToggle Margin="52,4,0,0">
              <StackPanel>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Small}"/>
                <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Doc.Source}" Focusable="False" Margin="0,6,0,0"
                              Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </c:ExplainToggle>
            <Grid Margin="52,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Visibility="{Binding HasTemporary, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <c:Icon Data="{StaticResource Icon.Bolt}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T MemDoc.ResolverAgora}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Trace}" VerticalAlignment="Center"/>
                  <TextBlock Text="{l:T MemDoc.TemporarioVoltaAcontecer}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Temporary}" ItemTemplate="{StaticResource Doc.Fix}" Focusable="False"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Visibility="{Binding HasPermanent, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <c:Icon Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.Good}" Margin="0,0,6,0"/>
                  <TextBlock Text="{l:T MemDoc.ResolverVez}" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Good}" VerticalAlignment="Center"/>
                  <TextBlock Text="{l:T MemDoc.AtacaCausa}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Permanent}" ItemTemplate="{StaticResource Doc.Fix}" Focusable="False"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação / erro -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.MemoryDoctor}" Title="{l:T MemDoc.MemoriaUso}"
                     Number="{Binding InUseBytes}" Kind="Bytes" IsLoading="{Binding IsLoading}" Caption="{Binding Subline}"
                     ActionText="{l:T MemDoc.LerAgora}" Command="{Binding SampleNowCommand}"
                     SecondaryText="{l:T MemDoc.RecomecarHistorico}" SecondaryCommand="{Binding ClearCommand}">
          <StackPanel Width="170">
            <c:RingMeter Value="{Binding CommitPercent}" WarnAt="80" BadAt="90" HigherIsBetter="False" Label="{l:T Mem.Limite}"
                         Width="132" Height="132" Thickness="11" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:T MemDoc.PressaoMemoria}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding CommitText}" FontFamily="{StaticResource Font.Numbers}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- ===== 2. Para onde vai a RAM ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.Ram}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T MemDoc.OndeVaiRam}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="{l:T MemDoc.TudoCianoEstaDisponivel}" Style="{StaticResource Text.Small}" Margin="0,0,0,12"/>
            <c:SkeletonLoader Shape="Lines" Lines="2" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border Height="22" CornerRadius="5" ClipToBounds="True" Background="{StaticResource Brush.Bg}" Visibility="{Binding HasSample, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="{l:T MemDoc.BarraRamUsoModificada}">
              <Grid RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="0"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1"
                                         Duration="{x:Static shell:ShellMotion.Count}">
                          <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding StackInUse}"/>
                  <ColumnDefinition Width="{Binding StackModified}"/>
                  <ColumnDefinition Width="{Binding StackStandby}"/>
                  <ColumnDefinition Width="{Binding StackFree}"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Brush.Trace}" ToolTip="{Binding InUseText}"/>
                <Border Grid.Column="1" Background="{StaticResource Brush.TextDim}" ToolTip="{Binding ModifiedText}"/>
                <Border Grid.Column="2" Background="{StaticResource Brush.Signal}" ToolTip="{Binding StandbyText}"/>
                <Border Grid.Column="3" Background="{StaticResource Brush.SignalSoft}" ToolTip="{Binding FreeText}"/>
              </Grid>
            </Border>
            <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasSample, Converter={StaticResource BoolToVis}}">
              <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Trace}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Doc.LegendText}"><Run Text="{l:T Mon.Uso}"/> <Run Text="{Binding InUseText, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/></TextBlock>
              <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.TextDim}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Doc.LegendText}"><Run Text="{l:T MemDoc.EsperandoIrDisco}"/> <Run Text="{Binding ModifiedText, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/></TextBlock>
              <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.Signal}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Doc.LegendText}"><Run Text="{l:T MemDoc.Cache}"/> <Run Text="{Binding StandbyText, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/></TextBlock>
              <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource Brush.SignalSoft}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Doc.LegendText}"><Run Text="{l:T MemDoc.Livre}"/> <Run Text="{Binding FreeText, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/></TextBlock>
            </WrapPanel>
            <c:ExplainToggle Header="{l:T MemDoc.TodosNumeros}" Margin="0,4,0,0">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorBar}">
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="190"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Small}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}">
                          <Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Font.Numbers}"/> <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}"/>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding KernelText}" Style="{StaticResource Text.Small}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Small}" Visibility="{Binding GpuText, Converter={StaticResource NullToCollapsed}}"/>
                <TextBlock Text="{Binding PoolNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Visibility="{Binding PoolNote, Converter={StaticResource NullToCollapsed}}"/>
              </StackPanel>
            </c:ExplainToggle>
          </StackPanel>
        </Border>

        <!-- Leitura: intervalo e continuar com a página fechada -->
        <Border Style="{StaticResource Panel.Inset}" Padding="16,10" Margin="0,0,0,14">
          <WrapPanel VerticalAlignment="Center">
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0"/>
            <TextBlock Text="{l:T MemDoc.LerCada}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding IntervalMinutes}" Width="64" VerticalAlignment="Center"
                      AutomationProperties.Name="{l:T MemDoc.IntervaloEntreLeiturasMinutos}"/>
            <TextBlock Text="{l:T MemDoc.Min}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="6,0,20,0"/>
            <CheckBox Content="{l:T MemDoc.ContinuarPaginaFechada}" IsChecked="{Binding KeepRecording}" VerticalAlignment="Center" Margin="0,0,20,0"
                      ToolTip="{l:T MemDoc.ContinuaLendoEnquantoNexus}"/>
            <TextBlock Text="{Binding LastSample}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
          </WrapPanel>
        </Border>

        <!-- Honestidade -->
        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,20">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,1,10,0" VerticalAlignment="Top"/>
            <StackPanel>
              <TextBlock Text="{l:T MemDoc.NadaAquiLimpadorRam}"
                         Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
              <c:ExplainToggle Margin="0,2,0,0" Content="{x:Static vm:MemoryDoctorPage.HonestText}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ===== 3. Suspeitos ===== -->
        <TextBlock Text="{l:T Scan.Suspeitos}" Style="{StaticResource Text.H2}" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding HistoryText}" Style="{StaticResource Text.Small}" Margin="0,0,0,12" Visibility="{Binding HistoryText, Converter={StaticResource NullToCollapsed}}"/>
        <c:SkeletonLoader Shape="Lines" Lines="4" Margin="4,0,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <c:EmptyState Illustration="{StaticResource Illo.MemoryDoctor}" Text="{l:T MemDoc.NadaForaNormalAte}"
                      Detail="{l:T MemDoc.DeixePaginaAbertaVazamento}"
                      ActionText="{l:T MemDoc.LerAgora}" Command="{Binding SampleNowCommand}" Margin="0,0,0,14"
                      Visibility="{Binding NoSuspects, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Suspects}" ItemTemplate="{StaticResource Doc.Suspect}" Focusable="False"/>

        <!-- ===== 4. Vigiar enquanto jogo ===== -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,6,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.Games}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T MemDoc.VigiarEnquantoJogo}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="{l:T MemDoc.AvisaQuandoJogoEsta}" Style="{StaticResource Text.Small}" Margin="0,0,0,8"/>
            <CheckBox Content="{l:T MemDoc.LigarAviso}" IsChecked="{Binding GameGuard}"/>
            <TextBlock Text="{Binding GuardText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"
                       Visibility="{Binding GuardText, Converter={StaticResource NullToCollapsed}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding GuardSuggest, Converter={StaticResource BoolToVis}}">
              <Button Content="{l:T MemDoc.EsvaziarListaEsperaAgora}" Command="{Binding PurgeNowCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,10,0"/>
              <c:StatusChip Tone="Bad" Text="{l:T MemDoc.SemDesfazerAdministrador}" VerticalAlignment="Center"/>
            </StackPanel>
            <c:ExplainToggle Margin="0,4,0,0"
                             Content="{l:T MemDoc.DesligadoPadraoJogoAberto}"/>
          </StackPanel>
        </Border>

        <!-- Maiores consumidores -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.Apps}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T MemDoc.QuemMaisUsaMemoria}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="{l:T MemDoc.SomadoAppNavegadorConta}" Style="{StaticResource Text.Small}" Margin="0,0,0,8"/>
            <c:SkeletonLoader Shape="Lines" Lines="5" Margin="0,4,0,4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Consumers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DoctorConsumerRow}">
                  <Border BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="32" Height="32" Margin="0,0,12,0">
                        <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="16" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Kind, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Processes, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding WorkingSet, Mode=OneWay}"/> <Run Text="{l:T MemDoc.Ram}"/>
                        </TextBlock>
                      </StackPanel>
                      <c:Sparkline Grid.Column="2" Values="{Binding History}" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Stroke="{Binding TrendToneKind, Converter={StaticResource ToneBrush}}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Private}" FontFamily="{StaticResource Font.Numbers}" FontSize="16" Foreground="{StaticResource Brush.Trace}"
                                 VerticalAlignment="Center" TextWrapping="NoWrap" ToolTip="{l:T MemDoc.MemoriaComprometidaPrivada}"/>
                      <c:StatusChip Grid.Column="4" Tone="{Binding TrendToneKind}" Text="{Binding Trend}" VerticalAlignment="Center" MinWidth="120"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Últimas horas -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <c:Icon Data="{StaticResource Icon.TrendUp}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T MemDoc.UltimasHoras}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <TextBlock Text="{l:T MemDoc.LinhaSoSobeNunca}" Style="{StaticResource Text.Small}" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,8">
              <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.Signal}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T Mon.Uso}" Style="{StaticResource Doc.LegendText}"/>
              <Border Width="14" Height="3" CornerRadius="1.5" Background="{StaticResource Brush.Trace}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T MemDoc.Comprometida}" Style="{StaticResource Doc.LegendText}"/>
              <Border Width="14" Height="2" Background="{StaticResource Brush.Bad}" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T MemDoc.MemoriaKernelEscalaPropria}" Style="{StaticResource Doc.LegendText}"/>
            </WrapPanel>
            <Grid Height="150">
              <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
              </Grid.RenderTransform>
              <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static shell:ShellMotion.Count}"/>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0"
                                       Duration="{x:Static shell:ShellMotion.Count}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Grid.Triggers>
              <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"/>
              <Path Data="{Binding CommitGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" Margin="8"/>
              <Path Data="{Binding UsedGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" Margin="8"/>
              <Path Data="{Binding PoolGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Bad}" StrokeThickness="1.5" StrokeDashArray="3 2" Margin="8"/>
              <TextBlock Text="{l:T MemDoc.GraficoAparecePartirSegunda}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding HasChart, Converter={StaticResource FalseToVisible}}"/>
            </Grid>
            <c:ExplainToggle Header="{l:T Gpu.ComoLerGrafico}" Margin="0,6,0,0"
                             Content="{l:T MemDoc.EnquantoPaginaEstaAberta}"/>
          </StackPanel>
        </Border>

        <!-- Linha do tempo -->
        <Border Style="{StaticResource Panel.Card}" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <c:Icon Data="{StaticResource Icon.History}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T MemDoc.LinhaTempo}" Style="{StaticResource Text.H2}" FontSize="15.5"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DoctorEvent}">
                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="50"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Brush.Signal}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding When}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                    <TextBlock x:Name="text" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Text.Small}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="bad">
                      <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Bad}"/>
                      <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Bad}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warn">
                      <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
                      <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Trace}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="good">
                      <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Good}"/>
                      <Setter TargetName="dot" Property="Fill" Value="{StaticResource Brush.Good}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
