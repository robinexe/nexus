<!--
  Memória: diagnóstico. Quadro "Memória agora" (barras), suspeitos com evidência e soluções temporárias/permanentes,
  maiores consumidores com tendência, gráfico das últimas horas (em uso, comprometida, pool do kernel) e linha do tempo.
  Escrita só pelo aplicador (Host.ApplyAsync) a partir do ViewModel; aqui só ligações.
  Recursos locais em DataTemplate.Resources; do tema, só chaves do contrato (Tokens.xaml / Controls.xaml / Converters.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels">
  <DataTemplate DataType="{x:Type vm:MemoryDoctorPage}">
    <DataTemplate.Resources>

      <Style x:Key="Doc.Severity" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Severity}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding Severity}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="Doc.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.H1}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numbers}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="bad"><Setter Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding HeadlineTone}" Value="info"><Setter Property="Foreground" Value="{StaticResource Brush.Signal}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <DataTemplate x:Key="Doc.Bar" DataType="{x:Type vm:DoctorBar}">
        <Grid Margin="0,0,0,10" ToolTip="{Binding Detail}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
          <Grid Grid.Column="1" Height="12" Margin="0,0,12,0" VerticalAlignment="Center">
            <Border Background="{StaticResource Brush.Bg}" CornerRadius="3"/>
            <Rectangle x:Name="bar" Fill="{StaticResource Brush.Signal}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
              <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding Fraction}"/>
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
          <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" MinWidth="150"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="good"><Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Good}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Trace}"/></DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter TargetName="bar" Property="Fill" Value="{StaticResource Brush.Bad}"/></DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Doc.Source" DataType="{x:Type vm:MemSourceRow}">
        <Button Content="{Binding Title}" Command="{Binding OpenCommand}" ToolTip="{Binding Url}" Style="{StaticResource Button.Ghost}"
                HorizontalAlignment="Left" Margin="-8,0,0,0" Padding="8,2"/>
      </DataTemplate>

      <DataTemplate x:Key="Doc.Fix" DataType="{x:Type vm:DoctorFixRow}">
        <Border Style="{StaticResource Panel.Inset}" Margin="0,0,0,8" Padding="12,10">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
            <TextBlock Text="{Binding WhatItDoes}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding HowLong}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}"/>
            <TextBlock Text="{Binding Cost}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasButton, Converter={StaticResource BoolToVis}}">
              <Button x:Name="go" Content="{Binding ButtonText}" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
              <Button Content="Desfazer" Command="{Binding RevertCommand}" Style="{StaticResource Button.Secondary}"
                      Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsTemporary}" Value="False">
            <Setter TargetName="go" Property="Style" Value="{StaticResource Button.Primary}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="Doc.Suspect" DataType="{x:Type vm:DoctorSuspectRow}">
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding SeverityText}" Style="{StaticResource Doc.Severity}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,2,0,6"/>
            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Numbers}" Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Visibility="{Binding HasTemporary, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Resolver agora (temporário)" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Trace}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Temporary}" ItemTemplate="{StaticResource Doc.Fix}" Focusable="False"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Visibility="{Binding HasPermanent, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Resolver de vez (permanente)" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Good}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Permanent}" ItemTemplate="{StaticResource Doc.Fix}" Focusable="False"/>
              </StackPanel>
            </Grid>
            <StackPanel Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Fontes" Style="{StaticResource Text.Label}" Margin="0,8,0,2"/>
              <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Doc.Source}" Focusable="False"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="28,24,28,28" MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,16"/>

        <!-- Memória agora -->
        <Border Style="{StaticResource Panel.Hero}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Memória agora" Style="{StaticResource Text.Label}"/>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Doc.Headline}" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding Subline}" Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource Doc.Bar}" Focusable="False"/>
            <TextBlock Text="{Binding KernelText}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Small}"/>
            <TextBlock Text="{Binding PoolNote}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Ler agora" Command="{Binding SampleNowCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
              <Button Content="Recomeçar histórico" Command="{Binding ClearCommand}" Style="{StaticResource Button.Secondary}" Margin="0,0,16,0"/>
              <TextBlock Text="Ler a cada" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding IntervalMinutes}" Width="64" VerticalAlignment="Center"/>
              <TextBlock Text="min" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="6,0,16,0"/>
              <CheckBox Content="Continuar com a página fechada" IsChecked="{Binding KeepRecording}" VerticalAlignment="Center"
                        ToolTip="Continua lendo enquanto o NEXUS estiver aberto (nada é gravado em disco)."/>
            </StackPanel>
            <TextBlock Text="{Binding LastSample}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,16">
          <TextBlock Text="{x:Static vm:MemoryDoctorPage.HonestText}" Style="{StaticResource Text.Small}"/>
        </Border>

        <!-- Suspeitos -->
        <TextBlock Text="Suspeitos" Style="{StaticResource Text.H2}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding HistoryText}" Style="{StaticResource Text.Small}" Margin="0,0,0,10"/>
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,12" Visibility="{Binding NoSuspects, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Nada fora do normal até agora. Deixe a página aberta: vazamentos aparecem depois de 15 min subindo sem parar."
                     Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Good}"/>
        </Border>
        <ItemsControl ItemsSource="{Binding Suspects}" ItemTemplate="{StaticResource Doc.Suspect}" Focusable="False"/>

        <!-- Modo vigiar enquanto jogo -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,4,0,16">
          <StackPanel>
            <TextBlock Text="Vigiar enquanto jogo" Style="{StaticResource Text.H2}"/>
            <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,8"
                       Text="Desligado por padrão. Com um jogo aberto e a memória LIVRE abaixo de 5% (com cache grande), o NEXUS avisa e oferece esvaziar a lista de espera. Nunca roda sozinho: cada vez pede sua confirmação e permissão de administrador. Só ajuda em casos de engasgo com pouca RAM; a solução de verdade é mais memória."/>
            <CheckBox Content="Ligar o aviso" IsChecked="{Binding GameGuard}"/>
            <TextBlock Text="{Binding GuardText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"/>
            <Button Content="Esvaziar a lista de espera agora" Command="{Binding PurgeNowCommand}" Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding GuardSuggest, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </Border>

        <!-- Maiores consumidores -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Maiores consumidores" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="Somados por app (navegador = todas as abas) e serviços agrupados pelo svchost que os hospeda. Memória comprometida (privada) e o que está na RAM."
                       Style="{StaticResource Text.Small}" Margin="0,2,0,10"/>
            <ItemsControl ItemsSource="{Binding Consumers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DoctorConsumerRow}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Private}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.Text}" ToolTip="Memória comprometida (privada)"/>
                    <TextBlock Grid.Column="2" Text="{Binding WorkingSet}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.TextMuted}" ToolTip="Na RAM agora (working set)"/>
                    <TextBlock Grid.Column="3" Text="{Binding Processes}" Style="{StaticResource Text.Small}"/>
                    <TextBlock x:Name="trend" Grid.Column="4" Text="{Binding Trend}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding TrendTone}" Value="bad"><Setter TargetName="trend" Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
                    <DataTrigger Binding="{Binding TrendTone}" Value="good"><Setter TargetName="trend" Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Histórico (gráfico) -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Últimas horas" Style="{StaticResource Text.H2}"/>
            <TextBlock Text="Enquanto a página está aberta (ou com &quot;continuar com a página fechada&quot;). Escala: o maior entre RAM e limite de commit; o pool do kernel tem escala própria."
                       Style="{StaticResource Text.Small}" Margin="0,2,0,10"/>
            <Grid Height="140">
              <Border Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Control}"/>
              <Path Data="{Binding CommitGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" Margin="8"/>
              <Path Data="{Binding UsedGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" Margin="8"/>
              <Path Data="{Binding PoolGeometry}" Stretch="Fill" Stroke="{StaticResource Brush.Bad}" StrokeThickness="1.5" StrokeDashArray="3 2" Margin="8"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="— em uso" Foreground="{StaticResource Brush.Signal}" Style="{StaticResource Text.Small}" Margin="0,0,16,0"/>
              <TextBlock Text="— comprometida" Foreground="{StaticResource Brush.Trace}" Style="{StaticResource Text.Small}" Margin="0,0,16,0"/>
              <TextBlock Text="- - pool não paginado (kernel)" Foreground="{StaticResource Brush.Bad}" Style="{StaticResource Text.Small}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Linha do tempo -->
        <Border Style="{StaticResource Panel.Card}" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Linha do tempo" Style="{StaticResource Text.H2}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DoctorEvent}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                    <TextBlock x:Name="text" Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Text.Small}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="bad"><Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Bad}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Trace}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="good"><Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Good}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
