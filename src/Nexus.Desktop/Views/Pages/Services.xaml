<!--
  Serviços (design system v2, docs/10-design-system.md):
    1. Destaque: engrenagens + quantos serviços rodam agora (contando) e o anel de % rodando; selo honesto "quase nunca dá FPS".
    2. Quatro números (total, iniciam sozinhos, de terceiros, protegidos). Como funciona: lê → explica → aplica → desfaz.
    3. Ajustes prontos como cartões: ícone, para quem, quantos mudam e, item por item, antes → depois em selos (ciano → âmbar);
       o porquê de cada item e a nota de honestidade ficam em "Por que isso?". Aplicar / Desfazer no cartão.
    4. Todos os serviços: busca, filtros, lista com selos de estado e um painel de detalhe com a mudança individual.
  A lógica é a mesma do ServicesPage (só foram expostos números para a apresentação: RunningCount, PendingCount, AfterTone…).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls">
  <DataTemplate DataType="{x:Type vm:ServicesPage}">
    <DataTemplate.Resources>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Selo pequeno de tipo de início (texto puro, sem ícone): ciano = antes, cor do tom = depois. -->
      <Style x:Key="S.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Chip}"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- Linha do preset: nome, antes → depois. -->
      <DataTemplate x:Key="S.PresetItem" DataType="{x:Type vm:PresetItemRow}">
        <Grid Margin="0,4" ToolTip="{Binding Why}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0"/>
          <Border Grid.Column="1" Style="{StaticResource S.Pill}" BorderBrush="{StaticResource Brush.Signal}" Background="{StaticResource Brush.SignalSoft}">
            <TextBlock Text="{Binding Before}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" TextWrapping="NoWrap"/>
          </Border>
          <c:Icon Grid.Column="2" Data="{StaticResource Icon.ArrowRight}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="6,0" VerticalAlignment="Center"/>
          <Border Grid.Column="3" Style="{StaticResource S.Pill}" BorderBrush="{Binding AfterTone, Converter={StaticResource ToneBrush}}"
                  Background="{Binding AfterTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
            <TextBlock Text="{Binding After}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap"
                       Foreground="{Binding AfterTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
          </Border>
        </Grid>
      </DataTemplate>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="1180">

        <!-- Resultado da última ação -->
        <Border Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Control}" Padding="12,8" Margin="0,0,0,14"
                Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
          <DockPanel>
            <c:Icon Data="{StaticResource Icon.Info}" Size="16" Foreground="{StaticResource Brush.Signal}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" AutomationProperties.LiveSetting="Polite"/>
          </DockPanel>
        </Border>

        <!-- ===== 1. Destaque ===== -->
        <c:HeroPanel Illustration="{StaticResource Illo.Services}" Title="Rodando agora"
                     Number="{Binding RunningCount}" Decimals="0" Suffix=" serviços" IsLoading="{Binding IsLoading}"
                     Caption="A maioria fica em Manual e só abre quando precisa. Aqui ficam só ajustes com motivo claro."
                     SecondaryText="Ler de novo" SecondaryCommand="{Binding RefreshCommand}">
          <StackPanel Width="190">
            <c:RingMeter Value="{Binding RunningPercent}" Label="rodando" Width="120" Height="120" Thickness="10" HorizontalAlignment="Center"/>
            <c:StatusChip Tone="Warn" Text="Quase nunca dá FPS" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
        </c:HeroPanel>

        <!-- Desfazer visível depois de aplicar (mudança individual) -->
        <Border Style="{StaticResource Panel.Notice}" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Icon Data="{StaticResource Icon.History}" Size="16" Foreground="{StaticResource Brush.Trace}" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding LastChange}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- ===== 2. Números + como funciona ===== -->
        <c:SkeletonLoader Shape="Tiles" Columns="4" Height="150" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <UniformGrid Columns="4" Margin="-7,0,-7,16" Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Services}" Number="{Binding TotalCount}" Decimals="0"
                      Label="Serviços" Detail="Todos os instalados neste PC."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Startup}" Number="{Binding AutomaticCount}" Decimals="0" Tone="Warn"
                      Label="Iniciam sozinhos" Detail="Tipo automático: abrem no boot."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Apps}" Number="{Binding ThirdPartyCount}" Decimals="0" Tone="Info"
                      Label="De terceiros" Detail="Instalados por outros programas."/>
          <c:StatTile Margin="7,0" Icon="{StaticResource Icon.Lock}" Number="{Binding ProtectedCount}" Decimals="0" Tone="Good"
                      Label="Protegidos" Detail="Essenciais: o NEXUS não deixa mexer."/>
        </UniformGrid>

        <Border Style="{StaticResource Panel.Inset}" Padding="22,16,8,16" Margin="0,0,0,20">
          <StackPanel>
            <c:HowItWorks>
              <c:StepItem Icon="{StaticResource Icon.Search}" Title="Lê" Text="Lista os serviços e quem fez cada um. Ler não muda nada."/>
              <c:StepItem Icon="{StaticResource Icon.Info}" Title="Explica" Text="Cada ajuste mostra o que muda e por quê."/>
              <c:StepItem Icon="{StaticResource Icon.Services}" Title="Aplica" Text="Só o tipo de início. Vale no próximo boot." Tone="Warn"/>
              <c:StepItem Icon="{StaticResource Icon.Undo}" Title="Desfaz" Text="Cada serviço volta ao tipo anterior." Tone="Good"/>
            </c:HowItWorks>
            <c:ExplainToggle Margin="0,12,0,0"
                             Content="A maioria dos serviços já fica parada em Manual e só abre quando precisa: desligar serviços quase nunca dá FPS. Aqui ficam só ajustes com motivo claro, sempre reversíveis. Serviços essenciais (RPC, Defender, firewall, rede, som, anticheat) não podem ser alterados. Exige administrador; o Windows cria um ponto de restauração."/>
          </StackPanel>
        </Border>

        <!-- ===== 3. Ajustes prontos ===== -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <c:Icon Data="{StaticResource Icon.Sparkle}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
          <TextBlock Text="Ajustes prontos" Style="{StaticResource Text.H2}" FontSize="15.5"/>
        </StackPanel>
        <c:SkeletonLoader Shape="Tiles" Columns="2" Height="220" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" Margin="-7,0,-7,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PresetRow}">
              <Border Style="{StaticResource Panel.Card}" Padding="16,14" Margin="7,0,7,14">
                <DockPanel>
                  <!-- Ações no rodapé do cartão -->
                  <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                    <Button Grid.Column="1" Command="{Binding UndoCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Undo}" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Desfazer" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="Aplicar" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Title, StringFormat='Aplicar: {0}'}"/>
                  </Grid>

                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                        <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="20" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" FontSize="15.5" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ForWho}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ForWho}"/>
                      </StackPanel>
                      <c:StatusChip Grid.Column="2" Tone="{Binding StatusTone}" Text="{Binding ChangeText}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,10,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Summary}"/>

                    <!-- Antes → depois, item por item -->
                    <Border Style="{StaticResource Panel.Inset}" Margin="0,10,0,0" Padding="12,8">
                      <StackPanel>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Serviço" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                          <TextBlock Grid.Column="1" Text="antes → depois" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource S.PresetItem}" Focusable="False"/>
                      </StackPanel>
                    </Border>

                    <c:ExplainToggle Margin="0,4,0,0">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PresetItemRow}">
                              <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,4">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" Foreground="{StaticResource Brush.Text}"/><Run Text=": "/><Run Text="{Binding Why, Mode=OneWay}"/>
                              </TextBlock>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Honesty}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </c:ExplainToggle>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== 4. Todos os serviços ===== -->
        <Grid Margin="0,4,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <c:Icon Data="{StaticResource Icon.Services}" Size="18" Foreground="{StaticResource Brush.Signal}" Margin="0,0,8,0"/>
            <TextBlock Text="Todos os serviços" Style="{StaticResource Text.H2}" FontSize="15.5" TextWrapping="NoWrap"/>
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left"
                   ToolTip="Buscar por nome, nome interno ou descrição" AutomationProperties.Name="Buscar serviços"/>
          <Button Grid.Column="2" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" Margin="0,0,6,0"/>
              <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
            </StackPanel>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="svcFilter" Content="Todos" IsChecked="{Binding FilterAll}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="svcFilter" Content="Terceiros" IsChecked="{Binding FilterThirdParty}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="svcFilter" Content="Microsoft" IsChecked="{Binding FilterMicrosoft}"/>
          <RadioButton Style="{StaticResource Tab.Underline}" GroupName="svcFilter" Content="Em execução" IsChecked="{Binding FilterRunning}"/>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,0,8"
                   Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}"/>

        <c:SkeletonLoader Shape="Lines" Lines="8" Margin="4,4,4,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Visibility="{Binding IsLoading, Converter={StaticResource FalseToVisible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <ListView Height="520" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
                      VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="Serviços" Visibility="{Binding HasVisible, Converter={StaticResource BoolToVis}}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Serviço" Width="270">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:ServiceRow}">
                        <DockPanel>
                          <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="16" Foreground="{StaticResource Brush.TextMuted}"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Info.DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Info.DisplayName}"/>
                            <TextBlock Text="{Binding Info.Name}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Início" Width="170">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:ServiceRow}">
                        <Border Style="{StaticResource S.Pill}" HorizontalAlignment="Left"
                                BorderBrush="{Binding StartTone, Converter={StaticResource ToneBrush}}"
                                Background="{Binding StartTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                          <TextBlock Text="{Binding StartTypeText}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap"
                                     Foreground="{Binding StartTone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
                        </Border>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Estado" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type vm:ServiceRow}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Fill="{Binding StateTone, Converter={StaticResource ToneBrush}}"/>
                          <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Origem" Width="90" DisplayMemberBinding="{Binding Origin}"/>
                </GridView>
              </ListView.View>
            </ListView>
            <c:EmptyState Illustration="{StaticResource Illo.Services}" Text="Nenhum serviço com esse filtro."
                          Detail="Troque o filtro ou apague a busca."
                          Visibility="{Binding HasVisible, Converter={StaticResource FalseToVisible}}"/>
          </Grid>

          <!-- Detalhe + mudança individual -->
          <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="16,14" VerticalAlignment="Top">
            <StackPanel>
              <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}">
                <Grid Width="40" Height="40" HorizontalAlignment="Left">
                  <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                  <c:Icon Data="{StaticResource Icon.Services}" Size="20" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Escolha um serviço na lista." Style="{StaticResource Text.H2}" FontSize="15" Margin="0,10,0,4"/>
                <TextBlock Text="Você vê o que ele faz e pode mudar o tipo de início." Style="{StaticResource Text.Small}"/>
              </StackPanel>

              <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                  <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Brush.SignalSoft}"/>
                    <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="20" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Center"/>
                  </Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding Info.DisplayName}" Style="{StaticResource Text.H2}" FontSize="15"/>
                    <TextBlock Text="{Binding Info.Name}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}"/>
                  </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                  <c:StatusChip Tone="{Binding StartTone}" Text="{Binding StartTypeText}" Margin="0,0,6,6"/>
                  <c:StatusChip Tone="{Binding StateTone}" Text="{Binding StateText}" Margin="0,0,6,6"/>
                  <c:StatusChip Tone="Info" Text="{Binding Origin}" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,4,0,0"
                           MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding DescriptionText}"/>
                <Border Style="{StaticResource Panel.Notice}" Padding="8,6" Margin="0,8,0,0" Visibility="{Binding ProtectionText, Converter={StaticResource NullToCollapsed}}">
                  <DockPanel>
                    <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.Trace}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"/>
                  </DockPanel>
                </Border>
                <c:ExplainToggle Header="Mais detalhes" Margin="0,4,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource Text.Small}"/>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"><Run Text="Conta: " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding AccountText, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0"><Run Text="Depende de: " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding DependenciesText, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0"><Run Text="Editor: " Foreground="{StaticResource Brush.TextDim}"/><Run Text="{Binding PublisherText, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </c:ExplainToggle>
              </StackPanel>

              <!-- Mudança individual (no contexto da página para alcançar os comandos) -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding Selected.CanChange, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <Border Height="1" Background="{StaticResource Brush.LineSoft}" Margin="0,0,0,12"/>
                <TextBlock Text="Mudar o tipo de início" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Vale no próximo boot. Pede administrador e pode ser desfeito." Style="{StaticResource Text.Small}" Margin="0,2,0,8"/>
                <ComboBox ItemsSource="{Binding StartTypes}" SelectedItem="{Binding Chosen}" DisplayMemberPath="Label" AutomationProperties.Name="Novo tipo de início"/>
                <Button Content="Aplicar a este serviço" Style="{StaticResource Button.Secondary}" Command="{Binding ApplySelectedCommand}" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
