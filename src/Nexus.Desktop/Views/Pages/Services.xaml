<!--
  Serviços: presets explicados (antes/depois, aplicar, desfazer), busca e filtros, lista completa e detalhe com mudança individual.
  Recursos locais em DataTemplate.Resources; do tema, só chaves do contrato.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
                    xmlns:o="clr-namespace:Nexus.Desktop.Views.Optimize">
  <DataTemplate DataType="{x:Type vm:ServicesPage}">
    <DataTemplate.Resources>
      <o:EmptyToCollapsedConverter x:Key="S.Has"/>
      <o:EmptyToCollapsedConverter x:Key="S.HasNot" Invert="True"/>

      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Trace}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Signal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <!-- Filtro como segmento (mesmo desenho dos atalhos da página Medir). -->
      <Style x:Key="S.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="seg" Background="Transparent" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Control}" Padding="12,6">
                <TextBlock x:Name="label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.TextMuted}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.TextDim}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="seg" Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                  <Setter TargetName="seg" Property="Background" Value="{StaticResource Brush.SignalSoft}"/>
                  <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,24,28,28">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
        <TextBlock Style="{StaticResource Text.Small}" Margin="0,6,0,0"
                   Text="A maioria dos serviços já fica parada em Manual e só abre quando precisa: desligar serviços quase nunca dá FPS. Aqui ficam só ajustes com motivo claro, sempre reversíveis. Serviços essenciais (RPC, Defender, firewall, rede, som, anticheat) não podem ser alterados."/>

        <Border Style="{StaticResource Panel.Notice}" Margin="0,14,0,0" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding LastChange}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Desfazer" Style="{StaticResource Button.Secondary}" Command="{Binding UndoCommand}" Margin="12,0,0,0"/>
          </Grid>
        </Border>

        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Signal}" Margin="0,12,0,0"
                   Visibility="{Binding Message, Converter={StaticResource S.Has}}"/>

        <!-- Presets -->
        <TextBlock Text="Ajustes prontos" Style="{StaticResource Text.H2}" Margin="0,22,0,8"/>
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Panel.Card}" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Small}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding ForWho}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,4,0,0"/>
                  <Border Style="{StaticResource Panel.Inset}" Margin="0,8,0,0" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,2" ToolTip="{Binding Why}">
                            <TextBlock Text="{Binding Line}" FontFamily="{StaticResource Font.Numbers}" FontSize="{StaticResource Size.Small}"
                                       Foreground="{StaticResource Brush.Text}"/>
                            <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Small}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <TextBlock Text="{Binding Honesty}" Style="{StaticResource Text.Small}" Margin="0,8,0,0"/>
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Desfazer" Style="{StaticResource Button.Secondary}" Command="{Binding UndoCommand}" Margin="8,0,0,0"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="2" Content="Aplicar" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" Margin="8,0,0,0"/>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lista completa -->
        <TextBlock Text="Todos os serviços" Style="{StaticResource Text.H2}" Margin="0,18,0,8"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nome, nome interno ou descrição"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <RadioButton Style="{StaticResource S.Segment}" Content="Todos" IsChecked="{Binding FilterAll}" GroupName="svcFilter"/>
            <RadioButton Style="{StaticResource S.Segment}" Content="Terceiros" IsChecked="{Binding FilterThirdParty}" GroupName="svcFilter"/>
            <RadioButton Style="{StaticResource S.Segment}" Content="Microsoft" IsChecked="{Binding FilterMicrosoft}" GroupName="svcFilter"/>
            <RadioButton Style="{StaticResource S.Segment}" Content="Em execução" IsChecked="{Binding FilterRunning}" GroupName="svcFilter"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="12,0"/>
          <Button Grid.Column="3" Content="Ler de novo" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}"/>
        </Grid>
        <TextBlock Text="Lendo serviços e editores…" Style="{StaticResource Text.Small}" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
          </Grid.ColumnDefinitions>
          <ListView Height="520" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
                    VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Serviço" Width="250">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Info.DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Info.Name}" Style="{StaticResource Text.Small}" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Início" Width="150" DisplayMemberBinding="{Binding StartTypeText}"/>
                <GridViewColumn Header="Estado" Width="100" DisplayMemberBinding="{Binding StateText}"/>
                <GridViewColumn Header="Origem" Width="90" DisplayMemberBinding="{Binding Origin}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <Border Grid.Column="2" Style="{StaticResource Panel.Card}" VerticalAlignment="Top">
            <Grid>
              <TextBlock Text="Escolha um serviço na lista para ver o que ele faz e mudar o tipo de início." Style="{StaticResource Text.Small}"
                         Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}"/>
              <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource S.Has}}">
                <TextBlock Text="{Binding Info.DisplayName}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Display}"/>
                <TextBlock Text="{Binding Info.Name}" Style="{StaticResource Text.Small}"/>
                <TextBlock Text="{Binding DescriptionText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                <TextBlock Style="{StaticResource Text.Label}" Text="Tipo de início" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding StartTypeText}" Style="{StaticResource Text.Body}"/>
                <TextBlock Style="{StaticResource Text.Label}" Text="Estado agora" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Body}"/>
                <TextBlock Style="{StaticResource Text.Label}" Text="Conta" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding AccountText}" Style="{StaticResource Text.Small}"/>
                <TextBlock Style="{StaticResource Text.Label}" Text="Depende de" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding DependenciesText}" Style="{StaticResource Text.Small}"/>
                <TextBlock Style="{StaticResource Text.Label}" Text="Editor" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding PublisherText}" Style="{StaticResource Text.Small}"/>
                <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Bad}" Margin="0,10,0,0"
                           Visibility="{Binding ProtectionText, Converter={StaticResource S.Has}}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Mudança individual (fora do DataContext do detalhe para alcançar os comandos da página) -->
        <Border Style="{StaticResource Panel.Card}" Margin="0,12,0,0" Visibility="{Binding Selected.CanChange, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Small}" VerticalAlignment="Center" Margin="0,0,12,0"
                       Text="Mudar o tipo de início deste serviço. Vale a partir do próximo boot; exige administrador e pode ser desfeito."/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding StartTypes}" SelectedItem="{Binding Chosen}" DisplayMemberPath="Label"/>
            <Button Grid.Column="2" Content="Aplicar" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedCommand}" Margin="10,0,0,0"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
