<Window x:Class="Nexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Nexus.Desktop.Localization"
        xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell"
        xmlns:c="clr-namespace:Nexus.Desktop.Views.Controls"
        xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
        xmlns:opt="clr-namespace:Nexus.Desktop.Views.Optimize"
        Title="NEXUS Performance Lab" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource Size.Body}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <!--
    Casca (design system v2, docs/10-design-system.md): cabeçalho limpo (marca, selo de segurança com "Por que isso?",
    ações de leitura), navegação com ícone por página (mapa em Views/Shell/ShellMap.cs, sem mexer nas páginas), indicador da
    página atual animado, transição de entrada de página (ShellMotion.EnterPage, uma vez por troca) e rodapé com status.
    Qualquer página navega com Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="NomeDoTipoDaPagina".
  -->
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static shell:ShellCommands.Navigate}" Executed="OnNavigate" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>

  <Window.Resources>
    <!-- Páginas: Views/Pages/*.xaml (mescladas em App.xaml). Aqui só o que é da casca. -->

    <!-- Linha do feed da tela de progresso (a mesma do Assistente, Views/Pages/Assistant.xaml "As.FeedRow"). -->
      <DataTemplate x:Key="Shell.FeedRow" DataType="{x:Type vm:ProcessFeedRow}">
        <Grid x:Name="Row" Margin="0,5" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StatusText}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="Badge" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Top" c:Pulse.IsOn="{Binding IsRunning}">
            <Ellipse Fill="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}" Stroke="{Binding Tone, Converter={StaticResource ToneBrush}}" StrokeThickness="1"/>
            <c:Icon Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Size="13" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Center"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
            <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding Detail}"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Numbers}" Margin="12,2,0,0"
                     VerticalAlignment="Top" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=text}"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsChild}" Value="True">
            <Setter TargetName="Row" Property="Margin" Value="36,2,0,2"/>
            <Setter TargetName="Badge" Property="Width" Value="18"/>
            <Setter TargetName="Badge" Property="Height" Value="18"/>
            <Setter TargetName="Title" Property="FontSize" Value="13"/>
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsRunning}" Value="True">
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsPending}" Value="True">
            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsEstimate}" Value="True">
            <Setter TargetName="Detail" Property="FontStyle" Value="Italic"/>
            <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource Brush.Signal}"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

    <!-- Item da navegação lateral: ícone + nome; marca âmbar que cresce no ativo, lavagem leve no hover. -->
    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="10,1" Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" Background="Transparent"/>
              <Border x:Name="Wash" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Mark" Width="3" Margin="0,7" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Brush.Trace}"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
              </Border>
              <ContentPresenter Margin="14,8,12,8" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.05" Duration="{x:Static shell:ShellMotion.Fast}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static shell:ShellMotion.Fast}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <!-- A marca "cresce" do centro quando a página é escolhida (zero com animações desligadas). -->
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       From="0.2" To="1" Duration="{x:Static shell:ShellMotion.Normal}">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botões do cabeçalho: secundários compactos. -->
    <Style x:Key="Header.Button" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Selo de segurança do cabeçalho: clicável ("Por que isso?" abre a explicação num balão). -->
    <Style x:Key="Header.SafetyChip" TargetType="ToggleButton" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Background" Value="{StaticResource Brush.GoodSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Good}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5,10,6"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Cabeçalho: marca, selo de segurança, ações de leitura ============ -->
    <Border x:Name="HeaderBar" Grid.ColumnSpan="2" Background="{StaticResource Brush.SurfaceLow}"
            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid Margin="0,11,20,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Marca: traço de frametime com um pico (o que o NEXUS mede) sobre a linha de referência. -->
          <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
            <Canvas Width="44" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
              <Path Data="M0,16.5 L44,16.5" Stroke="{StaticResource Brush.Signal}" StrokeThickness="1" StrokeDashArray="2 2" Opacity="0.7"/>
              <Path Data="M0,16.5 L7,16.5 L9,14 L11,16.5 L17,16.5 L19.5,3 L22,16.5 L28,16.5 L30,13 L32,16.5 L44,16.5"
                    Stroke="{StaticResource Brush.Trace}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NEXUS" FontFamily="{StaticResource Font.Display}" FontSize="19" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
              <TextBlock Text="{l:T Shell.PerformanceLab}" Style="{StaticResource Text.Small}" Margin="0,-2,0,0" TextWrapping="NoWrap"/>
            </StackPanel>
          </StackPanel>

          <!-- Selo compacto: o aviso longo virou "Por que isso?" (balão). -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="SafetyChip" Style="{StaticResource Header.SafetyChip}"
                          AutomationProperties.Name="{l:T Shell.NadaMudaSemVoce}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=SafetyPopup, Converter={StaticResource InvertBool}}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Lock}" Size="14" StrokeThickness="2.2" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T Shell.NadaMudaSemVoce2}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T Shell.Isso}" Foreground="{StaticResource Brush.Signal}" Margin="12,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <Popup x:Name="SafetyPopup" PlacementTarget="{Binding ElementName=SafetyChip}" Placement="Bottom" VerticalOffset="8"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   IsOpen="{Binding IsChecked, ElementName=SafetyChip, Mode=TwoWay}">
              <Border Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Card}" Padding="16,12" MaxWidth="420" Margin="0,0,8,8">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <c:Icon Data="{StaticResource Icon.Security}" Size="18" Foreground="{StaticResource Brush.Good}" Margin="0,0,8,0"/>
                    <TextBlock Text="{l:T Shell.ComoNexusProtegeSeu}" Style="{StaticResource Text.H2}" FontSize="15"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ModeBanner}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
              </Border>
            </Popup>
          </StackPanel>

          <!-- Modo simples: só o botão de reler (ícone) e o selo de segurança. Modo completo: as ações de leitura de antes. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding RelaunchAsAdminCommand}" ToolTip="{l:T Shell.AlgumasLeiturasSoAparecem}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Header.Button}">
                  <Setter Property="Visibility" Value="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVis}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Security}" Size="15" Foreground="{StaticResource Brush.Trace}" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T Shell.VerTudoAdministrador}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Header.Button}" Command="{Binding RefreshCommand}"
                    ToolTip="{l:T Shell.LeHardwareWindowsNovo}" AutomationProperties.Name="{l:T Shell.LerNovo}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Refresh}" Size="15" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{l:T Shell.LerNovo}" TextWrapping="NoWrap" Margin="7,0,0,0" Visibility="{Binding IsFullMode, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Header.Button}" Command="{Binding ExportCommand}" Margin="0"
                    ToolTip="{l:T Shell.SalvaTudoFoiLido}" Visibility="{Binding IsFullMode, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <c:Icon Data="{StaticResource Icon.Export}" Size="15" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T Shell.ExportarLeitura}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- A varredura de abertura: um traço âmbar percorre a base do cabeçalho uma vez (ShellMotion.SweepOnce). -->
        <Canvas x:Name="SweepLayer" Height="2" VerticalAlignment="Bottom" ClipToBounds="True" IsHitTestVisible="False">
          <Rectangle x:Name="SweepBeam" Width="240" Height="2" Canvas.Left="-240" Opacity="0">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFB547" Offset="0"/>
                <GradientStop Color="#FFFFB547" Offset="0.92"/>
                <GradientStop Color="#FFFFE2B0" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Canvas>
      </Grid>
    </Border>

    <!-- ============ Navegação lateral agrupada, com ícone por página ============ -->
    <Border Grid.Row="1" Background="{StaticResource Brush.SurfaceLow}" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,1,0">
      <DockPanel>
      <!-- Pé da navegação: Ajustes (no modo simples) e a troca de modo ("Mostrar todas as ferramentas" / "Voltar ao modo simples"). -->
      <StackPanel DockPanel.Dock="Bottom" Margin="14,6,14,14">
        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Command="{x:Static shell:ShellCommands.Navigate}" CommandParameter="SettingsPage"
                Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Settings}" Size="16" Margin="0,0,8,0"/>
            <TextBlock Text="{l:T Settings.Ajustes}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Command="{Binding ToggleModeCommand}" ToolTip="{l:T Simple.Shell.ModeTip}">
          <StackPanel Orientation="Horizontal">
            <c:Icon Data="{StaticResource Icon.Apps}" Size="16" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ToggleModeText}" TextWrapping="Wrap" MaxWidth="170" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <ListBox x:Name="Nav" Margin="0,6,0,8" ItemContainerStyle="{StaticResource Nav.Item}"
               SelectedItem="{Binding SelectedPage, Mode=OneWay}" IsSynchronizedWithCurrentItem="False"
               Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Once"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel"
               AutomationProperties.Name="{l:T Shell.Navegacao}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Margin="24,16,12,5" Style="{StaticResource Text.Label}" FontSize="12"
                           Foreground="{StaticResource Brush.TextDim}"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ToolTip="{Binding Subtitle}" ToolTipService.InitialShowDelay="900">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <c:Icon x:Name="Ico" Data="{Binding Converter={StaticResource PageIcon}}" Size="18" Margin="0,0,11,0"/>
              <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
              <!-- Modo simples: ícone grande, uma palavra maior, mais altura por item. -->
              <DataTrigger Binding="{Binding DataContext.IsSimpleMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="Ico" Property="Size" Value="24"/>
                <Setter TargetName="Ico" Property="Margin" Value="0,10,14,10"/>
                <Setter TargetName="Name" Property="FontSize" Value="17"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource Brush.Trace}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </DockPanel>
    </Border>

    <!-- ============ Conteúdo: a página escolhida (com a transição de entrada) ============ -->
    <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding SelectedPage}" Focusable="False" IsTabStop="False"/>

    <!-- ============ Aviso único da mudança (quem já usava): o NEXUS ficou mais simples; como voltar ao completo ============ -->
    <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,14,24,0" MaxWidth="820" Panel.ZIndex="5"
            Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.SignalSoft}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}" Padding="18,12"
            Visibility="{Binding ShowSimpleNotice, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
      </Border.Effect>
      <DockPanel>
        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Sparkle}" Size="20" Foreground="{StaticResource Brush.Signal}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="{l:T Simple.Notice.Ok}" Style="{StaticResource Button.Primary}" Command="{Binding DismissNoticeCommand}"/>
          <Button Content="{l:T Simple.Notice.Full}" Style="{StaticResource Button.Ghost}" Command="{Binding NoticeFullCommand}"/>
        </StackPanel>
        <TextBlock Text="{l:T Simple.Notice.Text}" Style="{StaticResource Text.Body}" FontSize="14.5" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- ============ Boas-vindas (primeira abertura, uma vez): 3 telas curtas, dá para pular ============ -->
    <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="30" DataContext="{Binding Welcome}"
          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
      <Rectangle Fill="#F00E1320"/>
      <Border MaxWidth="760" Margin="32" VerticalAlignment="Center" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Line}"
              BorderThickness="1" CornerRadius="{StaticResource Radius.Panel}" Padding="44,36" AutomationProperties.Name="{l:T Simple.Welcome.Name}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <!-- 1. O que é -->
          <StackPanel Visibility="{Binding IsFirst, Converter={StaticResource BoolToVis}}">
            <Image Source="{StaticResource Illo.Pc}" Width="220" HorizontalAlignment="Left" Margin="-12,0,0,18"/>
            <TextBlock Text="{l:T Simple.Welcome.T1}" Style="{StaticResource Text.Display}" FontSize="32"/>
            <TextBlock Text="{l:T Simple.Welcome.S1}" Style="{StaticResource Text.Body}" FontSize="16" Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,0"/>
          </StackPanel>
          <!-- 2. Segurança -->
          <StackPanel Visibility="{Binding IsSecond, Converter={StaticResource BoolToVis}}">
            <Image Source="{StaticResource Illo.Security}" Width="220" HorizontalAlignment="Left" Margin="-12,0,0,18"/>
            <TextBlock Text="{l:T Simple.Welcome.T2}" Style="{StaticResource Text.Display}" FontSize="32"/>
            <TextBlock Text="{l:T Simple.Welcome.S2}" Style="{StaticResource Text.Body}" FontSize="16" Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,0"/>
          </StackPanel>
          <!-- 3. Escolha -->
          <StackPanel Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{l:T Simple.Welcome.T3}" Style="{StaticResource Text.Display}" FontSize="32" Margin="0,0,0,22"/>
            <UniformGrid Columns="2" Margin="-8,0">
              <Button Margin="8,0" Padding="22,20" HorizontalContentAlignment="Left" Command="{Binding ChooseSimpleCommand}" BorderBrush="{StaticResource Brush.Trace}"
                      AutomationProperties.Name="{l:T Simple.Welcome.Simple}">
                <StackPanel>
                  <c:Icon Data="{StaticResource Icon.Home}" Size="28" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{l:T Simple.Welcome.Simple}" FontFamily="{StaticResource Font.Display}" FontSize="20" Margin="0,12,0,4"/>
                  <TextBlock Text="{l:T Simple.Welcome.SimpleDetail}" Style="{StaticResource Text.Small}" FontSize="14"/>
                </StackPanel>
              </Button>
              <Button Margin="8,0" Padding="22,20" HorizontalContentAlignment="Left" Command="{Binding ChooseFullCommand}"
                      AutomationProperties.Name="{l:T Simple.Welcome.Full}">
                <StackPanel>
                  <c:Icon Data="{StaticResource Icon.Apps}" Size="28" Foreground="{StaticResource Brush.Signal}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{l:T Simple.Welcome.Full}" FontFamily="{StaticResource Font.Display}" FontSize="20" Margin="0,12,0,4"/>
                  <TextBlock Text="{l:T Simple.Welcome.FullDetail}" Style="{StaticResource Text.Small}" FontSize="14"/>
                </StackPanel>
              </Button>
            </UniformGrid>
            <TextBlock Text="{l:T Simple.Welcome.ChangeLater}" Style="{StaticResource Text.Small}" Margin="0,16,0,0"/>
          </StackPanel>

          <!-- Pontos e botões -->
          <DockPanel Margin="0,32,0,0">
            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Dots}" Focusable="False" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,8,0" Fill="{StaticResource Brush.Line}"/>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="True">
                      <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Trace}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="{l:T Simple.Welcome.Skip}" Style="{StaticResource Button.Ghost}" Command="{Binding SkipCommand}" Margin="0,0,8,0"
                      Visibility="{Binding NotChoice, Converter={StaticResource BoolToVis}}"/>
              <Button Content="{l:T Simple.Welcome.Back}" Style="{StaticResource Button.Secondary}" Command="{Binding BackCommand}"
                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
              <Button Content="{l:T Simple.Welcome.Next}" Style="{StaticResource Button.Primary}" Command="{Binding NextCommand}" Padding="22,10"
                      Visibility="{Binding NotChoice, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ Atualização: faixa não bloqueante sobre o conteúdo (ViewModels/AppUpdates.cs) ============ -->
    <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,18" MaxWidth="760"
            Background="{StaticResource Brush.SurfaceHi}" BorderBrush="{StaticResource Brush.Trace}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}" Padding="16,12"
            Visibility="{Binding Updates.BannerVisible, Converter={StaticResource BoolToVis}}"
            AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{l:T Shell.AtualizacaoNexus}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
      </Border.Effect>
      <DockPanel>
        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Sparkle}" Size="20" Foreground="{StaticResource Brush.Trace}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="{l:T Shell.ReiniciarAtualizar}" Style="{StaticResource Button.Primary}" Command="{Binding Updates.InstallNowCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Updates.BannerIsReady, Converter={StaticResource BoolToVis}}"/>
          <Button Content="{l:T Shell.AbrirDownloads}" Style="{StaticResource Button.Secondary}" Command="{Binding Updates.OpenDownloadsCommand}" Margin="0,0,8,0"
                  Visibility="{Binding Updates.BannerIsNotify, Converter={StaticResource BoolToVis}}"/>
          <Button Content="{Binding Updates.DismissText}" Style="{StaticResource Button.Ghost}" Command="{Binding Updates.LaterCommand}"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Updates.BannerText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Updates.BannerNote}" Style="{StaticResource Text.Small}" Margin="0,2,0,0"
                     Visibility="{Binding Updates.BannerNote, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ Tela de progresso de qualquer aplicar/desfazer (ViewModels/ApplyOverlay.cs) ============
         Mesmo painel de telemetria do Assistente (que tem a sua própria, embutida, e não usa esta). Fica por cima do conteúdo
         enquanto o aplicador trabalha e, no fim, mostra o resumo com "Ver resultado" e "Fechar". -->
    <Grid Grid.Row="1" Grid.Column="1" Panel.ZIndex="20" DataContext="{Binding ApplyView}"
          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding IsVisible}">
      <Rectangle Fill="#D90E1320"/>
      <Border MaxWidth="900" Margin="32,24" VerticalAlignment="Center" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.TraceLine}"
              BorderThickness="1" CornerRadius="{StaticResource Radius.Panel}" ClipToBounds="True" SnapsToDevicePixels="True"
              AutomationProperties.Name="{l:T Shell.AndamentoAplicacao}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
          <Rectangle Fill="{StaticResource Brush.Graticule}" Opacity="0.35"/>
          <Rectangle>
            <Rectangle.Fill>
              <RadialGradientBrush Center="0.22,0.38" GradientOrigin="0.22,0.38" RadiusX="0.55" RadiusY="0.9">
                <GradientStop Color="#22FFB547" Offset="0"/>
                <GradientStop Color="#00FFB547" Offset="1"/>
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <c:ScanlineOverlay IsActive="{Binding IsRunning}"/>
          <Path Data="M0,16 L0,0 L16,0" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
          <Path Data="M0,0 L16,0 L16,16" Stroke="{StaticResource Brush.Trace}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
          <Path Data="M0,0 L0,16 L16,16" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Opacity="0.7"/>
          <Path Data="M16,0 L16,16 L0,16" Stroke="{StaticResource Brush.Signal}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Opacity="0.7"/>

          <StackPanel Margin="30,24,30,22">
            <DockPanel Margin="0,0,0,18">
              <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="{StaticResource Radius.Chip}" Padding="10,4"
                      Background="{Binding RingTone, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{Binding RingTone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" Margin="0,0,7,0"
                           c:Pulse.IsOn="{Binding IsRunning}"/>
                  <TextBlock Text="{l:T Shell.Vivo}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{l:T Shell.Concluido}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" FontFamily="{StaticResource Font.Numbers}"
                             Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </Border>
              <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                <Ellipse Fill="{StaticResource Brush.TraceSoft}" Stroke="{StaticResource Brush.TraceLine}" StrokeThickness="1"/>
                <c:Icon Data="{StaticResource Icon.Apply}" Size="21" Foreground="{StaticResource Brush.Trace}" HorizontalAlignment="Center"/>
              </Grid>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.MetricLabel}" Foreground="{StaticResource Brush.Signal}" FontFamily="{StaticResource Font.Numbers}" FontSize="14">
                  <Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding LevelText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Width="200" Height="200" VerticalAlignment="Top">
                <c:ProcessRing Value="{Binding Percent}" IsActive="{Binding IsRunning}" Tone="{Binding RingTone}" Thickness="12"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <c:AnimatedNumber Value="{Binding Percent}" Kind="Percent" Decimals="0" FontFamily="{StaticResource Font.Numbers}" FontSize="50"
                                    Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{l:T Shell.Concluido}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Margin="30,4,0,0">
                <UniformGrid Columns="2" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="{l:T Shell.TempoRestante}" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource Font.Numbers}" FontSize="28" Foreground="{StaticResource Brush.Trace}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" AutomationProperties.Name="{l:T Shell.TempoRestante}"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{l:T Shell.Decorrido}" Style="{StaticResource Text.MetricLabel}"/>
                    <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Font.Numbers}" FontSize="28" Foreground="{StaticResource Brush.Signal}"
                               TextWrapping="NoWrap" Margin="0,2,0,0" AutomationProperties.Name="{l:T Shell.TempoDecorrido}"/>
                  </StackPanel>
                </UniformGrid>
                <Border Background="{StaticResource Brush.SurfaceLow}" BorderThickness="3,1,1,1" CornerRadius="{StaticResource Radius.Control}" Padding="14,10">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource Brush.Trace}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource Brush.Signal}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="{StaticResource Brush.SignalSoft}" CornerRadius="{StaticResource Radius.Chip}" Padding="8,2" Margin="10,0,0,0"
                              VerticalAlignment="Top" Visibility="{Binding CurrentIsEstimate, Converter={StaticResource BoolToVis}}"
                              ToolTip="{l:T Shell.AplicadorRespondeFimItem}">
                        <TextBlock Text="{l:T Shell.Estimativa}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" FontSize="11.5"/>
                      </Border>
                      <TextBlock Text="{l:T Shell.Agora}" Style="{StaticResource Text.MetricLabel}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Text.Body}" FontSize="15" Margin="0,4,0,0" MaxHeight="42" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentText}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding SummaryText}" FontFamily="{StaticResource Font.Numbers}" FontSize="21" Foreground="{StaticResource Brush.Good}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" opt:Reveal.Trigger="{Binding IsFinished}"
                               AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock Text="{l:T Shell.RespondaJanelaConfirmacaoOu}"
                               Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Signal}" Margin="0,6,0,0"
                               Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <DockPanel Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Right" Text="{l:T Shell.AtualizaSozinho}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
              <TextBlock Text="{l:T Shell.EstaAcontecendo}" Style="{StaticResource Text.H2}"/>
            </DockPanel>
            <Border Style="{StaticResource Panel.Inset}" Padding="14,8">
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Shell.FeedRow}" Focusable="False"/>
              </ScrollViewer>
            </Border>

            <DockPanel Margin="0,14,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                <Button Content="{l:T Shell.VerResultado}" Style="{StaticResource Button.Primary}" Command="{Binding ShowResultCommand}" Margin="0,0,10,0"/>
                <Button Content="{l:T Shell.Fechar}" Style="{StaticResource Button.Secondary}" Command="{Binding CloseCommand}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <c:Icon Data="{StaticResource Icon.Lock}" Size="14" Foreground="{StaticResource Brush.TextDim}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                <TextBlock Text="{l:T Shell.NaoInterromperMeioAplicador}"
                           Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" MaxWidth="700"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ============ Rodapé: status, legenda das cores e ocupado ============ -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.SurfaceLow}" BorderBrush="{StaticResource Brush.Line}"
            BorderThickness="0,1,0,0" Padding="22,6,20,7">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0"
                      Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{l:T Shell.Lendo}" Style="{StaticResource Text.Small}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <ProgressBar Width="110" Height="3" IsIndeterminate="{Binding Busy, Mode=OneWay}" VerticalAlignment="Center"
                         AutomationProperties.Name="{l:T Shell.LendoPc}"/>
          </StackPanel>
          <!-- Legenda das duas cores de medição, para ler os gráficos (só no modo completo, onde há gráficos). -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsFullMode, Converter={StaticResource BoolToVis}}">
            <Border Width="12" Height="2" Background="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{l:T Shell.MedidoAgora}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Border Width="12" Height="2" Background="{StaticResource Brush.Signal}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{l:T Shell.Referencia}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Brush.Good}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Brush.Trace}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
