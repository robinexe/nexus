<Window x:Class="Nexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
        xmlns:v="clr-namespace:Nexus.Desktop.Views"
        Title="NEXUS Performance Lab" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>

    <!-- ===================== Visão geral ===================== -->
    <DataTemplate DataType="{x:Type vm:OverviewPage}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Width="290" MinHeight="110">
                  <StackPanel>
                    <DockPanel>
                      <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Small}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Footer}" Style="{StaticResource Small}" Margin="0,8,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Hardware ===================== -->
    <DataTemplate DataType="{x:Type vm:HardwarePage}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Facts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="250"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ToolTip>
                              <TextBlock>
                                <Run Text="Fonte: "/><Run Text="{Binding Source, Mode=OneWay}"/>
                              </TextBlock>
                            </Grid.ToolTip>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Value, TargetNullValue=—}"/>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Tables}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Expander Header="{Binding Header}" Margin="0,10,0,0">
                            <StackPanel Margin="0,6,0,0">
                              <DockPanel Margin="0,0,0,4">
                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource Chip}"/>
                                <TextBlock Style="{StaticResource Small}"><Run Text="Fonte: "/><Run Text="{Binding Source, Mode=OneWay}"/></TextBlock>
                              </DockPanel>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Margin="0,0,0,4" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}"/>
                              <ListView ItemsSource="{Binding Rows}" v:TableColumns.Source="{Binding Columns}" MaxHeight="380"/>
                            </StackPanel>
                          </Expander>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Diagnóstico ===================== -->
    <DataTemplate DataType="{x:Type vm:DiagnosticsPage}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <TextBlock Text="{Binding Summary}" Margin="0,0,0,10"/>
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource Chip}" Margin="0,0,6,0"/>
                        <ContentPresenter Content="{Binding Basis}" ContentTemplate="{StaticResource Chip}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Evidence}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="{Binding RelatedActionId, Converter={StaticResource NullToCollapsed}}">
                      <Run Text="Ação relacionada no catálogo (não aplicada): "/><Run Text="{Binding RelatedActionId, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Catálogo ===================== -->
    <DataTemplate DataType="{x:Type vm:CatalogPage}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="230"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <TextBlock Text="{Binding Version}" Style="{StaticResource Small}" Margin="0,0,0,8"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Ação" Width="290" DisplayMemberBinding="{Binding Title}"/>
              <GridViewColumn Header="Classificação" Width="130" DisplayMemberBinding="{Binding Classification}"/>
              <GridViewColumn Header="Handler" Width="150" DisplayMemberBinding="{Binding Handler}"/>
              <GridViewColumn Header="Estado atual (lido)" Width="230" DisplayMemberBinding="{Binding Current}"/>
              <GridViewColumn Header="Desejado" Width="130" DisplayMemberBinding="{Binding Desired}"/>
              <GridViewColumn Header="Leitura" Width="190">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><ContentPresenter Content="{Binding ReadLabel}" ContentTemplate="{StaticResource Chip}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Aplicação" Width="260" DisplayMemberBinding="{Binding ApplyLabel}"/>
            </GridView>
          </ListView.View>
        </ListView>
        <Expander Grid.Row="2" Header="Itens rejeitados / mitos (com motivo)">
          <ListView ItemsSource="{Binding Rejected}" MaxHeight="200">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Id" Width="260" DisplayMemberBinding="{Binding Id}"/>
                <GridViewColumn Header="Classificação" Width="120" DisplayMemberBinding="{Binding Classification}"/>
                <GridViewColumn Header="Motivo" Width="620" DisplayMemberBinding="{Binding Reason}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Expander>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Selected}">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Style="{StaticResource Small}"><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Persistence, Mode=OneWay}"/><Run Text="  ·  reinício: "/><Run Text="{Binding Reboot, Mode=OneWay}"/><Run Text="  ·  privilégio: "/><Run Text="{Binding Privileges, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,6,0,0"><Run Text="Alvo: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Target, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0"><Run Text="Mecanismo: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Mechanism, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0" Visibility="{Binding Condition, Converter={StaticResource NullToCollapsed}}"><Run Text="Condição: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Condition, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0"><Run Text="Riscos: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Risks, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0"><Run Text="Evidência: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Evidence, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0"><Run Text="Verificação: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Verification, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0"><Run Text="Reversão: " Foreground="{StaticResource Muted}"/><Run Text="{Binding Revert, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0" Visibility="{Binding NotInstantiableReason, Converter={StaticResource NullToCollapsed}}"><Run Text="Fora da simulação: " Foreground="{StaticResource Muted}"/><Run Text="{Binding NotInstantiableReason, Mode=OneWay}"/></TextBlock>
              <TextBlock Margin="0,4,0,0" Foreground="#FF8A8A" Visibility="{Binding ReadError, Converter={StaticResource NullToCollapsed}}"><Run Text="Erro de leitura: "/><Run Text="{Binding ReadError, Mode=OneWay}"/></TextBlock>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- ===================== Simulação ===================== -->
    <DataTemplate DataType="{x:Type vm:PlanPage}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <Border Background="{StaticResource Warn}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding BlockedNotice}"/>
          </Border>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Ações simuláveis (todos os parâmetros resolvidos)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button DockPanel.Dock="Bottom" Content="Simular plano (dry-run)" Command="{Binding SimulateCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include}" Margin="0,3">
                      <TextBlock><Run Text="{Binding Title, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Classification, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11"/></TextBlock>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Grid.Column="1">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="0,0,0,8"/>
          <ListView ItemsSource="{Binding Rows}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Ação" Width="300" DisplayMemberBinding="{Binding Action}"/>
                <GridViewColumn Header="Resultado" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Kind, Converter={StaticResource StatusBrush}}" CornerRadius="9" Padding="8,1">
                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" TextWrapping="NoWrap"/>
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Lido agora" Width="170" DisplayMemberBinding="{Binding Observed}"/>
                <GridViewColumn Header="Desejado" Width="150" DisplayMemberBinding="{Binding Desired}"/>
                <GridViewColumn Header="Lote" Width="110" DisplayMemberBinding="{Binding Batch}"/>
                <GridViewColumn Header="Motivo" Width="320" DisplayMemberBinding="{Binding Reason}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Grid>
    </DataTemplate>

    <!-- ===================== Histórico ===================== -->
    <DataTemplate DataType="{x:Type vm:HistoryPage}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <TextBlock Text="{Binding Coordination}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Margin="0,0,0,8"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" Margin="0,0,0,10">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Início" Width="140" DisplayMemberBinding="{Binding Started}"/>
              <GridViewColumn Header="Situação" Width="170" DisplayMemberBinding="{Binding Status}"/>
              <GridViewColumn Header="Perfil" Width="220" DisplayMemberBinding="{Binding Profile}"/>
              <GridViewColumn Header="Catálogo" Width="120" DisplayMemberBinding="{Binding Catalog}"/>
              <GridViewColumn Header="Execução" Width="300" DisplayMemberBinding="{Binding RunId}"/>
            </GridView>
          </ListView.View>
        </ListView>
        <ListView Grid.Row="2" ItemsSource="{Binding Entries}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Id}"/>
              <GridViewColumn Header="Estado" Width="110" DisplayMemberBinding="{Binding State}"/>
              <GridViewColumn Header="Ação" Width="220" DisplayMemberBinding="{Binding Action}"/>
              <GridViewColumn Header="Original" Width="130" DisplayMemberBinding="{Binding Original}"/>
              <GridViewColumn Header="Desejado" Width="130" DisplayMemberBinding="{Binding Desired}"/>
              <GridViewColumn Header="Observado" Width="130" DisplayMemberBinding="{Binding Observed}"/>
              <GridViewColumn Header="Nota" Width="400" DisplayMemberBinding="{Binding Note}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </DataTemplate>

    <!-- ===================== Capacidades ===================== -->
    <DataTemplate DataType="{x:Type vm:CapabilitiesPage}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Área" Width="110" DisplayMemberBinding="{Binding Area}"/>
              <GridViewColumn Header="Capacidade" Width="360" DisplayMemberBinding="{Binding Capability}"/>
              <GridViewColumn Header="Rótulo" Width="210">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><ContentPresenter Content="{Binding Label}" ContentTemplate="{StaticResource Chip}"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Observação" Width="520">
                <GridViewColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Width="500"/></DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </DataTemplate>
    <!-- ===================== Broker (serviço) ===================== -->
    <DataTemplate DataType="{x:Type vm:BrokerPage}">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
          <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Sub}"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Consultar serviço" Command="{Binding StatusCommand}" Margin="0"/>
                <TextBlock Text="{Binding ServiceStatus}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <TextBlock Text="{Binding Gate}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Coordination}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Ações (as mesmas marcadas em Simulação)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <WrapPanel>
                <Button Content="Simular pelo broker" Command="{Binding PlanCommand}"/>
                <Button Content="Aplicar…" Command="{Binding ApplyCommand}"/>
              </WrapPanel>
              <TextBlock Text="Aplicar pede confirmação e só fica disponível quando o serviço informa escrita liberada." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Include}" Margin="0,3">
                      <TextBlock><Run Text="{Binding Title, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Desired, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11"/></TextBlock>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock><Run Text="Última execução: " FontWeight="SemiBold"/><Run Text="{Binding LastRunText, Mode=OneWay}"/></TextBlock>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Reverter esta execução…" Command="{Binding RevertCommand}"/>
                <Button Content="Encerrar sessão" Command="{Binding EndSessionCommand}"/>
                <Button Content="Recuperar interrompidas…" Command="{Binding RecoverCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <ListView ItemsSource="{Binding Results}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Ação" Width="260" DisplayMemberBinding="{Binding Action}"/>
                <GridViewColumn Header="Resultado" Width="130" DisplayMemberBinding="{Binding Outcome}"/>
                <GridViewColumn Header="Lido" Width="130" DisplayMemberBinding="{Binding Observed}"/>
                <GridViewColumn Header="Desejado" Width="120" DisplayMemberBinding="{Binding Desired}"/>
                <GridViewColumn Header="Detalhe" Width="420" DisplayMemberBinding="{Binding Detail}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.ColumnSpan="2" Background="{StaticResource Warn}" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Ler novamente" Command="{Binding RefreshCommand}"/>
          <Button Content="Exportar leitura (JSON)…" Command="{Binding ExportCommand}" Margin="0"/>
        </StackPanel>
        <TextBlock Text="{Binding ModeBanner}" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
          <TextBlock Text="NEXUS" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="Performance Lab" Style="{StaticResource Small}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="16,9"/>
              <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Title}" FontSize="14"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding SelectedPage}"/>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource PanelAlt}" Padding="12,4">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="140" Height="10" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Small}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
