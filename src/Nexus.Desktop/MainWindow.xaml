<Window x:Class="Nexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Nexus.Desktop.Views.Shell"
        Title="NEXUS Performance Lab" Width="1280" Height="820" MinWidth="980" MinHeight="600"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="{StaticResource Size.Body}"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Páginas: Views/Pages/*.xaml (mescladas em App.xaml). Aqui só o que é da casca. -->

    <!-- Item da navegação lateral: indicador âmbar no ativo, lavagem leve no hover. -->
    <Style x:Key="Nav.Item" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="10,1" Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" Background="Transparent"/>
              <Border x:Name="Wash" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Text}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Mark" Width="3" Margin="0,9" CornerRadius="1.5" HorizontalAlignment="Left" Background="{StaticResource Brush.Trace}" Opacity="0"/>
              <ContentPresenter Margin="16,9,12,9" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.05" Duration="{x:Static shell:ShellMotion.Fast}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static shell:ShellMotion.Fast}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHi}"/>
                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botões do cabeçalho: secundários compactos. -->
    <Style x:Key="Header.Button" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Cabeçalho: marca, aviso de modo, ações de leitura ============ -->
    <Border x:Name="HeaderBar" Grid.ColumnSpan="2" Background="{StaticResource Brush.SurfaceLow}"
            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid Margin="0,12,20,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Marca: traço de frametime com um pico (o que o NEXUS mede) sobre a linha de referência. -->
          <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
            <Canvas Width="44" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="False">
              <Path Data="M0,16.5 L44,16.5" Stroke="{StaticResource Brush.Signal}" StrokeThickness="1" StrokeDashArray="2 2" Opacity="0.7"/>
              <Path Data="M0,16.5 L7,16.5 L9,14 L11,16.5 L17,16.5 L19.5,3 L22,16.5 L28,16.5 L30,13 L32,16.5 L44,16.5"
                    Stroke="{StaticResource Brush.Trace}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NEXUS" FontFamily="{StaticResource Font.Display}" FontSize="19" Foreground="{StaticResource Brush.Text}" TextWrapping="NoWrap"/>
              <TextBlock Text="Performance Lab" Style="{StaticResource Text.Small}" Margin="0,-2,0,0" TextWrapping="NoWrap"/>
            </StackPanel>
          </StackPanel>

          <!-- Aviso de modo: sempre visível, discreto e legível. -->
          <Border Grid.Column="1" Style="{StaticResource Panel.Notice}" Padding="12,7" Margin="0,0,16,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="720"
                  ToolTip="Ler o PC e simular nunca altera nada. A escrita fica com o serviço, que tem as próprias travas.">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Cadeado -->
              <Path Width="12" Height="14" Margin="0,1,10,0" VerticalAlignment="Center" Stretch="None"
                    Data="M3,6.5 L3,4.5 C3,1 9,1 9,4.5 L9,6.5 M1,6.5 L11,6.5 L11,13 L1,13 Z"
                    Stroke="{StaticResource Brush.Trace}" StrokeThickness="1.3" StrokeLineJoin="Round"/>
              <TextBlock Grid.Column="1" Text="{Binding ModeBanner}" FontSize="12" LineHeight="16"
                         Foreground="{StaticResource Brush.Text}" Opacity="0.88" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Header.Button}" Command="{Binding RefreshCommand}"
                    ToolTip="Lê o hardware e o Windows de novo. Não muda nada.">
              <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                      Data="M12,7 A5,5 0 1 1 10.5,3.5 M10.8,0.8 L10.8,3.8 L7.8,3.8"
                      Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock Text="Ler de novo" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Header.Button}" Command="{Binding ExportCommand}" Margin="0"
                    ToolTip="Salva tudo o que foi lido num arquivo JSON.">
              <StackPanel Orientation="Horizontal">
                <Path Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                      Data="M7,1 L7,9 M3.8,6 L7,9.2 L10.2,6 M1.5,10.5 L1.5,13 L12.5,13 L12.5,10.5"
                      Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock Text="Exportar leitura" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- A varredura de abertura: um traço âmbar percorre a base do cabeçalho uma vez (ShellMotion.SweepOnce). -->
        <Canvas x:Name="SweepLayer" Height="2" VerticalAlignment="Bottom" ClipToBounds="True" IsHitTestVisible="False">
          <Rectangle x:Name="SweepBeam" Width="240" Height="2" Canvas.Left="-240" Opacity="0">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00FFB547" Offset="0"/>
                <GradientStop Color="#FFFFB547" Offset="0.92"/>
                <GradientStop Color="#FFFFE2B0" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Canvas>
      </Grid>
    </Border>

    <!-- ============ Navegação lateral agrupada ============ -->
    <Border Grid.Row="1" Background="{StaticResource Brush.SurfaceLow}" BorderBrush="{StaticResource Brush.LineSoft}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Legenda das duas cores de medição, para o jogador ler os gráficos. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="26,12,20,18">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Width="14" Height="2" Background="{StaticResource Brush.Trace}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Âmbar: o que você mede agora" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="14" Height="2" Background="{StaticResource Brush.Signal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Ciano: a referência" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.TextDim}"/>
          </StackPanel>
        </StackPanel>

        <ListBox x:Name="Nav" Margin="0,8,0,0" ItemContainerStyle="{StaticResource Nav.Item}"
                 SelectedItem="{Binding SelectedPage}" IsSynchronizedWithCurrentItem="False"
                 Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Once"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Navegação">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Margin="26,16,12,6" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextDim}"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============ Conteúdo: a página escolhida (com a transição de entrada) ============ -->
    <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding SelectedPage}" Focusable="False" IsTabStop="False"/>

    <!-- ============ Rodapé: status e ocupado ============ -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Brush.SurfaceLow}" BorderBrush="{StaticResource Brush.Line}"
            BorderThickness="0,1,0,0" Padding="22,7,20,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="Lendo" Style="{StaticResource Text.Small}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <ProgressBar Width="120" Height="3" IsIndeterminate="{Binding Busy}" VerticalAlignment="Center"/>
        </StackPanel>
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{StaticResource Brush.Signal}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Busy}" Value="True">
                  <Setter Property="Fill" Value="{StaticResource Brush.Trace}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Small}" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
