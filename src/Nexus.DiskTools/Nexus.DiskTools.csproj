<Project Sdk="Microsoft.NET.Sdk">
  <!-- Módulo DiskTools. net10.0: a lógica roda nos testes em qualquer SO; o que toca o Windows usa [SupportedOSPlatform("windows")]. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.DiskTools</RootNamespace>
    <!-- P/Invoke (LibraryImport) para tipo de mídia (IOCTL) e verificações da exclusão segura pelo handle. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
  </ItemGroup>
</Project>
