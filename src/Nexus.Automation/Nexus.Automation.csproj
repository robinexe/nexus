<Project Sdk="Microsoft.NET.Sdk">
  <!-- Módulo Automático: perfil do PC, recomendações, "Otimizar agora", verificação agendada e a base da linha de comando.
       net10.0: a lógica roda nos testes em qualquer SO; o que toca o Windows usa [SupportedOSPlatform("windows")]. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nexus.Automation</RootNamespace>
    <!-- P/Invoke (LibraryImport) das leituras de gabinete, bateria e tipo de disco. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <ProjectReference Include="..\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
    <ProjectReference Include="..\Nexus.Broker\Nexus.Broker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Rules\recommendations.v1.json" LogicalName="Nexus.Automation.Rules.recommendations.v1.json" />
  </ItemGroup>
</Project>
