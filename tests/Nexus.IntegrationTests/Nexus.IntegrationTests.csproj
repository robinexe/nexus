<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testes de integração com handlers REAIS (registro, energia, serviços). FORA da solução de propósito:
       só rodam numa VM Windows de teste. Cada teste avalia o VmOnlyExecutionGate antes de qualquer escrita e falha
       sem tocar no sistema se não estiver liberado; o broker confere o portão de novo. Ver tools/vm/README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexus.Broker\Nexus.Broker.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Persistence\Nexus.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Cleaning\Nexus.Cleaning.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Cpu\Nexus.Lab.Cpu.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Gpu\Nexus.Lab.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Memory\Nexus.Lab.Memory.csproj" />
    <ProjectReference Include="..\..\src\Nexus.DiskTools\Nexus.DiskTools.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Programs\Nexus.Programs.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Boot\Nexus.Boot.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Privacy\Nexus.Privacy.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Security\Nexus.Security.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Monitoring\Nexus.Monitoring.csproj" />
    <ProjectReference Include="..\..\src\Nexus.SystemTools\Nexus.SystemTools.csproj" />
    <ProjectReference Include="..\..\src\Nexus.DriverUpdates\Nexus.DriverUpdates.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Automation\Nexus.Automation.csproj" />
    <ProjectReference Include="..\..\src\Nexus.GameProfiles\Nexus.GameProfiles.csproj" />
    <ProjectReference Include="..\..\src\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Recovery.Cli\Nexus.Recovery.Cli.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Assistant\Nexus.Assistant.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Broker.Host\Nexus.Broker.Host.csproj" ReferenceOutputAssembly="false" />
    <!-- nexus.exe ao lado do aplicador (como no produto instalado): a etapa "Manter em dia" do assistente agenda a verificação
         semanal apontando para ele. Só a ordem de compilação; os arquivos são copiados em CopyCli. -->
    <ProjectReference Include="..\..\src\Nexus.Cli\Nexus.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyBrokerHost" AfterTargets="Build">
    <ItemGroup>
      <BrokerHostFiles Include="$(MSBuildThisFileDirectory)..\..\src\Nexus.Broker.Host\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerHostFiles)" DestinationFiles="@(BrokerHostFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCli" AfterTargets="Build">
    <ItemGroup>
      <CliCandidates Include="$(MSBuildThisFileDirectory)..\..\src\Nexus.Cli\bin\$(Configuration)\net10.0\nexus.exe;$(MSBuildThisFileDirectory)..\..\src\Nexus.Cli\bin\$(Configuration)\net10.0\nexus.dll;$(MSBuildThisFileDirectory)..\..\src\Nexus.Cli\bin\$(Configuration)\net10.0\nexus.runtimeconfig.json" />
      <CliFiles Include="@(CliCandidates)" Condition="Exists('%(CliCandidates.FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
