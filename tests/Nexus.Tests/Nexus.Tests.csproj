<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\..\src\Nexus.WindowsActions\Nexus.WindowsActions.csproj" />
    <ProjectReference Include="..\..\src\Nexus.GameProfiles\Nexus.GameProfiles.csproj" />
    <ProjectReference Include="..\..\src\Nexus.TraceAnalysis\Nexus.TraceAnalysis.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Experimentation\Nexus.Experimentation.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Measurement\Nexus.Measurement.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Cleaning\Nexus.Cleaning.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Cpu\Nexus.Lab.Cpu.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Gpu\Nexus.Lab.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Lab.Memory\Nexus.Lab.Memory.csproj" />
    <ProjectReference Include="..\..\src\Nexus.DiskTools\Nexus.DiskTools.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Programs\Nexus.Programs.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Boot\Nexus.Boot.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Privacy\Nexus.Privacy.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Security\Nexus.Security.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Security.Scanner\Nexus.Security.Scanner.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Monitoring\Nexus.Monitoring.csproj" />
    <ProjectReference Include="..\..\src\Nexus.SystemTools\Nexus.SystemTools.csproj" />
    <ProjectReference Include="..\..\src\Nexus.DriverUpdates\Nexus.DriverUpdates.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Automation\Nexus.Automation.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Assistant\Nexus.Assistant.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Persistence\Nexus.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Nexus.HardwareDiscovery\Nexus.HardwareDiscovery.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Broker\Nexus.Broker.csproj" />
    <ProjectReference Include="..\..\src\Nexus.SelfTest\Nexus.SelfTest.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Updates\Nexus.Updates.csproj" />
    <!-- Executáveis iniciados como processos separados pelos testes de coordenação (copiados para a saída dos testes). -->
    <ProjectReference Include="..\Nexus.TestHelper\Nexus.TestHelper.csproj" />
    <ProjectReference Include="..\..\src\Nexus.Recovery.Cli\Nexus.Recovery.Cli.csproj" />
    <!-- Só ordem de build: DesktopReadOnlyTests inspeciona o Nexus.Desktop.dll compilado (net10.0-windows). -->
    <ProjectReference Include="..\..\src\Nexus.Desktop\Nexus.Desktop.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lógica pura do design system (sem WPF), compilada também aqui para os testes (DesignSystemTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\Views\Controls\DesignMath.cs" Link="DesignSystem\DesignMath.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\Views\Shell\ShellMap.cs" Link="DesignSystem\ShellMap.cs" />
    <!-- Lógica pura da casca: vigia da interface (suspensão não é travamento) e contagem "Manter esta taxa?". -->
    <Compile Include="..\..\src\Nexus.Desktop\Services\Shell\StallDetector.cs" Link="Shell\StallDetector.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\KeepChangeCountdown.cs" Link="Shell\KeepChangeCountdown.cs" />
    <!-- Avisos do NEXUS: texto em blocos e tom (DialogTextTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\DialogText.cs" Link="Shell\DialogText.cs" />
    <!-- Modo simples: modos da navegação, nota de saúde, "o que dá para melhorar", achados em palavras simples (SimpleModeTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\SimpleLogic.cs" Link="Shell\SimpleLogic.cs" />
    <!-- Jogos: estado real de cada opção e o que a desfaz no diário (GameOptionStateTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\GameOptionStates.cs" Link="Shell\GameOptionStates.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\GameCardPlans.cs" Link="Shell\GameCardPlans.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\GameCardLookup.cs" Link="Shell\GameCardLookup.cs" />
    <!-- Recomendação por hardware: textos dos vereditos, seleção padrão e frase do perfil (HardwareRecommendationTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\HardwareFitText.cs" Link="Shell\HardwareFitText.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\GameSessionStore.cs" Link="Shell\GameSessionStore.cs" />
    <!-- Laboratório A/B: candidatos, pedidos e frases do veredito (AbLabPageTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Modules\AbLabText.cs" Link="Shell\AbLabText.cs" />
    <!-- Medir: "Por que travou?" em palavras simples (MeasureStutterTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Modules\MeasureStutter.cs" Link="Shell\MeasureStutter.cs" />
    <!-- Checagens do PC: achados em palavras simples com os números da leitura (PcChecksDesktopTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\PcCheckText.cs" Link="Shell\PcCheckText.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\ViewModels\Simple\PcChecksCoordinator.cs" Link="Shell\PcChecksCoordinator.cs" />
    <!-- Idiomas: Loc/LanguageOption (lógica pura) e os mesmos .resx, com o nome de recurso do Desktop (LocalizationTests). -->
    <Compile Include="..\..\src\Nexus.Desktop\Localization\Loc.cs" Link="Localization\Loc.cs" />
    <Compile Include="..\..\src\Nexus.Desktop\Localization\LanguageOption.cs" Link="Localization\LanguageOption.cs" />
    <EmbeddedResource Include="..\..\src\Nexus.Desktop\Localization\Strings.resx" Link="Localization\Strings.resx" LogicalName="Nexus.Desktop.Localization.Strings.resources" />
    <EmbeddedResource Include="..\..\src\Nexus.Desktop\Localization\Strings.en.resx" Link="Localization\Strings.en.resx" LogicalName="Nexus.Desktop.Localization.Strings.en.resources" />
    <EmbeddedResource Include="..\..\src\Nexus.Desktop\Localization\Strings.es.resx" Link="Localization\Strings.es.resx" LogicalName="Nexus.Desktop.Localization.Strings.es.resources" />
    <Using Include="Nexus.Desktop.Localization" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
